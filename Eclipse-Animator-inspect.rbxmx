            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)
local GifBackground = require("GifBackground")
local GifSequence = require("Sequence")
local presetRevision = 0
local requestRevision = 0
local activeProgress
local HttpService = game:GetService("HttpService")

local ThemeConfig = require("ThemeConfig")

local Theme = {}

local screenGui = nil
local extraRoots = {}
local getSetting = nil
local setSetting = nil
local updateSetting = nil
local persistedTheme = nil
local timelineState = nil
local getTimeline = nil

local mode = "A"
local overrides = {}
local scriptOriginals = nil
local changedCallbacks = {}
local initialized = false
local themeRevision = 0
local appliedRevision = setmetatable({}, { __mode = "k" })
local pendingTheme = setmetatable({}, { __mode = "k" })
local themeQueued = false

local ATTR_PROPS = {
	ThemeBg = { "BackgroundColor3", "BackgroundTransparency" },
	ThemeTxt = { "TextColor3", "TextTransparency" },
	ThemeImg = { "ImageColor3", "ImageTransparency" },
	ThemeStrk = { "Color", "Transparency" },
	ThemeScr = { "ScrollBarImageColor3", "ScrollBarImageTransparency" },
	ThemeGrad = { "Color", nil },
}

local function hexToColor(hex)
	hex = tostring(hex or ""):gsub("#", "")
	if #hex ~= 6 then
		return nil
	end

	local r = tonumber(hex:sub(1, 2), 16)
	local g = tonumber(hex:sub(3, 4), 16)
	local b = tonumber(hex:sub(5, 6), 16)
	if not r or not g or not b then
		return nil
	end

	return Color3.fromRGB(r, g, b)
end

local function colorToHex(c)
	return string.format(
		"#%02x%02x%02x",
		math.round(c.R * 255),
		math.round(c.G * 255),
		math.round(c.B * 255)
	)
end

function Theme.parseValue(str)
	if typeof(str) ~= "string" or str == "" then
		return nil
	end

	local rot = nil
	local atPos = str:find("@")
	if atPos then
		rot = tonumber(str:sub(atPos + 1))
		str = str:sub(1, atPos - 1)
	end

	local stops = {}
	for part in str:gmatch("[^>]+") do
		local c = hexToColor(part)
		if not c then
			return nil
		end

		table.insert(stops, c)
	end

	if #stops == 0 then
		return nil
	end

	return { stops = stops, rot = rot }
end

function Theme.formatValue(v)
	if not v or not v.stops or #v.stops == 0 then
		return nil
	end

	local parts = {}
	for _, c in ipairs(v.stops) do
		table.insert(parts, colorToHex(c))
	end

	local s = table.concat(parts, ">")
	if v.rot and v.rot ~= 0 and #v.stops > 1 then
		s ..= "@" .. tostring(math.round(v.rot))
	end

	return s
end

local function shade(c, modName, amt)
	if modName == "darken" then
		return c:Lerp(Color3.new(0, 0, 0), amt)
	elseif modName == "lighten" then
		return c:Lerp(Color3.new(1, 1, 1), amt)
	end

	return c
end

local function shadeValue(v, modName, amt)
	if not modName then
		return v
	end

	local stops = {}
	for _, c in ipairs(v.stops) do
		table.insert(stops, shade(c, modName, amt))
	end

	return { stops = stops, rot = v.rot, t = v.t }
end

local oldEclipse = false
local legacyValues = {}
local defaultValues = {}
for _, setting in ipairs(ThemeConfig.settings) do
	local legacy = Theme.parseValue(ThemeConfig.oldTheme[setting.key])
	if legacy then
		legacyValues[setting.key] = legacy
	end

	local value = Theme.parseValue(ThemeConfig.defaultTheme[setting.key])
	if value then
		defaultValues[setting.key] = value
	end
end

local function baseValues()
	return oldEclipse and legacyValues or defaultValues
end

function Theme.panelOutlineDefault()
	if baseValues().Strk then
		return baseValues().Strk.stops[1]
	end

	local node = screenGui
	for _, name in { "Frame", "Tabs", "Animator", "Frames", "Main", "BottomContainer" } do
		node = node and node:FindFirstChild(name)
	end

	local stroke = node and node:FindFirstChildOfClass("UIStroke")
	local original = stroke and stroke:GetAttribute("EOrig_Color")
	return typeof(original) == "Color3" and original
		or stroke and stroke.Color
		or Color3.fromRGB(147, 147, 147)
end

local effectiveCache
local sequenceCache = setmetatable({}, { __mode = "k" })

local function effectiveValues()
	if effectiveCache then
		return effectiveCache
	end

	local values = table.clone(baseValues())
	for key, value in pairs(overrides) do
		values[key] = value
	end

	if not values.Div then
		values.Div = values.Strk or { stops = { Theme.panelOutlineDefault() } }
	end

	effectiveCache = values
	return values
end

local function encodeOrigValue(v)
	if typeof(v) == "ColorSequence" then
		local parts = {}
		for _, kp in ipairs(v.Keypoints) do
			table.insert(parts, colorToHex(kp.Value))
		end

		return "CS:" .. table.concat(parts, ">")
	end

	return v
end

local function decodeOrigValue(v)
	if typeof(v) == "string" and v:sub(1, 3) == "CS:" then
		local parsed = Theme.parseValue(v:sub(4))
		if parsed then
			if #parsed.stops == 1 then
				return ColorSequence.new(parsed.stops[1])
			end

			local kps = {}
			for i, c in ipairs(parsed.stops) do
				table.insert(kps, ColorSequenceKeypoint.new((i - 1) / (#parsed.stops - 1), c))
			end

			return ColorSequence.new(kps)
		end

		return nil
	end

	return v
end

local function captureOriginal(inst, prop)
	local attr = "EOrig_" .. prop
	if inst:GetAttribute(attr) == nil then
		local ok, v = pcall(function()
			return inst[prop]
		end)
		if ok and v ~= nil then
			pcall(function()
				inst:SetAttribute(attr, encodeOrigValue(v))
			end)
		end
	end
end

local function getOriginal(inst, prop)
	local v = inst:GetAttribute("EOrig_" .. prop)
	if v == nil then
		return nil
	end

	return decodeOrigValue(v)
end

local buttonText = setmetatable({}, { __mode = "k" })

function Theme.separateButtonText(button)
	if not button:IsA("TextButton") or button.Text == "" then
		return nil
	end

	if buttonText[button] then
		return buttonText[button]
	end

	local label = Instance.new("TextLabel")
	label.Name = "EclipseButtonText"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Active = false
	label.Selectable = false
	local properties = {
		"Text",
		"FontFace",
		"TextSize",
		"TextColor3",
		"TextTransparency",
		"TextStrokeColor3",
		"TextStrokeTransparency",
		"TextXAlignment",
		"TextYAlignment",
		"TextWrapped",
		"TextScaled",
		"TextTruncate",
		"RichText",
		"LineHeight",
		"MaxVisibleGraphemes",
	}
	for _, prop in properties do
		label[prop] = button[prop]
	end

	captureOriginal(button, "TextTransparency")
	captureOriginal(button, "TextStrokeTransparency")
	buttonText[button] = label
	label.ZIndex = button.ZIndex + 1
	label.Parent = button
	local connections = {}
	for _, prop in properties do
		table.insert(
			connections,
			button:GetPropertyChangedSignal(prop):Connect(function()
				if prop == "TextTransparency" or prop == "TextStrokeTransparency" then
					if button[prop] ~= 1 then
						label[prop] = button[prop]
						button[prop] = 1
					end
				else
					label[prop] = button[prop]
				end
			end)
		)
	end

	table.insert(
		connections,
		button:GetPropertyChangedSignal("ZIndex"):Connect(function()
			label.ZIndex = button.ZIndex + 1
		end)
	)
	button.TextTransparency = 1
	button.TextStrokeTransparency = 1
	for _, child in button:GetChildren() do
		if child:IsA("UIPadding") or child:IsA("UITextSizeConstraint") then
			child:Clone().Parent = label
		end
	end

	button.Destroying:Once(function()
		for _, c in connections do
			c:Disconnect()
		end

		buttonText[button] = nil
	end)
	return label
end

local function setProp(inst, prop, value)
	if buttonText[inst] and (prop:sub(1, 4) == "Text" or prop == "FontFace") then
		inst = buttonText[inst]
	end

	pcall(function()
		if
			prop == "BackgroundTransparency"
			or prop == "TextTransparency"
			or prop == "ImageTransparency"
			or prop == "Transparency"
			or prop == "ScrollBarImageTransparency"
		then
			require("WindowFX").setRestingProperty(inst, prop, value)
		elseif inst[prop] ~= value then
			inst[prop] = value
		end
	end)
end

local function restoreProp(inst, prop)
	local v = getOriginal(inst, prop)
	if v ~= nil then
		setProp(inst, prop, v)
	end
end

local function toSequence(v)
	local cached = sequenceCache[v]
	if cached then
		return cached
	end

	if #v.stops == 1 then
		local sequence = ColorSequence.new(v.stops[1])
		sequenceCache[v] = sequence
		return sequence
	end

	local kps = {}
	for i, c in ipairs(v.stops) do
		table.insert(kps, ColorSequenceKeypoint.new((i - 1) / (#v.stops - 1), c))
	end

	local sequence = ColorSequence.new(kps)
	sequenceCache[v] = sequence
	return sequence
end

local function hasTaggedGradient(inst, key)
	for _, c in ipairs(inst:GetChildren()) do
		if c:IsA("UIGradient") and c:GetAttribute("ThemeGrad") == key then
			return true
		end
	end

	return false
end

local function findForeignGradient(inst)
	for _, c in ipairs(inst:GetChildren()) do
		if
			c:IsA("UIGradient")
			and c.Name ~= "EclipseThemeGradient"
			and not c:GetAttribute("ThemeGrad")
		then
			return c
		end
	end

	return nil
end

local function manageGradientChild(inst, v)
	local g = inst:FindFirstChild("EclipseThemeGradient")
	local foreign = findForeignGradient(inst)
	if v and #v.stops > 1 then
		if foreign then
			if g then
				g:Destroy()
			end

			captureOriginal(foreign, "Color")
			captureOriginal(foreign, "Rotation")
			setProp(foreign, "Color", toSequence(v))
			setProp(foreign, "Rotation", v.rot or 90)
		else
			if not g then
				g = Instance.new("UIGradient")
				g.Name = "EclipseThemeGradient"
				g.Parent = inst
			end

			g.Color = toSequence(v)
			g.Rotation = v.rot or 90
			g.Enabled = true
		end
	else
		if g then
			g:Destroy()
		end

		if foreign then
			restoreProp(foreign, "Color")
			restoreProp(foreign, "Rotation")
		end
	end
end

local function applyAttrToInstance(inst, attrName, key, values)
	local props = ATTR_PROPS[attrName]
	if not props then
		return
	end

	local colorProp, transProp = props[1], props[2]
	local v = values[key]

	if attrName == "ThemeGrad" then
		captureOriginal(inst, "Color")
		if v then
			setProp(inst, "Color", toSequence(v))
			if v.rot then
				captureOriginal(inst, "Rotation")
				setProp(inst, "Rotation", v.rot)
			else
				restoreProp(inst, "Rotation")
			end
		else
			restoreProp(inst, "Color")
			restoreProp(inst, "Rotation")
		end

		return
	end

	captureOriginal(inst, colorProp)
	if transProp then
		captureOriginal(inst, transProp)
	end

	local shadeAmt = inst:GetAttribute("ThemeShade")
	if v and typeof(shadeAmt) == "number" and shadeAmt ~= 0 then
		v = shadeValue(v, shadeAmt > 0 and "lighten" or "darken", math.abs(shadeAmt))
	end

	if attrName == "ThemeTxt" and inst:IsA("TextBox") then
		captureOriginal(inst, "PlaceholderColor3")
		if v then
			setProp(inst, "PlaceholderColor3", shade(v.stops[1], "darken", 0.35))
		else
			restoreProp(inst, "PlaceholderColor3")
		end
	end

	if v then
		setProp(inst, colorProp, v.stops[1])
		if attrName == "ThemeBg" or attrName == "ThemeStrk" then
			if hasTaggedGradient(inst, key) then
				manageGradientChild(inst, nil)
				setProp(inst, colorProp, Color3.new(1, 1, 1))
			elseif #v.stops > 1 then
				manageGradientChild(inst, v)
				setProp(inst, colorProp, Color3.new(1, 1, 1))
			else
				manageGradientChild(inst, nil)
			end
		end

		if transProp and v.t ~= nil then
			setProp(inst, transProp, v.t)
		elseif transProp then
			restoreProp(inst, transProp)
		end
	else
		restoreProp(inst, colorProp)
		if transProp then
			restoreProp(inst, transProp)
		end

		if attrName == "ThemeBg" or attrName == "ThemeStrk" then
			manageGradientChild(inst, nil)
		end
	end

	local stateTransparency = (attrName == "ThemeBg" or attrName == "ThemeTxt")
		and inst:GetAttribute(attrName .. "Transparency")
	if typeof(stateTransparency) == "number" then
		require("WindowFX").setRestingProperty(
			inst,
			attrName == "ThemeTxt" and "TextTransparency" or "BackgroundTransparency",
			1 - (1 - stateTransparency) * (1 - (v and v.t or 0))
		)
	end
end

local function backgroundLayout(value)
	local function finite(n, fallback, lo, hi)
		return typeof(n) == "number"
				and n == n
				and math.abs(n) < math.huge
				and math.clamp(n, lo, hi)
			or fallback
	end

	value = type(value) == "table" and value or {}
	return {
		scale = finite(value.scale, 1, 0.25, 4),
		x = finite(value.x, 0, -1, 1),
		y = finite(value.y, 0, -1, 1),
	}
end

local function applyBackgroundImage(inst, values)
	local v = values.Img
	local stray = inst:FindFirstChild("EclipseThemeBackground")
	if stray then
		stray:Destroy()
	end

	local folder = inst:FindFirstChild("EclipseThemeBackdrop")
	if folder and not folder:IsA("Folder") then
		folder:Destroy()
		folder = nil
	end

	local viewport = folder and folder:FindFirstChild("Viewport")
	local img = viewport and viewport:FindFirstChild("EclipseThemeBackground")
	local frames = v and v.mode ~= "image" and GifBackground.effectiveFrames(v.frames) or nil
	if v and (frames or (v.image and v.image ~= "")) then
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "EclipseThemeBackdrop"
			folder.Parent = inst
		end

		if not viewport then
			local legacy = folder:FindFirstChild("EclipseThemeBackground")
			if legacy then
				GifBackground.bind(legacy, nil)
				legacy:Destroy()
			end

			viewport = Instance.new("Frame")
			viewport.Name = "Viewport"
			viewport.Size = UDim2.fromScale(1, 1)
			viewport.BackgroundTransparency = 1
			viewport.BorderSizePixel = 0
			viewport.ClipsDescendants = true
			viewport.ZIndex = -5
			viewport.Parent = folder
		end

		if not img then
			img = Instance.new("ImageLabel")
			img.Name = "EclipseThemeBackground"
			img.BackgroundTransparency = 1
			img.Size = UDim2.fromScale(1, 1)
			img.Position = UDim2.fromScale(0, 0)
			img.ZIndex = -5
			img.ScaleType = Enum.ScaleType.Crop
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 6)
			corner.Parent = img
			img.Parent = viewport
		end

		local layout = backgroundLayout(v.layout)
		img.AnchorPoint = Vector2.new(0.5, 0.5)
		img.Position = UDim2.fromScale(0.5 + layout.x, 0.5 + layout.y)
		img.Size = UDim2.fromScale(layout.scale, layout.scale)
		if not frames then
			img.Image = v.image
		end

		GifBackground.bind(img, frames)
		GifBackground.setTransparency(img, v.t or 0)
	elseif folder then
		if img then
			GifBackground.bind(img, nil)
		end

		folder:Destroy()
	end
end

function Theme.contrastText(color)
	local function linear(v)
		return v <= 0.04045 and v / 12.92 or ((v + 0.055) / 1.055) ^ 2.4
	end

	local luminance = 0.2126 * linear(color.R) + 0.7152 * linear(color.G) + 0.0722 * linear(color.B)
	return luminance > 0.179 and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
end

local function applyToInstance(inst, values, changedKeys)
	if inst:IsA("TextButton") and inst:GetAttribute("ThemeBg") then
		Theme.separateButtonText(inst)
	end

	if appliedRevision[inst] == nil then
		changedKeys = nil
	end

	appliedRevision[inst] = themeRevision
	for attrName in pairs(ATTR_PROPS) do
		local key = inst:GetAttribute(attrName)
		if key and (not changedKeys or changedKeys[key]) then
			applyAttrToInstance(inst, attrName, key, values)
		end
	end

	if inst:IsA("TextLabel") and inst.Parent and inst.Parent.Name == "TopSelector" then
		setProp(inst, "TextColor3", Theme.contrastText(inst.Parent.BackgroundColor3))
		setProp(inst, "TextTransparency", values.TopT and values.TopT.t or 0)
	end

	if inst:GetAttribute("ThemeBgImage") and (not changedKeys or changedKeys.Img) then
		applyBackgroundImage(inst, values)
	end

	if
		inst:GetAttribute("ThemeStateGrad")
		and (not changedKeys or changedKeys[inst:GetAttribute("ThemeStateGrad")])
	then
		local v = values[inst:GetAttribute("ThemeStateGrad")]
		manageGradientChild(inst, v)
	end
end

local function applyScriptColors(values)
	if not timelineState or not timelineState.Colors then
		return
	end

	local colors = timelineState.Colors
	if not scriptOriginals then
		scriptOriginals = { flat = {}, handleD = {}, handleH = {} }
		for _, field in pairs(ThemeConfig.scriptColorMap) do
			scriptOriginals.flat[field] = colors[field]
		end

		for _, hName in pairs(ThemeConfig.scriptHandleMap) do
			scriptOriginals.handleD[hName] = colors.KEYFRAME_HANDLE_DEFAULT[hName]
			scriptOriginals.handleH[hName] = colors.KEYFRAME_HANDLE_HOVER[hName]
		end
	end

	for key, field in pairs(ThemeConfig.scriptColorMap) do
		local v = values[key]
		if v then
			if #v.stops > 1 and (key == "Loop" or key == "Rec") then
				colors[field] = Color3.new(1, 1, 1)
			else
				colors[field] = v.stops[1]
			end
		else
			colors[field] = scriptOriginals.flat[field]
		end
	end

	for key, hName in pairs(ThemeConfig.scriptHandleMap) do
		local v = values[key]
		if v then
			colors.KEYFRAME_HANDLE_DEFAULT[hName] = v.stops[1]
			colors.KEYFRAME_HANDLE_HOVER[hName] = v.stops[1]:Lerp(Color3.new(0, 0, 0), 0.3)
		else
			colors.KEYFRAME_HANDLE_DEFAULT[hName] = scriptOriginals.handleD[hName]
			colors.KEYFRAME_HANDLE_HOVER[hName] = scriptOriginals.handleH[hName]
		end
	end
end

local function allRoots()
	local roots = {}
	if screenGui then
		table.insert(roots, screenGui)
	end

	for _, r in ipairs(extraRoots) do
		if r and r.Parent then
			table.insert(roots, r)
		end
	end

	return roots
end

function Theme.apply(changedKeys)
	effectiveCache = nil
	sequenceCache = setmetatable({}, { __mode = "k" })
	if not screenGui then
		return
	end

	themeRevision += 1
	local values = effectiveValues()
	for _, root in ipairs(allRoots()) do
		applyToInstance(root, values, changedKeys)
		for _, inst in ipairs(root:GetDescendants()) do
			applyToInstance(inst, values, changedKeys)
		end
	end

	applyScriptColors(values)
	local tl = getTimeline and getTimeline() or nil
	local keyframesChanged = not changedKeys
	for key in changedKeys or {} do
		local field = ThemeConfig.scriptColorMap[key]
		if ThemeConfig.scriptHandleMap[key] or field and field:find("KEYFRAME", 1, true) then
			keyframesChanged = true
			break
		end
	end

	if tl and keyframesChanged then
		pcall(function()
			if tl.RefreshAllKeyframeVisuals then
				tl:RefreshAllKeyframeVisuals()
			end

			if tl.RefreshAllChannelDiamondColors then
				tl:RefreshAllChannelDiamondColors()
			end
		end)
	end

	for _, cb in ipairs(changedCallbacks) do
		pcall(cb, changedKeys)
	end
end

local function persist()
	if not setSetting then
		return
	end

	local encoded = Theme.encode()
	local wanted = HttpService:JSONDecode(encoded)
	local ok, err = pcall(function()
		if updateSetting and persistedTheme then
			local before = persistedTheme
			updateSetting(ThemeConfig.settingKey, function(saved)
				local current = type(saved) == "string" and HttpService:JSONDecode(saved) or saved
				assert(
					current == nil or type(current) == "table" and current.V == ThemeConfig.version,
					"The saved theme cannot be safely updated"
				)
				if current == nil then
					return encoded
				end

				current = table.clone(current)
				local equal = require("ChannelEasing").equal
				local keys = {}
				for k in before do
					keys[k] = true
				end

				for k in wanted do
					keys[k] = true
				end

				for k in keys do
					if not equal(before[k], wanted[k]) then
						current[k] = wanted[k]
					end
				end

				return HttpService:JSONEncode(current)
			end)
		else
			setSetting(ThemeConfig.settingKey, encoded)
		end
	end)
	if not ok then
		require("Notification").show(
			"THEME NOT SAVED",
			tostring(err) .. " Your saved theme has been kept; retry your change.",
			8
		)
		return false
	end

	persistedTheme = wanted
	return true
end

function Theme.get(key, fallback)
	local values = effectiveValues()
	local v = values[key]
	if v and v.stops then
		return v.stops[1]
	end

	return fallback
end

function Theme.videoPalette()
	local values = effectiveValues()
	local result = {}
	for _, key in { "Bg", "Pnl", "TopBtn", "MenuSel", "Txt", "Strk", "Div" } do
		local value = values[key] or Theme.sampleDefaultValue(key)
		local colors = {}
		for _, color in value.stops do
			table.insert(colors, "#" .. color:ToHex())
		end

		result[key] = colors
	end

	return result
end

function Theme.getOverride(key)
	return overrides[key] or baseValues()[key]
end

function Theme.getPresetRevision()
	return presetRevision
end

function Theme.isGradient(key)
	local v = effectiveValues()[key]
	return v ~= nil and #v.stops > 1
end

local function writeKey(key, value)
	local expansions = ThemeConfig.simpleExpand[key]
	if expansions then
		for _, e in ipairs(expansions) do
			overrides[e.target] = value and shadeValue(value, e.mod, e.amt) or nil
		end
	else
		overrides[key] = value
	end
end

local function reportProgress(callback, done, total, state)
	if callback then
		pcall(callback, done, total, state)
	end
end

local function cancelLoad()
	requestRevision += 1
	local previous = activeProgress
	activeProgress = nil
	reportProgress(previous, 0, 1, "cancelled")
end

local function prepareImage(value, title, request, progress)
	if not value or not value.frames then
		return true
	end

	local frames = value.mode == "image"
			and { { image = value.image or value.frames[1].image, delay = 100 } }
		or GifBackground.effectiveFrames(value.frames)
	if not frames then
		return false
	end

	if not GifBackground.needsLoad(frames) then
		reportProgress(progress, 1, 1, "complete")
		return true
	end

	activeProgress = progress
	reportProgress(progress, 0, #frames, "loading")

	local function cancelled()
		return request ~= requestRevision
	end

	local completed, ok, reason, id, details = pcall(GifBackground.preload, frames, function(
		done,
		total
	)
		if not cancelled() then
			reportProgress(progress, done, total, "loading")
		end
	end, cancelled)
	if cancelled() then
		return false
	end

	activeProgress = nil
	if completed and reason == "cancelled" then
		reportProgress(progress, 0, 1, "cancelled")
		return false
	end

	local partial = completed
		and not ok
		and reason ~= "cancelled"
		and details
		and details.loaded > 0
	reportProgress(
		progress,
		ok and completed and 1 or partial and details.loaded or 0,
		partial and details.total or 1,
		ok and completed and "complete" or partial and "partial" or "failed"
	)
	if not completed or not ok then
		if reason == "cancelled" then
			return false
		end

		local message = "GIF image loading failed. Your saved preset has been kept."
		if partial then
			return true
		elseif completed then
			local described, text = pcall(GifBackground.loadMessage, reason, id)
			if described then
				message = text
			end
		end

		require("Notification").show(title or "GIF BACKGROUND", message, 8)
	end

	return completed and (ok or partial) or false
end

function Theme.cancelLoad()
	cancelLoad()
end

function Theme.set(key, value, transient)
	cancelLoad()
	if key == "Img" and not prepareImage(value, "GIF background", requestRevision) then
		return false
	end

	writeKey(key, value)
	local affected = {}
	local expansions = ThemeConfig.simpleExpand[key]
	if expansions then
		for _, entry in expansions do
			affected[entry.target] = true
		end
	else
		affected[key] = true
	end

	if affected.Strk then
		affected.Div = true
	end

	Theme.apply(affected)
	if not transient then
		persist()
	end
end

function Theme.setBackgroundTransparency(value)
	assert(type(value) == "number" and value == value, "Invalid background transparency")
	local previous = Theme.getOverride("Img")
	if not previous then
		return false
	end

	local image = table.clone(previous)
	image.t = math.clamp(value, 0, 1)
	writeKey("Img", image)
	Theme.apply({ Img = true })
	persist()
	return true
end

function Theme.getBackgroundLayout()
	local image = Theme.getOverride("Img")
	return backgroundLayout(image and image.layout)
end

function Theme.setBackgroundLayout(value)
	local previous = Theme.getOverride("Img")
	local image = previous and table.clone(previous)
		or { image = "", t = 0.85, stops = { Color3.new(1, 1, 1) } }
	image.layout = backgroundLayout(value)
	writeKey("Img", image)
	Theme.apply({ Img = true })
	persist()
	return true
end

function Theme.setBackgroundMode(nextMode)
	if nextMode ~= "image" and nextMode ~= "gif" then
		return false
	end

	local previous = Theme.getOverride("Img")
	if nextMode == "gif" and not (previous and previous.frames) then
		return false
	end

	local value = previous and table.clone(previous)
		or { image = "", t = 0.85, stops = { Color3.new(1, 1, 1) } }
	value.mode = nextMode
	if nextMode == "image" and value.frames and not value.image then
		value.image = value.frames[1].image
	end

	Theme.set("Img", value)
	return true
end

function Theme.clear(key)
	cancelLoad()
	writeKey(key, nil)
	Theme.apply()
	persist()
end

function Theme.getMode()
	return mode
end

function Theme.setMode(m)
	if m ~= "S" and m ~= "A" then
		return
	end

	if mode == m then
		return persist()
	end

	mode = m
	Theme.apply()
	return persist()
end

function Theme.resetAll()
	oldEclipse = false
	cancelLoad()
	presetRevision += 1
	overrides = {}
	Theme.apply()
	persist()
end

function Theme.encode()
	local out = { V = ThemeConfig.version, M = mode, OldEclipse = oldEclipse or nil }
	for key, v in pairs(effectiveValues()) do
		if key == "Img" then
			if v.layout then
				out.ImgLayout = backgroundLayout(v.layout)
			end

			if v.frames then
				out.Gif = GifSequence.encode(v.frames)
				if ThemeConfig.isKoiFrames(v.frames) then
					out.KoiPalette = 2
					out.KoiFrames = 3
				end
			end

			if v.frames then
				out.ImgMode = v.mode == "image" and "image" or "gif"
			end

			if v.image and v.image ~= "" then
				out.Img = v.image:gsub("rbxassetid://", "")
			end

			if v.t then
				out.Imgt = v.t
			end
		else
			local s = Theme.formatValue(v)
			if s then
				out[key] = s
				if v.t then
					out[key .. "t"] = v.t
				end
			end
		end
	end

	return HttpService:JSONEncode(out)
end

local function knownKeys()
	local known = {}
	for _, s in ipairs(ThemeConfig.settings) do
		known[s.key] = true
	end

	for _, s in ipairs(ThemeConfig.simpleSettings) do
		known[s.key] = true
	end

	return known
end

function Theme.load(json, title, progress, transient)
	local data = json
	if typeof(json) == "string" then
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(json)
		end)
		if not ok then
			return false
		end

		data = decoded
	end

	if typeof(data) ~= "table" then
		return false
	end

	local known = knownKeys()
	data = ThemeConfig.migratePreset(data)
	local newOverrides = {}
	for key, raw in pairs(data) do
		if known[key] and key ~= "Img" and typeof(raw) == "string" then
			local v = Theme.parseValue(raw)
			if v then
				local t = tonumber(data[key .. "t"])
				if t then
					v.t = math.clamp(t, 0, 1)
				end

				local expansions = ThemeConfig.simpleExpand[key]
				if expansions then
					for _, e in ipairs(expansions) do
						newOverrides[e.target] = shadeValue(v, e.mod, e.amt)
					end
				else
					newOverrides[key] = v
				end
			end
		end
	end

	if data.Gif ~= nil then
		local frames = GifSequence.normalize(data.Gif)
		if not frames then
			return false
		end

		newOverrides.Img = {
			frames = frames,
			t = math.clamp(tonumber(data.Imgt) or 0.85, 0, 1),
			stops = { Color3.new(1, 1, 1) },
		}
		if
			not data.KoiPalette
			and ThemeConfig.isKoiFrames(frames)
			and data.Loop == "#91c6b4>#407e77@90"
		then
			newOverrides.Loop = Theme.parseValue("#dba0b0>#407e77@90")
		end
	end

	local imgRaw = data.Img
	if typeof(imgRaw) == "number" then
		imgRaw = string.format("%.0f", imgRaw)
	end

	if typeof(imgRaw) == "string" and imgRaw ~= "" then
		if tonumber(imgRaw) then
			imgRaw = "rbxassetid://" .. imgRaw
		end

		local t = tonumber(data.Imgt)
		newOverrides.Img = newOverrides.Img
			or { t = t and math.clamp(t, 0, 1) or 0.85, stops = { Color3.new(1, 1, 1) } }
		newOverrides.Img.image = imgRaw
	end

	if not newOverrides.Img and tonumber(data.Imgt) then
		newOverrides.Img = {
			image = "",
			t = math.clamp(tonumber(data.Imgt), 0, 1),
			stops = { Color3.new(1, 1, 1) },
		}
	end

	if data.ImgLayout ~= nil then
		newOverrides.Img = newOverrides.Img
			or { image = "", t = 0.85, stops = {
				Color3.new(1, 1, 1),
			} }
		newOverrides.Img.layout = backgroundLayout(data.ImgLayout)
	end

	if newOverrides.Img and newOverrides.Img.frames then
		newOverrides.Img.mode = data.ImgMode == "image" and "image" or "gif"
		newOverrides.Img.image = newOverrides.Img.image or newOverrides.Img.frames[1].image
	end

	cancelLoad()
	if not prepareImage(newOverrides.Img, title, requestRevision, progress) then
		return false
	end

	presetRevision += 1
	oldEclipse = data.OldEclipse == true
	overrides = newOverrides
	if data.M == "S" or data.M == "A" then
		mode = data.M
	end

	Theme.apply()
	if not transient then
		persist()
	end

	return true
end

function Theme.resolveInstanceValue(inst, attrName)
	local key = inst:GetAttribute(attrName)
	if not key then
		return nil
	end

	local v = effectiveValues()[key]
	if v then
		local shadeAmt = inst:GetAttribute("ThemeShade")
		if typeof(shadeAmt) == "number" and shadeAmt ~= 0 then
			v = shadeValue(v, shadeAmt > 0 and "lighten" or "darken", math.abs(shadeAmt))
		end

		if attrName == "ThemeGrad" then
			return toSequence(v)
		end

		return v.stops[1]
	end

	local props = ATTR_PROPS[attrName]
	if props then
		local orig = getOriginal(inst, props[1])
		if orig ~= nil then
			return orig
		end
	end

	return nil
end

function Theme.sampleDefaultValue(key)
	local value = baseValues()[key]
	if value then
		return { stops = table.clone(value.stops), rot = value.rot, t = value.t }
	end

	if key == "Strk" or key == "Div" then
		return { stops = { Theme.panelOutlineDefault() } }
	end

	local expansions = ThemeConfig.simpleExpand[key]
	if expansions then
		return Theme.sampleDefaultValue(expansions[1].target)
	end

	if screenGui then
		local fallbackInst = nil
		for _, inst in ipairs(screenGui:GetDescendants()) do
			if inst:GetAttribute("ThemeGrad") == key then
				local orig = getOriginal(inst, "Color")
				local ok, live = pcall(function()
					return inst.Color
				end)
				local seq = (typeof(orig) == "ColorSequence" and orig) or (ok and live) or nil
				if typeof(seq) == "ColorSequence" then
					local kps = seq.Keypoints
					local rotOrig = getOriginal(inst, "Rotation")
					local okR, liveR = pcall(function()
						return inst.Rotation
					end)
					local rot = (typeof(rotOrig) == "number" and rotOrig) or (okR and liveR) or 90
					if #kps > 1 then
						return { stops = { kps[1].Value, kps[#kps].Value }, rot = rot }
					end

					return { stops = { kps[1].Value } }
				end
			elseif not fallbackInst then
				for attrName, props in pairs(ATTR_PROPS) do
					if attrName ~= "ThemeGrad" and inst:GetAttribute(attrName) == key then
						fallbackInst = { inst = inst, prop = props[1] }
						break
					end
				end
			end
		end

		if fallbackInst then
			local orig = getOriginal(fallbackInst.inst, fallbackInst.prop)
			local ok, live = pcall(function()
				return fallbackInst.inst[fallbackInst.prop]
			end)
			local v = (typeof(orig) == "Color3" and orig)
				or (ok and typeof(live) == "Color3" and live)
				or nil
			if v then
				return { stops = { v } }
			end
		end
	end

	return { stops = { Theme.sampleDefault(key) } }
end

function Theme.onChanged(cb)
	table.insert(changedCallbacks, cb)
	local connected = true
	return function()
		if not connected then
			return
		end

		connected = false
		local index = table.find(changedCallbacks, cb)
		if index then
			table.remove(changedCallbacks, index)
		end
	end
end

function Theme.applyTree(root)
	require("Motion").watchFloatingGui(root)
	local values = effectiveValues()
	applyToInstance(root, values)
	for _, inst in root:GetDescendants() do
		applyToInstance(inst, values)
	end
end

function Theme.applyInstance(inst)
	applyToInstance(inst, effectiveValues())
end

local function added(inst)
	if not (inst:IsA("GuiBase") or inst:IsA("UIBase") or inst:IsA("GuiBase3d")) then
		return
	end

	if appliedRevision[inst] == themeRevision then
		return
	end

	pendingTheme[inst] = true
	if themeQueued then
		return
	end

	themeQueued = true
	task.defer(function()
		themeQueued = false
		local batch = pendingTheme
		pendingTheme = setmetatable({}, { __mode = "k" })
		local values = effectiveValues()
		for object in batch do
			if object.Parent and appliedRevision[object] ~= themeRevision then
				applyToInstance(object, values)
			end
		end
	end)
end

function Theme.addRoot(gui)
	require("Motion").watchFloatingGui(gui)
	if not gui then
		return
	end

	for _, r in ipairs(extraRoots) do
		if r == gui then
			return
		end
	end

	table.insert(extraRoots, gui)
	local connection = gui.DescendantAdded:Connect(added)
	gui.Destroying:Once(function()
		connection:Disconnect()
		local index = table.find(extraRoots, gui)
		if index then
			table.remove(extraRoots, index)
		end
	end)
	if initialized then
		local values = effectiveValues()
		applyToInstance(gui, values)
		for _, inst in ipairs(gui:GetDescendants()) do
			applyToInstance(inst, values)
		end
	end
end

function Theme.sampleDefault(key)
	if baseValues()[key] then
		return baseValues()[key].stops[1]
	end

	if key == "Strk" or key == "Div" then
		return Theme.panelOutlineDefault()
	end

	if not screenGui then
		return Color3.fromRGB(128, 128, 128)
	end

	for _, inst in ipairs(screenGui:GetDescendants()) do
		for attrName, props in pairs(ATTR_PROPS) do
			if inst:GetAttribute(attrName) == key then
				local orig = getOriginal(inst, props[1])
				local ok, live = pcall(function()
					return inst[props[1]]
				end)
				local v = orig or (ok and live) or nil
				if typeof(v) == "Color3" then
					return v
				end

				if typeof(v) == "ColorSequence" then
					return v.Keypoints[1].Value
				end
			end
		end
	end

	if timelineState and timelineState.Colors then
		local src = scriptOriginals
		local field = ThemeConfig.scriptColorMap[key]
		if field then
			return (src and src.flat[field])
				or timelineState.Colors[field]
				or Color3.fromRGB(128, 128, 128)
		end

		local hName = ThemeConfig.scriptHandleMap[key]
		if hName then
			return (src and src.handleD[hName])
				or timelineState.Colors.KEYFRAME_HANDLE_DEFAULT[hName]
				or Color3.fromRGB(128, 128, 128)
		end
	end

	local sd = ThemeConfig.scriptDefaults and ThemeConfig.scriptDefaults[key]
	if sd then
		local v = Theme.parseValue(sd)
		if v then
			return v.stops[1]
		end
	end

	return Color3.fromRGB(128, 128, 128)
end

function Theme.init(refs)
	local Preferences = require("Preferences")
	GifBackground.setPlaybackMode(Preferences.get("GifPlayback"))
	if initialized then
		return
	end

	screenGui = refs.ScreenGui
	getSetting = refs.GetSetting
	setSetting = refs.SetSetting
	updateSetting = refs.UpdateSetting
	timelineState = refs.TimelineState
	getTimeline = refs.GetTimeline
	if not screenGui then
		return
	end

	initialized = true

	screenGui.DescendantAdded:Connect(added)

	local saved = getSetting and getSetting(ThemeConfig.settingKey)
	local pending
	local pendingRevision = presetRevision
	if typeof(saved) == "string" and saved ~= "" then
		local ok, data = pcall(function()
			return HttpService:JSONDecode(saved)
		end)
		if ok and type(data) == "table" and data.Gif then
			pending = saved
			local palette = table.clone(data)
			palette.Gif = nil
			palette.Img = nil
			palette.Imgt = nil
			palette.ImgMode = nil
			Theme.load(palette, nil, nil, true)
			pendingRevision = presetRevision
		else
			Theme.load(saved, nil, nil, true)
		end
	else
		Theme.apply()
	end

	persistedTheme = HttpService:JSONDecode(Theme.encode())

	local function opened()
		if not screenGui.Enabled then
			cancelLoad()
			return
		end

		if
			getSetting
			and persistedTheme
			and require("ChannelEasing").equal(
				HttpService:JSONDecode(Theme.encode()),
				persistedTheme
			)
		then
			local read, latest = pcall(getSetting, ThemeConfig.settingKey)
			if read and type(latest) == "string" and latest ~= "" and latest ~= saved then
				local decoded, data = pcall(HttpService.JSONDecode, HttpService, latest)
				if decoded and type(data) == "table" and data.V == ThemeConfig.version then
					if Theme.load(latest, "saved theme", nil, true) then
						saved = latest
						pending = nil
						persistedTheme = HttpService:JSONDecode(Theme.encode())
						return
					end
				end
			end
		end

		if pending and pendingRevision == presetRevision then
			local deferred = HttpService:JSONDecode(pending)
			local current = HttpService:JSONDecode(Theme.encode())
			for k, v in current do
				if k ~= "Gif" and k ~= "Img" and k ~= "Imgt" and k ~= "ImgMode" then
					deferred[k] = v
				end
			end

			if Theme.load(deferred, "saved GIF preset", nil, true) then
				pending = nil
				persistedTheme = HttpService:JSONDecode(Theme.encode())
			end
		else
			pending = nil
			local image = overrides.Img
			if image and image.frames then
				Theme.load(Theme.encode(), "GIF background", nil, true)
			end
		end
	end

	local opening = screenGui:GetPropertyChangedSignal("Enabled"):Connect(opened)
	local preference = Preferences.subscribe(function(key)
		if key == "GifPlayback" then
			GifBackground.setPlaybackMode(Preferences.get("GifPlayback"))
			cancelLoad()
			if pending and pendingRevision == presetRevision then
				task.defer(opened)
				return
			end

			local image = overrides.Img
			if image and image.frames then
				Theme.load(Theme.encode(), "GIF background", nil, true)
			end
		end
	end)
	screenGui.Destroying:Once(function()
		cancelLoad()
		opening:Disconnect()
		preference()
		GifBackground.destroy()
	end)
	task.defer(opened)
end

return Theme
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a4cb</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2178">
          <Properties>
            <string name="Name">SelectionMenu</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000029025</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{8EC9DA95-5F92-4E15-B6BE-8C03034360D4}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local Outline = require("Outline")
local Model = require("KeyGroups")
local Raw = require("RawState")
local State = require("State")
local History = require("History")
local Menu = require("KeyframeMenu")
local Input = require("UserInputService")
local BlenderEdit = require("BlenderEdit")
local Http = game:GetService("HttpService")
local POSE = Model.POSE
local raw = Raw.Timeline

local function snapshot(motors)
	local result = {}
	for motor in motors do
		local track = {}
		result[motor] = track
		for frame, key in raw.Keyframes[motor] or {} do
			track[frame] = Model.clone(key.KeyGroups) or false
		end
	end

	return result
end

local function restore(self, data)
	for motor, track in data do
		for frame, key in raw.Keyframes[motor] or {} do
			key.KeyGroups = Model.clone(track[frame])
		end
	end

	State.currentProjectSaved = false
	self:RefreshAllKeyframeVisuals()
end

local function selectedTracks()
	local tracks = {}

	local function add(key, lane)
		local motor = key.Motor

		if not motor or not raw.Keyframes[motor] or raw.Keyframes[motor][key.Frame] ~= key then
			return
		end

		tracks[motor] = tracks[motor] or {}
		tracks[motor][lane] = tracks[motor][lane] or {}
		tracks[motor][lane][key] = true
	end

	for key in raw.SelectedKeyframes do
		add(key, POSE)
	end

	for key, lanes in raw.SelectedChannelKeyframes do
		if not raw.SelectedKeyframes[key] then
			for lane in lanes do
				add(key, lane)
			end
		end
	end

	return tracks
end

local function busy(self)
	return BlenderEdit.blocked()
		or Raw.KeyframeDrag.draggingKeyframe ~= nil
		or (self.IsBlenderKeyframeTransformActive and self:IsBlenderKeyframeTransformActive())
end

return function(Timeline)
	local clearTimeline = Timeline.ClearTimelineData

	function Timeline:ClearTimelineData(...)
		local result = clearTimeline(self, ...)
		self._viewportRefreshQueued = nil
		self._keyGroupsRefreshQueued = nil
		if self._viewportLayoutConnection then
			self._viewportLayoutConnection:Disconnect()
		end

		self._viewportLayoutConnection = nil
		self._viewportLayoutPane = nil
		self._keyViewport = nil
		self._keyViewportIndex = nil
		self._viewportBulk = nil
		self:RestoreGroupedButtons()
		for _, groups in self._keyGroupBars or {} do
			for _, entry in groups do
				entry.bar:Destroy()
			end
		end

		self._keyGroupBars = nil
		self._groupsByKey = nil
		self._groupedMotors = nil
		self._expandedKeyGroups = nil
		self._compactKeyDrag = nil
		self._selectionHitTargets = nil
		return result
	end

	function Timeline:InvalidateKeyframeViewportLayout()
		self._keyViewportLayoutRevision = (self._keyViewportLayoutRevision or 0) + 1
		self:QueueKeyframeViewportRefresh()
	end

	function Timeline:PrepareKeyframeViewport(force)
		if not force and (self._refreshingKeyGroups or self._viewportBulk) then
			return
		end

		local pane = self.refs and self.refs.KeysRoot
		if not pane then
			self._keyViewport = nil
			return
		end

		if pane.AbsoluteSize.X <= 0 or pane.AbsoluteSize.Y <= 0 then
			self._keyViewport = { visible = {}, groups = {}, containers = {}, pending = true }
			if self._viewportLayoutConnection and self._viewportLayoutPane ~= pane then
				self._viewportLayoutConnection:Disconnect()
				self._viewportLayoutConnection = nil
			end

			if not self._viewportLayoutConnection then
				self._viewportLayoutPane = pane
				self._viewportLayoutConnection = pane:GetPropertyChangedSignal("AbsoluteSize")
					:Connect(function()
						if pane.AbsoluteSize.X > 0 and pane.AbsoluteSize.Y > 0 then
							self._viewportLayoutConnection:Disconnect()
							self._viewportLayoutConnection = nil
							self:QueueKeyframeViewportRefresh()
						end
					end)
			end

			return
		end

		if busy(self) and self._keyViewport then
			return
		end

		local revision = require("cache").revision()
		local width, maximum = self:GetVisibleTimelineWidth(), self:GetMaxFrame()
		local scale = require("Motion").scale(pane)
		local left, right =
			raw.ScrollOffset - 128, raw.ScrollOffset + self:GetTimelineViewportWidth() + 128
		local top, bottom =
			pane.AbsolutePosition.Y - 96 * scale,
			pane.AbsolutePosition.Y + pane.AbsoluteSize.Y + 96 * scale
		local old = self._keyViewport
		local layoutRevision = self._keyViewportLayoutRevision or 0
		if
			not force
			and old
			and not old.pending
			and old.revision == revision
			and old.keys == raw.Keyframes
			and old.layoutRevision == layoutRevision
			and old.channels == raw.ChannelTracks
			and old.rows == raw.TrackRows
			and old.width == width
			and old.maximum == maximum
			and old.scale == scale
			and old.paneSize == pane.AbsoluteSize
			and old.panePosition == pane.AbsolutePosition
			and math.abs(old.canvas.Y - pane.CanvasPosition.Y) < 48 * scale
			and math.abs(old.left - left) < 64
		then
			return
		end

		local index = self._keyViewportIndex
		if force or not index or index.keys ~= raw.Keyframes or index.revision ~= revision then
			index = { keys = raw.Keyframes, revision = revision, tracks = {} }
			self._keyViewportIndex = index
			for motor, bucket in raw.Keyframes do
				local track = { ordered = {}, authored = {} }
				index.tracks[motor] = track
				for _, key in bucket do
					table.insert(track.ordered, key)
					if key.KeyGroups then
						track.authored[key] = true
					end
				end

				table.sort(track.ordered, function(a, b)
					return a.Frame < b.Frame
				end)
			end
		end

		if
			not force
			and old
			and old.revision == revision
			and old.keys == raw.Keyframes
			and old.width == width
			and old.maximum == maximum
			and old.left == left
			and old.right == right
			and old.top == top
			and old.bottom == bottom
			and old.canvas == pane.CanvasPosition
			and old.rows == raw.TrackRows
			and old.layoutRevision == layoutRevision
			and old.channels == raw.ChannelTracks
		then
			return
		end

		local view = {
			layoutRevision = layoutRevision,
			channels = raw.ChannelTracks,
			revision = revision,
			keys = raw.Keyframes,
			width = width,
			maximum = maximum,
			left = left,
			right = right,
			top = top,
			bottom = bottom,
			canvas = pane.CanvasPosition,
			rows = raw.TrackRows,
			visible = {},
			groups = {},
			containers = {},
			jobs = {},
			scale = scale,
			paneSize = pane.AbsoluteSize,
			panePosition = pane.AbsolutePosition,
		}
		self._keyViewport = view

		local function visibleRow(row)
			if not row or not row.Parent then
				return false
			end

			local node = row
			while node and node ~= pane do
				if node:IsA("GuiObject") and not node.Visible then
					return false
				end

				node = node.Parent
			end

			if node ~= pane then
				return false
			end

			local y = row.AbsolutePosition.Y
			return y + row.AbsoluteSize.Y >= top and y <= bottom
		end

		for motor, bucket in raw.Keyframes do
			local lanes = { [POSE] = raw.TrackRows[motor.Part1] }
			for lane, row in raw.ChannelTracks[motor] or {} do
				lanes[lane] = row
			end

			for lane, row in lanes do
				if not visibleRow(row) then
					continue
				end

				local container = self:GetTrackKeyframesContainer(row)
				if not container then
					continue
				end

				view.containers[container] = true
				local bins = {}
				local ordered = index.tracks[motor].ordered
				local firstFrame = math.floor(left / 64) * 64 / width * maximum
				local lastFrame = math.ceil(right / 64) * 64 / width * maximum
				local lo, hi = 1, #ordered + 1
				while lo < hi do
					local mid = math.floor((lo + hi) / 2)
					if ordered[mid].Frame < firstFrame then
						lo = mid + 1
					else
						hi = mid
					end
				end

				for i = lo, #ordered do
					local key = ordered[i]
					local frame = key.Frame
					if frame >= lastFrame then
						break
					end

					local x = maximum > 0 and frame / maximum * width or 0
					if x < math.floor(left / 64) * 64 or x >= math.ceil(right / 64) * 64 then
						continue
					end

					if
						not Model.hasLane(key, lane)
						or lane == POSE
							and not require("GraphCurves").hasVisibleKey(bucket, key)
					then
						continue
					end

					view.visible[key] = view.visible[key] or {}
					view.visible[key][lane] = true
					view.jobs[motor] = view.jobs[motor] or {}
					view.jobs[motor][key] = true

					if
						Model.get(key, lane)
						and not (
							self._expandedKeyGroups
							and self._expandedKeyGroups[Model.get(key, lane)]
						)
					then
						continue
					end

					local bin = math.floor(x / 64)
					bins[bin] = bins[bin] or {}
					table.insert(bins[bin], key)
				end

				for key in index.tracks[motor].authored do
					view.jobs[motor] = view.jobs[motor] or {}
					view.jobs[motor][key] = true
				end

				for bin, members in bins do
					if #members <= 10 then
						continue
					end

					for _, key in members do
						view.groups[key] = view.groups[key] or {}
						view.groups[key][lane] = "@dense:" .. lane .. ":" .. bin
					end
				end
			end
		end
	end

	function Timeline:KeyframeInViewport(key, lane)
		local view = self._keyViewport
		return not view or view.visible[key] and view.visible[key][lane] == true
	end

	function Timeline:DisplayKeyGroup(key, lane)
		local view = self._keyViewport
		return view and view.groups[key] and view.groups[key][lane] or Model.get(key, lane)
	end

	function Timeline:ZoomDenseKeyGroup(entry)
		local zoom = self.timelineZoom
		if not zoom then
			return
		end

		local first, last = entry.members[1].frame, entry.members[#entry.members].frame
		local span = math.max(1, last - first)
		local desired = self:GetTimelineViewportWidth()
			* 0.75
			* self:GetMaxFrame()
			/ span
			/ self:GetBaseTimelineWidth()
		zoom.zoomScale = math.clamp(
			math.max(zoom:GetZoom() * 2, desired),
			zoom.minimum and zoom.minimum() or 1,
			zoom.maxZoom
		)
		zoom:Apply()
		self:SetTimelineScroll(
			self:FrameToVisibleX((first + last) / 2) - self:GetTimelineViewportWidth() / 2
		)
		self:RefreshKeyframeGroups()
	end

	function Timeline:QueueKeyframeViewportRefresh()
		if raw._ImportingKeyframes or self._viewportRefreshQueued or self._refreshingKeyGroups then
			return
		end

		local ticket = {}
		self._viewportRefreshQueued = ticket
		task.defer(function()
			if self._viewportRefreshQueued ~= ticket then
				return
			end

			self._viewportRefreshQueued = nil
			if self.refs and self.refs.KeysRoot and self.refs.KeysRoot.Parent then
				self:RefreshKeyframeGroups(nil, true)
			end
		end)
	end

	function Timeline:IsKeyGroupCollapsed(key, lane)
		local id = self:DisplayKeyGroup(key, lane)
		if id and id:sub(1, 7) == "@dense:" then
			return true
		end

		return id ~= nil and not (self._expandedKeyGroups and self._expandedKeyGroups[id])
	end

	function Timeline:GroupSelectedKeyframes()
		if busy(self) then
			return 0
		end

		local tracks, plans, motors = selectedTracks(), {}, {}
		for motor, lanes in tracks do
			for lane, selected in lanes do
				local members = Model.range(raw.Keyframes[motor], selected, lane)
				if #members > 1 then
					table.insert(plans, { lane = lane, members = members })
					motors[motor] = true
				end
			end
		end

		if #plans == 0 then
			return 0
		end

		local before = snapshot(motors)
		for _, plan in plans do
			local id = Http:GenerateGUID(false)
			for _, member in plan.members do
				Model.set(member.key, plan.lane, id)
			end
		end

		local after = snapshot(motors)
		State.currentProjectSaved = false
		self:RefreshAllKeyframeVisuals()
		History.record(function()
			restore(self, before)
		end, function()
			restore(self, after)
		end, "Group keyframes")
		return #plans
	end

	function Timeline:UngroupSelectedKeyframes(all)
		if busy(self) then
			return 0
		end

		local tracks, wanted, motors = selectedTracks(), {}, {}
		for motor, bucket in raw.Keyframes do
			local lanes = tracks[motor] or {}
			for _, key in bucket do
				for lane, id in key.KeyGroups or {} do
					if all or (lanes[lane] and lanes[lane][key]) then
						wanted[motor] = wanted[motor] or {}
						wanted[motor][lane] = wanted[motor][lane] or {}
						wanted[motor][lane][id] = true
						motors[motor] = true
					end
				end
			end
		end

		if not next(motors) then
			return 0
		end

		local before, count = snapshot(motors), 0
		for motor, lanes in wanted do
			for _, ids in lanes do
				for _ in ids do
					count += 1
				end
			end

			for _, key in raw.Keyframes[motor] do
				for lane, ids in lanes do
					if ids[Model.get(key, lane)] then
						Model.set(key, lane, nil)
					end
				end
			end
		end

		local after = snapshot(motors)
		State.currentProjectSaved = false
		self:RefreshAllKeyframeVisuals()
		History.record(function()
			restore(self, before)
		end, function()
			restore(self, after)
		end, all and "Ungroup all keyframes" or "Ungroup keyframes")
		return count
	end

	function Timeline:ExpandSelectedKeyframeGroups()
		if busy(self) then
			return
		end

		self._expandedKeyGroups = self._expandedKeyGroups or {}
		for _, lanes in selectedTracks() do
			for lane, selected in lanes do
				for key in selected do
					local id = Model.get(key, lane)
					if id then
						self._expandedKeyGroups[id] = true
					end
				end
			end
		end

		self:RefreshAllKeyframeVisuals()
	end

	function Timeline:RegroupKeyframes()
		self._expandedKeyGroups = {}
		self:RefreshAllKeyframeVisuals()
	end

	function Timeline:AdoptKeyIntoGroups(motor, key)
		local bucket = raw.Keyframes[motor]
		if not bucket or not key then
			return
		end

		local lanes = {}
		for _, candidate in bucket do
			for lane in candidate.KeyGroups or {} do
				lanes[lane] = true
			end
		end

		for lane in lanes do
			if Model.get(key, lane) or not Model.hasLane(key, lane) then
				continue
			end

			for id, members in Model.collect(bucket, lane) do
				if key.Frame > members[1].frame and key.Frame < members[#members].frame then
					Model.set(key, lane, id)
					break
				end
			end
		end
	end

	function Timeline:ConstrainGroupedDrag(delta, entries)
		local first, last, grouped = math.huge, -math.huge, false
		for _, entry in entries do
			local key, lane = entry.keyData, entry.channelId or POSE
			local id = Model.get(key, lane)
			grouped = grouped
				or (id ~= nil and not (self._expandedKeyGroups and self._expandedKeyGroups[id]))
			first, last = math.min(first, entry.originalFrame), math.max(last, entry.originalFrame)
		end

		if #entries == 0 then
			return delta
		end

		if not grouped and #entries == 1 then
			return delta
		end

		delta = math.clamp(delta, -first, self:GetMaxFrame() - last)
		return delta
	end

	function Timeline:ExpandGroupedSelection()
		for motor, lanes in selectedTracks() do
			for lane, selected in lanes do
				for id, members in Model.collect(raw.Keyframes[motor], lane) do
					if self._expandedKeyGroups and self._expandedKeyGroups[id] then
						continue
					end

					local hit = false
					for _, member in members do
						if selected[member.key] then
							hit = true
							break
						end
					end

					if not hit then
						continue
					end

					for _, member in members do
						if lane == POSE then
							raw.SelectedKeyframes[member.key] = true
						else
							raw.SelectedChannelKeyframes[member.key] = raw.SelectedChannelKeyframes[member.key]
								or {}
							raw.SelectedChannelKeyframes[member.key][lane] = true
						end
					end
				end
			end
		end
	end

	local function selectGroup(self, entry, additive)
		local first = entry.members[1].key
		local alreadySelected = entry.lane == POSE and raw.SelectedKeyframes[first]
			or entry.lane ~= POSE
				and raw.SelectedChannelKeyframes[first]
				and raw.SelectedChannelKeyframes[first][entry.lane]
		if not additive and not alreadySelected then
			table.clear(raw.SelectedKeyframes)
			table.clear(raw.SelectedChannelKeyframes)
		end

		for _, member in entry.members do
			if entry.lane == POSE then
				raw.SelectedKeyframes[member.key] = true
			else
				raw.SelectedChannelKeyframes[member.key] = raw.SelectedChannelKeyframes[member.key]
					or {}
				raw.SelectedChannelKeyframes[member.key][entry.lane] = true
			end
		end

		raw.SelectedKeyframe = entry.members[1].key
		self:RefreshKeyframeSelectionVisuals()
		self:UpdateDeleteButtonState()
		if self.refs and self.refs.RefreshSelectionFilter then
			self.refs.RefreshSelectionFilter()
		end
	end

	local function createBar(self, container)
		local bar = Instance.new("TextButton")
		bar.Name, bar.Text = "KeyframeGroup", ""
		bar.BackgroundTransparency, bar.BorderSizePixel = 1, 0
		bar.AutoButtonColor, bar.AnchorPoint = false, Vector2.new(0, 0.5)
		bar.Active, bar.Selectable = true, true
		local entry = { bar = bar }
		bar.MouseButton1Down:Connect(function()
			if busy(self) then
				return
			end

			local now = os.clock()
			local modified = self:IsSelectionModifierDown()
			local key = entry.members[1].key
			if modified then
				entry.clicked = nil
				local selected = entry.lane == POSE and raw.SelectedKeyframes[key]
					or entry.lane ~= POSE
						and raw.SelectedChannelKeyframes[key]
						and raw.SelectedChannelKeyframes[key][entry.lane]
				if selected then
					if entry.automatic then
						for _, member in entry.members do
							if entry.lane == POSE then
								raw.SelectedKeyframes[member.key] = nil
							elseif raw.SelectedChannelKeyframes[member.key] then
								raw.SelectedChannelKeyframes[member.key][entry.lane] = nil
								if not next(raw.SelectedChannelKeyframes[member.key]) then
									raw.SelectedChannelKeyframes[member.key] = nil
								end
							end
						end

						self:RefreshKeyframeSelectionVisuals()
						self:UpdateDeleteButtonState()
						return
					end

					if entry.lane == POSE then
						self:ToggleSelectedKeyframe(key)
					else
						self:ToggleSelectedChannelKeyframe(key, entry.lane)
					end

					return
				end
			end

			selectGroup(self, entry, modified)
			if not modified and entry.clicked and now - entry.clicked < 0.3 then
				entry.clicked = nil
				if entry.automatic then
					self:ZoomDenseKeyGroup(entry)
				else
					self:ExpandSelectedKeyframeGroups()
				end

				return
			end

			entry.clicked = now
			if entry.lane == POSE then
				self:_initiateKeyframeDrag(entry.members[1].key, true)
			else
				self:_initiateChannelKeyframeDrag(entry.members[1].key, entry.lane, true)
			end
		end)
		bar.MouseButton2Click:Connect(function()
			if busy(self) then
				return
			end

			local key = entry.members[1].key
			local selected = entry.lane == POSE and raw.SelectedKeyframes[key]
				or entry.lane ~= POSE
					and raw.SelectedChannelKeyframes[key]
					and raw.SelectedChannelKeyframes[key][entry.lane]
			if not selected then
				selectGroup(self, entry, false)
			end

			Menu.open(Input:GetMouseLocation())
		end)
		bar.Parent = container
		return entry
	end

	function Timeline:RestoreGroupedButtons()
		for button, visible in self._groupHiddenButtons or {} do
			if button.Parent then
				button.Visible = visible
			end
		end

		self._groupHiddenButtons = {}
	end

	function Timeline:RefreshKeyframeGroups(budget, viewportOnly)
		if self._refreshingKeyGroups or raw._ImportingKeyframes then
			return
		end

		local previousView = self._keyViewport
		self:PrepareKeyframeViewport(not viewportOnly)
		if viewportOnly and previousView == self._keyViewport then
			return
		end

		local jobs = {}

		local function collectJobs(view)
			for motor, keys in view and view.jobs or {} do
				jobs[motor] = jobs[motor] or {}
				for key in keys do
					jobs[motor][key] = true
				end
			end
		end

		collectJobs(previousView)
		collectJobs(self._keyViewport)

		if not previousView then
			for motor, bucket in raw.Keyframes do
				jobs[motor] = jobs[motor] or {}
				for _, key in bucket do
					if key.Button then
						jobs[motor][key] = true
					end
				end
			end
		end

		self._keyGroupsRefreshQueued = nil
		self._refreshingKeyGroups = true
		self._selectionHitTargets = nil
		self:RestoreGroupedButtons()
		local previous, wanted = self._keyGroupBars or {}, {}
		local byContainer = {}
		self._groupedMotors = {}
		self._groupsByKey = {}

		local function add(key, lane, button, virtualContainer)
			local id = self:DisplayKeyGroup(key, lane)
			if not id or (self._expandedKeyGroups and self._expandedKeyGroups[id]) then
				return
			end

			if not virtualContainer and (not button or not button.Parent or not button.Visible) then
				return
			end

			local image = virtualContainer and self:GetKeyframeAppearance(key, lane)
				or self:GetKeyframeImageObject(button)
			if not image then
				return
			end

			local container = virtualContainer or button.Parent
			byContainer[container] = byContainer[container] or {}
			local token = lane .. ":" .. id
			local group = byContainer[container][token]
			if not group then
				group = { id = id, lane = lane, members = {} }
				byContainer[container][token] = group
			end

			table.insert(
				group.members,
				{ key = key, frame = key.Frame, button = button, image = image }
			)
		end

		for motor, bucket in raw.Keyframes do
			local row = raw.TrackRows[motor.Part1]
			local container = row and self:GetTrackKeyframesContainer(row)
			for key in jobs[motor] or {} do
				local frame = key.Frame
				if bucket[frame] ~= key then
					if key.Button then
						key.Button:Destroy()
						key.Button = nil
					end

					continue
				end

				if budget then
					budget()
				end

				if key.Button and not self:KeyframeInViewport(key, POSE) then
					key.Button:Destroy()
					key.Button = nil
				end

				if key.KeyGroups then
					self._groupedMotors[motor] = true
				end

				local view = self._keyViewport
				if view and not view.visible[key] and not key.KeyGroups then
					for _, channelRow in raw.ChannelTracks[motor] or {} do
						local host = self:GetTrackKeyframesContainer(channelRow)
						local button = host and host:FindFirstChild("ChannelKF_" .. frame)
						if button then
							button:Destroy()
						end
					end

					continue
				end

				if self:IsKeyGroupCollapsed(key, POSE) and container then
					if key.Button then
						key.Button:Destroy()
						key.Button = nil
					end

					add(key, POSE, nil, container)
				elseif key.Part and not key.Button then
					self:CreateOrUpdateTimelineKeyframeButton(
						key.Part,
						motor,
						frame,
						key.Template,
						key.SanitizeName
					)
				end

				if raw.ChannelTracks[motor] then
					self:_addChannelDiamondAtFrame(motor, frame)
				end

				local displayLanes = table.clone(key.KeyGroups or {})
				for lane, id in self._keyViewport and self._keyViewport.groups[key] or {} do
					displayLanes[lane] = id
				end

				if not next(displayLanes) then
					continue
				end

				add(key, POSE, key.Button)
				for lane in displayLanes do
					local row = raw.ChannelTracks[motor] and raw.ChannelTracks[motor][lane]
					local container = row and self:GetTrackKeyframesContainer(row)
					if container then
						if self:IsKeyGroupCollapsed(key, lane) then
							add(key, lane, nil, container)
						end
					end
				end
			end
		end

		for key, buttons in self._ikEndMarkers or {} do
			for _, button in buttons do
				add(key, POSE, button)
			end
		end

		for container, groups in byContainer do
			for token, group in groups do
				local members = group.members
				if #members == 0 then
					continue
				end

				table.sort(members, function(a, b)
					return a.frame < b.frame
				end)
				local view = self._keyViewport
				if
					view
					and (
						view.pending
						or not view.containers[container]
						or self:FrameToVisibleX(members[#members].frame) < view.left
						or self:FrameToVisibleX(members[1].frame) > view.right
					)
				then
					continue
				end

				local entry = previous[container] and previous[container][token]
					or createBar(self, container)
				entry.members, entry.lane, entry.id = members, group.lane, group.id
				entry.automatic = group.id:sub(1, 7) == "@dense:"
				entry.bar:SetAttribute("AutomaticGroup", entry.automatic)
				wanted[container] = wanted[container] or {}
				wanted[container][token] = entry
				local shape = Model.majority(members, function(member)
					return member.image.Image
				end)
				local color = members[1].image.ImageColor3
				for _, member in members do
					if member.image.Image == shape then
						color = member.image.ImageColor3
						break
					end
				end

				entry.baseColor = color
				for _, member in members do
					local selected = group.lane == POSE and raw.SelectedKeyframes[member.key]
						or group.lane ~= POSE
							and raw.SelectedChannelKeyframes[member.key]
							and raw.SelectedChannelKeyframes[member.key][group.lane]
					if selected then
						color = Raw.Colors.KEYFRAME_SELECTED_COLOR
						break
					end
				end

				entry.bar.ZIndex = 10 + math.max(0, math.floor(members[1].frame))
				entry.bar:SetAttribute("GroupShape", shape)
				entry.bar:SetAttribute("GroupCount", #members)
				entry.shape, entry.color = shape, color
				for _, member in members do
					self._groupsByKey[member.key] = self._groupsByKey[member.key] or {}
					table.insert(self._groupsByKey[member.key], entry)
					if member.button then
						self._groupHiddenButtons[member.button] = member.button.Visible
						member.button.Visible = false
					end
				end
			end
		end

		for container, groups in previous do
			for token, entry in groups do
				if not wanted[container] or not wanted[container][token] then
					entry.bar:Destroy()
				end
			end
		end

		self._keyGroupBars = wanted
		self._refreshingKeyGroups = false
		self:RefreshKeyframeGroupPositions()
	end

	function Timeline:RefreshKeyframeGroupSelection(entries)
		for entry in entries do
			local selected = false
			for _, member in entry.members do
				if
					(entry.lane == POSE and raw.SelectedKeyframes[member.key])
					or (
						entry.lane ~= POSE
						and raw.SelectedChannelKeyframes[member.key]
						and raw.SelectedChannelKeyframes[member.key][entry.lane]
					)
				then
					selected = true
					break
				end
			end

			local color = selected and Raw.Colors.KEYFRAME_SELECTED_COLOR or entry.baseColor
			Outline.update(entry, entry.shape, entry.bar.Size.X.Offset, color)
		end
	end

	function Timeline:RefreshKeyframeGroupPositions()
		local drag = Raw.KeyframeDrag
		local info = drag.draggingKeyframe
		if not info then
			self._compactKeyDrag = nil
		end

		local delta = info and drag.dragCurrentFrame and drag.dragCurrentFrame - info.OriginalFrame
			or 0

		local function position(member, lane)
			if member.button then
				return member.button.Position.X.Offset
			end

			local frame = member.key.Frame
			if info then
				if not info.ChannelId and drag.groupDragOriginals[member.key] ~= nil then
					frame = drag.groupDragOriginals[member.key] + delta
				elseif
					info.ChannelId
					and raw.SelectedChannelKeyframes[member.key]
					and raw.SelectedChannelKeyframes[member.key][lane]
				then
					frame += delta
				end
			end

			return self:FrameToVisibleX(frame)
		end

		for _, groups in self._keyGroupBars or {} do
			for _, entry in groups do
				local a, b = entry.members[1], entry.members[#entry.members]
				local x, y = position(a, entry.lane), position(b, entry.lane)
				local first, last = math.min(x, y), math.max(x, y)
				local width = math.max(Outline.Height, last - first + Outline.Height)
				entry.bar.Position = UDim2.new(0, first - Outline.Height / 2, 0.5, 0)
				entry.bar.Size = UDim2.fromOffset(width, Outline.Height)
				Outline.update(entry, entry.shape, width, entry.color)
			end
		end
	end

	function Timeline:PreviewCompactKeyframeDrag(delta)
		local drag = Raw.KeyframeDrag
		local info = drag.draggingKeyframe
		if not info then
			self._compactKeyDrag = nil
			return false
		end

		local revision = require("cache").revision()
		local cached = self._compactKeyDrag
		if
			not cached
			or cached.info ~= info
			or cached.bars ~= self._keyGroupBars
			or cached.revision ~= revision
		then
			cached = {
				info = info,
				bars = self._keyGroupBars,
				revision = revision,
				buttons = {},
				compact = false,
			}
			local added = {}

			local function add(button, frame)
				if button and not added[button] then
					added[button] = true
					table.insert(cached.buttons, { button = button, frame = frame })
				end
			end

			local function collect(key, frame, lane)
				cached.compact = cached.compact or self:IsKeyGroupCollapsed(key, lane or POSE)
				add(key.Button, frame)
				for id, row in raw.ChannelTracks[key.Motor] or {} do
					if lane and lane ~= id then
						continue
					end

					local container = self:GetTrackKeyframesContainer(row)
					add(container and container:FindFirstChild("ChannelKF_" .. frame), frame)
				end
			end

			if info.ChannelId then
				for _, entry in drag.groupDragSelectedChannels or {} do
					collect(entry.keyData, entry.originalFrame, entry.channelId)
				end
			else
				for _, key in drag.groupDragSelected or {} do
					collect(key, drag.groupDragOriginals[key] or key.Frame)
				end
			end

			self._compactKeyDrag = cached
		end

		if not cached.compact then
			return false
		end

		for _, entry in cached.buttons do
			if entry.button.Parent then
				entry.button.Position =
					UDim2.new(0, self:FrameToVisibleX(entry.frame + delta), 0.5, 0)
			end
		end

		self:RefreshKeyframeGroupPositions()
		return true
	end

	local function visible(bar)
		local object = bar
		while object do
			if object:IsA("GuiObject") and not object.Visible then
				return false
			end

			object = object.Parent
		end

		return bar.Parent ~= nil
	end

	function Timeline:AddGroupsInSelectionBox(minX, minY, maxX, maxY, origin, keys, channels)
		for _, groups in self._keyGroupBars or {} do
			for _, entry in groups do
				local bar = entry.bar
				local pos, size = bar.AbsolutePosition - origin, bar.AbsoluteSize
				if
					visible(bar)
					and pos.X <= maxX
					and pos.X + size.X >= minX
					and pos.Y <= maxY
					and pos.Y + size.Y >= minY
				then
					for _, member in entry.members do
						if entry.lane == POSE then
							table.insert(keys, member.key)
						else
							table.insert(channels, { keyData = member.key, channelId = entry.lane })
						end
					end
				end
			end
		end
	end

	local originalHit = Timeline.IsMouseDirectlyOverKeyframeButton

	function Timeline:IsMouseDirectlyOverKeyframeButton(key, point)
		if originalHit(self, key, point) then
			return true
		end

		for _, entry in self._groupsByKey and self._groupsByKey[key] or {} do
			local bar = entry.bar
			local pos, size = bar.AbsolutePosition, bar.AbsoluteSize
			if
				visible(bar)
				and point.X >= pos.X
				and point.X <= pos.X + size.X
				and point.Y >= pos.Y
				and point.Y <= pos.Y + size.Y
			then
				return true
			end
		end

		return false
	end

	local originalRefresh = Timeline.RefreshAllKeyframeVisuals

	function Timeline:RefreshKeyframeSelectionVisuals()
		if raw._ImportingKeyframes then
			return
		end

		if not self._keyGroupBars or self._keyGroupsRefreshQueued then
			self:RefreshAllKeyframeVisuals()
			return
		end

		local entries, wanted = {}, {}
		for _, lanes in selectedTracks() do
			for lane, selected in lanes do
				for key in selected do
					for _, entry in self._groupsByKey and self._groupsByKey[key] or {} do
						if entry.lane == lane then
							wanted[entry] = true
						end
					end
				end
			end
		end

		for _, groups in self._keyGroupBars do
			for _, entry in groups do
				entries[entry] = true
				if wanted[entry] then
					for _, member in entry.members do
						if entry.lane == POSE then
							raw.SelectedKeyframes[member.key] = true
						else
							raw.SelectedChannelKeyframes[member.key] = raw.SelectedChannelKeyframes[member.key]
								or {}
							raw.SelectedChannelKeyframes[member.key][entry.lane] = true
						end
					end
				end
			end
		end

		local refreshing = self._refreshingKeyGroups
		self._refreshingKeyGroups = true
		local ok, err = pcall(originalRefresh, self)
		self._refreshingKeyGroups = refreshing
		if not ok then
			error(err, 0)
		end

		self:RefreshKeyframeGroupSelection(entries)
	end

	function Timeline:RefreshAllKeyframeVisuals(...)
		if raw._ImportingKeyframes then
			return
		end

		self:RestoreGroupedButtons()
		self:ExpandGroupedSelection()
		local refreshing = self._refreshingKeyGroups
		self._refreshingKeyGroups = true
		local ok, err = pcall(originalRefresh, self, ...)
		self._refreshingKeyGroups = refreshing
		if not ok then
			error(err, 0)
		end

		self:RefreshKeyframeGroups(...)
	end

	for _, name in
		{ "RecordKeyframeForMotorAtCurrentTime", "RecordPartialKeyframeForMotorAtCurrentTime" }
	do
		local original = Timeline[name]
		if original then
			Timeline[name] = function(self, part, motor, ...)
				local result = original(self, part, motor, ...)

				local options =
					select(name == "RecordPartialKeyframeForMotorAtCurrentTime" and 4 or 2, ...)
				local frame = type(options) == "table" and options.Frame
					or self:TimeToFrame(raw.CurrentTime)
				local key = raw.Keyframes[motor] and raw.Keyframes[motor][frame]
				if
					self._groupedMotors
					and self._groupedMotors[motor]
					and not BlenderEdit.blocked()
				then
					self:AdoptKeyIntoGroups(motor, key)
				end

				return result
			end
		end
	end

	for _, name in { "ToggleSelectedKeyframe", "ToggleSelectedChannelKeyframe" } do
		local original = Timeline[name]
		Timeline[name] = function(self, key, lane)
			if not key then
				return original(self, key, lane)
			end

			local groupLane = name == "ToggleSelectedKeyframe" and POSE or lane
			local id = Model.get(key, groupLane)
			local selected = groupLane == POSE and raw.SelectedKeyframes[key]
				or groupLane ~= POSE
					and raw.SelectedChannelKeyframes[key]
					and raw.SelectedChannelKeyframes[key][groupLane]
			if
				id
				and selected
				and not (self._expandedKeyGroups and self._expandedKeyGroups[id])
			then
				for _, member in Model.collect(raw.Keyframes[key.Motor] or {}, groupLane)[id] or {} do
					if member.key == key then
						continue
					end

					if groupLane == POSE then
						raw.SelectedKeyframes[member.key] = nil
						raw.SelectedChannelKeyframes[member.key] = nil
					else
						raw.SelectedKeyframes[member.key] = nil
						local mask = raw.SelectedChannelKeyframes[member.key]
						if mask then
							mask[groupLane] = nil
							if not next(mask) then
								raw.SelectedChannelKeyframes[member.key] = nil
							end
						end
					end
				end

				raw.SelectedKeyframe = key
			end

			local result = original(self, key, lane)
			if
				selected
				and not next(raw.SelectedKeyframes)
				and not next(raw.SelectedChannelKeyframes)
			then
				raw.SelectedKeyframe = nil
				self:RefreshAllKeyframeVisuals()
			end

			return result
		end
	end

	for _, name in { "RefreshAllTimelineKeyframePositions", "ProcessBlenderKeyframeTransform" } do
		local original = Timeline[name]
		Timeline[name] = function(self, ...)
			local result = original(self, ...)
			self:RefreshKeyframeGroupPositions()
			self:QueueKeyframeViewportRefresh()
			return result
		end
	end

	for _, name in
		{
			"CreateOrUpdateTimelineKeyframeButton",
			"RefreshIKEndMarkers",
			"RefreshChannelDiamondsForMotor",
			"RebuildAllTimelineKeyframeButtons",
			"_restoreMotorBucket",
		}
	do
		local original = Timeline[name]
		if original then
			Timeline[name] = function(self, ...)
				if name == "RebuildAllTimelineKeyframeButtons" then
					self:PrepareKeyframeViewport(true)
					self._viewportBulk = true
				end

				local ok, result = pcall(original, self, ...)
				if name == "RebuildAllTimelineKeyframeButtons" then
					self._viewportBulk = nil
				end

				if not ok then
					error(result, 0)
				end

				if name == "_restoreMotorBucket" and select(3, ...) then
					return result
				end

				if self._refreshingKeyGroups or raw._ImportingKeyframes then
					return result
				end

				if not self._keyGroupsRefreshQueued then
					local queued = {}
					self._keyGroupsRefreshQueued = queued
					task.defer(function()
						if self._keyGroupsRefreshQueued ~= queued then
							return
						end

						self._keyGroupsRefreshQueued = nil
						self:RefreshKeyframeGroups()
					end)
				end

				return result
			end
		end
	end
end
]]></string>
