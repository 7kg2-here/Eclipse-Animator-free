          <Item class="ModuleScript" referent="2054">
            <Properties>
              <string name="Name">EclipseExportHelpersEclipseVFX</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028fa9</UniqueId>
