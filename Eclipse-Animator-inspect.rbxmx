            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local Tool = require("Tool")
local Theme = require("Theme")
local Camera = require("CameraRig")
local Organization = require("Organization")
local Package = require("Package")
local Exporter = {}
local refs, current
local Selection = game:GetService("Selection")

function Exporter.errorMessage(message)
	for line in tostring(message):gmatch("[^\r\n]+") do
		local text = line
		repeat
			local stripped, count = text:gsub("^.-:%d+:%s*", "", 1)
			text = stripped
		until count == 0
		text = text:match("^%s*(.-)%s*$")
		if text ~= "" and text ~= "stack traceback:" and not text:match("^%[C%]") then
			return text
		end
	end

	return "Export could not finish. See Output for details."
end

function Exporter.close()
	if current then
		local old = current
		current = nil
		old:close()
	end
end

function Exporter.open()
	if current then
		return current
	end

	if not refs or not refs.Active() then
		return
	end

	local timeline = refs.State.Timeline
	local raw = timeline:GetState()
	local window = Tool.new(
		refs,
		"EclipseModuleExporter",
		"MODULE EXPORTER",
		Vector2.new(510, 466),
		false,

		function()
			current = nil
		end
	)
	current = window
	local body = Tool.make("Frame", window.frame, "Body", {
		Position = UDim2.fromOffset(16, 42),
		Size = UDim2.new(1, -32, 1, -56),
		BackgroundTransparency = 1,
		ZIndex = 11,
	})

	local function label(name, text, x, y, w, h)
		local object = Tool.label(body, name, text, UDim2.fromOffset(x, y), UDim2.fromOffset(w, h))
		object.ZIndex = 12
		return object
	end

	local function button(name, text, x, y, w, fn)
		return Tool.button(body, name, text, UDim2.fromOffset(x, y), UDim2.fromOffset(w, 28), fn)
	end

	local function field(name, text, x, y, w)
		return Tool.field(body, name, text, UDim2.fromOffset(x, y), UDim2.fromOffset(w, 28))
	end

	local mode = "Button"
	local dependencies = {}
	local modeLabels = {}
	local relayout
	local popup
	local expanded = false
	label("Introduction", "Play this project in your game", 0, 0, 478, 24).TextSize = 16
	label("ModeLabel", "START WITH", 0, 32, 478, 18).TextTransparency = 0.4
	local descriptions = {
		Scripting = "Exports only a module so you, or your scripter can hook it to your systems.",
		Button = "Adds a game button to start or stop the cutscene for the player who clicks it.",
	}
	local description = label("ModeDescription", "", 0, 84, 478, 35)
	description.TextTransparency = 0.2
	local name = field("ExportName", refs.Name(), 148, 126, 330)
	label("NameLabel", "Export name", 0, 126, 135, 28)
	local trigger = field("Trigger", "Play cutscene", 148, 163, 330)
	local triggerLabel = label("TriggerLabel", "Button label", 0, 163, 135, 28)
	for i, item in { { "Button", "BUTTONS" }, { "Scripting", "SCRIPTING" } } do
		local b, l = button(item[1], item[2], (i - 1) * 243, 50, 235, function()
			if window.busy then
				return
			end

			mode = item[1]
			description.Text = "> " .. descriptions[mode]
			trigger.Parent.Visible = mode ~= "Scripting"
			triggerLabel.Visible = mode ~= "Scripting"
			triggerLabel.Text = "Button label"
			for id, row in modeLabels do
				row.TextTransparency = id == mode and 0 or 0.55
				row.Parent:SetAttribute("ThemeBg", id == mode and "MenuSel" or "TopBtn")
			end

			if relayout then
				relayout()
			end

			Theme.applyTree(body)
		end)
		modeLabels[item[1]] = l
	end

	description.Text = "> " .. descriptions[mode]
	for id, row in modeLabels do
		row.TextTransparency = id == mode and 0 or 0.55
		row.Parent:SetAttribute("ThemeBg", id == mode and "MenuSel" or "TopBtn")
	end

	label("CameraLabel", "Camera view", 0, 200, 135, 28)
	local cameras = { { Name = "Outside view", Mode = "Game" } }
	for _, rig in refs.State.getAllRigs() do
		if (Camera.isRig(rig) or rig:IsA("Camera")) and Organization.isEnabled(rig) then
			table.insert(cameras, { Name = rig.Name, Mode = "Authored", Rig = rig })
		end
	end

	local cameraIndex
	if #cameras == 1 then
		cameraIndex = 1
	elseif #cameras == 2 then
		cameraIndex = 2
	end

	local cameraHelp = label("CameraHelp", "", 148, 231, 330, 26)
	cameraHelp.TextTransparency = 0.35
	local cameraButton, cameraText

	local function refreshCamera()
		local choice = cameraIndex and cameras[cameraIndex]
		cameraText.Text = (
			choice and (choice.Mode == "Authored" and "Camera: " .. choice.Name or choice.Name)
			or "Select a camera\u{2026}"
		) .. "  \u{25be}"
		cameraHelp.Text = not choice and "Choose an animation camera or Outside view."
			or choice.Mode == "Game" and "Watch with the player\u{2019}s normal game camera."
			or "View through this animation camera."
	end

	cameraButton, cameraText = button("Camera", "", 148, 200, 330, function()
		if window.busy then
			return
		end

		if popup then
			popup:Destroy()
			popup = nil
			return
		end

		popup = Tool.make("ScrollingFrame", body, "CameraChoices", {
			Position = cameraButton.Position + UDim2.fromOffset(0, 30),
			Size = UDim2.fromOffset(330, math.min(180, #cameras * 30)),
			CanvasSize = UDim2.fromOffset(0, #cameras * 30),
			ScrollBarThickness = 4,
			BorderSizePixel = 0,
			ZIndex = 30,
			BackgroundColor3 = Theme.get("Pnl", Color3.fromRGB(20, 34, 40)),
		})
		for index, choice in cameras do
			local pick, text = Tool.button(
				popup,
				"Choice" .. index,
				choice.Mode == "Authored" and "Camera: " .. choice.Name or choice.Name,
				UDim2.fromOffset(0, (index - 1) * 30),
				UDim2.new(1, -4, 0, 30),

				function()
					cameraIndex = index
					refreshCamera()
					popup:Destroy()
					popup = nil
				end
			)
			pick.ZIndex = 31
			for _, child in pick:GetDescendants() do
				if child:IsA("GuiObject") then
					child.ZIndex = 32
				end
			end

			pick:SetAttribute("ThemeBg", index == cameraIndex and "MenuSel" or "Pnl")
		end

		Theme.applyTree(popup)
	end)
	refreshCamera()
	label("FrameLabel", "End frame", 0, 264, 135, 28)
	local last = field("EndFrame", math.max(1, timeline:GetMaxFrame()), 148, 264, 106)
	local timing = label("Timing", raw.FPS .. " FPS \u{00B7} from frame 0", 266, 264, 212, 28)
	timing.TextTransparency = 0.3
	local extraButton, extraLabel = button("ExtraFiles", "EXTRA FILES\u{2026}", 0, 302, 170, function()
		if window.busy then
			return
		end

		expanded = not expanded
		relayout()
	end
)
	local extras = Tool.make("Frame", body, "ExtraFilesPanel", {
		Position = UDim2.fromOffset(0, 338),
		Size = UDim2.fromOffset(478, 108),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 12,
	})
	local help = Tool.label(
		extras,
		"Help",
		"Optional: for event scripts that use files outside this animation. Select those objects in Studio\u{2019}s Explorer, then include them.",
		UDim2.fromOffset(0, 0),
		UDim2.fromOffset(478, 36)
	)
	help.TextTransparency = 0.3
	help.ZIndex = 12
	local dependencyText = Tool.label(
		extras,
		"IncludedFiles",
		"No extra files. Actors and referenced modules are included automatically.",
		UDim2.fromOffset(0, 74),
		UDim2.fromOffset(478, 32)
	)
	dependencyText.TextTransparency = 0.3
	dependencyText.ZIndex = 12
	Tool.button(
		extras,
		"Dependencies",
		"INCLUDE EXPLORER SELECTION",
		UDim2.fromOffset(0, 42),
		UDim2.fromOffset(280, 28),

		function()
			if window.busy then
				return
			end

			local added = 0
			for _, object in Selection:Get() do
				if
					not table.find(dependencies, object)
					and object ~= workspace
					and (
						object:IsDescendantOf(workspace)
						or object:IsDescendantOf(game:GetService("ReplicatedStorage"))
					)
				then
					table.insert(dependencies, object)
					added += 1
				end
			end

			local names = {}
			for _, object in dependencies do
				table.insert(names, object.Name)
			end

			dependencyText.Text = added == 0
					and "Select extra objects in Workspace or ReplicatedStorage in Explorer first."
				or (#names .. " included: " .. table.concat(names, ", "))
			extraLabel.Text = "EXTRA FILES (" .. #dependencies .. ")  \u{25b4}"
		end
	)
	Tool.button(
		extras,
		"ClearDependencies",
		"CLEAR",
		UDim2.fromOffset(290, 42),
		UDim2.fromOffset(90, 28),

		function()
			if not window.busy then
				table.clear(dependencies)
				dependencyText.Text =
					"No extra files. Actors and referenced modules are included automatically."
				extraLabel.Text = "EXTRA FILES  \u{25b4}"
			end
		end
	)
	local status = label(
		"Status",
		"Creates a new package in ReplicatedStorage \u{2192} EclipseCutscenes.",
		0,
		340,
		478,
		40
	)
	status.TextSize = 11
	local exportButton, exportText
	exportButton, exportText = button("Export", "EXPORT CUTSCENE", 295, 386, 183, function()
		if window.busy then
			return
		end

		local exportName = name.Text:match("^%s*(.-)%s*$")
		local finish = tonumber(last.Text)
		if exportName == "" or #exportName > 80 or exportName:find("[%c]") then
			status.Text = "Use an export name between 1 and 80 characters."
			return
		end

		if not finish or finish % 1 ~= 0 or finish < 1 then
			status.Text = "End frame must be a positive whole number."
			return
		end

		if mode == "Button" and not trigger.Text:find("%S") then
			status.Text = "Enter a label for the game button."
			return
		end

		if not cameraIndex then
			status.Text = "Choose a camera or Outside view before exporting."
			return
		end

		if timeline:IsExportLocked() then
			status.Text = "A module export is already running. Wait for it to finish."
			return
		end

		if refs.State.PhysicsSimulating then
			status.Text = "Wait for the physics simulation to finish before exporting."
			return
		end

		local existing = game:GetService("ReplicatedStorage"):FindFirstChild("EclipseCutscenes")
		if existing and existing:FindFirstChild(exportName) then
			status.Text = "That export already exists. Change the name to keep both versions."
			return
		end

		window.busy = true
		exportText.Text = "EXPORTING\u{2026}"
		if popup then
			popup:Destroy()
			popup = nil
		end

		local choice = cameras[cameraIndex]
		local options = {
			Name = exportName,
			LastFrame = finish,
			Mode = mode,
			CameraMode = choice.Mode,
			Camera = choice.Rig,
			ButtonLabel = trigger.Text,
			Dependencies = table.clone(dependencies),
			IsCancelled = function()
				return window.closed
			end,
		}
		local shield = Tool.make("TextButton", window.gui, "ExportInputShield", {
			Size = UDim2.fromScale(1, 1),
			Text = "",
			BackgroundTransparency = 1,
			Modal = true,
			Active = true,
			ZIndex = 1,
		})
		local Input = require("UserInputService")
		local captured = not Input.isCapturingKeys()
		if captured then
			Input.setKeyCapture(function(input)
				if input.KeyCode == Enum.KeyCode.Escape then
					Exporter.close()
				end
			end)
		end

		task.defer(function()
			local root, launcher
			local ok, message = xpcall(function()
				require("Bake").withExportLock(refs, options, function()
					root, launcher = Package.build(refs, options, function(text)
						if not window.closed then
							status.Text = text
						end
					end)
					assert(not window.closed, "Export cancelled because the window was closed")
					Package.install(root, launcher)
				end)
			end, debug.traceback)
			window.busy = false
			shield:Destroy()
			if captured then
				Input.setKeyCapture(nil)
			end

			if not ok then
				if root then
					root:Destroy()
				end

				if launcher then
					launcher:Destroy()
				end
			end

			if not window.closed then
				exportText.Text = "EXPORT CUTSCENE"
				status.Text = ok
						and ("Exported " .. exportName .. " to EclipseCutscenes. " .. (mode == "Scripting" and "Open its README for the scripting API." or "Press Play in Studio to try " .. "the game button" .. "."))
					or Exporter.errorMessage(message)
				if not ok then
					warn("Eclipse Module Exporter: " .. tostring(message))
				end
			end

			if ok then
				local previous = refs.State.ignoreSelectionChanged
				refs.State.ignoreSelectionChanged = true
				Selection:Set({ root })
				refs.State.ignoreSelectionChanged = previous
			end
		end)
	end)
	button("Close", "CLOSE", 0, 386, 100, Exporter.close)
	local positions = {}
	for _, child in body:GetChildren() do
		if child:IsA("GuiObject") and child.Position.Y.Offset >= 200 then
			positions[child] = child.Position
		end
	end

	relayout = function()
		if popup then
			popup:Destroy()
			popup = nil
		end

		local shift = mode == "Scripting" and -38 or 0
		for child, position in positions do
			local extra = (child == status or child == exportButton or child.Name == "Close")
					and expanded
					and 112
				or 0
			child.Position = position + UDim2.fromOffset(0, shift + extra)
		end

		extras.Visible = expanded
		extraLabel.Text = "EXTRA FILES"
			.. (#dependencies > 0 and " (" .. #dependencies .. ")" or "")
			.. (expanded and "  \u{25b4}" or "\u{2026}")
		local height = 466 + shift + (expanded and 112 or 0)
		local minimum = window.frame:FindFirstChildOfClass("UISizeConstraint")
		if minimum then
			minimum.MinSize = Vector2.new(510, height)
		end

		window.frame.Size = UDim2.fromOffset(510, height)
	end

	relayout()
	Theme.applyTree(body)
	return window
end

function Exporter.init(options)
	Exporter.close()
	refs = options
	options.Plugin.Unloading:Connect(Exporter.close)
	options.ScreenGui.Destroying:Once(Exporter.close)
end

return Exporter
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a383</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1850">
          <Properties>
            <string name="Name">PropertyValues</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028edd</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{87F90CDA-3DA4-48B4-BCD8-BA273997D1CA}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local State = require("State")
local Tracks = require("Properties")
local Camera = require("CameraRig")
local History = require("History")
local Tool = require("Tool")
local Theme = require("Theme")
local Notification = require("Notification")
local Edit = require("BlenderEdit")
local Values = {}

function Values.definition(key)
	if Tracks.is(key.Motor) then
		return key.Motor.Definition
	end

	if Camera.isFov(key.Motor) then
		return { id = "FieldOfView", label = "FOV", kind = "number" }
	end
end

function Values.value(key)
	if Camera.isFov(key.Motor) then
		return Camera.decode(key.Motor, key.C0)
	end

	return Tracks.decode(key.Motor, key.C0, key.PropertyValue)
end

function Values.components(kind, value)
	if kind == "number" or kind == "string" or kind == "boolean" then
		return { value }
	end

	if kind == "EnumItem" then
		return { value.Name }
	end

	if kind == "Vector3" then
		return { value.X, value.Y, value.Z }
	end

	if kind == "Vector2" then
		return { value.X, value.Y }
	end

	if kind == "Color3" then
		return { value.R * 255, value.G * 255, value.B * 255 }
	end

	if kind == "NumberRange" then
		return { value.Min, value.Max }
	end

	if kind == "UDim" then
		return { value.Scale, value.Offset }
	end

	if kind == "UDim2" then
		return { value.X.Scale, value.X.Offset, value.Y.Scale, value.Y.Offset }
	end

	if kind == "Rect" then
		return { value.Min.X, value.Min.Y, value.Max.X, value.Max.Y }
	end

	if kind == "BrickColor" then
		return { value.Number }
	end

	if kind == "NumberSequence" or kind == "ColorSequence" then
		local keys = {}
		for _, key in value.Keypoints do
			table.insert(
				keys,
				kind == "NumberSequence"
						and string.format("%.9g:%.9g:%.9g", key.Time, key.Value, key.Envelope)
					or string.format(
						"%.9g:%.9g:%.9g:%.9g",
						key.Time,
						key.Value.R * 255,
						key.Value.G * 255,
						key.Value.B * 255
					)
			)
		end

		return { table.concat(keys, "; ") }
	end

	if kind == "CFrame" then
		local x, y, z = value:ToEulerAnglesXYZ()
		return { value.X, value.Y, value.Z, math.deg(x), math.deg(y), math.deg(z) }
	end
end

function Values.compose(def, values)
	local kind = def.kind
	if kind == "number" or kind == "string" or kind == "boolean" then
		return values[1]
	end

	if kind == "EnumItem" then
		for _, value in def.enum:GetEnumItems() do
			if value.Name:lower() == tostring(values[1]):lower() then
				return value
			end
		end

		error("Choose a valid " .. def.label)
	end

	if kind == "Vector3" then
		return Vector3.new(table.unpack(values))
	end

	if kind == "Vector2" then
		return Vector2.new(table.unpack(values))
	end

	if kind == "Color3" then
		for _, v in values do
			assert(v >= 0 and v <= 255, "RGB values must be 0–255")
		end

		return Color3.fromRGB(table.unpack(values))
	end

	if kind == "UDim" then
		return UDim.new(table.unpack(values))
	end

	if kind == "UDim2" then
		return UDim2.new(table.unpack(values))
	end

	if kind == "Rect" then
		return Rect.new(table.unpack(values))
	end

	if kind == "BrickColor" then
		return BrickColor.new(values[1])
	end

	if kind == "NumberSequence" or kind == "ColorSequence" then
		local keys = {}
		for _, text in string.split(values[1], ";") do
			local v = {}
			for _, component in string.split(text, ":") do
				local number =
					assert(tonumber(component), "Enter numeric keypoint values separated by :")
				table.insert(v, number)
			end

			assert(
				#v == (kind == "NumberSequence" and 3 or 4),
				kind == "NumberSequence" and "Use time:value:envelope; time:value:envelope"
					or "Use time:red:green:blue; time:red:green:blue"
			)
			if kind == "ColorSequence" then
				for i = 2, 4 do
					assert(v[i] >= 0 and v[i] <= 255, "RGB values must be 0–255")
				end
			end

			table.insert(
				keys,
				kind == "NumberSequence" and NumberSequenceKeypoint.new(v[1], v[2], v[3])
					or ColorSequenceKeypoint.new(v[1], Color3.fromRGB(v[2], v[3], v[4]))
			)
		end

		return kind == "NumberSequence" and NumberSequence.new(keys) or ColorSequence.new(keys)
	end

	if kind == "NumberRange" then
		assert(values[1] <= values[2], "Minimum must not exceed maximum")
		return NumberRange.new(table.unpack(values))
	end

	if kind == "CFrame" then
		return CFrame.new(values[1], values[2], values[3])
			* CFrame.Angles(math.rad(values[4]), math.rad(values[5]), math.rad(values[6]))
	end
end

function Values.edit(keys, index, value)
	assert(not Edit.blocked(), "Finish the current edit before changing values")
	if #keys == 0 then
		return false
	end

	local timeline = State.Timeline
	local raw = timeline:GetState()
	local before, after, updates = {}, {}, {}
	for _, key in keys do
		local def = Values.definition(key)
		assert(def, "Select property keys of the same type")
		assert(
			raw.Keyframes[key.Motor] and raw.Keyframes[key.Motor][key.Frame] == key,
			"These keyframes changed; select them again"
		)
		local components = Values.components(def.kind, Values.value(key))
		components[index] = value
		local updated
		if index == 0 and def.kind == "ColorSequence" then
			assert(
				type(value) == "table"
					and typeof(value.Color) == "Color3"
					and type(value.StopTime) == "number",
				"Choose a color stop"
			)
			local points, found = {}, false
			for _, point in Values.value(key).Keypoints do
				local selected = math.abs(point.Time - value.StopTime) < 1e-6
				found = found or selected
				table.insert(
					points,
					ColorSequenceKeypoint.new(point.Time, selected and value.Color or point.Value)
				)
			end

			if not found then
				table.insert(points, ColorSequenceKeypoint.new(value.StopTime, value.Color))
				table.sort(points, function(a, b)
					return a.Time < b.Time
				end)
			end

			updated = ColorSequence.new(points)
		elseif index == 0 and def.kind == "BrickColor" then
			updated = BrickColor.new(value)
		elseif index == 0 and def.kind == "Color3" then
			updated = value
		else
			updated = Values.compose(def, components)
		end

		assert(
			Camera.isFov(key.Motor)
					and typeof(updated) == "number"
					and updated >= 1
					and updated <= 120
				or Tracks.is(key.Motor) and Tracks.validate(key.Motor, updated),
			"Invalid " .. def.label .. " value"
		)
		if Tracks.is(key.Motor) then
			Tracks.prepare(key.Motor, updated)
		end

		updates[key] = updated
		if not before[key.Motor] then
			before[key.Motor] = timeline:_snapshotMotorBucket(key.Motor)
		end
	end

	local function refresh()
		State.currentProjectSaved = false
		for _, rig in State.getAllRigs() do
			timeline:ApplyPoseAtTime(rig, raw.CurrentTime, { OnlyRig = true })
		end

		timeline:RefreshAllKeyframeVisuals()
	end

	local function restore(snapshot)
		for motor, bucket in snapshot do
			timeline:_restoreMotorBucket(motor, bucket)
		end

		refresh()
	end

	local ok, err = pcall(function()
		for key, updated in updates do
			assert(
				raw.Keyframes[key.Motor] and raw.Keyframes[key.Motor][key.Frame] == key,
				"These keyframes changed; select them again"
			)
			if Tracks.is(key.Motor) then
				key.PropertyValue = updated
			else
				key.PropertyValue = nil
			end

			key.C0 = Camera.isFov(key.Motor) and Camera.encode(key.Motor, updated)
				or Tracks.encode(updated)
			key.Position, key.Rotation = key.C0.Position, key.C0.Rotation
			key.Channels = nil
			key.GraphCurves = nil
			key.ChannelPoseC0 = nil
			raw._motorUniform[key.Motor] = nil
		end

		for motor in before do
			require("GraphCurves").invalidate(raw.Keyframes[motor])
		end

		refresh()
	end)
	if not ok then
		restore(before)
		error(err, 0)
	end

	for motor in before do
		after[motor] = timeline:_snapshotMotorBucket(motor)
		require("HumanoidScale").bucketsChanged(motor, before[motor], after[motor])
	end

	History.record(function()
		restore(before)
	end, function()
		restore(after)
	end, "Edit property value")
	return true
end

function Values.build(frame, selection)
	local panel = Tool.make("Frame", frame.Content, "PropertyValues", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = frame.ZIndex + 2,
		Visible = false,
	})
	local signature
	local colorButton
	local fields = {}
	local def
	local editor = { panel = panel }

	local function commit(index, value, keys)
		local ok, err = pcall(Values.edit, keys or selection(), index, value)
		if not ok then
			Notification.show("PROPERTY VALUE", (tostring(err):gsub("^.-:%d+: ", "")))
		end

		editor.refresh()
	end

	function editor.refresh()
		local keys = selection()
		def = keys[1] and Values.definition(keys[1])
		for _, key in keys do
			local other = Values.definition(key)
			if not def or not other or other.kind ~= def.kind or other.enum ~= def.enum then
				def = nil
				break
			end
		end

		if not def then
			local typed = false
			for _, key in keys do
				if Values.definition(key) then
					typed = true
					break
				end
			end

			panel.Visible = typed
			if typed then
				for _, child in panel:GetChildren() do
					child:Destroy()
				end

				signature = nil
				fields = {}
				frame.Size = UDim2.fromOffset(214, 48)
				Tool.label(
					panel,
					"Mixed",
					"Select keys of one value type",
					UDim2.fromOffset(8, 4),
					UDim2.new(1, -16, 1, -8)
				)
				Theme.applyTree(panel)
			end

			return typed
		end

		panel.Visible = true
		local nextSignature = def.kind .. ":" .. def.label
		if signature ~= nextSignature then
			signature = nextSignature
			for _, child in panel:GetChildren() do
				child:Destroy()
			end

			fields = {}
			colorButton = nil
			local labels = ({
				Vector3 = { "X", "Y", "Z" },
				Vector2 = { "X", "Y" },
				Color3 = { "R", "G", "B" },
				NumberRange = { "Min", "Max" },
				UDim = { "Scale", "Offset" },
				UDim2 = { "X Scale", "X Offset", "Y Scale", "Y Offset" },
				Rect = { "Min X", "Min Y", "Max X", "Max Y" },
				BrickColor = { "Color number" },
				CFrame = { "X", "Y", "Z", "RX °", "RY °", "RZ °" },
			})[def.kind] or { def.label }
			local labelWidth = 64
			for _, label in labels do
				labelWidth = math.max(labelWidth, #label * 8 + 4)
			end

			local fieldX = labelWidth + 21
			local width = math.max(
				def.kind == "CFrame" and 214
					or (def.kind == "NumberSequence" or def.kind == "ColorSequence") and 420
					or def.kind == "string" and 240
					or 178,
				fieldX + 108
			)
			frame.Size = UDim2.fromOffset(width, 12 + #labels * 27)
			for index, label in labels do
				Tool.label(
					panel,
					"Label" .. index,
					label,
					UDim2.fromOffset(8, 6 + (index - 1) * 27),
					UDim2.fromOffset(labelWidth, 22)
				)
				if def.kind == "boolean" then
					local button, text = Tool.button(
						panel,
						"Toggle",
						"",
						UDim2.fromOffset(fieldX, 6),
						UDim2.new(1, -fieldX - 8, 0, 22),

						function()
							commit(1, not Values.value(selection()[1]))
						end
					)
					fields[index] = text
				elseif def.kind == "EnumItem" then
					local button, text = Tool.button(
						panel,
						"Choice",
						"",
						UDim2.fromOffset(fieldX, 6),
						UDim2.new(1, -fieldX - 8, 0, 22)
					)
					fields[index] = text
					button.Activated:Connect(function()
						local old = panel:FindFirstChild("Choices")
						if old then
							old:Destroy()
							signature = nil
							editor.refresh()
							return
						end

						local list = Tool.make("ScrollingFrame", panel, "Choices", {
							Position = UDim2.fromOffset(8, 34),
							Size = UDim2.new(
								1,
								-16,
								0,
								math.min(180, #def.enum:GetEnumItems() * 24)
							),
							CanvasSize = UDim2.new(),
							AutomaticCanvasSize = Enum.AutomaticSize.Y,
							ScrollBarThickness = 3,
							BorderSizePixel = 0,
							ZIndex = panel.ZIndex + 8,
							BackgroundColor3 = Color3.fromRGB(40, 20, 55),
						})
						list:SetAttribute("ThemeBg", "Top")
						Tool.make("UIListLayout", list, "Rows", {})
						frame.Size = UDim2.fromOffset(math.max(200, width), 42 + list.Size.Y.Offset)
						for _, choice in def.enum:GetEnumItems() do
							Tool.button(
								list,
								choice.Name,
								choice.Name,
								UDim2.new(),
								UDim2.new(1, -4, 0, 24),

								function()
									list:Destroy()
									signature = nil
									commit(1, choice.Name)
								end
							)
						end

						Theme.applyTree(list)
					end)
				else
					local field = Tool.field(
						panel,
						"Field" .. index,
						"",
						UDim2.fromOffset(fieldX, 6 + (index - 1) * 27),
						UDim2.new(1, -fieldX - 8, 0, 22)
					)
					fields[index] = field
					local editing
					local kind = (def.kind == "NumberSequence" or def.kind == "ColorSequence")
							and "string"
						or def.kind
					field.Focused:Connect(function()
						editing = table.clone(selection())
					end)
					require("NumericInput").connect(field, {
						step = kind == "Color3" and 1 or 0.1,
						enabled = function()
							return kind ~= "string"
						end,
					}, function()
						local value = kind == "string" and field.Text or tonumber(field.Text)
						if value ~= nil and editing then
							commit(index, value, editing)
						else
							editor.refresh()
						end

						editing = nil
					end)
				end
			end

			if def.kind == "Color3" or def.kind == "BrickColor" or def.kind == "ColorSequence" then
				local isSequence = def.kind == "ColorSequence"
				local y = 12 + #labels * 27
				frame.Size = UDim2.fromOffset(width, y + 30)
				local stop = 1
				local stopText

				local function chosen()
					local value = Values.value(selection()[1])
					if isSequence then
						stop = math.clamp(stop, 1, #value.Keypoints)
						return value.Keypoints[stop]
					end
				end

				local function showStop()
					if stopText then
						local point = chosen()
						stopText.Text = string.format(
							"STOP %d / %d - %.2f",
							stop,
							#Values.value(selection()[1]).Keypoints,
							point.Time
						)
					end
				end

				if isSequence then
					local button, label = Tool.button(
						panel,
						"ColorStop",
						"",
						UDim2.fromOffset(8, y),
						UDim2.new(0.5, -12, 0, 22),

						function()
							stop = stop % #Values.value(selection()[1]).Keypoints + 1
							showStop()
						end
					)
					stopText = label
					showStop()
				end

				colorButton = Tool.button(
					panel,
					"PickColor",
					"PICK COLOR",
					isSequence and UDim2.new(0.5, 4, 0, y) or UDim2.fromOffset(8, y),
					isSequence and UDim2.new(0.5, -12, 0, 22) or UDim2.new(1, -16, 0, 22),

					function()
						local keys = table.clone(selection())
						if #keys == 0 then
							return
						end

						local timeline = State.Timeline
						local ui = require("UI")
						local gui = ui.EclipseGUI or frame:FindFirstAncestorWhichIsA("ScreenGui")
						if not gui then
							return
						end

						local value = Values.value(keys[1])
						local point = isSequence and chosen()
						local color = point and point.Value
							or typeof(value) == "BrickColor" and value.Color
							or value
						require("Picker").open(
							{ ScreenGui = gui },
							colorButton,
							{ stops = { color } },

							function(picked)
								commit(
									0,
									point and { StopTime = point.Time, Color = picked.stops[1] }
										or picked.stops[1],
									keys
								)
								showStop()
							end,
							{
								solid = true,
								commitOnDone = true,
								alive = function()
									return State.Timeline == timeline
										and not State.LoadingProject
										and gui.Enabled
										and (not ui.AnimatorFrame or ui.AnimatorFrame.Visible)
								end,
							}
						)
					end
				)
			end

			Theme.applyTree(panel)
		end

		for index, field in fields do
			if field:IsA("TextBox") and field:IsFocused() then
				continue
			end

			local value = Values.components(def.kind, Values.value(keys[1]))[index]
			for _, key in keys do
				if Values.components(def.kind, Values.value(key))[index] ~= value then
					value = nil
					break
				end
			end

			field.Text = value == nil and "Mixed"
				or typeof(value) == "boolean" and (value and "ON" or "OFF")
				or typeof(value) == "number" and string.format("%.4f", value):gsub("%.?0+$", "")
				or tostring(value)
		end

		return true
	end

	return editor
end

return Values
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a384</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1851">
          <Properties>
            <string name="Name">TrackOrganizationStorage</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028ede</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{8741A5AA-88AE-4682-984B-1C8CC82EE471}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local Properties = require("Properties")
local CameraRig = require("CameraRig")
local HttpService = game:GetService("HttpService")
local Storage = {}
local NAME = "EclipseTrackOrganization"
local ID = "EclipseTrackId"

local function finite(value, fallback)
	return typeof(value) == "number" and value == value and math.abs(value) < math.huge and value
		or fallback
end

local function identity(object, used)
	local id = object:GetAttribute(ID)
	if typeof(id) ~= "string" or id == "" or used and used[id] and used[id] ~= object then
		id = HttpService:GenerateGUID(false)
		object:SetAttribute(ID, id)
	end

	if used then
		used[id] = object
	end

	return id
end

local function reference(parent, name, value)
	local result = Instance.new("ObjectValue")
	result.Name, result.Value, result.Parent = name, require("rig").original(value), parent
end

local function referenced(entry, name)
	local value = entry:FindFirstChild(name)
	return value and value:IsA("ObjectValue") and value.Value or nil
end

local function traversable(object)
	return not object:IsA("ValueBase")
		and not object:IsA("KeyframeSequence")
		and object.Name ~= "AnimSaves"
		and object.Name ~= NAME
		and object:GetAttribute("EclipseSave") ~= true
end

local function childSegments(parent)
	local result, counts = {}, {}
	for _, child in parent:GetChildren() do
		local nameClass = child.ClassName .. "\0" .. child.Name
		counts[nameClass] = (counts[nameClass] or 0) + 1
		table.insert(
			result,
			{ child, { name = child.Name, class = child.ClassName, index = counts[nameClass] } }
		)
	end

	return result
end

local function appended(path, segment)
	local result = table.clone(path)
	table.insert(result, segment)
	return result
end

local function buildBindingIndex(rig)
	local index = { members = {}, ids = {}, paths = {} }
	local step = require("State").ProjectWorkStep
	local links = {}

	local function visit(object, path)
		if index.members[object] then
			return
		end

		if step then
			step()
		end

		index.members[object], index.paths[object] = true, path
		local id = object:GetAttribute(ID)
		if typeof(id) == "string" and id ~= "" then
			index.ids[id] = index.ids[id] == nil and object or false
		end

		if object:IsA("Motor6D") and object.Part1 then
			table.insert(links, { object.Part1, appended(path, { link = "Part1" }) })
		end

		for _, info in
			object == rig and Properties.propertyOnly(rig) and {} or childSegments(object)
		do
			if traversable(info[1]) then
				visit(info[1], appended(path, info[2]))
			end
		end
	end

	visit(rig, {})
	Properties.list(rig)
	local properties = Properties.folder(rig, false)
	if properties then
		visit(properties, { { link = "Properties" } })
	end

	local cursor = 1
	while cursor <= #links do
		local link = links[cursor]
		visit(link[1], link[2])
		cursor += 1
	end

	return index
end

local function follow(root, encoded)
	if typeof(encoded) ~= "string" then
		return nil
	end

	local ok, path = pcall(HttpService.JSONDecode, HttpService, encoded)
	if not ok or typeof(path) ~= "table" then
		return nil
	end

	local current = root
	for _, segment in ipairs(path) do
		if typeof(segment) ~= "table" then
			return nil
		end

		if segment.link == "Properties" then
			current = Properties.folder(current, true)
		elseif segment.link == "Part1" then
			if not current:IsA("Motor6D") or not current.Part1 then
				return nil
			end

			current = current.Part1
		else
			local found, ordinal = nil, 0
			for _, child in current:GetChildren() do
				if child.Name == segment.name and child.ClassName == segment.class then
					ordinal += 1
					if ordinal == segment.index then
						found = child
						break
					end
				end
			end

			if not found and segment.name == "Properties" and segment.class == "Folder" then
				found = Properties.folder(current, false)
			end

			if not found then
				return nil
			end

			current = found
		end
	end

	return current
end

local function pathFrom(root, object)
	local path = {}
	while object and object ~= root do
		local parent = object.Parent
		if not parent then
			return nil
		end

		for _, info in childSegments(parent) do
			if info[1] == object then
				table.insert(path, 1, info[2])
				break
			end
		end

		object = parent
	end

	return object == root and path or nil
end

function Storage.bindingPath(rig, object, cache)
	local state = require("State")
	local rigs = state.getAllRigs and state.getAllRigs() or {}
	local ancestor = object
	while ancestor do
		if table.find(rigs, ancestor) then
			if ancestor ~= rig then
				return nil
			end

			break
		end

		ancestor = ancestor.Parent
	end

	if cache and not cache.index then
		cache.index = buildBindingIndex(rig)
	end

	local index = cache and cache.index or buildBindingIndex(rig)
	return index.paths[object]
end

function Storage.writeRig(entry, rig, order)
	rig = require("rig").original(rig)
	CameraRig.write(entry, rig)
	reference(entry, "Rig", rig)
	entry:SetAttribute("RigId", identity(rig))
	entry:SetAttribute("RigName", rig.Name)
	entry:SetAttribute("RigClass", rig.ClassName)
	entry:SetAttribute("Order", order)
	local path = pathFrom(workspace, rig)
	if path then
		entry:SetAttribute("RigPath", HttpService:JSONEncode(path))
	end

	local gamePath = pathFrom(game, rig)
	if gamePath then
		entry:SetAttribute("RigGamePath", HttpService:JSONEncode(gamePath))
	end
end

function Storage.resolveRigs(folder, scope)
	scope = scope or workspace
	local entries = folder:GetChildren()
	table.sort(entries, function(a, b)
		local first, second =
			finite(a:GetAttribute("Order"), math.huge), finite(b:GetAttribute("Order"), math.huge)
		if first ~= second then
			return first < second
		end

		return a.Name < b.Name
	end)
	local models

	local function candidates()
		if models then
			return models
		end

		models = {}

		local function visit(object)
			if object:IsA("Model") or object:IsA("BasePart") or #Properties.catalog(object) > 0 then
				table.insert(models, object)
			end

			for _, child in object:GetChildren() do
				if traversable(child) then
					visit(child)
				end
			end
		end

		visit(scope)
		return models
	end

	local results, used = {}, {}
	for _, entry in entries do
		local rig = referenced(entry, "Rig")
		local camera = entry:GetAttribute("EclipseCamera") == true
		local savedId = entry:GetAttribute("RigId")

		local function matchingCamera(candidate)
			return not camera
				or CameraRig.isRig(candidate)
					and (not savedId or candidate:GetAttribute(ID) == savedId)
		end

		if rig and not matchingCamera(rig) then
			rig = nil
		end

		if (not rig or not rig.Parent) and scope == workspace then
			local found = follow(game, entry:GetAttribute("RigGamePath"))
			if
				found
				and found.ClassName == entry:GetAttribute("RigClass")
				and matchingCamera(found)
			then
				rig = found
			end
		end

		if not rig or not rig.Parent then
			rig = nil
			local id, name =
				entry:GetAttribute("RigId"), entry:GetAttribute("RigName") or entry.Name
			local class = entry:GetAttribute("RigClass")
			local byId, byName = {}, {}
			for _, candidate in candidates() do
				if not matchingCamera(candidate) then
					continue
				end

				if id and candidate:GetAttribute(ID) == id then
					table.insert(byId, candidate)
				end

				if candidate.Name == name and (not class or candidate.ClassName == class) then
					table.insert(byName, candidate)
				end
			end

			if #byId == 1 then
				rig = byId[1]
			else
				local atPath = follow(scope, entry:GetAttribute("RigPath"))
				if atPath and table.find(#byId > 0 and byId or byName, atPath) then
					rig = atPath
				elseif #byId == 0 and #byName == 1 then
					rig = byName[1]
				end
			end
		end

		if not rig then
			rig = CameraRig.restore(entry, scope)
		end

		if rig and used[rig] then
			rig = nil
		end

		if rig then
			used[rig] = true
			if CameraRig.isRig(rig) and entry:GetAttribute("EclipseCamera") == true then
				rig:SetAttribute(
					"EclipseOrthographic",
					entry:GetAttribute("CameraOrthographic") == true
				)
				local project = folder.Parent
				CameraRig.organize(
					rig,
					project and project:GetAttribute("EclipseSave") and project.Name or nil,
					scope
				)
			end
		end

		table.insert(results, { entry = entry, rig = rig })
	end

	return results
end

local function findRig(object, natural, rigs, indexes)
	local entry = natural[object]
	if entry and entry.rig and table.find(rigs, entry.rig) then
		return entry.rig
	end

	for _, rig in rigs do
		if indexes[rig].members[object] then
			return rig
		end
	end

	return nil
end

local function writeReference(entry, name, key, context)
	if typeof(key) == "Instance" and key:GetAttribute("EclipseNavigationOrigin") == true then
		entry:SetAttribute(name .. "Kind", "Origin")
		return
	end

	if key == nil or key == false then
		entry:SetAttribute(name .. "Kind", "Root")
		return
	end

	if typeof(key) == "string" then
		entry:SetAttribute(name .. "Kind", "Folder")
		entry:SetAttribute(name .. "Id", key)
		return
	end

	local rig = findRig(key, context.natural, context.rigs, context.indexes)
	if not rig then
		entry:SetAttribute(name .. "Kind", "Root")
		return
	end

	entry:SetAttribute(name .. "Kind", "Instance")
	reference(entry, name, key)
	reference(entry, name .. "Rig", rig)
	entry:SetAttribute(name .. "ObjectId", identity(key, context.used))
	entry:SetAttribute(name .. "RigId", identity(rig, context.used))
	entry:SetAttribute(name .. "RigName", rig.Name)
	local path = context.indexes[rig].paths[key]
	if path then
		entry:SetAttribute(name .. "Path", HttpService:JSONEncode(path))
	end
end

function Storage.write(container, snapshot, natural, rigs, singleRig)
	rigs = rigs or {}
	local context = { natural = natural, rigs = rigs, indexes = {}, used = {} }
	for _, rig in rigs do
		identity(rig, context.used)
	end

	for key in natural do
		if table.find(rigs, natural[key].rig) then
			identity(key, context.used)
		end
	end

	for _, rig in rigs do
		context.indexes[rig] = buildBindingIndex(rig)
	end

	local root = Instance.new("Folder")
	root.Name = NAME
	root:SetAttribute("Version", 2)
	root:SetAttribute("NextNumber", snapshot.nextNumber)
	if singleRig then
		root:SetAttribute("SingleRigId", identity(singleRig, context.used))
	end

	local ok, message = xpcall(function()
		for id, folder in snapshot.folders do
			local entry = Instance.new("Folder")
			entry.Name = id
			entry:SetAttribute("Kind", "Folder")
			entry:SetAttribute("Title", folder.name)
			entry:SetAttribute("Enabled", folder.enabled ~= false)
			local placement = snapshot.placements[id] or {}
			entry:SetAttribute("Order", finite(placement.order, 2147483647))
			writeReference(entry, "Parent", placement.parent, context)
			entry.Parent = root
		end

		local armatureIndex = 0
		for arm, initialized in snapshot.collectionArmatures or {} do
			if
				initialized
				and typeof(arm) == "Instance"
				and arm.Parent
				and arm:GetAttribute("EclipseArmature")
				and findRig(arm, natural, rigs, context.indexes)
			then
				armatureIndex += 1
				local entry = Instance.new("Folder")
				entry.Name = "ArmatureCollections" .. armatureIndex
				entry:SetAttribute("Kind", "ArmatureCollections")
				entry:SetAttribute("ArmatureKey", arm:GetAttribute("EclipseArmatureKey"))
				writeReference(entry, "Target", arm, context)
				entry.Parent = root
			end
		end

		for id, collection in snapshot.collections or {} do
			local entry = Instance.new("Folder")
			entry.Name = id
			entry:SetAttribute("Kind", "BoneCollection")
			entry:SetAttribute("Title", collection.name)
			entry:SetAttribute("Visible", collection.visible ~= false)
			local count = 0
			for part in collection.members do
				if
					typeof(part) == "Instance"
					and part.Parent
					and findRig(part, natural, rigs, context.indexes)
				then
					count += 1
					local member = Instance.new("Folder")
					member.Name = "Member" .. count
					writeReference(member, "Target", part, context)
					member.Parent = entry
				end
			end

			if not singleRig or count > 0 or not next(collection.members) then
				entry.Parent = root
			else
				entry:Destroy()
			end
		end

		local keys = {}
		for key in snapshot.placements do
			if typeof(key) == "Instance" then
				keys[key] = true
			end
		end

		for key in snapshot.enabled do
			if typeof(key) == "Instance" then
				keys[key] = true
			end
		end

		for key in snapshot.removed or {} do
			if typeof(key) == "Instance" then
				keys[key] = true
			end
		end

		for _, field in { "hiddenBones", "partWidgets" } do
			for key in snapshot[field] or {} do
				keys[key] = true
			end
		end

		local index = 0
		for key in keys do
			if
				not key:GetAttribute("EclipseNavigationOrigin")
				and not findRig(key, natural, rigs, context.indexes)
			then
				continue
			end

			index += 1
			local entry = Instance.new("Folder")
			entry.Name = "Item" .. index
			entry:SetAttribute("Kind", "Item")
			for _, field in { "hiddenBones", "partWidgets" } do
				if snapshot[field] and snapshot[field][key] then
					entry:SetAttribute(field, true)
				end
			end

			entry:SetAttribute("Removed", snapshot.removed and snapshot.removed[key] or nil)
			writeReference(entry, "Target", key, context)
			local placement = snapshot.placements[key]
			if placement then
				entry:SetAttribute("Placed", true)
				entry:SetAttribute("Order", finite(placement.order, 2147483647))
				writeReference(entry, "Parent", placement.parent, context)
			end

			if snapshot.enabled[key] ~= nil then
				entry:SetAttribute("Enabled", snapshot.enabled[key])
			end

			entry.Parent = root
		end
	end, debug.traceback)
	if not ok then
		root:Destroy()
		error(message)
	end

	local previous = container:FindFirstChild(NAME)
	root.Parent = container
	if previous then
		previous:Destroy()
	end

	return root
end

local function readReference(entry, name, context)
	local kind = entry:GetAttribute(name .. "Kind")
	if kind == "Origin" then
		return require("Origin").ensure()
	end

	if kind == "Root" then
		return false
	end

	if kind == "Folder" then
		return entry:GetAttribute(name .. "Id")
	end

	if kind ~= "Instance" then
		return nil
	end

	local object = referenced(entry, name)
	if object and object.Parent then
		for _, rig in context.rigs do
			if context.indexes[rig].members[object] then
				return object
			end
		end
	end

	local rig = referenced(entry, name .. "Rig")
	if not table.find(context.rigs, rig) then
		rig = nil
		local id = entry:GetAttribute(name .. "RigId")
		if id and id == context.singleId and #context.rigs == 1 then
			rig = context.rigs[1]
		else
			local exact, named = {}, {}
			for _, candidate in context.rigs do
				if id and candidate:GetAttribute(ID) == id then
					table.insert(exact, candidate)
				end

				if candidate.Name == entry:GetAttribute(name .. "RigName") then
					table.insert(named, candidate)
				end
			end

			if #exact == 1 then
				rig = exact[1]
			elseif #exact == 0 and #named == 1 then
				rig = named[1]
			end
		end
	end

	if not rig then
		return nil
	end

	local id = entry:GetAttribute(name .. "ObjectId")
	local exact = id and context.indexes[rig].ids[id]
	if exact then
		return exact
	end

	local found = follow(rig, entry:GetAttribute(name .. "Path"))
	if not found or not context.indexes[rig].members[found] then
		return nil
	end

	local currentId = found:GetAttribute(ID)
	local sourceRigId = entry:GetAttribute(name .. "RigId")
	local retargeted = context.singleId ~= nil
		or sourceRigId ~= nil and rig:GetAttribute(ID) ~= sourceRigId
	if id and currentId and currentId ~= id and not retargeted and not Properties.owner(found) then
		return nil
	end

	return found
end

function Storage.read(container, rigs)
	local root = container and container:FindFirstChild(NAME)
	if not root or not root:IsA("Folder") then
		return nil
	end

	local version = root:GetAttribute("Version")
	if version ~= 1 and version ~= 2 then
		return nil
	end

	rigs = rigs or {}
	local context = { rigs = rigs, indexes = {}, singleId = root:GetAttribute("SingleRigId") }
	for _, rig in rigs do
		context.indexes[rig] = buildBindingIndex(rig)
	end

	local snapshot = {
		folders = {},
		placements = {},
		enabled = {},
		removed = {},
		collections = {},
		collectionArmatures = {},
		hiddenBones = {},
		partWidgets = {},
		nextNumber = 1,
	}
	snapshot.nextNumber = math.max(1, math.floor(finite(root:GetAttribute("NextNumber"), 1)))
	local entries = root:GetChildren()
	for _, entry in entries do
		if entry:IsA("Folder") and entry:GetAttribute("Kind") == "ArmatureCollections" then
			local arm = readReference(entry, "Target", context)
			local key = entry:GetAttribute("ArmatureKey")
			if
				typeof(arm) == "Instance"
				and arm:GetAttribute("EclipseArmature")
				and (key == nil or key == arm:GetAttribute("EclipseArmatureKey"))
			then
				snapshot.collectionArmatures[arm] = true
			end
		end
	end

	for _, entry in entries do
		if
			entry:IsA("Folder")
			and entry:GetAttribute("Kind") == "BoneCollection"
			and type(entry:GetAttribute("Title")) == "string"
		then
			local collection = {
				id = entry.Name,
				name = entry:GetAttribute("Title"),
				visible = entry:GetAttribute("Visible") ~= false,
				members = {},
			}
			for _, member in entry:GetChildren() do
				local part = readReference(member, "Target", context)
				if typeof(part) == "Instance" and (part:IsA("BasePart") or part:IsA("Bone")) then
					collection.members[part] = true
				end
			end

			snapshot.collections[entry.Name] = collection
		end
	end

	for _, entry in entries do
		if entry:IsA("Folder") and entry:GetAttribute("Kind") == "Folder" then
			local name = entry:GetAttribute("Title")
			if typeof(name) == "string" and name ~= "" and not snapshot.folders[entry.Name] then
				snapshot.folders[entry.Name] = {
					id = entry.Name,
					name = name,
					enabled = entry:GetAttribute("Enabled") ~= false,
				}
			end
		end
	end

	for _, entry in entries do
		if not entry:IsA("Folder") then
			continue
		end

		local key = entry:GetAttribute("Kind") == "Folder" and entry.Name
			or readReference(entry, "Target", context)
		if not key or typeof(key) == "string" and not snapshot.folders[key] then
			continue
		end

		if entry:GetAttribute("Kind") == "Folder" or entry:GetAttribute("Placed") then
			local parent = readReference(entry, "Parent", context)
			if typeof(parent) == "string" and not snapshot.folders[parent] then
				parent = false
			end

			snapshot.placements[key] = {
				parent = parent or false,
				order = finite(entry:GetAttribute("Order"), 2147483647),
			}
		end

		if typeof(key) == "Instance" and entry:GetAttribute("Removed") == true then
			snapshot.removed[key] = true
		end

		if typeof(key) == "Instance" then
			for _, field in { "hiddenBones", "partWidgets" } do
				if entry:GetAttribute(field) == true then
					snapshot[field][key] = true
				end
			end
		end

		if typeof(key) == "Instance" and typeof(entry:GetAttribute("Enabled")) == "boolean" then
			snapshot.enabled[key] = entry:GetAttribute("Enabled")
		end
	end

	for key, placement in snapshot.placements do
		local parent, seen = placement.parent, { [key] = true }
		while parent and snapshot.placements[parent] do
			if seen[parent] then
				placement.parent = false
				break
			end

			seen[parent] = true
			parent = snapshot.placements[parent].parent
		end
	end

	return snapshot
end

return Storage
