            <string name="ScriptGuid">{D2175C03-C282-432A-B474-D45283864DDA}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local DockHost = require("DockHost")

local RunService = game:GetService("RunService")
local Input = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Organization = require("Organization")
local CameraRig = require("CameraRig")
local CameraTarget = require("Target")
local Visibility = require("Visibility")
local Selection = game:GetService("Selection")
local Scene = require("Environment")
local Chrome = require("Chrome")
local Surface = require("Surface")
local Sizeable = require("SizeableWindows")
local FX = require("WindowFX")
local Theme = require("Theme")
local Data = require("ProjectData")
local Preferences = require("Preferences")
local Preview = {}
local ViewRotate = require("ViewRotate")
local viewRotate
local refs, window, scene, screenGrid, previewGrid, field, fovLabel, gridButton, empty, viewport, title
local docked, docking, widgetFocused = false, false, false
local widgetConnections = {}
local widget, floatingGui, floating, dockLabel
local linked, grid, static, mainGrid = true, false, 70, false
local fitted, fitLabel, full = false, nil, nil
local opening, dockRequest = false, nil
local currentCamera, observedSelection, navigation
local retiring = {}
local accessoryButton
local accessoryViews = setmetatable({}, { __mode = "k" })

local function accessoryView(rig)
	if not rig then
		return nil
	end

	local attachment = CameraTarget.attachmentObject(rig)
	local state = accessoryViews[rig]
	if not state or state.attachment ~= attachment then
		state =
			{ attachment = attachment, hidden = attachment ~= nil and attachment.Name == "Head" }
		accessoryViews[rig] = state
	end

	return state
end

local updateView

function Preview.toggleAccessories()
	local state = accessoryView(Preview.target(Preview.cameras()))
	if state then
		state.hidden = not state.hidden
		updateView()
	end
end

local previewGate, previewMatte
local authoredPreviewFov = 70
local previewElapsed = math.huge
local previewPlaying = false
local titleState = {}

local function make(class, parent, name, properties)
	local object = Instance.new(class)

	object.Name = name
	for key, value in properties do
		object[key] = value
	end

	object.Parent = parent
	return object
end

local gridKinds =
	{ "Thirds", "Golden Ratio", "Golden Spiral", "Triangles", "Center", "Custom Image" }
local composition =
	{ kind = "Thirds", opacity = 0.55, thickness = 2, rotation = 0, image = "", fit = true }
local compositionProfiles = {}
local compositionViews = {}
local compositionOwned = {}
local compositionWindow
local compositionGeneration = 0

local function finite(value, fallback, low, high)
	local n = tonumber(value)
	if not n or n ~= n or math.abs(n) == math.huge then
		return fallback
	end

	return math.clamp(n, low, high)
end

local function normalizeComposition(value)
	value = type(value) == "table" and value or {}
	return {
		kind = table.find(gridKinds, value.kind) and value.kind or "Thirds",
		opacity = finite(value.opacity, 0.55, 0, 1),
		thickness = finite(value.thickness, 2, 1, 6),
		rotation = math.floor(finite(value.rotation, 0, 0, 359) / 90 + 0.5) % 4 * 90,
		image = require("Sequence").asset(value.image) or "",
		fit = value.fit ~= false,
		profile = type(value.profile) == "string" and value.profile or nil,
	}
end

local function readCompositionSetting(key, fallback)
	local ok, value = pcall(Data.getSetting, key)
	if ok and type(value) == "string" then
		ok, value = pcall(game.HttpService.JSONDecode, game.HttpService, value)
	end

	return ok and type(value) == "table" and value or fallback
end

local function saveComposition()
	Data.setSetting("EclipseCompositionGridV1", game.HttpService:JSONEncode(composition))
	for _, refresh in compositionViews do
		refresh()
	end
end

function Preview.composition()
	return table.clone(composition)
end

function Preview.compositionPresets()
	local result = {}
	for _, entry in compositionProfiles do
		table.insert(result, { name = entry.name, config = table.clone(entry.config) })
	end

	return result
end

function Preview.setComposition(value)
	local nextValue = normalizeComposition(value)
	if nextValue.kind == "Custom Image" and nextValue.image == "" then
		return false, "Paste an image asset ID or choose a recent image."
	end

	local old = composition
	composition = nextValue
	local ok, err = pcall(saveComposition)
	if not ok then
		composition = old
		return false, tostring(err)
	end

	return true
end

function Preview.saveCompositionPreset(name)
	name = tostring(name or ""):match("^%s*(.-)%s*$"):sub(1, 80)
	if name == "" then
		return false, "Give the preset a name."
	end

	local nextProfiles = table.clone(compositionProfiles)
	local found
	for index, entry in nextProfiles do
		if entry.name == name then
			found = index
			break
		end
	end

	if not found and #nextProfiles >= 20 then
		return false, "You can save up to 20 grid presets."
	end

	local config = table.clone(composition)
	config.profile = name
	nextProfiles[found or #nextProfiles + 1] = { name = name, config = config }
	local ok, err = pcall(
		Data.setSetting,
		"EclipseCompositionPresetsV1",
		game.HttpService:JSONEncode(nextProfiles)
	)
	if not ok then
		return false, tostring(err)
	end

	compositionProfiles = nextProfiles
	return true
end

function Preview.deleteCompositionPreset(name)
	local profiles = {}
	for _, entry in compositionProfiles do
		if entry.name ~= name then
			table.insert(profiles, entry)
		end
	end

	local ok, err =
		pcall(Data.setSetting, "EclipseCompositionPresetsV1", game.HttpService:JSONEncode(profiles))
	if not ok then
		return false, tostring(err)
	end

	compositionProfiles = profiles
	return true
end

function Preview.cycleComposition()
	local choices = {}
	for _, kind in gridKinds do
		if kind ~= "Custom Image" then
			local c = table.clone(composition)
			c.kind = kind
			c.profile = nil
			table.insert(choices, c)
		end
	end

	for _, entry in compositionProfiles do
		local c = table.clone(entry.config)
		c.profile = entry.name
		table.insert(choices, c)
	end

	local current = 0
	for i, value in choices do
		if
			composition.profile and composition.profile == value.profile
			or not composition.profile and not value.profile and composition.kind == value.kind
		then
			current = i
			break
		end
	end

	return Preview.setComposition(choices[current % #choices + 1])
end

function Preview.rotateComposition()
	local value = table.clone(composition)
	value.rotation = (value.rotation + 90) % 360
	value.profile = nil
	return Preview.setComposition(value)
end

function Preview.compositionSegments(kind, size)
	local result = {}

	local function line(x, y, u, v)
		table.insert(result, { Vector2.new(x, y), Vector2.new(u, v) })
	end

	if kind == "Thirds" or kind == "Golden Ratio" then
		local n = kind == "Thirds" and 1 / 3 or (3 - math.sqrt(5)) / 2
		for _, at in { n, 1 - n } do
			line(at, 0, at, 1)
			line(0, at, 1, at)
		end
	elseif kind == "Center" then
		line(0.5, 0, 0.5, 1)
		line(0, 0.5, 1, 0.5)
	elseif kind == "Triangles" then
		line(0, 1, 1, 0)
		line(0, 0, 0.5, 0.5)
		line(0.5, 0.5, 1, 1)
	elseif kind == "Golden Spiral" then
		local previous
		local factor = math.min(size.X, size.Y) * 0.46
		local phi = (1 + math.sqrt(5)) / 2
		for i = 0, 96 do
			local angle = -math.pi * 4 + i / 96 * math.pi * 4
			local radius = factor * math.exp(math.log(phi) / (math.pi / 2) * angle)
			local point = Vector2.new(
				0.5 + radius * math.cos(angle) / math.max(size.X, 1),
				0.5 + radius * math.sin(angle) / math.max(size.Y, 1)
			)
			if previous then
				table.insert(result, { previous, point })
			end

			previous = point
		end
	end

	return result
end

function Preview.closeGridSettings()
	compositionGeneration += 1
	if compositionWindow then
		local view = compositionWindow
		compositionWindow = nil
		view:close(true)
	end

	for gui in compositionOwned do
		gui:Destroy()
	end

	table.clear(compositionOwned)
end

function Preview.toggleGridSettings()
	if compositionWindow then
		Preview.closeGridSettings()
		return
	end

	if not refs then
		return
	end

	local Tool = require("Tool")
	local recent = require("ImageLibrary")
	local draft = Preview.composition()
	local recentIndex = 0
	local view = Tool.new(
		refs,
		"EclipseGridSettings",
		"GRID SETTINGS",
		Vector2.new(430, 324),
		true,

		function()
			compositionGeneration += 1
			compositionWindow = nil
		end
	)
	compositionWindow = view
	compositionOwned[view.gui] = true
	view.gui.Destroying:Once(function()
		compositionOwned[view.gui] = nil
	end)
	local apply

	local function report(message)
		require("Notification").show("GRID SETTINGS", message)
	end

	local kind, kindLabel
	local choices
	kind, kindLabel = Tool.button(
		view.frame,
		"Guide",
		draft.kind .. "  \u{25be}",
		UDim2.fromOffset(12, 42),
		UDim2.new(1, -24, 0, 27),

		function()
			choices.Visible = not choices.Visible
		end
	)
	choices = Tool.make("Frame", view.frame, "GuideChoices", {
		Visible = false,
		Position = UDim2.fromOffset(12, 71),
		Size = UDim2.new(1, -24, 0, #gridKinds * 28 + 4),
		BorderSizePixel = 0,
		ZIndex = 100,
		Active = true,
	})
	choices:SetAttribute("ThemeBg", "TopBtn")
	for index, value in gridKinds do
		Tool.button(
			choices,
			"Guide" .. index,
			value,
			UDim2.fromOffset(2, 2 + (index - 1) * 28),
			UDim2.new(1, -4, 0, 26),

			function()
				draft.kind = value
				kindLabel.Text = value .. "  \u{25be}"
				choices.Visible = false
				apply(false)
			end
		)
	end

	table.insert(
		view.connections,
		game:GetService("UserInputService").InputBegan:Connect(function(input)
			if not choices.Visible then
				return
			end

			if input.KeyCode == Enum.KeyCode.Escape then
				choices.Visible = false
			elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
				local function inside(object)
					local p, s = object.AbsolutePosition, object.AbsoluteSize
					local point = input.Position
					return point.X >= p.X
						and point.Y >= p.Y
						and point.X <= p.X + s.X
						and point.Y <= p.Y + s.Y
				end

				if not inside(kind) and not inside(choices) then
					choices.Visible = false
				end
			end
		end)
	)
	local asset = Tool.field(
		view.frame,
		"ImageAsset",
		draft.image,
		UDim2.fromOffset(12, 78),
		UDim2.new(1, -182, 0, 25)
	)
	asset.PlaceholderText = "Image asset ID"

	local function selectImage(id)
		if id then
			draft.kind = "Custom Image"
			draft.image = id
			asset.Text = id
			kindLabel.Text = draft.kind .. "  \u{25be}"
			apply(false)
		end
	end

	Tool.button(
		view.frame,
		"Recent",
		"RECENT",
		UDim2.new(1, -162, 0, 77),
		UDim2.fromOffset(72, 27),

		function()
			local images = recent.recent()
			if #images == 0 then
				report("No recent images. Paste an ID or upload an image.")
				return
			end

			recentIndex = recentIndex % #images + 1
			selectImage(images[recentIndex].id)
		end
	)
	local busy = false
	Tool.button(view.frame, "Upload", "UPLOAD", UDim2.new(1, -84, 0, 77), UDim2.fromOffset(72, 27), function()
		if busy then
			return
		end

		busy = true
		local token = compositionGeneration
		task.spawn(function()
			local ok, id, message = pcall(require("Upload").prompt)
			busy = false
			if token ~= compositionGeneration or view.closed then
				return
			end

			if ok and id then
				selectImage(id)
			else
				report(tostring(ok and message or id or "Upload cancelled."))
			end
		end)
	end
)
	Tool.label(
		view.frame,
		"OpacityLabel",
		"Opacity %",
		UDim2.fromOffset(12, 115),
		UDim2.fromOffset(86, 25)
	)
	local opacity = Tool.field(
		view.frame,
		"Opacity",
		math.round(draft.opacity * 100),
		UDim2.fromOffset(100, 115),
		UDim2.fromOffset(60, 25)
	)
	Tool.label(
		view.frame,
		"ThicknessLabel",
		"Width",
		UDim2.fromOffset(178, 115),
		UDim2.fromOffset(48, 25)
	)
	local thickness = Tool.field(
		view.frame,
		"Thickness",
		draft.thickness,
		UDim2.fromOffset(230, 115),
		UDim2.fromOffset(44, 25)
	)
	local rotation, rotationLabel
	rotation, rotationLabel = Tool.button(
		view.frame,
		"Rotate",
		draft.rotation .. "\u{b0}",
		UDim2.fromOffset(292, 114),
		UDim2.fromOffset(56, 27),

		function()
			draft.rotation = (draft.rotation + 90) % 360
			rotationLabel.Text = draft.rotation .. "\u{b0}"
			apply(false)
		end
	)
	local fit, fitLabel
	fit, fitLabel = Tool.button(
		view.frame,
		"Fit",
		draft.fit and "FIT" or "FILL",
		UDim2.fromOffset(354, 114),
		UDim2.fromOffset(64, 27),

		function()
			draft.fit = not draft.fit
			fitLabel.Text = draft.fit and "FIT" or "FILL"
			apply(false)
		end
	)
	local name = Tool.field(
		view.frame,
		"PresetName",
		"",
		UDim2.fromOffset(12, 154),
		UDim2.new(1, -178, 0, 25)
	)
	name.PlaceholderText = "Preset name"
	local list = Tool.make("ScrollingFrame", view.frame, "Presets", {
		Position = UDim2.fromOffset(12, 190),
		Size = UDim2.new(1, -24, 0, 96),
		CanvasSize = UDim2.new(),
		BackgroundTransparency = 0,
		BorderSizePixel = 1,
		ScrollBarThickness = 4,
	})
	list:SetAttribute("ThemeBg", "TopBtn")
	list:SetAttribute("ThemeBorder", "Strk")
	list.BorderColor3 = Theme.get("Strk", Color3.fromRGB(74, 116, 124))

	local function showDraft(value)
		draft = table.clone(value)
		kindLabel.Text = draft.kind .. "  \u{25be}"
		asset.Text = draft.image
		opacity.Text = tostring(math.round(draft.opacity * 100))
		thickness.Text = tostring(draft.thickness)
		rotationLabel.Text = draft.rotation .. "\u{b0}"
		fitLabel.Text = draft.fit and "FIT" or "FILL"
	end

	local function refresh()
		for _, child in list:GetChildren() do
			child:Destroy()
		end

		for index, entry in Preview.compositionPresets() do
			Tool.button(
				list,
				entry.name,
				entry.name,
				UDim2.fromOffset(0, (index - 1) * 29),
				UDim2.new(1, -6, 0, 25),

				function()
					name.Text = entry.name
					showDraft(entry.config)
					apply(false)
				end
			)
		end

		list.CanvasSize = UDim2.fromOffset(0, #compositionProfiles * 29)
	end

	apply = function(save)
		compositionGeneration += 1
		local token = compositionGeneration
		draft.image = asset.Text
		draft.opacity = finite(opacity.Text, 55, 0, 100) / 100
		draft.thickness = finite(thickness.Text, 2, 1, 6)
		draft.profile = nil
		local nextValue = normalizeComposition(draft)
		if nextValue.kind == "Custom Image" and nextValue.image == "" then
			report("Paste an image asset ID first.")
			return
		end

		task.spawn(function()
			local image, worker
			local loaded = true
			if nextValue.kind == "Custom Image" then
				loaded = false
				image = Instance.new("ImageLabel")
				image.Image = nextValue.image
				local settled = false
				worker = task.spawn(function()
					pcall(function()
						game:GetService("ContentProvider")
							:PreloadAsync({ image }, function(_, fetch)
								loaded = fetch == Enum.AssetFetchStatus.Success
							end)
					end)
					loaded = loaded or image.IsLoaded
					settled = true
				end)
				local untilTime = os.clock() + 10
				while not settled and token == compositionGeneration and os.clock() < untilTime do
					task.wait(0.03)
				end

				if not settled then
					pcall(task.cancel, worker)
				end

				image:Destroy()
			end

			if token ~= compositionGeneration or view.closed then
				return
			end

			if not loaded then
				report("Image could not load. The previous grid is unchanged.")
				return
			end

			local ok, message = Preview.setComposition(nextValue)
			if ok and nextValue.kind == "Custom Image" then
				recent.add(
					nextValue.image,
					{ name = name.Text ~= "" and name.Text or "Composition grid" }
				)
			end

			if ok and save then
				ok, message = Preview.saveCompositionPreset(name.Text)
				refresh()
			end

			if not ok then
				report(tostring(message))
			end
		end)
	end

	Tool.button(view.frame, "Save", "SAVE", UDim2.new(1, -158, 0, 153), UDim2.fromOffset(68, 27), function()
		apply(true)
	end
)
	Tool.button(
		view.frame,
		"Delete",
		"DELETE",
		UDim2.new(1, -84, 0, 153),
		UDim2.fromOffset(72, 27),

		function()
			local ok, message = Preview.deleteCompositionPreset(name.Text)
			if not ok then
				report(tostring(message))
			end

			refresh()
		end
	)
	local shortcuts = require("Shortcuts")
	Tool.label(
		view.frame,
		"Shortcuts",
		shortcuts.format("ToggleCameraGrid")
			.. ": toggle   "
			.. shortcuts.format("CycleCameraGrid")
			.. ": next guide   "
			.. shortcuts.format("RotateCameraGrid")
			.. ": rotate",
		UDim2.fromOffset(12, 292),
		UDim2.new(1, -24, 0, 30)
	)
	for _, field in { asset, opacity, thickness } do
		table.insert(
			view.connections,
			require("NumericInput").connect(field, {
				step = 1,
				enabled = function()
					return field ~= asset
				end,
			}, function()
				apply(false)
			end)
		)
	end

	refresh()
	Theme.applyTree(view.frame)
	return view.frame
end

function Preview.grid(parent, name, z)
	local frame = make("Frame", parent, name, {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = z,
		Active = false,
		Interactable = false,
		ClipsDescendants = true,
	})
	local image = make("ImageLabel", frame, "CustomGrid", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = z,
		Active = false,
		Interactable = false,
	})
	local lines = {}

	local function layout()
		local size = frame.AbsoluteSize
		if size.X < 1 or size.Y < 1 then
			return
		end

		local custom = composition.kind == "Custom Image"
		image.Visible = custom
		image.Image = composition.image
		image.ImageTransparency = 1 - composition.opacity
		image.ScaleType = composition.fit and Enum.ScaleType.Fit or Enum.ScaleType.Stretch
		image.Rotation = composition.rotation
		image.Size = composition.rotation % 180 == 90
				and UDim2.fromScale(size.Y / size.X, size.X / size.Y)
			or UDim2.fromScale(1, 1)
		local segmentSize = composition.rotation % 180 == 90 and Vector2.new(size.Y, size.X) or size
		local segments = Preview.compositionSegments(composition.kind, segmentSize)
		local angle = math.rad(composition.rotation)
		local c, s = math.cos(angle), math.sin(angle)

		local function rotate(point)
			local p = point - Vector2.new(0.5, 0.5)
			return Vector2.new(p.X * c - p.Y * s + 0.5, p.X * s + p.Y * c + 0.5) * size
		end

		local color = Theme.get("Txt", Color3.fromRGB(225, 243, 238))
		for i, segment in segments do
			local line = lines[i]
			if not line then
				line = make("Frame", frame, "Guide" .. i, {
					AnchorPoint = Vector2.new(0.5, 0.5),
					BorderSizePixel = 0,
					ZIndex = z,
					Active = false,
					Interactable = false,
				})
				lines[i] = line
			end

			local a, b = rotate(segment[1]), rotate(segment[2])
			local delta = b - a
			local middle = (a + b) * 0.5
			line.Position = UDim2.fromScale(middle.X / size.X, middle.Y / size.Y)
			line.Size = UDim2.fromScale(delta.Magnitude / size.X, composition.thickness / size.Y)
			line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
			line.BackgroundTransparency = 1 - composition.opacity
			line.BackgroundColor3 = color
			line.Visible = true
		end

		for i = #segments + 1, #lines do
			lines[i].Visible = false
		end
	end

	compositionViews[frame] = layout
	local resized = frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
	local themed = Theme.onChanged(layout)
	frame.Destroying:Once(function()
		resized:Disconnect()
		themed()
		compositionViews[frame] = nil
	end)
	layout()
	return frame
end

function Preview.cameras(includeDisabled)
	local cameras, seen = {}, {}
	if not refs then
		return cameras
	end

	for _, rig in refs.State.getAllRigs() do
		if
			rig.Parent
			and not seen[rig]
			and CameraRig.isRig(rig)
			and (includeDisabled or Organization.isEnabled(rig))
		then
			seen[rig] = true
			table.insert(cameras, rig)
		end
	end

	return cameras
end

local function selectedCamera()
	local rig = refs and refs.State.Rig
	local item = rig and rig._lastClickedItem
	return item and CameraRig.owner(item.linkedRigInstance)
end

function Preview.target(cameras)
	cameras = cameras or Preview.cameras()
	local candidate = selectedCamera()
	if candidate ~= observedSelection then
		observedSelection = candidate
		if not full and table.find(cameras, candidate) then
			currentCamera = candidate
		end
	end

	if not table.find(cameras, currentCamera) then
		currentCamera = table.find(cameras, candidate) and candidate or cameras[1]
	end

	return currentCamera
end

function Preview.select(rig)
	local cameras = Preview.cameras()
	if not table.find(cameras, rig) then
		return false
	end

	currentCamera, observedSelection = rig, selectedCamera()
	if full then
		if viewRotate then
			viewRotate.finish(not viewRotate.isFlying())
		end

		if refs and refs.State.CameraControls then
			refs.State.CameraControls.finish(true)
		end

		if not full.view.setRig(rig) then
			Preview.exitFull()
			return false
		end

		full.rig = rig
		if
			not full.view.step(
				(linked or refs.State.CameraControls and refs.State.CameraControls.isEditing())
						and CameraRig.fov(rig)
					or static
			)
		then
			Preview.exitFull()
			return false
		end
	end

	if updateView then
		updateView(cameras)
	end

	return true
end

function Preview.navigate(direction)
	local cameras = Preview.cameras()
	if #cameras == 0 then
		return false
	end

	local index = table.find(cameras, Preview.target(cameras)) or 1
	local step = direction < 0 and -1 or 1
	return Preview.select(cameras[(index - 1 + step) % #cameras + 1])
end

function Preview.subtitleSurface()
	return Preview.isOpen() and previewGate or nil
end

function Preview.isOpen()
	if not window or not window.Parent then
		return false
	end

	if refs.State.PresentationHidden or docking or opening then
		return true
	end

	return window.Visible
		and (
			docked and widget ~= nil and widget.Enabled
			or not docked and floatingGui ~= nil and floatingGui.Enabled
		)
end

function Preview.hasFocus()
	if refs and refs.State.PresentationHidden then
		return false
	end

	if not Preview.isOpen() then
		return false
	end

	if docked then
		return widgetFocused
	end

	local point, p, size = Input:GetMouseLocation(), window.AbsolutePosition, window.AbsoluteSize
	return point.X >= p.X and point.Y >= p.Y and point.X <= p.X + size.X and point.Y <= p.Y + size.Y
end

function Preview.toggleGrid()
	grid = not grid
	Data.setSetting("CameraPreviewGrid", grid)
	if gridButton then
		gridButton:SetAttribute("Selected", grid)
	end

	return grid
end

function Preview.mainGridEnabled()
	return mainGrid
end

function Preview.toggleMainGrid()
	mainGrid = not mainGrid
	Data.setSetting("CameraMainGrid", mainGrid)
	return mainGrid
end

function Preview.setLinked(enabled)
	linked = enabled == true
	Data.setSetting("CameraPreviewLinkedFOV", linked)
end

function Preview.setStatic(value)
	static = CameraRig.clamp(value)
	Data.setSetting("CameraPreviewStaticFOV", static)
end

function Preview.isDocked()
	return docked
end

function Preview.setDocked(enabled)
	if not window or docking or docked == enabled then
		return false
	end

	local frame = window
	local request = {}
	dockRequest, docking = request, true
	if enabled and not widget then
		if not refs.Plugin then
			dockRequest, docking = nil, false
			return false
		end

		local ok, created = pcall(function()
			return DockHost.acquire(
				refs.Plugin,
				"EclipseAnimatorCameraPreview",
				DockWidgetPluginGuiInfo.new(
					Enum.InitialDockState.Right,
					true,
					true,
					560,
					390,
					460,
					230
				)
			)
		end)
		if dockRequest ~= request or window ~= frame then
			if ok then
				DockHost.release(created)
			end

			return false
		end

		if not ok then
			dockRequest, docking = nil, false
			return false
		end

		widget = created
		widget.Title = "Eclipse Camera Preview"
		widget.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		table.insert(
			widgetConnections,
			widget.WindowFocused:Connect(function()
				if widget == created then
					widgetFocused = true
				end
			end)
		)
		table.insert(
			widgetConnections,
			widget.WindowFocusReleased:Connect(function()
				if widget == created then
					widgetFocused = false
				end
			end)
		)
		table.insert(
			widgetConnections,
			widget:GetPropertyChangedSignal("Enabled"):Connect(function()
				if widget ~= created then
					return
				end

				if not created.Enabled then
					widgetFocused = false
					if scene then
						scene.destroy()
						scene = nil
					end
				end

				if refs.State.Timeline then
					refs.State.Timeline:RefreshNavigation()
				end
			end)
		)
	end

	if
		enabled
		and not DockHost.show(widget, function()
			return dockRequest == request and window == frame
		end)
	then
		if dockRequest == request then
			dockRequest, docking = nil, false
			widget.Enabled = false
		end

		return false
	end

	FX.clear(frame)
	local scale = frame:FindFirstChild("EclipseWindowScale")
	if scale then
		scale.Scale = 1
	end

	docked = enabled
	if enabled then
		floating = { position = frame.Position, size = frame.Size }
		frame.Parent, frame.Position, frame.Size =
			widget, UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1, 1)
		widget.Enabled = true
	else
		frame.Parent, frame.Position, frame.Size = floatingGui, floating.position, floating.size
		widget.Enabled, widgetFocused = false, false
	end

	dockLabel.Text = docked and "UNDOCK" or "DOCK"
	for _, child in frame:GetChildren() do
		if string.find(child.Name, "EclipseResizeHandle_", 1, true) == 1 then
			child.Visible = not docked
		end
	end

	Data.setSetting("CameraPreviewDocked", docked)
	dockRequest, docking = nil, false
	return true
end

function Preview.presentationWidget()
	return widget
end

function Preview.close(immediate)
	opening, docking, dockRequest = false, false, nil
	local previous, previousGui, wasDocked = window, floatingGui, docked
	window, floatingGui, dockLabel, fitLabel = nil, nil, nil, nil
	docked, widgetFocused = false, false
	if scene then
		scene.destroy()
		scene = nil
	end

	field, gridButton, previewGrid, viewport = nil, nil, nil, nil
	accessoryButton = nil
	previewGate, previewMatte = nil, nil
	if navigation then
		for _, tween in navigation.tweens do
			tween:Cancel()
		end

		navigation = nil
	end

	if widget then
		widget.Enabled = false
	end

	if previous then
		retiring[previous] = previousGui or true
	end

	local function destroy()
		if previous then
			retiring[previous] = nil
			previous:Destroy()
		end

		if previousGui then
			previousGui:Destroy()
		end
	end

	if previous and not wasDocked and not immediate then
		FX.shrink(previous, destroy)
	else
		destroy()
	end

	if refs and refs.State.Timeline then
		refs.State.Timeline:RefreshNavigation()
	end
end

function Preview.fitSize(width, height)
	if width <= 0 or height <= 0 then
		return UDim2.fromScale(1, 1)
	end

	local ratio = 1920 / 1080
	if width / height > ratio then
		return UDim2.fromScale(height * ratio / width, 1)
	end

	return UDim2.fromScale(1, width / ratio / height)
end

function Preview.frameGeometry(width, height, fov, fit)
	fov = CameraRig.clamp(fov)
	if width <= 0 or height <= 0 or not fit then
		return 1, 1, fov
	end

	local size = Preview.fitSize(width, height)
	local x, y = size.X.Scale * 0.92, size.Y.Scale * 0.92
	local tangent = math.tan(math.rad(fov) * 0.5)
	local minimumHeight = tangent / math.tan(math.rad(120) * 0.5)
	if y < minimumHeight then
		x, y = x * minimumHeight / y, minimumHeight
	end

	return x, y, math.deg(2 * math.atan(tangent / y))
end

local layoutState

local function layoutView()
	if not viewport or not previewGate then
		return authoredPreviewFov
	end

	local size = viewport.Parent.AbsoluteSize
	if
		layoutState
		and layoutState.viewport == viewport
		and layoutState.size == size
		and layoutState.authored == authoredPreviewFov
		and layoutState.fitted == fitted
	then
		return layoutState.fov
	end

	local x, y, fov = Preview.frameGeometry(size.X, size.Y, authoredPreviewFov, fitted)
	layoutState = {
		viewport = viewport,
		size = size,
		authored = authoredPreviewFov,
		fitted = fitted,
		fov = fov,
	}
	previewGate.Size = UDim2.fromScale(x, y)
	local left, top = math.max(0, (1 - x) * 0.5), math.max(0, (1 - y) * 0.5)
	local layouts = {
		{ 0, 0, 1, top },
		{ 0, 1 - top, 1, top },
		{ 0, top, left, 1 - 2 * top },
		{ 1 - left, top, left, 1 - 2 * top },
	}
	for i, rect in layouts do
		previewMatte[i].Position = UDim2.fromScale(rect[1], rect[2])
		previewMatte[i].Size = UDim2.fromScale(rect[3], rect[4])
	end

	if scene then
		scene.camera.FieldOfView = fov
	end

	return fov
end

function Preview.toggleFit()
	fitted = not fitted
	Data.setSetting("CameraPreviewFit", fitted)
	if fitLabel then
		fitLabel.Text = fitted and "UNFIT" or "FIT"
	end

	layoutView()
	return fitted
end

function Preview.isFull()
	return full ~= nil
end

function Preview.isViewRotating()
	return viewRotate ~= nil and viewRotate.isEditing()
		or refs and refs.State.CameraControls and refs.State.CameraControls.isEditing()
end

function Preview.finishViewRotation(cancel)
	if refs and refs.State.CameraControls then
		refs.State.CameraControls.finish(cancel)
	end

	return viewRotate and viewRotate.finish(cancel)
end

function Preview.fullInput(input)
	if not full or not viewRotate then
		return false
	end

	if game:GetService("UserInputService"):GetFocusedTextBox() then
		return false
	end

	local controls = refs.State.CameraControls
	local shortcuts = require("Shortcuts")
	local rotate = shortcuts.matches("ToggleBlenderGrab", input)
	local fov = shortcuts.matches("StartBlenderRotate", input)
	if rotate or fov then
		local axis = refs.State.Axis
		if
			require("BlenderEdit").blocked()
			or refs.State.Timeline:GetState().Playing
			or refs.State.Timeline:IsExportLocked()
			or refs.State.PhysicsSimulating
			or axis
				and (axis:IsHoldingAxis() or axis:IsBlenderGrabMode() or axis:IsBlenderRotateMode())
		then
			return false
		end

		if fov then
			if not controls then
				return false
			end

			if controls.isEditing() then
				return controls.input(input)
			end

			viewRotate.finish(false)
			Preview.setLinked(true)
			return controls.begin(CameraRig.motor(full.rig, "FovPart"), "view")
		end

		if controls and controls.isEditing() then
			controls.finish(false)
		end

		if viewRotate.isFlying() then
			viewRotate.finish(false)
		end
	elseif controls and controls.isEditing() then
		return controls.input(input)
	end

	return viewRotate.input(input, full.rig)
end

function Preview.exitFull(fromVisibility)
	local previous = full
	if not previous then
		return false
	end

	if viewRotate then
		viewRotate.finish(not viewRotate.isFlying())
	end

	if refs and refs.State.CameraControls then
		refs.State.CameraControls.finish(true)
	end

	if Visibility.beforeHide then
		Visibility.beforeHide()
	end

	full = nil
	refs.State.CameraPoseMode = nil
	refs.State.CameraBonesHidden = nil
	previous.view.stop()
	local restoring = refs.State.ignoreSelectionChanged
	refs.State.ignoreSelectionChanged = true
	local selection = {}
	for _, object in previous.selection do
		if object.Parent then
			table.insert(selection, object)
		end
	end

	Selection:Set(selection)
	refs.State.ignoreSelectionChanged = restoring
	if not fromVisibility then
		Visibility.setHidden(previous.hidden, true)
	end

	return true
end

function Preview.toggleFull()
	if refs and refs.State.BlenderNavigation then
		local nav = refs.State.BlenderNavigation
		if nav.prepareCameraView then
			nav.prepareCameraView()
		else
			nav.stop()
		end
	end

	if full then
		return Preview.exitFull()
	end

	if not refs or not refs.Active() then
		return false
	end

	local rig = Preview.target()
	if not rig then
		Preview.open()
		return false
	end

	full = {
		rig = rig,
		view = CameraRig.startView(rig),
		hidden = refs.State.PresentationHidden,
		selection = Selection:Get(),
	}
	refs.State.CameraPoseMode = true
	refs.State.CameraBonesHidden = full.hidden or Preferences.get("ShowBonesInCamera") == false
	Visibility.setHidden(true, true)
	local restoring = refs.State.ignoreSelectionChanged
	refs.State.ignoreSelectionChanged = true
	Selection:Set({})
	refs.State.ignoreSelectionChanged = restoring
	if
		not full.view.step(
			(linked or refs.State.CameraControls and refs.State.CameraControls.isEditing())
					and CameraRig.fov(rig)
				or static
		)
	then
		Preview.exitFull()
		return false
	end

	return true
end

function Preview.cycleFull()
	if not full then
		return Preview.toggleFull()
	end

	local cameras = Preview.cameras()
	local index = table.find(cameras, full.rig)
	if not index or index >= #cameras then
		return Preview.exitFull()
	end

	return Preview.select(cameras[index + 1])
end

function Preview.togglePlayback()
	if refs.State.Timeline and refs.State.Timeline:IsExportLocked() then
		return
	end

	if not full or not refs.State.Timeline then
		return
	end

	if viewRotate and viewRotate.isFlying() then
		viewRotate.finish(false)
	end

	local timeline = refs.State.Timeline
	local state = timeline:GetState()
	if state.Playing then
		state.Playing = false
	else
		timeline:StartPlayback(true)
	end
end

function Preview.open()
	previewElapsed = math.huge
	if opening then
		return window
	end

	if window and window.Parent then
		window.Visible = true
		local active = window
		if docked then
			if
				not DockHost.show(widget, function()
					return window == active
				end) and window == active
			then
				Preview.setDocked(false)
			end

			if window ~= active then
				return nil
			end
		elseif floatingGui then
			floatingGui.Enabled = true
		end

		FX.clear(window)
		local scale = window:FindFirstChild("EclipseWindowScale")
		if scale then
			scale.Scale = 1
		end

		refs.State.Timeline:RefreshNavigation()
		return window
	end

	if window then
		Preview.close()
	end

	local frame = make("Frame", refs.ScreenGui, "CameraPreview", {
		Size = UDim2.fromOffset(560, 390),
		Position = UDim2.fromScale(0.66, 0.44),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Active = true,
		Visible = false,
		ZIndex = 220,
		BorderSizePixel = 0,
	})
	window, opening = frame, true
	local factor = Chrome.scale(frame)
	local layer = make("ScreenGui", refs.ScreenGui.Parent, "EclipseCameraPreview", {
		IgnoreGuiInset = refs.ScreenGui.IgnoreGuiInset,
		ScreenInsets = refs.ScreenGui.ScreenInsets,
		ResetOnSpawn = false,
		DisplayOrder = refs.ScreenGui.DisplayOrder + 1,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	layer:SetAttribute("EclipseWindowIsolated", true)
	local layerScale = make("UIScale", layer, "Scale", { Scale = factor })
	local sourceScale = refs.ScreenGui:FindFirstChildOfClass("UIScale")
	if sourceScale then
		local changed = sourceScale:GetPropertyChangedSignal("Scale"):Connect(function()
			layerScale.Scale = sourceScale.Scale
		end)
		layer.Destroying:Once(function()
			changed:Disconnect()
		end)
	end

	floatingGui, frame.Parent = layer, layer
	Surface.fill(frame)
	local outline = make(
		"UIStroke",
		frame,
		"Outline",
		{ Color = Theme.panelOutlineDefault(), ApplyStrokeMode = Enum.ApplyStrokeMode.Border }
	)
	outline:SetAttribute("ThemeStrk", "Strk")
	local header, heading, drag = Chrome.header(frame, "CAMERA PREVIEW", 221, 192)
	title = heading
	title.TextTruncate = Enum.TextTruncate.AtEnd
	Chrome.close(header, Preview.close, 225)
	accessoryButton = Chrome.menuButton(
		header,
		"HideAccessories",
		"HIDE ACCESSORIES",
		UDim2.new(1, -178, 0, 3),
		UDim2.fromOffset(140, 24),
		225
	)
	accessoryButton.TextLabel.TextSize = 11
	accessoryButton.Activated:Connect(Preview.toggleAccessories)
	local fov = Chrome.menuButton(
		frame,
		"LinkFOV",
		"FOV",
		UDim2.fromOffset(10, 36),
		UDim2.fromOffset(72, 26),
		224
	)
	fovLabel = fov.TextLabel
	fovLabel.TextSize = 14
	fov.Corner.CornerRadius = UDim.new(0, 3)
	local box = make("Frame", frame, "StaticFOV", {
		Position = UDim2.fromOffset(90, 36),
		Size = UDim2.fromOffset(62, 26),
		BorderSizePixel = 0,
		ZIndex = 224,
		ClipsDescendants = true,
	})
	box:SetAttribute("ThemeBg", "TopBtn")
	local border = make(
		"UIStroke",
		box,
		"Outline",
		{ ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Thickness = 1 }
	)
	border:SetAttribute("ThemeStrk", "Strk")
	make("UICorner", box, "Corner", { CornerRadius = UDim.new(0, 3) })
	field = make("TextBox", box, "Value", {
		Text = tostring(static),
		Size = UDim2.new(1, -8, 1, 0),
		Position = UDim2.fromOffset(4, 0),
		BackgroundTransparency = 1,
		TextSize = 14,
		FontFace = Chrome.FONT,
		ClearTextOnFocus = false,
		ZIndex = 225,
	})
	field:SetAttribute("ThemeTxt", "Txt")
	local gridToggle = Chrome.menuButton(
		frame,
		"Grid",
		"GRID",
		UDim2.new(1, -76, 0, 36),
		UDim2.fromOffset(66, 26),
		224
	)
	local dockButton, label = Chrome.menuButton(
		frame,
		"Dock",
		"DOCK",
		UDim2.new(1, -150, 0, 36),
		UDim2.fromOffset(66, 26),
		224
	)
	dockLabel = label
	local fit, fitText = Chrome.menuButton(
		frame,
		"Fit",
		fitted and "UNFIT" or "FIT",
		UDim2.new(1, -224, 0, 36),
		UDim2.fromOffset(66, 26),
		224
	)
	fitLabel = fitText
	fit.Activated:Connect(Preview.toggleFit)
	local fullButton = Chrome.menuButton(
		frame,
		"Full",
		"FULL",
		UDim2.new(1, -298, 0, 36),
		UDim2.fromOffset(66, 26),
		224
	)
	fullButton.Activated:Connect(Preview.toggleFull)
	dockButton.Activated:Connect(function()
		Preview.setDocked(not docked)
	end)
	gridButton = gridToggle
	gridToggle.TextLabel.TextSize = 14
	gridToggle.Corner.CornerRadius = UDim.new(0, 3)
	gridToggle:SetAttribute("Selected", grid)
	gridToggle.Activated:Connect(Preview.toggleGrid)
	fov.Activated:Connect(function()
		Preview.setLinked(not linked)
	end)
	local inputField = field
	require("NumericInput").connect(inputField, { step = 1 }, function()
		if window ~= frame then
			return
		end

		if not linked then
			Preview.setStatic(tonumber(inputField.Text) or static)
		end

		inputField.Text = tostring(static)
	end)
	local well = make("Frame", frame, "View", {
		BackgroundColor3 = Color3.fromRGB(5, 9, 11),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(8, 70),
		Size = UDim2.new(1, -16, 1, -78),
		ZIndex = 223,
		ClipsDescendants = true,
	})
	viewport = make("ViewportFrame", well, "Viewport", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		ZIndex = 223,
	})
	previewGate = make("Frame", well, "CameraFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		ZIndex = 225,
	})
	make("UIStroke", previewGate, "Outline", {
		Color = Color3.fromRGB(235, 232, 217),
		Thickness = 1,
		Transparency = 0.15,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
	previewMatte = {}
	for _, name in { "Top", "Bottom", "Left", "Right" } do
		table.insert(
			previewMatte,
			make("Frame", well, "Outside" .. name, {
				BackgroundColor3 = Color3.new(0, 0, 0),
				BackgroundTransparency = 0.55,
				BorderSizePixel = 0,
				ZIndex = 224,
			})
		)
	end

	well:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutView)
	layoutView()
	previewGrid = Preview.grid(previewGate, "Grid", 226)
	empty = make("TextLabel", well, "Empty", {
		Text = "Add a camera to get started!",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		FontFace = Chrome.FONT,
		TextSize = 14,
		TextWrapped = true,
		ZIndex = 227,
	})
	empty:SetAttribute("ThemeTxt", "Txt")
	local nav = { arrows = {}, buttons = {}, tweens = {}, hover = nil }
	navigation = nav

	local function arrows()
		for _, arrow in nav.arrows do
			if nav.tweens[arrow] then
				nav.tweens[arrow]:Cancel()
			end

			local tween = TweenService:Create(
				arrow,
				TweenInfo.new(0.15),
				{ TextTransparency = nav.hover and 0.1 or 1 }
			)
			nav.tweens[arrow] = tween
			tween:Play()
		end
	end

	local function side(name, right)
		local hit = make("TextButton", well, name, {
			Text = "",
			Position = UDim2.fromScale(right and 0.8 or 0, 0),
			Size = UDim2.fromScale(0.2, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Visible = false,
			ZIndex = 228,
		})
		local arrow = make("TextLabel", hit, "Arrow", {
			Text = right and "\u{203a}" or "\u{2039}",
			BackgroundTransparency = 1,
			Position = UDim2.new(right and 1 or 0, right and -32 or 8, 0.5, -18),
			Size = UDim2.fromOffset(24, 36),
			FontFace = Chrome.FONT,
			TextSize = 30,
			TextTransparency = 1,
			ZIndex = 229,
		})
		arrow:SetAttribute("ThemeTxt", "Txt")
		table.insert(nav.buttons, hit)
		table.insert(nav.arrows, arrow)
		hit.MouseEnter:Connect(function()
			nav.hover = hit
			arrows()
		end)
		hit.MouseLeave:Connect(function()
			if nav.hover == hit then
				nav.hover = nil
				arrows()
			end
		end)
		hit.MouseButton1Click:Connect(function()
			Preview.navigate(right and 1 or -1)
		end)
	end

	side("Previous", false)
	side("Next", true)
	Chrome.bindDrag(frame, drag, {
		clamp = true,
		margin = 8,
		disabled = function()
			return docked or docking
		end,
	})
	Sizeable.attach({
		frame = frame,
		mouse = refs.State.mouse,
		minSize = Vector2.new(460, 230),
		maxSize = Vector2.new(1500, 1000),
		settingKey = "CameraPreviewSize",
	})
	frame.InputBegan:Connect(function(input)
		if docked then
			Visibility.input(input)
		end
	end)
	Theme.addRoot(frame)
	Theme.applyTree(frame)
	if Data.getSetting("CameraPreviewDocked") == true then
		Preview.setDocked(true)
	end

	if window ~= frame then
		return nil
	end

	opening = false
	frame.Visible = true
	if not docked then
		FX.pop(frame)
	end

	refs.State.Timeline:RefreshNavigation()
	updateView()
	return frame
end

function Preview.toggle()
	if Preview.isOpen() then
		Preview.close()
	else
		Preview.open()
	end
end

function Preview.shouldRefresh(dt, playing)
	previewElapsed += math.max(0, dt or 0)
	local changed = previewPlaying ~= playing
	previewPlaying = playing
	local limit = Preferences.get("CameraPreviewFPS")
	if not limit or limit <= 0 then
		previewElapsed = 0
		return true
	end

	local interval = 1 / limit
	if not changed and previewElapsed + 1e-9 < interval then
		return false
	end

	previewElapsed = previewElapsed == math.huge and 0
		or math.max(0, previewElapsed - math.floor((previewElapsed + 1e-9) / interval) * interval)
	return true
end

local function set(object, property, value)
	if object[property] ~= value then
		object[property] = value
	end
end

updateView = function(cameras)
	if
		not window
		or not viewport
		or not Preview.isOpen()
		or refs.State.PresentationHidden
		or docking
	then
		return
	end

	cameras = cameras or Preview.cameras()
	local rig = Preview.target(cameras)
	local accessoryState = accessoryView(rig)
	if accessoryButton then
		accessoryButton:SetAttribute("Selected", accessoryState and accessoryState.hidden or false)
		accessoryButton.Interactable = rig ~= nil
	end

	set(empty, "Visible", rig == nil)
	set(
		empty,
		"Text",
		#cameras == 0 and #Preview.cameras(true) > 0 and "Enable a camera to get started!"
			or "Add a camera to get started!"
	)
	local index, name = table.find(cameras, rig), rig and rig.Name
	if
		titleState.object ~= title
		or titleState.rig ~= rig
		or titleState.name ~= name
		or titleState.index ~= index
		or titleState.count ~= #cameras
	then
		titleState = { object = title, rig = rig, name = name, index = index, count = #cameras }
		set(
			title,
			"Text",
			rig and string.format("CAMERA PREVIEW \u{b7} %s (%d/%d)", name, index, #cameras)
				or "CAMERA PREVIEW"
		)
	end

	for _, button in navigation.buttons do
		set(button, "Visible", #cameras > 1)
	end

	set(viewport, "Visible", rig ~= nil)
	set(previewGate, "Visible", rig ~= nil)
	for _, matte in previewMatte do
		set(matte, "Visible", rig ~= nil)
	end

	set(previewGrid, "Visible", grid and rig ~= nil)
	set(fovLabel, "Text", linked and "\u{2713} FOV" or "FOV")
	set(field, "TextEditable", not linked)
	set(field, "Interactable", not linked)
	set(field, "TextTransparency", linked and 0.65 or 0)
	if linked then
		set(field, "Text", string.format("%.1f", rig and CameraRig.fov(rig) or 70))
	elseif not field:IsFocused() then
		set(field, "Text", tostring(static))
	end

	if rig then
		if not scene then
			scene = Scene.attach(viewport)
		end

		local fov = linked and CameraRig.fov(rig) or static
		local cf, renderFov = CameraRig.renderFrame(rig, fov)
		authoredPreviewFov = renderFov
		scene.setHideAccessories(accessoryState and accessoryState.hidden)
		scene.update(cf, layoutView(), refs.State.getAllRigs())
	elseif scene then
		scene.destroy()
		scene = nil
	end
end

local lifetime = {}
local gridOverlay

function Preview.destroy()
	table.clear(accessoryViews)
	Preview.closeGridSettings()
	for _, connection in widgetConnections do
		connection:Disconnect()
	end

	table.clear(widgetConnections)
	for _, connection in lifetime do
		connection:Disconnect()
	end

	table.clear(lifetime)
	Preview.exitFull()
	Preview.close(true)
	for frame, gui in retiring do
		FX.clear(frame)
		frame:Destroy()
		if typeof(gui) == "Instance" then
			gui:Destroy()
		end
	end

	table.clear(retiring)
	if gridOverlay then
		gridOverlay:Destroy()
		gridOverlay = nil
	end

	if widget then
		DockHost.release(widget)
		widget = nil
	end

	screenGrid = nil
end

function Preview.syncCamera(dt)
	if
		dt
		and refs
		and refs.PlaybackOwnsRefresh
		and window
		and not docking
		and not refs.State.PresentationHidden
		and refs.ScreenGui.Enabled
		and refs.Active()
		and Preview.isOpen()
		and Preview.shouldRefresh(dt, refs.State.Timeline:GetState().Playing == true)
	then
		updateView()
	end

	if not full then
		return
	end

	if
		not full.view.step(
			(linked or refs.State.CameraControls and refs.State.CameraControls.isEditing())
					and CameraRig.fov(full.rig)
				or static
		)
	then
		Preview.exitFull()
	end
end

function Preview.init(options)
	if refs then
		Preview.destroy()
	end

	refs = options
	composition = normalizeComposition(readCompositionSetting("EclipseCompositionGridV1", {}))
	if composition.kind == "Custom Image" and composition.image == "" then
		composition.kind = "Thirds"
	end

	compositionProfiles = {}
	for _, entry in readCompositionSetting("EclipseCompositionPresetsV1", {}) do
		if
			type(entry) == "table"
			and type(entry.name) == "string"
			and #compositionProfiles < 20
		then
			table.insert(
				compositionProfiles,
				{ name = entry.name, config = normalizeComposition(entry.config) }
			)
		end
	end

	viewRotate = ViewRotate.new(refs)
	table.insert(
		lifetime,
		Input.WindowFocusReleased:Connect(function()
			if viewRotate then
				viewRotate.focusLost()
			end
		end)
	)
	refs.State.CameraPreview = Preview
	linked = Data.getSetting("CameraPreviewLinkedFOV") ~= false
	grid = Data.getSetting("CameraPreviewGrid") == true
	fitted = Data.getSetting("CameraPreviewFit") ~= false
	mainGrid = Data.getSetting("CameraMainGrid") == true
	static = CameraRig.clamp(Data.getSetting("CameraPreviewStaticFOV"))
	local overlay = make(
		"ScreenGui",
		refs.ScreenGui.Parent,
		"EclipseCameraGrid-" .. game.HttpService:GenerateGUID(false),
		{
			IgnoreGuiInset = refs.ScreenGui.IgnoreGuiInset,
			ResetOnSpawn = false,
			DisplayOrder = refs.ScreenGui.DisplayOrder - 1,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		}
	)
	gridOverlay = overlay
	local boneHint = make("TextLabel", overlay, "CameraBoneHint", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -14),
		Size = UDim2.fromOffset(350, 22),
		TextSize = 13,
		Font = Enum.Font.Code,
		TextColor3 = Color3.fromRGB(180, 180, 180),
		TextTransparency = 0.35,
		TextXAlignment = Enum.TextXAlignment.Right,
		Visible = false,
		Active = false,
	})
	screenGrid = Preview.grid(overlay, "CameraCompositionGrid", 1)
	screenGrid.Visible = false
	local connection = RunService.RenderStepped:Connect(function(dt)
		local active = refs.Active()
		boneHint.Visible = full ~= nil
			and refs.ScreenGui.Enabled
			and not refs.State.CameraBonesHidden
		if boneHint.Visible then
			local chord = require("Shortcuts").format("TogglePresentation")
			boneHint.Text = chord
				.. (refs.State.CameraBonesHidden and " to show bones" or " to hide bones")
		end

		local cameras
		if full then
			viewRotate.step(full.rig, dt)
			cameras = Preview.cameras()
			local rig = Preview.target(cameras)
			if not refs.ScreenGui.Enabled or not rig then
				Preview.exitFull()
			elseif rig ~= full.rig then
				Preview.select(rig)
			elseif
				not full.view.step(
					(linked or refs.State.CameraControls and refs.State.CameraControls.isEditing())
							and CameraRig.fov(rig)
						or static
				)
			then
				Preview.exitFull()
			end
		end

		if full and refs.State.ScreenEffects then
			refs.State.ScreenEffects.step()
		end

		local hidden = refs.State.PresentationHidden
		set(screenGrid, "Visible", active and mainGrid and not hidden)
		if not window or hidden or docking then
			previewElapsed = math.huge
			return
		end

		if not refs.ScreenGui.Enabled then
			Preview.close()
			return
		end

		if refs.PlaybackOwnsRefresh or not active or not Preview.isOpen() then
			return
		end

		if
			Preview.shouldRefresh(
				dt,
				refs.State.Timeline and refs.State.Timeline:GetState().Playing == true
			)
		then
			updateView(cameras)
		end
	end)
	local changed
	if refs.AnimatorFrame then
		changed = refs.AnimatorFrame:GetPropertyChangedSignal("Visible"):Connect(function()
			if not refs.AnimatorFrame.Visible and not refs.State.PresentationHidden then
				Preview.closeGridSettings()
				Preview.exitFull()
				Preview.close()
				currentCamera, observedSelection = nil, nil
			end
		end)
	end

	table.insert(lifetime, connection)
	if changed then
		table.insert(lifetime, changed)
	end

	table.insert(
		lifetime,
		refs.ScreenGui:GetPropertyChangedSignal("Enabled"):Connect(function()
			if not refs.ScreenGui.Enabled then
				Preview.closeGridSettings()
			end
		end)
	)
	table.insert(lifetime, refs.ScreenGui.Destroying:Once(Preview.destroy))
	if refs.Plugin then
		table.insert(lifetime, refs.Plugin.Unloading:Once(Preview.destroy))
	end
end

return Preview
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a3ff</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1974">
          <Properties>
            <string name="Name">SceneSync</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f59</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{B7791CEB-AFEE-4A95-BA18-603C9B0DBBF9}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local Scene = require("Scene")
local Recovery = require("Recovery")
local History = require("History")
local Selection = game:GetService("Selection")
local RunService = game:GetService("RunService")
local Input = game:GetService("UserInputService")
local Cursor = require("RotateCursor")
local Shortcuts = require("Shortcuts")
local Edit = require("BlenderEdit")
local EditorInput = require("UserInputService")
local Document = require("Document")
local Path = require("Path")
local Timing = require("Timing")
local Display = {}

function Display.positionAt(part, frame, cache)
	cache = cache or {}
	local source = part:GetAttribute("ForcePath")
	if source ~= cache.pathSource then
		cache.pathSource, cache.pathSample, cache.pathEasing = source, nil, nil
		if source then
			local ok, data, sample = pcall(function()
				local value = Document.unpack(source)
				Path.validate({
					force = { points = value.points, smoothing = 0, easing = value.easing },
				})
				return value, Path.sampler(value.points)
			end)
			if ok then
				cache.pathSample, cache.pathEasing = sample, data.easing
			end
		end
	end

	if not cache.pathSample then
		return part.Position
	end

	local alpha = (frame - (part:GetAttribute("Frame") or 0))
		/ math.max(1, (part:GetAttribute("Duration") or 60) - 1)
	return part.Position + cache.pathSample(Timing.sample(cache.pathEasing, alpha))
end

local COLOR = Color3.fromRGB(242, 171, 196)
local refs, host, handles, selected, hovered, drag
local mode = "Move"
local shapes = {}
local connections = {}

local function editing()
	return (
		refs
		and refs.Active()
		and refs.State.Physics
		and refs.State.Physics.isEditorOpen
		and refs.State.Physics.isEditorOpen()
	) == true
end

local function radius(part)
	local value = part:GetAttribute("Radius")
	return typeof(value) == "number" and value == value and math.clamp(value, 0.1, 1000) or 5
end

function Display.segments(position, value)
	local lines = {}
	for axis = 1, 3 do
		for i = 1, 64 do
			local function point(angle)
				local a, b = math.cos(angle) * value, math.sin(angle) * value
				return position
					+ (
						axis == 1 and Vector3.new(0, a, b)
						or axis == 2 and Vector3.new(a, 0, b)
						or Vector3.new(a, b, 0)
					)
			end

			table.insert(lines, { point((i - 1) * math.pi / 32), point(i * math.pi / 32) })
		end
	end

	local center = math.clamp(value * 0.07, 0.4, 1.5)
	for _, axis in { Vector3.xAxis, Vector3.yAxis, Vector3.zAxis } do
		table.insert(lines, { position - axis * center, position + axis * center })
	end

	return lines
end

function Display.sync(part, shape)
	local value = radius(part)
	local nextRadius = value
	if shape.size and part.Size ~= shape.size and value == shape.radius then
		local delta = part.Size - shape.size
		local largest = math.max(math.abs(delta.X), math.abs(delta.Y), math.abs(delta.Z))
		local length = math.abs(delta.X) == largest and part.Size.X
			or math.abs(delta.Y) == largest and part.Size.Y
			or part.Size.Z
		nextRadius = math.clamp(length / 2, 0.1, 1000)
		part:SetAttribute("Radius", nextRadius)
	end

	local size = Vector3.one * (nextRadius * 2)
	if part.Size ~= size then
		part.Size = size
	end

	part.Transparency = 1
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	shape.size, shape.radius = size, nextRadius
	return nextRadius
end

function Display.select(part)
	if not editing() then
		return false
	end

	assert(
		part and part.Parent and part:GetAttribute("EclipsePhysicsForce"),
		"choose a blast first"
	)
	if refs and refs.State.Rig and refs.State.Rig.ClearItemSelection then
		refs.State.Rig:ClearItemSelection()
	end

	selected = part
	hovered = nil
	Selection:Set({ part })
	Display.refresh()
end

function Display.deselect()
	if not selected and not drag then
		return
	end

	Display.finish(false)
	selected, hovered = nil, nil
	local keep = {}
	local changed = false
	for _, object in Selection:Get() do
		if object:GetAttribute("EclipsePhysicsForce") then
			changed = true
		else
			table.insert(keep, object)
		end
	end

	if changed then
		local previous = refs and refs.State.ignoreSelectionChanged
		if refs then
			refs.State.ignoreSelectionChanged = true
		end

		Selection:Set(keep)
		if refs then
			refs.State.ignoreSelectionChanged = previous
		end
	end

	Display.refresh()
end

function Display.hide()
	Display.finish(true)
	Display.deselect()
	Display.refresh()
end

function Display.setMode(value)
	mode = value == "Scale" and "Scale" or "Move"
	if handles then
		handles.Style = mode == "Scale" and Enum.HandlesStyle.Resize or Enum.HandlesStyle.Movement
	end
end

function Display.getMode()
	return mode
end

function Display.toggleMode()
	if
		not refs
		or not refs.Active()
		or not selected
		or not selected.Parent
		or not handles
		or not handles.Visible
	then
		return false
	end

	if
		refs.State.PhysicsSimulating
		or refs.State.Timeline:GetState().Playing
		or Input:GetFocusedTextBox()
	then
		return false
	end

	if drag then
		return true
	end

	Display.setMode(mode == "Move" and "Scale" or "Move")
	return true
end

function Display.isEditing()
	return drag ~= nil
end

local function planePoint(camera, point, pivot, normal)
	local ray = camera:ViewportPointToRay(point.X, point.Y)
	local denominator = ray.Direction:Dot(normal)
	if math.abs(denominator) < 1e-6 then
		return
	end

	return ray.Origin + ray.Direction * ((pivot - ray.Origin):Dot(normal) / denominator)
end

function Display.start(value)
	if drag then
		return true
	end

	if
		not refs
		or not refs.Active()
		or not selected
		or not selected.Parent
		or not handles
		or not handles.Visible
	then
		return false
	end

	if
		refs.State.PhysicsSimulating
		or refs.State.Timeline:GetState().Playing
		or Input:GetFocusedTextBox()
		or EditorInput.inWidget()
		or Edit.blocked()
	then
		return false
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return false
	end

	if refs.Finalize then
		refs.Finalize()
	end

	Display.setMode(value)
	Display.begin()
	if not drag then
		return false
	end

	drag.pointer = true
	drag.mouse = Input:GetMouseLocation()
	drag.normal = camera.CFrame.LookVector
	drag.origin = shapes[selected] and shapes[selected].position or drag.cf.Position
	drag.plane = planePoint(camera, drag.mouse, drag.origin, drag.normal)
	if not drag.plane then
		drag = nil
		return false
	end

	Cursor.start(drag.origin, mode == "Move")
	hovered = nil
	handles.Visible = false
	return true
end

function Display.pointer(point)
	if not drag or not drag.pointer or not drag.part.Parent then
		return
	end

	local fine = (
		Input:IsKeyDown(Enum.KeyCode.LeftShift) or Input:IsKeyDown(Enum.KeyCode.RightShift)
	)
			and 0.1
		or 1
	if drag.mode == "Scale" then
		drag.part:SetAttribute(
			"Radius",
			math.clamp(
				drag.radius * math.exp(math.clamp((drag.mouse.Y - point.Y) * fine / 160, -12, 12)),
				0.1,
				1000
			)
		)
	else
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end

		local world = planePoint(camera, point, drag.origin, drag.normal)
		if world then
			local delta = (world - drag.plane) * fine
			if drag.axis then
				delta = drag.axis * delta:Dot(drag.axis)
			end

			drag.part.CFrame = drag.cf + delta
		end
	end
end

function Display.keyboard(input)
	if not drag or not drag.pointer then
		return false
	end

	if
		Shortcuts.matches("Cancel", input)
		or input.UserInputType == Enum.UserInputType.MouseButton2
	then
		Display.finish(true)
	elseif
		Shortcuts.matches("ConfirmTransform", input)
		or Shortcuts.matches("ConfirmTransformAlternate", input)
		or input.UserInputType == Enum.UserInputType.MouseButton1
	then
		Display.finish(false)
	elseif drag.mode == "Move" then
		local axis = input.KeyCode == Enum.KeyCode.X and Vector3.xAxis
			or input.KeyCode == Enum.KeyCode.Y and Vector3.yAxis
			or input.KeyCode == Enum.KeyCode.Z and Vector3.zAxis
		if axis then
			drag.axis = if drag.axis == axis then nil else axis
		end
	end

	return true
end

function Display.begin()
	if
		not selected
		or not selected.Parent
		or refs.State.Timeline:GetState().Playing
		or refs.State.PhysicsSimulating
	then
		return
	end

	drag = { part = selected, cf = selected.CFrame, radius = radius(selected), mode = mode }
end

function Display.change(face, distance)
	if not drag or not drag.part.Parent then
		return
	end

	if drag.mode == "Scale" then
		drag.part:SetAttribute("Radius", math.clamp(drag.radius + distance, 0.1, 1000))
	else
		drag.part.CFrame = drag.cf
			+ drag.cf:VectorToWorldSpace(Vector3.FromNormalId(face)) * distance
	end

	Display.refresh()
end

function Display.finish(cancel)
	if not drag then
		return
	end

	local before = drag
	drag = nil
	if before.pointer then
		Cursor.stop()
	end

	local part = before.part
	if not part.Parent then
		return
	end

	local after = { cf = part.CFrame, radius = radius(part) }

	local function apply(value)
		if part.Parent then
			part.CFrame = value.cf
			part:SetAttribute("Radius", value.radius)
			Display.refresh()
		end

		if refs then
			refs.State.currentProjectSaved = false
		end
	end

	if cancel then
		apply(before)
		return
	end

	if before.cf == after.cf and before.radius == after.radius then
		return
	end

	apply(after)
	History.record(function()
		apply(before)
	end, function()
		apply(after)
	end, before.mode == "Scale" and "Scale blast radius" or "Move blast")
end

local function distance(point, a, b)
	local delta = b - a
	local alpha = delta:Dot(delta) > 1e-8
			and math.clamp((point - a):Dot(delta) / delta:Dot(delta), 0, 1)
		or 0
	return (point - a - delta * alpha).Magnitude
end

function Display.hit(camera, point, entries)
	if not camera then
		return
	end

	local best, gap = nil, 10
	for part, shape in entries or shapes do
		if not part.Parent or not shape.visible then
			continue
		end

		local center = camera:WorldToScreenPoint(shape.position or part.Position)
		if center.Z > 0 and (Vector2.new(center.X, center.Y) - point).Magnitude < 12 then
			return part
		end

		for _, line in shape.lines or {} do
			local a, b = camera:WorldToScreenPoint(line[1]), camera:WorldToScreenPoint(line[2])
			if a.Z <= 0 or b.Z <= 0 then
				continue
			end

			local value = distance(point, Vector2.new(a.X, a.Y), Vector2.new(b.X, b.Y))
			if value < gap then
				best, gap = part, value
			end
		end
	end

	return best
end

function Display.input(point)
	if
		not editing()
		or refs.State.PresentationHidden
		or refs.State.PhysicsSimulating
		or refs.State.Timeline:GetState().Playing
	then
		return false
	end

	if hovered or drag then
		return true
	end

	local part = Display.hit(workspace.CurrentCamera, point)
	if not part then
		Display.deselect()
		return false
	end

	Display.select(part)
	return true
end

function Display.refresh()
	if not refs or not refs.State.Timeline then
		return
	end

	if not host or host.Parent ~= workspace.CurrentCamera then
		if host then
			host:Destroy()
		end

		shapes = {}
		if not workspace.CurrentCamera then
			return
		end

		host = Recovery.mark(Instance.new("Folder"))

		host.Name = "EclipseBlastDisplay"
		host.Parent = workspace.CurrentCamera
	end

	if drag and drag.pointer then
		Display.pointer(Input:GetMouseLocation())
	end

	local editor = editing()
	local visible = editor
		and not refs.State.PresentationHidden
		and not refs.State.PhysicsSimulating
	local editable = visible and not refs.State.Timeline:GetState().Playing
	local raw = refs.State.Timeline:GetState()
	local frame = raw.CurrentTime * raw.FPS
	local active = {}
	for _, part in Scene.get().forces do
		if not part.Parent then
			continue
		end

		if editor then
			if part.Parent ~= workspace then
				part.Parent = workspace
			end
		elseif part.Parent == workspace then
			Recovery.parkForce(part)
		end

		active[part] = true
		local shape = shapes[part]
		if not shape then
			local wire = Instance.new("WireframeHandleAdornment")

			wire.Name = "BlastRadius"
			wire.Adornee = workspace.Terrain
			wire.AlwaysOnTop = true
			wire.Color3 = COLOR
			wire.Thickness = 2
			wire.Parent = host
			local proxy = Instance.new("Part")
			proxy.Name = "ForcePreviewAnchor"
			proxy.Anchored = true
			proxy.Transparency = 1
			proxy.CanCollide, proxy.CanTouch, proxy.CanQuery = false, false, false
			proxy.Parent = host
			shape = { wire = wire, proxy = proxy }
			shapes[part] = shape
		end

		local value = Display.sync(part, shape)
		local position = Display.positionAt(part, frame, shape)
		shape.proxy.CFrame = part.CFrame.Rotation + position
		shape.proxy.Size = part.Size
		shape.visible = visible
		shape.wire.Visible = visible
		shape.wire.Thickness = part == selected and 3 or 2
		if shape.position ~= position or shape.drawnRadius ~= value then
			shape.position, shape.drawnRadius = position, value
			shape.lines = Display.segments(position, value)
			shape.wire:Clear()
			for _, line in shape.lines do
				shape.wire:AddLine(line[1], line[2])
			end
		end
	end

	for part, shape in shapes do
		if not active[part] then
			Recovery.parkForce(part)
			shape.wire:Destroy()
			shape.proxy:Destroy()
			shapes[part] = nil
		end
	end

	if selected and not active[selected] then
		selected = nil
	end

	if handles then
		handles.Adornee = selected and shapes[selected] and shapes[selected].proxy
		handles.Visible = editable and selected ~= nil and not (drag and drag.pointer)
	end

	if not editable then
		Display.finish(true)
		hovered = nil
	end
end

function Display.destroy()
	Display.finish(true)
	for part in shapes do
		Recovery.parkForce(part)
	end

	for _, connection in connections do
		connection:Disconnect()
	end

	table.clear(connections)
	if host then
		host:Destroy()
	end

	if handles then
		handles:Destroy()
	end

	host, handles, selected, hovered, refs = nil, nil, nil, nil, nil
	shapes = {}
end

function Display.init(options)
	Display.destroy()
	refs = options
	options.State.PhysicsDisplay = Display
	handles = Recovery.mark(Instance.new("Handles"))

	handles.Name = "BlastHandles"
	handles.Color3 = COLOR
	handles.Visible = false
	handles.Parent = options.ScreenGui
	Display.setMode("Move")

	local function connect(signal, fn)
		table.insert(connections, signal:Connect(fn))
	end

	connect(handles.MouseEnter, function(face)
		hovered = face
	end)
	connect(handles.MouseLeave, function()
		hovered = nil
	end)
	connect(handles.MouseButton1Down, Display.begin)
	connect(handles.MouseDrag, Display.change)
	connect(handles.MouseButton1Up, function()
		if not drag or not drag.pointer then
			Display.finish(false)
		end
	end)
	connect(Input.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and drag and not drag.pointer then
			Display.finish(false)
		end
	end)
	connect(Input.InputBegan, function(input)
		if drag and not drag.pointer and input.KeyCode == Enum.KeyCode.Escape then
			Display.finish(true)
		end
	end)
	connect(Input.WindowFocusReleased, function()
		Display.finish(true)
	end)
	connect(Selection.SelectionChanged, function()
		local part = Selection:Get()[1]
		if
			part
			and part:GetAttribute("EclipsePhysicsForce")
			and table.find(Scene.get().forces, part)
		then
			selected = part
		else
			Display.finish(false)
			selected = nil
			hovered = nil
		end

		Display.refresh()
	end)
	connect(RunService.RenderStepped, Display.refresh)
	connect(options.Plugin.Unloading, Display.destroy)
	connect(options.ScreenGui.Destroying, Display.destroy)
end

return Display
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a400</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1975">
          <Properties>
            <string name="Name">Scene</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f5a</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{3C0B4380-8A20-4D6E-9956-11F2D8F7343C}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local Timing = require("Timing")

local Selection = game:GetService("Selection")
local Parenting = require("Parenting")
local SelectedRig = require("SelectedRig")
local CameraRig = require("CameraRig")
local Armature = require("ArmatureRuntime")
local Document = require("Document")
local Data = require("ChunkStore")
local History = require("History")
local Properties = require("Properties")
local Scene = {}
local sessions = setmetatable({}, { __mode = "k" })
local refs

function Scene.get()
	local raw = refs.State.Timeline:GetState()
	local session = sessions[raw.Keyframes]
	if not session then
		session = { entries = {}, forces = {} }
		sessions[raw.Keyframes] = session
	end

	return session
end

local function changed()
	refs.State.currentProjectSaved = false
end

function Scene.part(motor)
	if Properties.is(motor) and motor.PropertyId == "CFrame" and motor.Rig:IsA("BasePart") then
		return motor.Rig
	end

	return motor.Part1
end

function Scene.name(motor)
	return Scene.part(motor):GetFullName()
end

function Scene.world(part)
	return part:IsA("Bone") and part.TransformedWorldCFrame or part.CFrame
end

function Scene.size(part)
	if part:IsA("BasePart") then
		return part.Size
	end

	local length = part.CFrame.Position.Magnitude
	for _, child in part:GetChildren() do
		if child:IsA("Bone") then
			length = child.CFrame.Position.Magnitude
			break
		end
	end

	local diameter = math.clamp(length * 0.3, 0.15, 2)
	return Vector3.new(diameter, diameter, diameter)
end

function Scene.all()
	local result = {}
	for _, rig in refs.State.getAllRigs() do
		if CameraRig.isRig(rig) or Armature.isRig(rig) then
			continue
		end

		if rig:IsA("BasePart") and not rig:FindFirstChildWhichIsA("Bone", true) then
			for _, motor in Properties.list(rig) do
				if motor.PropertyId == "CFrame" and not motor:GetAttribute("EclipseDisabled") then
					table.insert(result, { rig = rig, motor = motor, ragdoll = false })
				end
			end
		end

		for _, motor in Parenting.collectMotors(rig) do
			if
				typeof(motor) == "Instance"
				and motor:IsA("Motor6D")
				and motor.Part1
				and motor.Part1:IsA("BasePart")
			then
				if
					motor:GetAttribute("EclipsePartTrackEnabled") ~= false
					and (
						not motor:GetAttribute("EclipseAddedObject")
						or refs.State.activeObjectMotors[motor]
					)
				then
					table.insert(result, {
						rig = rig,
						motor = motor,
						ragdoll = not motor:GetAttribute("EclipseAddedObject"),
					})
				end
			end
		end

		for _, bone in require("RigTraversal").rigDescendants(rig) do
			if
				bone:IsA("Bone")
				and not bone:GetAttribute("EclipseArmatureSkinningHelper")
				and not require("R6Controls").isControl(bone)
			then
				local motor = require("BoneMotor").get(bone)
				if motor and not bone:GetAttribute("EclipseDisabled") then
					table.insert(result, { rig = rig, motor = motor, ragdoll = true })
				end
			end
		end
	end

	return result
end

function Scene.add(mode, objects)
	assert(not refs.State.Timeline:GetState().Playing, "pause the animation first")
	local picked, seen = {}, {}

	local function add(object)
		if typeof(object) ~= "Instance" then
			return
		end

		object = Properties.owner(object) or object
		local source = object:FindFirstChild("EclipseSourcePart")
		if source and source:IsA("ObjectValue") and source.Value then
			object = source.Value
		end

		if object:IsA("Motor6D") then
			object = object.Part1
		end

		if not object or seen[object] or object:GetAttribute("EclipsePhysicsForce") then
			return
		end

		if
			not (object:IsA("Model") or object:IsA("BasePart") or object:IsA("Bone"))
			or not object:IsDescendantOf(workspace)
		then
			return
		end

		seen[object] = true
		table.insert(picked, object)
	end

	if objects then
		for _, object in objects do
			add(object)
		end
	else
		for _, object in Selection:Get() do
			add(object)
		end

		if #picked == 0 then
			for item, selected in refs.State.Rig and refs.State.Rig._selectedItems or {} do
				if selected then
					add(item.linkedRigInstance)
				end
			end
		end
	end

	objects = picked
	assert(#objects > 0, "select a rig, model or parts first")
	local session = Scene.get()
	local before = table.clone(session.entries)
	local pending = {}
	local available = Scene.all()
	for _, object in objects do
		assert(
			typeof(object) == "Instance" and object:IsDescendantOf(workspace),
			"select a rig, model or parts in Workspace"
		)
		local matched = false
		for _, entry in available do
			if
				object == entry.rig
				or object == Scene.part(entry.motor)
				or Scene.part(entry.motor):IsDescendantOf(object)
			then
				matched = true
				break
			end
		end

		if not matched then
			assert(refs.AddObject and refs.AddRig, "add this object to the timeline first")
			if object:IsA("Bone") then
				refs.AddRig(
					object:FindFirstAncestorOfClass("Model")
						or object:FindFirstAncestorWhichIsA("BasePart")
				)
			elseif
				object:IsA("BasePart")
				or object:IsA("Model")
					and (object:FindFirstChildOfClass("Humanoid") or #Parenting.collectMotors(
						object
					) > 0)
			then
				refs.AddRig(object)
			else
				local owner = refs.State.currentRig
				assert(
					owner and not CameraRig.isRig(owner) and not Armature.isRig(owner),
					"select a Motor6D rig in Eclipse before adding objects"
				)
				refs.AddObject(object, { Physics = true })
			end

			available = Scene.all()
		end

		local count = 0
		for _, entry in available do
			local belongs = Scene.part(entry.motor) == object
				or Scene.part(entry.motor):IsDescendantOf(object)
			if
				belongs
				or mode == "Ragdoll"
					and entry.ragdoll
					and (object == entry.rig or object:IsDescendantOf(entry.rig))
			then
				pending[entry.motor] = {
					rig = entry.rig,
					motor = entry.motor,
					ragdoll = mode == "Ragdoll" and entry.ragdoll,
				}
				count += 1
			end
		end

		assert(count > 0, "add a Motor6D rig to the timeline before adding objects")
	end

	local after = table.clone(before)
	for motor, entry in pending do
		after[motor] = entry
	end

	local count = 0
	for _ in after do
		count += 1
	end

	if count > 150 then
		require("Notification").show(
			"PHYSICS",
			tostring(count) .. " parts. Big simulations work, they just take longer to finish.",
			6
		)
	end

	local function apply(entries)
		session.entries = table.clone(entries)
		changed()
	end

	apply(after)
	History.record(function()
		apply(before)
	end, function()
		apply(after)
	end, "Add physics participants")
	return count
end

function Scene.clear()
	local session = Scene.get()
	local before, guide, paths = session.entries, session.guide, session.guides

	local function apply(entries, path, guides)
		session.entries = entries
		session.guide = path
		session.guides = guides
		changed()
	end

	apply({}, nil, {})
	History.record(function()
		apply(before, guide, paths)
	end, function()
		apply({}, nil, {})
	end, "Clear physics participants")
end

function Scene.setMode(mode)
	local available = {}
	for _, entry in Scene.all() do
		available[entry.motor] = entry
	end

	for motor, entry in Scene.get().entries do
		entry.ragdoll = mode == "Ragdoll" and available[motor] and available[motor].ragdoll or false
	end
end

function Scene.entries()
	local result = {}
	for motor, entry in Scene.get().entries do
		assert(
			motor.Parent and motor.Part1 and motor.Part1.Parent and entry.rig.Parent,
			"a registered physics part was removed; clear the list and add it again"
		)
		table.insert(result, entry)
	end

	table.sort(result, function(a, b)
		return Scene.name(a.motor) < Scene.name(b.motor)
	end)
	return result
end

function Scene.useClip(clip)
	local session = Scene.get()
	session.entries = {}
	session.guide = nil
	session.guides = {}
	for motor in clip.tracks do
		local ragdoll = clip.ragdolls and clip.ragdolls[motor]
		session.entries[motor] = {
			motor = motor,
			rig = clip.owners and clip.owners[motor] or clip.rig,
			ragdoll = ragdoll == true
				or ragdoll == nil
					and clip.settings.mode == "Ragdoll"
					and not motor:GetAttribute("EclipseAddedObject"),
		}
	end

	local entries = Scene.entries()
	for _, saved in clip.settings.guides or (clip.settings.guide and { clip.settings.guide } or {}) do
		local guide = table.clone(saved)
		if clip.guideMotors then
			guide.motor = clip.guideMotors[guide.index]
		else
			guide.motor = clip.guideMotor or entries[guide.index] and entries[guide.index].motor
		end

		if guide.motor and session.entries[guide.motor] then
			session.guides[guide.motor] = guide
			session.guide = guide
		end
	end
end

function Scene.guideMotor()
	local entries = Scene.entries()
	local rig = SelectedRig.resolve(refs.State)
	for _, entry in entries do
		if
			entry.rig == rig
			and entry.ragdoll
			and (
				Scene.part(entry.motor).Name == "Torso"
				or Scene.part(entry.motor).Name == "LowerTorso"
			)
		then
			return entry.motor
		end
	end

	for _, entry in entries do
		if entry.rig == rig then
			return entry.motor
		end
	end

	return entries[1] and entries[1].motor
end

function Scene.paths()
	local session = Scene.get()
	local paths = table.clone(session.guides or {})
	if session.guide then
		paths[session.guide.motor] = session.guide
	end

	local result = {}
	for motor, guide in paths do
		if session.entries[motor] and motor.Parent and motor.Part1 and motor.Part1.Parent then
			table.insert(result, guide)
		end
	end

	table.sort(result, function(a, b)
		return Scene.name(a.motor) < Scene.name(b.motor)
	end)
	return result
end

function Scene.selectedGuideMotors()
	local chosen, objects = {}, {}
	for item, active in refs.State.Rig and refs.State.Rig._selectedItems or {} do
		if active then
			local motor = item.fetchMotor and item:fetchMotor()
			if motor then
				chosen[motor] = true
			end

			if typeof(item.linkedRigInstance) == "Instance" then
				table.insert(objects, item.linkedRigInstance)
			end
		end
	end

	for _, object in Selection:Get() do
		table.insert(objects, object)
	end

	local raw = refs.State.Timeline:GetState()
	for key in raw.SelectedKeyframes or {} do
		chosen[key.Motor] = true
	end

	for key in raw.SelectedChannelKeyframes or {} do
		chosen[key.Motor] = true
	end

	local result = {}
	for _, entry in Scene.entries() do
		local include = chosen[entry.motor]
		for _, object in objects do
			if
				object == entry.rig
				or object == entry.motor
				or object == Scene.part(entry.motor)
				or Scene.part(entry.motor):IsDescendantOf(object)
			then
				include = true
				break
			end
		end

		if include then
			table.insert(result, entry.motor)
		end
	end

	return result
end

function Scene.setGuides(motors, points, easing)
	Timing.validate(easing)
	require("Path").validate({ guide = { points = points, smoothing = 0 } })
	assert(#motors > 0, "select parts for this path first")
	local session = Scene.get()
	for _, motor in motors do
		assert(session.entries[motor], "add these parts to Physics first")
	end

	local before = {}
	for _, guide in Scene.paths() do
		before[guide.motor] = guide
	end

	local after = table.clone(before)
	local origin = Scene.world(Scene.part(motors[1])).Position
	for _, motor in motors do
		local shifted = {}
		local offset = Scene.world(Scene.part(motor)).Position - origin
		for i, point in points do
			shifted[i] = point + offset
		end

		after[motor] = {
			motor = motor,
			points = shifted,
			strength = 35,
			easing = easing and Timing.copy(easing),
		}
	end

	local function apply(paths)
		session.guides = table.clone(paths)
		session.guide = select(2, next(paths))
		changed()
	end

	apply(after)
	History.record(function()
		apply(before)
	end, function()
		apply(after)
	end, "Set physics paths")
end

function Scene.setGuide(motor, points, easing)
	Scene.setGuides({ motor }, points, easing)
end

function Scene.clearGuide(motor)
	local session = Scene.get()
	local before = {}
	for _, guide in Scene.paths() do
		before[guide.motor] = guide
	end

	local after = motor and table.clone(before) or {}
	if motor then
		after[motor] = nil
	end

	local function apply(paths)
		session.guides = table.clone(paths)
		session.guide = select(2, next(paths))
		changed()
	end

	apply(after)
	History.record(function()
		apply(before)
	end, function()
		apply(after)
	end, "Clear physics guide")
end

function Scene.addForce()
	local session = Scene.get()
	assert(#session.forces < 16, "use up to 16 blast forces")
	local motor = Scene.guideMotor()
	local camera = workspace.CurrentCamera
	local position = motor and Scene.world(Scene.part(motor)).Position
		or camera.CFrame.Position + camera.CFrame.LookVector * 10
	local part = Instance.new("Part")

	local number = 1
	local names = {}
	for _, force in session.forces do
		names[force.Name] = true
	end

	while names["Blast " .. number] do
		number += 1
	end

	part.Name = "Blast " .. number
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.one
	part.CFrame = CFrame.new(position)
	part.Anchored = true
	part.CanCollide, part.CanTouch, part.CanQuery = false, false, true
	part.Transparency = 0.35
	part.Color = Color3.fromRGB(242, 171, 196)
	part.Material = Enum.Material.Neon
	part:SetAttribute("EclipsePhysicsForce", true)
	part:SetAttribute(
		"Frame",
		math.floor(
			refs.State.Timeline:GetState().CurrentTime * refs.State.Timeline:GetState().FPS + 0.5
		)
	)
	part:SetAttribute("Radius", 5)
	part:SetAttribute("Power", 60)
	part:SetAttribute("ForceType", "Blast")
	part:SetAttribute("Duration", 60)
	part:SetAttribute("Spin", 1)
	part:SetAttribute("Launch", 0)
	part.Parent = workspace

	local function add()
		part.Parent = workspace
		if not table.find(session.forces, part) then
			table.insert(session.forces, part)
		end

		changed()
	end

	local function remove()
		local at = table.find(session.forces, part)
		if at then
			table.remove(session.forces, at)
		end

		part.Parent = nil
		changed()
	end

	add()
	History.record(remove, add, "Add blast force")
	return part
end

function Scene.registerForce(part)
	assert(
		part and part:IsA("BasePart") and part:GetAttribute("EclipsePhysicsForce"),
		"select an Eclipse Blast part first"
	)
	local forces = Scene.get().forces
	if not table.find(forces, part) then
		assert(#forces < 16, "use up to 16 blast forces")
		table.insert(forces, part)
		changed()
	end
end

function Scene.removeForce(part)
	local session = Scene.get()
	local before = table.clone(session.forces)
	local at = table.find(before, part)
	assert(at, "This blast was already removed")
	local after = table.clone(before)
	table.remove(after, at)
	local parent = part.Parent

	local function apply(forces, location)
		session.forces = table.clone(forces)
		part.Parent = location
		changed()
	end

	apply(after, nil)
	History.record(function()
		apply(before, parent)
	end, function()
		apply(after, nil)
	end, "Remove blast")
end

function Scene.setForcePath(part, points, easing)
	Timing.validate(easing)
	assert(part and table.find(Scene.get().forces, part), "Select a force first")
	require("Path").validate({ force = { points = points, smoothing = 0 } })
	local offsets = {}
	for _, point in points do
		table.insert(offsets, point - points[1])
	end

	local before = part:GetAttribute("ForcePath")
	local beforeFrame = part.CFrame
	local afterFrame = CFrame.new(points[1]) * beforeFrame.Rotation
	local after = Document.pack({ points = offsets, easing = easing and Timing.copy(easing) })

	local function apply(value, frame)
		part:SetAttribute("ForcePath", value)
		part.CFrame = frame
		changed()
	end

	apply(after, afterFrame)
	History.record(function()
		apply(before, beforeFrame)
	end, function()
		apply(after, afterFrame)
	end, "Draw force path")
end

function Scene.clearForcePath(part)
	local before = part:GetAttribute("ForcePath")

	local function apply(value)
		part:SetAttribute("ForcePath", value)
		changed()
	end

	apply(nil)
	History.record(function()
		apply(before)
	end, function()
		apply(nil)
	end, "Clear force path")
end

function Scene.guideChanged(clip)
	local guides = Scene.paths()
	local saved = clip.settings.guides or (clip.settings.guide and { clip.settings.guide } or {})
	if #guides ~= #saved then
		return true
	end

	for i, guide in guides do
		local old = saved[i]
		if not Timing.equal(guide.easing, old.easing) then
			return true
		end

		local motor = clip.guideMotors and clip.guideMotors[old.index] or clip.guideMotor
		if motor and motor ~= guide.motor or #guide.points ~= #old.points then
			return true
		end

		for j, point in guide.points do
			if point ~= old.points[j] then
				return true
			end
		end
	end

	return false
end

function Scene.forcesChanged(clip)
	if not clip then
		return false
	end

	local saved = clip.settings.forces or {}
	local forces = Scene.get().forces
	if #saved ~= #forces then
		return true
	end

	for i, part in forces do
		local old = saved[i]
		if
			(part:GetAttribute("ForceType") == "BlackHole" or part:GetAttribute("ForcePath"))
			and (old.duration or 60) ~= (part:GetAttribute("Duration") or 60)
		then
			return true
		end

		if (old.kind or "Blast") ~= (part:GetAttribute("ForceType") or "Blast") then
			return true
		end

		if
			(old.spin or 1) ~= (part:GetAttribute("Spin") or 1)
			or (old.launch or 0) ~= (part:GetAttribute("Launch") or 0)
			or old.pathSource ~= part:GetAttribute("ForcePath")
		then
			return true
		end

		if
			not part.Parent
			or old.position ~= part.Position
			or old.frame ~= part:GetAttribute("Frame")
			or old.radius ~= part:GetAttribute("Radius")
			or old.power ~= part:GetAttribute("Power")
		then
			return true
		end
	end

	return false
end

function Scene.snapshot(settings, entries)
	local session = Scene.get()
	settings.forces = {}
	for _, part in session.forces do
		assert(part.Parent, "a blast part was removed; remove it from Forces too")
		local pathData = part:GetAttribute("ForcePath")
			and Document.unpack(part:GetAttribute("ForcePath"))
		table.insert(settings.forces, {
			easing = pathData and pathData.easing,
			kind = part:GetAttribute("ForceType") or "Blast",
			duration = part:GetAttribute("Duration") or 60,
			spin = part:GetAttribute("Spin") or 1,
			launch = part:GetAttribute("Launch") or 0,
			pathSource = part:GetAttribute("ForcePath"),
			path = pathData and pathData.points,
			position = part.Position,
			frame = part:GetAttribute("Frame"),
			radius = part:GetAttribute("Radius"),
			power = part:GetAttribute("Power"),
		})
	end

	settings.guide = nil
	settings.guides = {}
	for _, guide in Scene.paths() do
		local index
		for i, entry in entries do
			if entry.motor == guide.motor then
				index = i
				break
			end
		end

		assert(index, "the guided bone is no longer in this simulation")
		table.insert(settings.guides, {
			index = index,
			points = table.clone(guide.points),
			strength = guide.strength or 35,
			easing = guide.easing and Timing.copy(guide.easing),
		})
	end

	return settings
end

function Scene.write(save)
	local session = Scene.get()
	local old = save:FindFirstChild("EclipsePhysicsSetup")
	if old then
		old:Destroy()
	end

	local folder = Instance.new("Folder")

	folder.Name = "EclipsePhysicsSetup"
	local functionRef = function(name, value)
		local ref = Instance.new("ObjectValue")

		ref.Name, ref.Value, ref.Parent = name, value, folder
		return ref
	end

	for _, entry in Scene.entries() do
		local ref = functionRef("Participant", Scene.part(entry.motor))
		ref:SetAttribute("Ragdoll", entry.ragdoll)
	end

	for _, part in session.forces do
		if part.Parent then
			functionRef("Force", part)
		end
	end

	for _, guide in Scene.paths() do
		local object = functionRef("Guide", Scene.part(guide.motor))
		Data.write(
			object,
			"Path",
			Document.pack({
				points = guide.points,
				strength = guide.strength,
				easing = guide.easing,
			})
		)
	end

	folder.Parent = save
end

function Scene.load(save)
	local session = Scene.get()
	session.entries, session.forces, session.guide, session.guides = {}, {}, nil, {}
	local folder = save and save:FindFirstChild("EclipsePhysicsSetup")
	if not folder then
		return
	end

	local byPart = {}
	for _, entry in Scene.all() do
		byPart[Scene.part(entry.motor)] = entry
	end

	for _, ref in folder:GetChildren() do
		if not ref:IsA("ObjectValue") or not ref.Value then
			continue
		end

		if ref.Name == "Participant" then
			local entry = byPart[ref.Value]
			if entry then
				entry.ragdoll = ref:GetAttribute("Ragdoll") == true
				session.entries[entry.motor] = entry
			end
		elseif ref.Name == "Force" and ref.Value.Parent then
			table.insert(session.forces, ref.Value)
		elseif ref.Name == "Guide" and byPart[ref.Value] and ref:FindFirstChild("Path") then
			local guide = Document.unpack(Data.read(ref.Path))
			require("Path").validate({
				guide = { points = guide.points, smoothing = 0, easing = guide.easing },
			})
			guide.motor = byPart[ref.Value].motor
			session.guides[guide.motor] = guide
			session.guide = guide
		elseif ref.Name == "GuidePart" and byPart[ref.Value] and folder:FindFirstChild("Guide") then
			local guide = Document.unpack(Data.read(folder.Guide))
			require("Path").validate({
				guide = { points = guide.points, smoothing = 0, easing = guide.easing },
			})
			guide.motor = byPart[ref.Value].motor
			session.guide = guide
			session.guides[guide.motor] = guide
		end
	end
end

function Scene.remapLive(state, mapping)
	local session = sessions[state.Timeline:GetState().Keyframes]
	if not session then
		return
	end

	local entries, guides = {}, {}
	for motor, entry in session.entries do
		local copy = table.clone(entry)
		copy.motor = mapping[motor] or motor
		copy.rig = mapping[entry.rig] or entry.rig
		entries[copy.motor] = copy
	end

	for motor, guide in session.guides or {} do
		local copy = table.clone(guide)
		copy.motor = mapping[motor] or motor
		guides[copy.motor] = copy
	end

	if session.guide then
		local copy = table.clone(session.guide)
		copy.motor = mapping[copy.motor] or copy.motor
		session.guide = copy
	end

	session.entries, session.guides = entries, guides
	for i, force in session.forces do
		session.forces[i] = mapping[force] or force
	end
end

function Scene.liveSnapshot(state, motorIds, rigIds)
	local session = sessions[state.Timeline:GetState().Keyframes]
	local value = { participants = {}, guides = {}, forces = {} }
	if not session then
		return value
	end

	for motor, entry in session.entries do
		local id = motorIds[motor]
		if id then
			value.participants[id] = { rig = rigIds[entry.rig], ragdoll = entry.ragdoll == true }
		end
	end

	for motor, guide in session.guides or {} do
		local id = motorIds[motor]
		if id then
			local copy = table.clone(guide)
			copy.motor = nil
			value.guides[id] = copy
		end
	end

	for _, force in session.forces do
		local path = force.Parent and require("Paths").of(force, game)
		if path then
			table.insert(value.forces, path)
		end
	end

	return value
end

function Scene.prepareLive(state, value, motors, rigs)
	local entries, guides, forces = {}, {}, {}
	for id, saved in value.participants or {} do
		local motor = motors[id]
		if not motor or not rigs[saved.rig] then
			continue
		end

		entries[motor] = {
			motor = motor,
			rig = assert(rigs[saved.rig], "Waiting for shared physics rig"),
			ragdoll = saved.ragdoll == true,
		}
	end

	for id, saved in value.guides or {} do
		local motor = motors[id]
		if not motor then
			continue
		end

		require("Path").validate({
			guide = { points = saved.points, smoothing = 0, easing = saved.easing },
		})
		local guide = table.clone(saved)
		guide.motor = motor
		guides[motor] = guide
	end

	for _, path in value.forces or {} do
		local force = require("Paths").resolve(game, path)
		assert(force and force:IsA("BasePart"), "Waiting for shared physics force")
		table.insert(forces, force)
	end

	return function()
		local raw = state.Timeline:GetState()
		sessions[raw.Keyframes] =
			{ entries = entries, guides = guides, guide = nil, forces = forces }
	end
end

function Scene.init(options)
	refs = options
end

return Scene
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a401</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1976">
          <Properties>
            <string name="Name">PropertyGizmo</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f5b</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{750DDD5C-26BA-4B18-A3B3-5FE9A84683C2}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)
local Shortcuts = require("Shortcuts")

local Tracks = require("Properties")
local Input = require("UserInputService")
local Edit = require("BlenderEdit")
local History = require("History")
local Cursor = require("RotateCursor")
local Run = game:GetService("RunService")
local Preferences = require("Preferences")
local Resize = require("Resize")
local Gizmo = {}

local function read(motor)
	if motor.IsEclipseScaleAdapter then
		return motor.read()
	end

	return Tracks.readValue(motor.Rig, motor.PropertyId)
end

local function write(motor, value, saved, offset)
	if motor.IsEclipseScaleAdapter then
		motor.write(value, saved, offset)
	else
		Tracks.setValue(motor, value)
		if saved and saved.placement then
			Resize.placeProperty(motor, saved, offset or Vector3.zero)
		end
	end
end

local refs, target, visual, drag, connection
local connections = {}
local handles = {}
local visualConnections = {}
local hovered, hoverMouse, previousIcon, hoverIcon

local function clearHover()
	if hoverMouse and hoverIcon and hoverMouse.Icon == hoverIcon then
		hoverMouse.Icon = previousIcon
	end

	hovered, hoverMouse, previousIcon, hoverIcon = nil, nil, nil, nil
end

local function setHover(handle, camera, center)
	if not handle then
		clearHover()
		return
	end

	local position = camera:WorldToViewportPoint(handle.part.Position)
	local pivot = camera:WorldToViewportPoint(center)
	local delta = Vector2.new(position.X - pivot.X, position.Y - pivot.Y)
	local icon
	if math.abs(delta.Y) < math.abs(delta.X) * 0.5 then
		icon = "SizeEW"
	elseif math.abs(delta.X) < math.abs(delta.Y) * 0.5 then
		icon = "SizeNS"
	elseif delta.X * delta.Y > 0 then
		icon = "SizeNWSE"
	else
		icon = "SizeNESW"
	end

	icon = "rbxasset://SystemCursors/" .. icon
	if hovered ~= handle or hoverIcon ~= icon then
		clearHover()
		hovered = handle
		hoverMouse = refs.Plugin:GetMouse()
		local _, iconBefore = require("Cursor").snapshot(hoverMouse)
		previousIcon = iconBefore
		hoverIcon = icon
		hoverMouse.Icon = icon
	end
end

local function hit(camera, mouse)
	local nearest, distance = nil, math.huge
	for _, handle in handles do
		local point, onScreen = camera:WorldToViewportPoint(handle.part.Position)
		local gap = (Vector2.new(point.X, point.Y) - mouse).Magnitude
		if onScreen and gap <= (handle.hitRadius or 14) and gap < distance then
			nearest, distance = handle, gap
		end
	end

	return nearest
end

local function destroyVisual()
	clearHover()
	for _, item in visualConnections do
		item:Disconnect()
	end

	table.clear(visualConnections)
	if visual then
		visual:Destroy()
		visual = nil
	end

	table.clear(handles)
end

local bounds = Resize.bounds

local function available()
	return refs
		and target
		and target.Parent
		and target.Rig.Parent
		and (target.IsEclipseScaleAdapter or Tracks.enabled(target.Rig, target.PropertyId))
		and (target.PropertyId == "CFrame" or Preferences.get("ScaleGizmo") ~= false)
		and not Edit.blocked()
		and (not refs.State.PresentationHidden or refs.State.CameraPoseMode and not refs.State.CameraBonesHidden)
		and refs.Active()
		and not refs.State.Timeline:GetState().Playing
		and refs.ScreenGui.Enabled
		and (refs.AnimatorFrame.Visible or refs.State.CameraPoseMode)
end

function Gizmo.isEditing()
	return drag ~= nil
end

function Gizmo.finish(cancel)
	if not drag then
		return false
	end

	if not cancel and (drag.mode == "pointer" or drag.mode == "handles") then
		Gizmo.change(Input:GetMouseLocation())
	end

	local saved = drag
	drag = nil
	if saved.motor.PropertyId == "CFrame" then
		local axis = refs.State.Axis
		axis:StopBlenderRotate(cancel)
		axis:StopBlenderGrab()
		axis:StopDrag()
	end

	if saved.mode == "pointer" or saved.mode == "handles" then
		Cursor.stop()
	end

	clearHover()
	local motor = saved.motor
	if not motor.Parent then
		return true
	end

	local timeline = refs.State.Timeline
	local raw = timeline:GetState()
	if motor.IsEclipseScaleAdapter then
		motor.finish(saved, cancel)
		return true
	end

	if saved.placement then
		Resize.finishProperty(refs, saved, cancel)
		return true
	end

	if cancel then
		Tracks.setValue(motor, saved.value)
		if motor.PropertyId == "CFrame" then
			refs.State.Axis:RefreshAxis()
		end

		return true
	end

	local value = Tracks.readValue(motor.Rig, motor.PropertyId)
	if value == saved.value then
		return true
	end

	require("HumanoidScale").propertyChanged(motor, saved.value, value)
	if timeline:IsRecording() then
		local before = timeline:_snapshotMotorBucket(motor)
		timeline:RecordKeyframeForMotorAtCurrentTime(
			motor.Part1,
			motor,
			Tracks.encode(value),
			{ Frame = saved.frame, PropertyValue = value },
			refs.State.UIHelpers.SanitizeName
		)
		local after = timeline:_snapshotMotorBucket(motor)

		local function apply(bucket)
			if not motor.Parent then
				return
			end

			timeline:_restoreMotorBucket(motor, bucket)
			timeline:ApplyPoseAtTime(motor.Rig, raw.CurrentTime, { OnlyRig = true })
			refs.State.currentProjectSaved = false
		end

		apply(after)
		History.record(function()
			apply(before)
		end, function()
			apply(after)
		end, motor.PropertyId .. " " .. motor.Rig.Name)
	else
		local Document = require("Document")
		local beforeDefault = motor.DefaultValue

		local function apply(v, default)
			if not motor.Parent then
				return
			end

			motor.Part1:SetAttribute("Default", Document.pack(default))
			raw.DefaultPose[motor] = Tracks.encode(default)
			Tracks.setValue(motor, v)
			refs.State.currentProjectSaved = false
		end

		apply(value, value)
		History.record(function()
			apply(saved.value, beforeDefault)
		end, function()
			apply(value, value)
		end, motor.PropertyId .. " " .. motor.Rig.Name)
	end

	refs.State.currentProjectSaved = false
	return true
end

function Gizmo.reset()
	if drag or not available() or Input:GetFocusedTextBox() or target.PropertyId == "CFrame" then
		return false
	end

	local motor = target
	local value = motor.DefaultValue
	if value == nil or read(motor) == value then
		return false
	end

	local saved = {
		motor = motor,
		mode = "reset",
		value = read(motor),
		frame = refs.State.Timeline:TimeToFrame(refs.State.Timeline:GetState().CurrentTime),
		placement = motor.IsEclipseScaleAdapter and motor.capture()
			or Resize.captureProperty(motor, refs.State.Timeline:GetState()),
	}
	write(motor, value)
	drag = saved
	Gizmo.finish(false)
	return true
end

function Gizmo.select(motor)
	if target == motor then
		if target and target.PropertyId == "CFrame" then
			refs.State.Axis:SetPropertyTarget(target)
		end

		return
	end

	Gizmo.finish(true)
	destroyVisual()
	target = nil
	if typeof(motor) == "table" and motor.IsEclipseScaleAdapter then
		target = motor
	elseif
		Tracks.is(motor)
		and (
			(
				motor.PropertyId == "CFrame"
				and (
					motor.Rig:IsA("Model")
					or motor.Rig:IsA("BasePart")
					or motor.Rig:IsA("Attachment")
				)
			)
			or (motor.PropertyId == "Scale" and (motor.Rig:IsA("Model") or motor.Rig:IsA(
				"DataModelMesh"
			) and motor.Rig:FindFirstAncestorWhichIsA("BasePart")))
			or (motor.PropertyId == "Size" and motor.Rig:IsA("BasePart"))
		)
	then
		target = motor
	end

	if refs and refs.State.Axis then
		refs.State.Axis:SetPropertyTarget(
			target and target.PropertyId == "CFrame" and target or nil
		)
	end
end

function Gizmo.begin(mode, name)
	if drag or not available() or Input:GetFocusedTextBox() or Input.inWidget() then
		return false
	end

	refs.Finalize()
	local motor = target
	local cf, size = bounds(motor.Rig)
	if motor.PropertyId == "CFrame" then
		cf = motor.Rig:IsA("Attachment") and motor.Rig.WorldCFrame
			or Tracks.readValue(motor.Rig, "CFrame")
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return false
	end

	local projection = camera:WorldToViewportPoint(cf.Position)
	if projection.Z <= 0 then
		return false
	end

	local mouse = Input:GetMouseLocation()
	local center = Vector2.new(projection.X, projection.Y)
	local axis, unit, pixels, sign
	if mode == "handles" then
		axis = name:sub(-1)
		sign = name:sub(1, 1) == "-" and -1 or 1
		local direction = cf:VectorToWorldSpace(
			axis == "X" and Vector3.xAxis or axis == "Y" and Vector3.yAxis or Vector3.zAxis
		) * sign
		local along = camera:WorldToViewportPoint(cf.Position + direction)
		local delta = Vector2.new(along.X - projection.X, along.Y - projection.Y)
		if delta.Magnitude < 0.01 then
			return false
		end

		unit, pixels = delta.Unit, delta.Magnitude
	end

	drag = {
		motor = motor,
		mode = mode,
		value = read(motor),
		mouse = mouse,
		center = center,
		radius = (mouse - center).Magnitude,
		unit = unit,
		pixels = pixels,
		size = size,
		cf = cf,
		sign = sign,
		axis = axis,
		handle = name,
		frame = refs.State.Timeline:TimeToFrame(refs.State.Timeline:GetState().CurrentTime),
	}
	if motor.IsEclipseScaleAdapter then
		drag.placement = motor.capture()
	elseif motor.PropertyId ~= "CFrame" then
		drag.placement = Resize.captureProperty(motor, refs.State.Timeline:GetState())
	end

	if motor.PropertyId == "CFrame" then
		local axis = refs.State.Axis
		local started
		if mode == "move" then
			started = axis:StartBlenderGrab(mouse)
		elseif mode == "rotate" then
			started = axis:StartBlenderRotate(mouse, false)
		elseif mode == "axisHandle" then
			started = axis:StartDrag(name, mouse)
		end

		if not started then
			drag = nil
			return false
		end
	elseif mode == "pointer" or mode == "handles" then
		clearHover()
		Cursor.start(cf.Position, true)
	end

	return true
end

function Gizmo.start(mode)
	if not available() then
		return false
	end

	if drag then
		if drag.motor.PropertyId == "CFrame" and drag.mode == "rotate" and mode ~= "move" then
			refs.State.Axis:EnterTrackballRotate()
		end

		return true
	end

	if target.PropertyId == "CFrame" then
		return Gizmo.begin(mode == "move" and "move" or "rotate")
	end

	if mode == "move" then
		return false
	end

	return Gizmo.begin("pointer")
end

function Gizmo.change(point)
	if not drag then
		return
	end

	local value, offset
	if drag.motor.PropertyId == "CFrame" then
		local axis = refs.State.Axis
		if drag.mode == "move" then
			axis:ProcessBlenderGrab(point)
		elseif drag.mode == "rotate" then
			axis:ProcessBlenderRotate(point)
		elseif drag.mode == "axisHandle" then
			axis:ProcessDrag(point)
		end

		return
	elseif drag.mode == "pointer" then
		local factor = tonumber(drag.numeric)
			or math.max(
				0.001,
				1 + ((point - drag.center).Magnitude - drag.radius) / math.max(60, drag.radius)
			)
		factor = math.clamp(factor, 0.001, 10000)
		if drag.axis and typeof(drag.value) == "Vector3" then
			local mask = drag.axis == "X" and Vector3.xAxis
				or drag.axis == "Y" and Vector3.yAxis
				or Vector3.zAxis
			value = drag.value * (Vector3.one + mask * (factor - 1))
		else
			value = drag.value * factor
		end

		if typeof(value) == "number" then
			value = math.clamp(value, 0.001, 10000)
		else
			value = Vector3.new(
				math.max(0.001, value.X),
				math.max(0.001, value.Y),
				math.max(0.001, value.Z)
			)
		end
	else
		local distance = (point - drag.mouse):Dot(drag.unit) / math.max(1, drag.pixels)
		local symmetric = Input:IsKeyDown(Enum.KeyCode.LeftControl)
			or Input:IsKeyDown(Enum.KeyCode.RightControl)
		local uniform = Input:IsKeyDown(Enum.KeyCode.LeftAlt)
			or Input:IsKeyDown(Enum.KeyCode.RightAlt)
		value, offset = Resize.resolve(drag, distance, symmetric, uniform)
	end

	write(drag.motor, value, drag, offset or Vector3.zero)
	Resize.syncBones(refs.State, drag.motor.Rig)
end

function Gizmo.input(input, processed)
	if drag then
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			Gizmo.finish(false)
			return false
		elseif Shortcuts.matches("Cancel", input) then
			Gizmo.finish(true)
		elseif
			(drag.mode == "pointer" or drag.mode == "move" or drag.mode == "rotate")
			and (
				input.UserInputType == Enum.UserInputType.MouseButton1
				or Shortcuts.matches("ConfirmTransform", input)
				or Shortcuts.matches("ConfirmTransformAlternate", input)
			)
		then
			Gizmo.finish(false)
		end

		if
			drag
			and drag.mode == "pointer"
			and input.UserInputType == Enum.UserInputType.Keyboard
		then
			local key = input.KeyCode.Name
			if key == "X" or key == "Y" or key == "Z" then
				key = Preferences.axisName(key)
			end

			if (key == "X" or key == "Y" or key == "Z") and typeof(drag.value) == "Vector3" then
				drag.axis = drag.axis ~= key and key or nil
			elseif key == "Backspace" then
				drag.numeric = (drag.numeric or ""):sub(1, -2)
			elseif key == "Period" or key == "KeypadPeriod" then
				if not (drag.numeric or ""):find(".", 1, true) then
					drag.numeric = (drag.numeric or "") .. "."
				end
			else
				local digits = {
					Zero = "0",
					One = "1",
					Two = "2",
					Three = "3",
					Four = "4",
					Five = "5",
					Six = "6",
					Seven = "7",
					Eight = "8",
					Nine = "9",
					KeypadZero = "0",
					KeypadOne = "1",
					KeypadTwo = "2",
					KeypadThree = "3",
					KeypadFour = "4",
					KeypadFive = "5",
					KeypadSix = "6",
					KeypadSeven = "7",
					KeypadEight = "8",
					KeypadNine = "9",
				}
				if digits[key] and #(drag.numeric or "") < 12 then
					drag.numeric = (drag.numeric or "") .. digits[key]
				end
			end

			Gizmo.change(Input:GetMouseLocation())
		end

		return true
	end

	if
		processed
		or not available()
		or Input.inWidget()
		or Input:GetFocusedTextBox()
		or input.UserInputType ~= Enum.UserInputType.MouseButton1
	then
		return false
	end

	local mouse = Input:GetMouseLocation()
	local camera = workspace.CurrentCamera
	if target.PropertyId == "CFrame" then
		local axis = refs.State.Axis:GetAxisUnderMouse()
		return axis ~= nil and Gizmo.begin("axisHandle", axis)
	end

	local nearest = hit(camera, mouse)
	return nearest ~= nil and Gizmo.begin("handles", nearest.part.Name)
end

local function step()
	if not available() then
		if drag then
			Gizmo.finish(true)
		end

		destroyVisual()
		return
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	if target.PropertyId == "CFrame" then
		if drag then
			Gizmo.change(Input:GetMouseLocation())
		end

		if not visual then
			visual = Instance.new("Part")
			visual.Name = "EclipsePropertyCFrame"
			visual.Archivable = false
			visual.Anchored = true
			visual.CanCollide = false
			visual.CanTouch = false
			visual.CanQuery = false
			visual.Transparency = 1
			visual:SetAttribute("EclipsePropertyGizmo", true)
			require("Recovery").mark(visual)
			local marker = Instance.new("BoxHandleAdornment")
			marker.Name = "CFrameHandle"
			marker.Adornee = visual
			marker.AlwaysOnTop = true
			marker.ZIndex = 1
			marker.Color3 = Color3.fromRGB(124, 186, 209)
			marker.Parent = visual
		end

		local _, size = bounds(target.Rig)
		visual.CFrame = target.Rig:IsA("Attachment") and target.Rig.WorldCFrame
			or Tracks.readValue(target.Rig, "CFrame")
		visual.Parent = camera
		visual.CFrameHandle.Size = Vector3.new(
			math.max(0.2, size.X * 0.28),
			math.max(0.2, size.Y * 0.28),
			math.max(0.2, size.Z * 0.28)
		)
		visual.CFrameHandle.Transparency = (Preferences.get("HandleBoneTransparency") or 55) / 100
		return
	end

	if not visual then
		local template = refs.Template
		if not template then
			return
		end

		visual = template:Clone()
		visual.Name = "EclipsePropertyScale"
		visual.Archivable = false
		visual.Parent = camera
		visual:SetAttribute("EclipsePropertyGizmo", true)
		require("Recovery").mark(visual)
		for _, part in visual:GetChildren() do
			if part:IsA("BasePart") then
				part.Anchored = true
				part.CanCollide = false
				part.CanTouch = false
				part.CanQuery = false
				part.Transparency = 1
				if not part.Name:match("^[+-][XYZ]$") then
					continue
				end

				local color = part.Color
				for _, adornment in part:GetChildren() do
					if adornment:IsA("HandleAdornment") then
						color = adornment.Color3
						adornment:Destroy()
					end
				end

				local position = template.Parent:FindFirstChild("Position")
				local axisPart = position and position:FindFirstChild(part.Name)
				local axisAdornment = axisPart
					and axisPart:FindFirstChildWhichIsA("HandleAdornment", true)
				if axisAdornment then
					color = axisAdornment.Color3
				end

				local adornment = Instance.new("SphereHandleAdornment")
				adornment.Name = "ScaleHandle"
				adornment.Adornee = part
				adornment.Color3 = color
				adornment.AlwaysOnTop = true
				adornment.ZIndex = 3
				adornment.Transparency = 0.85
				adornment.Parent = part
				table.insert(handles, { part = part, adornment = adornment, color = color })
			end
		end
	end

	if visual.Parent ~= camera then
		visual.Parent = camera
	end

	if drag then
		Gizmo.change(Input:GetMouseLocation())
	end

	local cf, size = bounds(target.Rig)
	if not drag and not Input.inWidget() and not Input:GetFocusedTextBox() then
		setHover(hit(camera, Input:GetMouseLocation()), camera, cf.Position)
	else
		clearHover()
	end

	local unit = 2
		* math.tan(math.rad(camera.FieldOfView) * 0.5)
		/ math.max(1, camera.ViewportSize.Y)
	for _, handle in handles do
		local part = handle.part
		local axis = part.Name:sub(-1)
		local sign = part.Name:sub(1, 1) == "-" and -1 or 1
		handle.adornment.Color3 = Preferences.get("BlenderAxes")
				and Preferences.axisColor(axis, {
					X = Color3.fromRGB(255, 88, 88),
					Y = Color3.fromRGB(92, 220, 92),
					Z = Color3.fromRGB(92, 140, 255),
				})
			or handle.color
		local direction = (
			axis == "X" and Vector3.xAxis
			or axis == "Y" and Vector3.yAxis
			or Vector3.zAxis
		) * sign
		local depth = math.max(0.1, -camera.CFrame:PointToObjectSpace(cf.Position).Z)
		local scale = (Preferences.get("GizmoSize") or 0.5) / 0.5
		local pixels = depth * unit * scale
		local length = size[axis] * 0.5
			+ pixels * (11 + 8 * (Preferences.get("GizmoDistance") or 2.5) / 2.5)
		local offset = direction * length
		part.CFrame = cf * CFrame.new(offset)
		depth = -camera.CFrame:PointToObjectSpace(part.Position).Z
		local active = drag and drag.mode == "handles" and part.Name == drag.handle
		local hot = hovered == handle
		local radius = (active and 13 or hot and 12 or 11) * scale
		handle.adornment.Radius = math.max(0.001, depth * unit * radius)
		handle.hitRadius = radius + 4
		handle.adornment.Transparency = active and 0.35 or hot and 0.65 or drag and 1 or 0.85
		handle.adornment.Visible = depth > 0 and not (drag and drag.mode == "pointer")
	end
end

function Gizmo.destroy()
	Gizmo.select(nil)
	if connection then
		connection:Disconnect()
		connection = nil
	end

	for _, item in connections do
		item:Disconnect()
	end

	connections = {}
end

function Gizmo.init(options)
	Gizmo.destroy()
	refs = options
	options.State.PropertyGizmo = Gizmo
	connection = Run.RenderStepped:Connect(step)
	table.insert(
		connections,
		Input.InputEnded:Connect(function(input)
			if
				drag
				and (drag.mode == "handles" or drag.mode == "axisHandle")
				and input.UserInputType == Enum.UserInputType.MouseButton1
			then
				Gizmo.finish(false)
			end
		end)
	)
	table.insert(
		connections,
		Input.WindowFocusReleased:Connect(function()
			Gizmo.finish(true)
			clearHover()
		end)
	)
	options.Plugin.Unloading:Once(Gizmo.destroy)
	options.ScreenGui.Destroying:Once(Gizmo.destroy)
end

return Gizmo
]]></string>
