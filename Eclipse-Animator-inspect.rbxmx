        <Item class="ModuleScript" referent="2163">
          <Properties>
            <string name="Name">Buttons</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000029016</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
