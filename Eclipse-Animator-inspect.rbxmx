					multiplyNumbers = { "Rate", "Drag" },
					divideRanges = { "Lifetime" },
					multiplyGraphs = { "Speed", "RotSpeedX", "RotSpeedY", "RotSpeedZ" },
					scaleVectors = { "Acceleration" },
				},
				clipboard = {
					{
						name = "Spawning",
						props = { "Rate", "Lifetime", "SpreadAngle", "EmissionDirection" },
					},
					{ name = "Scale", props = { "Scale" } },
					{
