        <Item class="ModuleScript" referent="1933">
          <Properties>
            <string name="Name">Bones</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f30</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{D0F79DC5-F476-4884-ADEF-BF0128495785}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local Codec = require("SceneCodec")
local Paths = require("Paths")
local History = require("History")
local Bones = {}

function Bones.apply(refs, entry, packet, changed)
	assert(entry and not entry.camera, "Choose a paired rig to sync bones.")
	assert(typeof(packet.bones) == "table" and #packet.bones <= 10000, "Invalid Blender bone list.")
	local raw, rig = refs.State.Timeline:GetState(), entry.rig
	local known, rest, names, created, defaults, existing = {}, {}, {}, {}, {}, {}
	local additions = {}
	local addedCount = 0
	local data = Codec.capture(refs)
	for _, row in data.rigs do
		if row.id == entry.id then
			for _, track in row.tracks do
				rest[track.id] = Codec.unpack(track.rest)
			end
		end
	end

	for name, id in packet.mapped or {} do
		local motor = assert(entry.byId[id], "Blender mapping changed; pair the rig again.")
		known[name] = { part = motor.Part1, world = rest[id] }
	end

	for _, object in rig:GetDescendants() do
		if object:IsA("BasePart") or object:IsA("Bone") then
			names[object.Name] = true
			local source = object:GetAttribute("EclipseBlenderSource")
			if source then
				existing[source] = object
			end
		end
	end

	local validated = {}
	for _, spec in packet.bones do
		assert(
			typeof(spec.name) == "string"
				and #spec.name > 0
				and #spec.name <= 100
				and (
					not names[spec.name]
					or existing[spec.source] and existing[spec.source].Name == spec.name
				),
			"A bone or part already uses this name: " .. tostring(spec.name)
		)
		assert(typeof(spec.source) == "string" and #spec.source > 0, "Missing Blender bone name.")
		assert(not validated[spec.source], "Duplicate Blender bone: " .. spec.source)
		assert(
			not spec.parent or known[spec.parent] or validated[spec.parent],
			"Missing parent for " .. spec.name
		)
		validated[spec.source], names[spec.name] = Codec.unpack(spec.world), true
	end

	local function rebuild()
		refs.State.Timeline:InvalidateMotorListCache()
		if refs.State.Rig and refs.State.Rig.BuildRigHierarchy then
			refs.State.Rig:BuildRigHierarchy(refs.State.currentRig)
		end

		refs.State.currentProjectSaved = false
	end

	local ok, err = xpcall(function()
		for _, spec in packet.bones do
			if existing[spec.source] then
				local part = existing[spec.source]
				known[spec.source] = { part = part, world = validated[spec.source] }
				additions[Paths.of(part, rig)] = spec.source
				continue
			end

			local parent = spec.parent and known[spec.parent]
			local part0 = parent and parent.part or rig.PrimaryPart
			assert(part0, "Set a PrimaryPart before syncing a root bone.")
			local world = validated[spec.source]
			local parentWorld = parent and parent.world or part0.CFrame
			local part, motor
			if part0:IsA("Bone") then
				part = Instance.new("Bone")
				part.Name, part.CFrame = spec.name, parentWorld:ToObjectSpace(world)
				part.Parent = part0
				table.insert(created, { object = part, parent = part0 })
			else
				part = Instance.new("Part")
				part.Name, part.Size, part.Transparency = spec.name, Vector3.new(0.2, 0.2, 0.2), 1
				part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch, part.Massless =
					true, false, false, false, true
				part.CFrame, part.Parent = part0.CFrame * parentWorld:ToObjectSpace(world), rig
				table.insert(created, { object = part, parent = rig })
				motor = Instance.new("Motor6D")
				motor.Name, motor.Part0, motor.Part1, motor.C0 =
					spec.name, part0, part, parentWorld:ToObjectSpace(world)
				motor.Parent = part0
				table.insert(created, { object = motor, parent = part0 })
				raw.DefaultPose[motor], raw.ParentingDefaults[motor] = motor.C0, true
				defaults[motor] = motor.C0
			end

			part:SetAttribute("EclipseBlenderSource", spec.source)
			addedCount += 1
			known[spec.source] = { part = part, world = world }
			additions[Paths.of(part, rig)] = spec.source
		end

		rebuild()
	end, debug.traceback)
	if not ok then
		for index = #created, 1, -1 do
			created[index].object:Destroy()
		end

		for motor in defaults do
			raw.DefaultPose[motor], raw.ParentingDefaults[motor] = nil, nil
		end

		error(err, 0)
	end

	if #created > 0 then
		History.record(function()
			if changed then
				changed()
			end

			for index = #created, 1, -1 do
				created[index].object.Parent = nil
			end

			rebuild()
		end, function()
			if changed then
				changed()
			end

			for _, item in created do
				item.object.Parent = item.parent
			end

			rebuild()
		end, "Sync Blender bones")
	end

	return addedCount, additions
end

return Bones
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a3d7</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1934">
          <Properties>
            <string name="Name">Model</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f31</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{6AC2BAFA-0360-436F-843A-9BF9A6D07111}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local Tween = game:GetService("TweenService")
local Assets = require("EffectCatalog")
local Model = { MAX_FRAME = 1000000, MAX_EFFECTS = 128 }
Model.kinds = { "Camera Shake", "Vignette", "Letterbox", "Screen Cover", "Impact Frames" }
Model.styles = {
	"Linear",
	"Sine",
	"Quad",
	"Cubic",
	"Quart",
	"Quint",
	"Exponential",
	"Circular",
	"Back",
	"Bounce",
	"Elastic",
	"Custom",
	"Constant",
}
Model.directions = { "In", "Out", "InOut" }
local catalog = { Solid = { id = "Solid", label = "Solid bars", group = "Classic" } }
for _, asset in Assets do
	catalog[asset.id] = asset
end

Model.catalog = catalog

function Model.finite(n)
	return type(n) == "number" and n == n and math.abs(n) < math.huge
end

local function number(n, lo, hi, label)
	assert(
		Model.finite(n) and n >= lo and n <= hi,
		label .. " must be between " .. lo .. " and " .. hi
	)
	return n
end

function Model.copy(value)
	if type(value) ~= "table" then
		return value
	end

	local result = {}
	for k, v in value do
		result[k] = Model.copy(v)
	end

	return result
end

function Model.defaults(kind, frame, fps)
	return {
		kind = kind or "Vignette",
		name = kind or "Vignette",
		style = "Solid",
		start = math.max(0, math.round(frame or 0)),
		duration = math.max(1, math.round((fps or 60) * 2)),
		fadeIn = math.round((fps or 60) * 0.25),
		fadeOut = math.round((fps or 60) * 0.25),
		color = { 0, 0, 0 },
		opacity = 1,
		height = 0.121749409,
		scale = 1,
		enabled = true,
		easeIn = { style = "Sine", direction = "Out", curve = { 0.25, 0.1, 0.25, 1 } },
		easeOut = { style = "Sine", direction = "In", curve = { 0.25, 0.1, 0.25, 1 } },
	}
end

local function easing(value)
	assert(
		type(value) == "table" and table.find(Model.styles, value.style),
		"Choose a valid easing style"
	)
	assert(table.find(Model.directions, value.direction), "Choose a valid easing direction")
	local curve = value.curve or { 0.25, 0.1, 0.25, 1 }
	assert(type(curve) == "table" and #curve == 4, "Custom easing needs four control values")
	for i, n in curve do
		number(n, i % 2 == 1 and 0 or -10, i % 2 == 1 and 1 or 10, "Custom easing control")
	end

	local result = { style = value.style, direction = value.direction, curve = table.clone(curve) }
	for _, id in { "Overshoot", "Amplitude", "Period" } do
		if value[id] ~= nil then
			result[id] = number(value[id], 0, 100, id)
		end
	end

	return result
end

function Model.validate(value)
	assert(type(value) == "table" and table.find(Model.kinds, value.kind), "Choose an effect type")
	local result = {
		kind = value.kind,
		name = tostring(value.name or value.kind):sub(1, 64),
		enabled = value.enabled ~= false,
	}
	if result.name:match("^%s*$") then
		result.name = result.kind
	end

	for _, key in { "start", "duration", "fadeIn", "fadeOut" } do
		result[key] = number(value[key], key == "duration" and 1 or 0, Model.MAX_FRAME, key)
		assert(result[key] % 1 == 0, "Timing values must be whole frames")
	end

	assert(
		result.start + result.duration <= Model.MAX_FRAME,
		"The effect ends beyond the timeline limit"
	)
	assert(
		result.fadeIn + result.fadeOut <= result.duration,
		"Fade in + fade out must fit inside duration"
	)
	assert(type(value.color) == "table" and #value.color == 3, "Choose a valid color")
	result.color = {}
	for i, n in value.color do
		result.color[i] = number(n, 0, 1, "Color")
	end

	result.opacity = number(value.opacity, 0, 1, "Opacity")
	result.height = number(value.height or 0.121749409, 0.01, 0.45, "Bar height")
	result.scale = number(value.scale or 1, 0.25, 3, "VFX scale")
	result.easeIn = easing(value.easeIn)
	result.easeOut = easing(value.easeOut)
	result.style = value.style or "Solid"
	assert(catalog[result.style], "The selected letterbox style is unavailable")
	if value.cameraId ~= nil then
		assert(
			type(value.cameraId) == "string" and #value.cameraId <= 200,
			"Invalid camera identity"
		)
		result.cameraId = value.cameraId
	end

	return result
end

function Model.validateAll(values)
	assert(type(values) == "table", "Invalid effects document")
	local result, count = {}, 0
	for id, value in values do
		count += 1
		assert(count <= Model.MAX_EFFECTS, "Too many effects")
		assert(type(id) == "string" and #id > 0 and #id <= 100, "Invalid effect identity")
		result[id] = Model.validate(value)
	end

	return result
end

local function cubic(t, a, b)
	local u = 1 - t
	return 3 * u * u * t * a + 3 * u * t * t * b + t * t * t
end

function Model.ease(value, ease)
	value = math.clamp(value, 0, 1)
	if ease.style == "Constant" then
		return value >= 1 and 1 or 0
	end

	if ease.style == "Custom" then
		local c = ease.curve
		local lo, hi = 0, 1
		for _ = 1, 22 do
			local mid = (lo + hi) * 0.5
			if cubic(mid, c[1], c[3]) < value then
				lo = mid
			else
				hi = mid
			end
		end

		return cubic((lo + hi) * 0.5, c[2], c[4])
	end

	return math.clamp(
		Tween:GetValue(value, Enum.EasingStyle[ease.style], Enum.EasingDirection[ease.direction]),
		0,
		1
	)
end

function Model.alpha(effect, frame)
	if
		effect.enabled == false
		or frame < effect.start
		or frame >= effect.start + effect.duration
	then
		return 0
	end

	local age = frame - effect.start
	if effect.fadeIn > 0 and age < effect.fadeIn then
		return Model.ease(age / effect.fadeIn, effect.easeIn) * effect.opacity
	end

	if effect.fadeOut > 0 and age > effect.duration - effect.fadeOut then
		return (
			1
			- Model.ease((age - effect.duration + effect.fadeOut) / effect.fadeOut, effect.easeOut)
		) * effect.opacity
	end

	return effect.opacity
end

function Model.ordered(values)
	local result = {}
	for id, value in values do
		table.insert(result, { id = id, value = value })
	end

	table.sort(result, function(a, b)
		return a.value.start < b.value.start or a.value.start == b.value.start and a.id < b.id
	end)
	return result
end

return Model
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a3d8</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1935">
          <Properties>
            <string name="Name">Resolve</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f32</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{7F74D26A-E6E3-4BE2-9CFD-99EE7E87A95C}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local Selection = {}

function Selection.resolve(rigs, selected, items)
	if #rigs == 1 then
		return rigs[1]
	end

	local chosen = {}

	local function collect(part)
		if typeof(part) ~= "Instance" then
			return
		end

		local reference = part.Parent and part.Parent:FindFirstChild("EclipseSourceRig")
		if reference and reference:IsA("ObjectValue") then
			part = reference.Value
		end

		for _, rig in rigs do
			if part == rig or part and part:IsDescendantOf(rig) then
				chosen[rig] = true
			end
		end
	end

	for _, part in selected do
		collect(part)
	end

	if next(chosen) == nil then
		for item, enabled in items or {} do
			if enabled then
				collect((item.grandpa or item).linkedRigInstance)
			end
		end
	end

	local rig
	for candidate in chosen do
		if rig then
			return nil
		end

		rig = candidate
	end

	return rig
end

return Selection
