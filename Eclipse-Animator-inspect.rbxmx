			AddBtn = "#eaeaea",
			KfAuto = "#80d6a3",
			TrackOff = "#7d7d7d",
			Slider = "#b2b2b2",
			KfAli = "#c59aff",
			KfVec = "#edc66c",
			KfFree = "#ee95c0",
		},
	},
	{ name = "Old Eclipse", desc = "Original Eclipse theme.", data = oldPreset },
}
return ThemeConfig
]]></string>
