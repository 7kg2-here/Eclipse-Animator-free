            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)
local Drawing = require(script:FindFirstAncestor("Container").Shared.EclipseDrawing)
local DrawingEditor = require(script:FindFirstAncestor("Container").Shared.EclipseDrawingEditor)
local ColorPicker = require("Picker")
local drawingEditor
local drawingTab = "Annotate"
local introductionShown = false

local function introduce()
	if introductionShown then
		return
	end

	local data = require("ProjectData")
	if data.getSetting("GreasePencilIntroductionV1") == true then
		introductionShown = true
		return
	end

	local notice = require("Notification").show(
		"GREASE PENCIL",
		"Grease pencil is INCREDIBLY new. It was a last minute addition. You may encounter issues!! -riftkuro",
		7,
		"GreasePencilFirstOpen"
	)
	if notice then
		introductionShown = true
		data.setSetting("GreasePencilIntroductionV1", true)
	end
end

local Timing = require("Timing")
local TimingEditor = require("TimingEditor")
local Shortcuts = require("Shortcuts")
local Input = game:GetService("UserInputService")
local Http = game:GetService("HttpService")
local Tool = require("Tool")
local Path = require("Path")
local Document = require("Document")
local Chunks = require("ChunkStore")
local Preferences = require("Preferences")
local History = require("History")
local Parenting = require("Parenting")
local Policy = require("Policy")
local CameraRig = require("CameraRig")
local LimbIK = require("LimbIK")
local Head = require("HeadStabilizer")
local Graph = require("GraphCurves")
local GraphModel = require("GraphModel")
local Defaults = require("Defaults")
local KeyDefaults = require("KeyframeDefaults")
local Recovery = require("Recovery")
local Run = game:GetService("RunService")
local Pencil = {}
local refs, window, host, wire, highlight, selected, stroke
local strokeCamera
local strokeRender = "EclipseStrokeCamera-" .. Http:GenerateGUID(false)

local function releaseStrokeCamera()
	if strokeCamera then
		strokeCamera.release()
	end
end

local function lockStrokeCamera(camera)
	releaseStrokeCamera()
	if refs.State.BlenderNavigation then
		refs.State.BlenderNavigation.cancelCameraGestures()
	end
	require("Focus").cancel()
	local current = {
		camera = camera,
		frame = camera.CFrame,
		focus = camera.Focus,
		fov = camera.FieldOfView,
		connections = {},
	}
	local release = Recovery.acquire(camera)
	strokeCamera = current
	function current.release()
		if strokeCamera ~= current then
			return
		end
		strokeCamera = nil
		Run:UnbindFromRenderStep(strokeRender)
		for _, connection in current.connections do
			connection:Disconnect()
		end
		release()
	end
	local function maintain()
		if strokeCamera ~= current or current.writing then
			return
		end
		local raw = refs.State.Timeline:GetState()
		if not camera.Parent or workspace.CurrentCamera ~= camera
			or not refs.Active() or not refs.ScreenGui.Enabled or not refs.AnimatorFrame.Visible
			or raw.Playing or raw.Exporting or refs.State.PhysicsSimulating
			or not Pencil.isStrokeActive() or not Recovery.maintain(camera) then
			current.release()
			Pencil.cancelStroke()
			return
		end
		current.writing = true
		local ok, err = pcall(function()
			camera.CameraType = Enum.CameraType.Scriptable
			camera.CFrame = current.frame
			camera.Focus = current.focus
			camera.FieldOfView = current.fov
		end)
		current.writing = false
		if not ok then
			current.release()
			Pencil.cancelStroke()
			warn(tostring(err))
		end
	end
	local ok, err = pcall(function()
		for _, property in { "CFrame", "Focus", "CameraType", "FieldOfView" } do
			table.insert(current.connections, camera:GetPropertyChangedSignal(property):Connect(maintain))
		end
		Run:BindToRenderStep(strokeRender, Enum.RenderPriority.Camera.Value + 1, maintain)
		maintain()
	end)
	if not ok then
		current.release()
		error(err)
	end
	return current.release, maintain
end

local drawing = false
local drawingTarget
local physicsTarget, physicsApply, physicsOptions
local physicsTargets = {}
local targetButtons = {}

local function refreshTargets()
	for motor, button in targetButtons do
		local active = table.find(physicsTargets, motor) ~= nil
		button.TextLabel.Text = (active and "☑  " or "☐  ")
			.. (physicsOptions.label and physicsOptions.label(motor) or motor.Part1.Name)
	end
end

local targetStrokes = setmetatable({}, { __mode = "k" })
local smoothing = 50
local hidden = false
local connections = {}
local Notification = require("Notification")

local function data()
	local raw = refs.State.Timeline:GetState()
	raw.GreaseStrokes = raw.GreaseStrokes or {}
	return raw.GreaseStrokes
end

local function target()
	if physicsApply then
		if
			physicsTarget
			and physicsTarget.Parent
			and physicsTarget.Part1
			and physicsTarget.Part1.Parent
		then
			return physicsTarget
		end

		return nil
	end

	local state = refs.State
	local raw = state.Timeline:GetState()
	local items = state.Rig and state.Rig._selectedItems or {}
	local chosen

	local function add(motor)
		if
			not (typeof(motor) == "table" and motor.IsEclipseProperty)
			and motor
			and motor.Parent
			and motor.Part0
			and motor.Part1
			and raw.DefaultPose[motor] ~= nil
			and not CameraRig.isFov(motor)
		then
			if chosen and chosen ~= motor then
				return false
			end

			chosen = motor
		end

		return true
	end

	for item in items do
		if item.fetchMotor and not add(item:fetchMotor()) then
			return nil
		end
	end

	if not chosen then
		for key in raw.SelectedKeyframes or {} do
			if not add(key.Motor) then
				return nil
			end
		end

		for key in raw.SelectedChannelKeyframes or {} do
			if not add(key.Motor) then
				return nil
			end
		end
	end

	return chosen
end

local function selectionChanged()
	local motor = target()
	if drawing and motor ~= drawingTarget then
		drawing = false
		drawingTarget = nil
		stroke = nil
		releaseStrokeCamera()
		Pencil.refresh()
	end

	if window then
		window.target.Text = motor and motor.Part1.Name or "Select a bone or camera"
		if window.targetChoice then
			window.targetChoice.TextLabel.Text = (
				physicsOptions.multiple and (#physicsTargets .. " parts selected")
				or (
					motor
						and (physicsOptions.label and physicsOptions.label(motor) or motor.Part1.Name)
					or "Choose object"
				)
			) .. "  ▾"
		end

		window.draw.Interactable = motor ~= nil
		window.drawText.Text = drawing and "STOP" or "DRAW PATH"
		window.drawText.TextTransparency = motor and 0.1 or 0.65
		window.apply.Interactable = motor ~= nil and selected ~= nil
		window.applyText.TextTransparency = window.apply.Interactable and 0.1 or 0.65
	end

	return motor
end

local function teardown()
	if host then
		host:Destroy()
	end

	host, wire, highlight = nil, nil, nil
end

local function showStatus(message)
	Notification.show("ANNOTATE", message)
end

function Pencil.refresh()
	if drawingEditor then
		drawingEditor:step()
	end

	if not refs then
		return
	end

	if not window then
		teardown()
		return
	end

	if not host or host.Parent ~= workspace.CurrentCamera then
		teardown()
		if not workspace.CurrentCamera then
			return
		end

		host = Instance.new("Folder")
		host.Name = "EclipseGreasePencil"
		host.Archivable = false
		host.Parent = workspace.CurrentCamera
		wire = Instance.new("WireframeHandleAdornment")
		wire.Name = "Strokes"
		wire.Adornee = workspace.Terrain
		wire.AlwaysOnTop = true
		wire.Thickness = 3
		wire.Color3 = Color3.fromRGB(245, 186, 222)
		wire.Parent = host
		highlight = wire:Clone()
		highlight.Name = "SelectedStroke"
		highlight.Color3 = Color3.fromRGB(255, 216, 108)
		highlight.Parent = host
	end

	wire:Clear()
	highlight:Clear()
	wire.Visible = not hidden and refs.Active() and not refs.State.PresentationHidden
	highlight.Visible = wire.Visible
	local ids = {}
	for id in data() do
		table.insert(ids, id)
	end

	table.sort(ids)
	if not selected or not data()[selected] then
		selected = ids[#ids]
	end

	for id, entry in data() do
		local points = Path.smooth(entry.points, entry.smoothing)
		local targetWire = id == selected and highlight or wire
		for i = 2, #points do
			targetWire:AddLine(points[i - 1], points[i])
		end
	end

	if stroke then
		for i = 2, #stroke.points do
			wire:AddLine(stroke.points[i - 1], stroke.points[i])
		end
	end

	if window then
		window.drawText.Text = drawing and "STOP" or "DRAW"
		window.showText.Text = hidden and "SHOW" or "HIDE"
		selectionChanged()
		window.strokeLabel.Text = #ids == 0 and "No strokes"
			or "Stroke " .. tostring(table.find(ids, selected)) .. " / " .. #ids
	end
end

function Pencil.isDrawing()
	return drawing or drawingEditor and drawingEditor:isDrawing() or false
end

function Pencil.isStrokeActive()
	return stroke ~= nil or drawingEditor and drawingEditor.pending ~= nil or false
end

function Pencil.isOpen()
	return window ~= nil
end

function Pencil.presentationChanged()
	Pencil.refresh()
end

function Pencil.cancelStroke()
	if drawingEditor then
		drawingEditor:cancel()
		drawingEditor.mode = "Select"
		drawingEditor:refresh()
	end

	stroke = nil

	releaseStrokeCamera()
	drawing = false
	drawingTarget = nil
	Pencil.refresh()
end

local function recordStrokes(before, after, label)
	local raw = refs.State.Timeline:GetState()

	local function restore(value)
		raw.GreaseStrokes = Document.unpack(value)
		refs.State.currentProjectSaved = false
		Pencil.refresh()
	end

	restore(after)
	History.record(function()
		restore(before)
	end, function()
		restore(after)
	end, label)
end

local function overUI(point)
	for _, object in game:GetService("CoreGui"):GetGuiObjectsAtPosition(point.X, point.Y) do
		if object.Active and object.Visible then
			return true
		end
	end

	return false
end

local function beginStroke()
	if drawingEditor and drawingEditor.visible then
		drawingEditor:begin()
		return
	end

	if not drawing then
		return
	end

	local motor = selectionChanged()
	if not motor or motor ~= drawingTarget then
		return
	end

	if not drawing or not refs.Active() or Input:GetFocusedTextBox() then
		return
	end

	local point = Input:GetMouseLocation()
	if overUI(point) then
		return
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	local origin = (motor.Part0.CFrame * motor.C0 * motor.C1:Inverse()).Position
	local normal = camera.CFrame.LookVector
	local hit = Path.intersect(camera:ScreenPointToRay(point.X, point.Y), origin, normal)
	if not hit then
		return
	end

	stroke = {
		motor = motor,
		origin = origin,
		normal = normal,
		points = { hit },
		camera = camera,
		last = point,
	}
	stroke.releaseCamera, stroke.holdCamera = lockStrokeCamera(camera)
end

local function moveStroke()
	if drawingEditor and drawingEditor.visible then
		drawingEditor:move()
		return
	end

	if not drawing then
		return
	end

	selectionChanged()
	if not stroke or workspace.CurrentCamera ~= stroke.camera then
		return
	end

	stroke.holdCamera()
	if not stroke then
		return
	end
	local point = Input:GetMouseLocation()
	if (point - stroke.last).Magnitude < 3 then
		return
	end

	local hit = Path.intersect(
		stroke.camera:ScreenPointToRay(point.X, point.Y),
		stroke.origin,
		stroke.normal
	)
	if hit then
		if #stroke.points >= 1024 then
			stroke.points = Path.resample(stroke.points, 512)
		end

		table.insert(stroke.points, hit)
		stroke.last = point
		Pencil.refresh()
	end
end

local function finishStroke()
	if drawingEditor and drawingEditor.visible then
		drawingEditor:finish()
		return
	end

	if not stroke then
		return
	end

	selectionChanged()
	if not stroke then
		return
	end

	local points = stroke.points
	stroke = nil
	releaseStrokeCamera()
	if #points < 2 then
		Pencil.refresh()
		return
	end

	local before = Document.pack(data())
	local nextData = Document.unpack(before)
	selected = Http:GenerateGUID(false)
	nextData[selected] = { points = points, smoothing = smoothing }
	recordStrokes(before, Document.pack(nextData), "Draw annotation stroke")
	showStatus("Path captured.")
end

function Pencil.apply(motor, points, first, last, step, offset, easing)
	Timing.validate(easing)
	local state = refs.State
	local timeline = state.Timeline
	local raw = timeline:GetState()
	assert(refs.Active() and not raw.Playing, "Stop playback before applying a path")
	assert(
		Policy.channelsEnabled(),
		"Enable Transform Channels in Preferences before applying a path"
	)
	assert(
		not state.BlenderBridge or not state.BlenderBridge.isLocked(),
		"Turn Blender Live off first"
	)
	assert(
		motor and motor.Parent and motor.Part0 and motor.Part1 and not CameraRig.isFov(motor),
		"Select a bone or camera transform track"
	)
	assert(
		not (typeof(motor) == "table" and motor.IsEclipseArmatureControl),
		"Use an output bone or camera track for Apply Path"
	)
	assert(
		first
			and last
			and step
			and first % 1 == 0
			and last % 1 == 0
			and step % 1 == 0
			and first >= 0
			and last > first
			and last <= 1000000
			and step >= 1,
		"Enter whole frames: End after Start, Step at least 1"
	)
	assert(math.ceil((last - first) / step) <= 5000, "Increase Step to use at most 5000 path keys")
	local motors = {}
	for candidate in raw.DefaultPose do
		table.insert(motors, candidate)
	end

	local evaluator = Parenting.newEvaluator(
		motors,
		Policy.activeTracks(raw.Keyframes),
		raw.DefaultPose,
		raw.DefaultWorldPose,
		raw.ParentingDefaults,

		function(candidate, time)
			return timeline:EvaluateMotorC0(candidate, time)
		end
	)
	local frames = {}
	for frame = first, last, step do
		table.insert(frames, frame)
	end

	if frames[#frames] ~= last then
		table.insert(frames, last)
	end

	local included = {}
	for _, frame in frames do
		included[frame] = true
	end

	for frame in raw.Keyframes[motor] or {} do
		if frame > first and frame < last and not included[frame] then
			table.insert(frames, frame)
		end
	end

	table.sort(frames)
	local positions = {}
	for i, frame in frames do
		positions[i] = Path.at(points, Timing.sample(easing, (frame - first) / (last - first)))
	end

	local shift = offset == true
			and evaluator.worldAt(motor, first / raw.FPS).Position - positions[1]
		or Vector3.zero
	local before = timeline:_snapshotMotorBucket(motor)
	local after = Document.unpack(Document.pack(before))
	for frame, key in after do
		key.Motor = motor
		key.Part = motor.Part1
		key.SanitizeName = state.UIHelpers.SanitizeName
		if not key.Channels and not key.GraphOnly then
			timeline:EnsureChannelsPopulated(key)
		end
	end

	local scratch = table.clone(raw)
	scratch.Keyframes = table.clone(raw.Keyframes)
	scratch.Keyframes[motor] = after
	local privateTimeline = setmetatable({
		GetState = function()
			return scratch
		end,
	}, {
		__index = function(_, key)
			local value = timeline[key]
			return type(value) == "function"
					and function(_, ...)
						return value(timeline, ...)
					end
				or value
		end,
	})
	local model = GraphModel.new({ Timeline = privateTimeline })
	for _, track in model:tracks({ motor }) do
		if track.group == "Position" then
			model:_adopt(track)
		end
	end

	for i, frame in frames do
		local time = frame / raw.FPS
		assert(
			not LimbIK.isDriven(motor, time) and not Head.isEnabled(motor, time),
			"Turn off IK or head stabilization on this track before applying a path"
		)
		assert(evaluator.isParentedAt(motor, time), "Use a parented track for Apply Path")
		local world = evaluator.worldAt(motor, time)
		local c0 = Path.localPose(
			evaluator.parentWorldAt(motor, time),
			world,
			positions[i] + shift,
			motor.C1
		)
		local key = after[frame]
		if not key then
			key = KeyDefaults.new(after, frame)
			key.Frame, key.Time, key.C0 = frame, time, timeline:EvaluateMotorC0(motor, time)
			key.Motor, key.Part, key.SanitizeName = motor, motor.Part1, state.UIHelpers.SanitizeName
			key.Parented, key.GraphOnly = true, true
			key.EasingStyle = key.EasingStyle or Defaults.EasingStyle
			key.EasingDirection = key.EasingDirection or Defaults.EasingDirection
			key.HandleType = key.HandleType or Defaults.HandleType
			if key.EasingStyle == "Bezier" and not key.BezierPoints then
				key.BezierPoints = Graph.clone(Defaults.BezierPoints)
			end
		end

		key.C0 = CFrame.new(c0.Position) * key.C0.Rotation
		key.Position = key.C0.Position
		key.Rotation = key.C0.Rotation
		key.BlenderCurve, key.BlenderSource, key.PathTangentIn, key.PathTangentOut =
			nil, nil, nil, nil
		key.GraphCurves = key.GraphCurves or {}
		key.Channels = key.Channels or {}
		for id, value in { loc_x = c0.X, loc_y = c0.Y, loc_z = c0.Z } do
			key.Channels[id] = { Value = value }
			local oldPoint = key.GraphCurves[id]
			local style = typeof(key.EasingStyle) == "EnumItem" and key.EasingStyle.Name
				or key.EasingStyle
			local native = typeof(key.EasingStyle) == "EnumItem"
				and key.EasingStyle.EnumType == Enum.PoseEasingStyle
			local interpolation = style == "Bezier" and "Bezier"
				or (style == "Linear" or style == "Constant" and not native) and style
				or "Legacy"
			key.GraphCurves[id] = {
				Value = value,
				Interpolation = oldPoint and oldPoint.Interpolation or interpolation,
				HandleType = oldPoint and oldPoint.HandleType or key.HandleType,
				Easing = oldPoint and Graph.clone(oldPoint.Easing) or {
					EasingStyle = style,
					NativePose = native,
					EasingDirection = key.EasingDirection,
					BezierPoints = Graph.clone(key.BezierPoints),
					Overshoot = key.Overshoot,
					Amplitude = key.Amplitude,
					Period = key.Period,
				},
			}
		end

		after[frame] = key
	end

	local functionRestore = function(bucket)
		timeline:_restoreMotorBucket(motor, bucket)
		if state.currentRig then
			timeline:ApplyPoseAtTime(state.currentRig, raw.CurrentTime)
		end

		if state.GraphEditor then
			state.GraphEditor.invalidate()
		end

		state.currentProjectSaved = false
		Pencil.refresh()
	end

	local ok, err = pcall(functionRestore, after)
	if not ok then
		functionRestore(before)
		error(err)
	end

	timeline:EnsureTimelineEnd(last)
	History.record(function()
		functionRestore(before)
	end, function()
		functionRestore(after)
	end, "Apply drawn path")
	return #frames
end

function Pencil.closePhysics()
	if physicsApply then
		Pencil.close()
	end
end

function Pencil.close()
	if drawingEditor then
		drawingEditor:cancel()
	end
	TimingEditor.close()
	physicsTarget, physicsApply, physicsOptions = nil, nil, nil
	physicsTargets = {}
	targetButtons = {}
	drawing = false
	drawingTarget = nil
	stroke = nil
	releaseStrokeCamera()
	if window then
		local old = window
		window = nil
		old:close()
	end

	Pencil.refresh()
end

function Pencil.chooseTarget(motor)
	assert(
		physicsOptions and table.find(physicsOptions.targets, motor),
		"choose an object from the list"
	)
	assert(motor.Parent and motor.Part1 and motor.Part1.Parent, "that object was removed")
	if physicsTarget and physicsTarget.Part1 then
		targetStrokes[physicsTarget.Part1] = selected
	end

	physicsTarget = motor
	physicsTargets = { motor }
	selected = targetStrokes[motor.Part1]
	drawing = false
	drawingTarget = nil
	stroke = nil
	releaseStrokeCamera()
	if window and window.targetList then
		window.targetList.Visible = false
	end

	Pencil.refresh()
end

function Pencil.open(guideMotor, onGuide, options)
	if window then
		if onGuide then
			Pencil.close()
		else
			return
		end
	end

	physicsTarget, physicsApply, physicsOptions = guideMotor, onGuide, options
	physicsTargets = options and options.selected and table.clone(options.selected)
		or (guideMotor and { guideMotor } or {})
	targetButtons = {}
	if guideMotor and guideMotor.Part1 and targetStrokes[guideMotor.Part1] then
		selected = targetStrokes[guideMotor.Part1]
	end

	assert(refs.Active(), "Open an Eclipse file first")
	smoothing = Preferences.get("GreasePencilSmoothing") or 50
	window = Tool.new(
		refs,
		"EclipseGreasePencilWindow",
		physicsApply and "ANNOTATE - PHYSICS" or "DRAWING",
		physicsApply and Vector2.new(320, 240) or Vector2.new(320, 344),
		false,

		function()
			TimingEditor.close()
			if drawingEditor then
				drawingEditor:setVisible(false)
				drawingEditor:unmount()
			end

			window = nil
			drawing = false
			drawingTarget = nil
			stroke = nil
			releaseStrokeCamera()
			physicsTarget = nil
			physicsApply = nil
			physicsOptions = nil
			Pencil.refresh()
		end
	)
	local rootFrame = window.frame
	local frame = rootFrame
	local header = rootFrame:FindFirstChild("Header")
	if header then
		header.Title.Position = UDim2.fromOffset(12, 0)
		header.Title.TextYAlignment = Enum.TextYAlignment.Center
		header.Title.TextSize = 13
	end

	if not physicsApply then
		frame = Tool.make("Frame", rootFrame, "AnnotationPanel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, 34),
			Size = UDim2.fromOffset(320, 310),
		})
		drawingEditor:mount(rootFrame)

		local function resizeDrawing()
			local grease = drawingTab == "Grease Pencil"
			local size = grease and Vector2.new(412, drawingEditor.advanced and 564 or 484)
				or Vector2.new(320, 344)
			rootFrame.MinimumSize.MinSize = size
			rootFrame.Size = UDim2.fromOffset(size.X, size.Y)
			local tabWidth = (size.X - 30) / 2
			rootFrame.TabBar.AnnotateTab.Size = UDim2.fromOffset(tabWidth, 26)
			rootFrame.TabBar.GreaseTab.Size = UDim2.fromOffset(tabWidth, 26)
			rootFrame.TabBar.GreaseTab.Position = UDim2.fromOffset(3 + tabWidth, 3)
			for _, name in { "AnnotateTab", "GreaseTab" } do
				local button = rootFrame.TabBar[name]
				local active = (name == "GreaseTab") == grease
				button:SetAttribute("ThemeBgTransparency", active and 0 or 1)
				button:SetAttribute("Primary", active)
				button.TextLabel:SetAttribute("ThemeTxtTransparency", active and 0 or 0.35)
				button.BackgroundTransparency = active and 0 or 1
				button.TextLabel.TextTransparency = active and 0 or 0.35
			end

			header.Title.Text = grease and "GREASE PENCIL" or "ANNOTATE"
		end

		drawingEditor.onLayout = resizeDrawing

		local function selectTab(tab)
			Pencil.cancelStroke()
			drawingTab = tab
			frame.Visible = tab == "Annotate"
			drawingEditor:setVisible(tab == "Grease Pencil")
			resizeDrawing()
			if tab == "Grease Pencil" then
				introduce()
			end
		end

		local tabBar = Tool.make("Frame", rootFrame, "TabBar", {
			Position = UDim2.fromOffset(12, 32),
			Size = UDim2.new(1, -24, 0, 32),
			BackgroundTransparency = 0.5,
			BorderSizePixel = 0,
		})
		tabBar:SetAttribute("ThemeBg", "Top")
		tabBar:SetAttribute("EclipseTabBar", true)
		Tool.make("UICorner", tabBar, "Corner", { CornerRadius = UDim.new(0, 5) })
		local outline = Tool.make("UIStroke", tabBar, "Outline", { Thickness = 1 })
		outline:SetAttribute("ThemeStrk", "Strk")
		Tool.button(
			tabBar,
			"AnnotateTab",
			"ANNOTATE",
			UDim2.fromOffset(3, 3),
			UDim2.fromOffset(190, 26),

			function()
				selectTab("Annotate")
			end
		)
		Tool.button(
			tabBar,
			"GreaseTab",
			"GREASE PENCIL",
			UDim2.fromOffset(193, 3),
			UDim2.fromOffset(190, 26),

			function()
				selectTab("Grease Pencil")
			end
		)
		frame.Visible = drawingTab == "Annotate"
		drawingEditor:setVisible(drawingTab == "Grease Pencil")
		resizeDrawing()
		if drawingTab == "Grease Pencil" then
			introduce()
		end
	end

	window.target =
		Tool.label(frame, "Target", "", UDim2.fromOffset(12, 36), UDim2.new(1, -24, 0, 22))
	if physicsOptions and #physicsOptions.targets > 1 then
		window.target.Visible = false
		window.targetList = Tool.make("ScrollingFrame", frame, "Targets", {
			Position = UDim2.fromOffset(12, 62),
			Size = UDim2.new(1, -24, 0, 138),
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 3,
			BackgroundTransparency = 0,
			BorderSizePixel = 0,
			ZIndex = 80,
			Visible = false,
		})
		window.targetList:SetAttribute("ThemeBg", "Pnl")
		Tool.make(
			"UIListLayout",
			window.targetList,
			"Layout",
			{ SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }
		)
		window.targetChoice = Tool.button(
			frame,
			"TargetChoice",
			"CHOOSE OBJECT",
			UDim2.fromOffset(12, 36),
			UDim2.new(1, -24, 0, 24),

			function()
				window.targetList.Visible = not window.targetList.Visible
			end
		)
		window.targetChoice.TextLabel.TextWrapped = false
		window.targetChoice.TextLabel.TextTruncate = Enum.TextTruncate.AtEnd
		if physicsOptions.multiple then
			local all = Tool.button(
				window.targetList,
				"SelectAll",
				"SELECT ALL",
				UDim2.new(),
				UDim2.new(1, -4, 0, 26),

				function()
					physicsTargets = table.clone(physicsOptions.targets)
					physicsTarget = physicsTargets[1]
					refreshTargets()
					selectionChanged()
				end
			)
			all.LayoutOrder = -2
			local done = Tool.button(
				window.targetList,
				"DoneTargets",
				"DONE",
				UDim2.new(),
				UDim2.new(1, -4, 0, 26),

				function()
					window.targetList.Visible = false
				end
			)
			done.LayoutOrder = 10000
		end

		for i, motor in physicsOptions.targets do
			local text = physicsOptions.label and physicsOptions.label(motor) or motor.Part1.Name
			local button, label = Tool.button(
				window.targetList,
				"Target" .. i,
				text,
				UDim2.new(),
				UDim2.new(1, -4, 0, 26),

				function()
					if not physicsOptions.multiple then
						Pencil.chooseTarget(motor)
						return
					end

					local at = table.find(physicsTargets, motor)
					if at then
						table.remove(physicsTargets, at)
					else
						table.insert(physicsTargets, motor)
					end

					physicsTarget = physicsTargets[1]
					drawing = false
					drawingTarget = nil
					stroke = nil
					releaseStrokeCamera()
					refreshTargets()
					selectionChanged()
				end
			)
			targetButtons[motor] = button
			button.LayoutOrder = i
			label.TextWrapped = false
			label.TextTruncate = Enum.TextTruncate.AtEnd
		end

		if physicsOptions.multiple then
			refreshTargets()
		end
	end

	window.draw, window.drawText = Tool.button(
		frame,
		"Draw",
		"DRAW PATH",
		UDim2.fromOffset(12, 66),
		UDim2.fromOffset(128, 26),

		function()
			refs.Finalize()
			local motor = target()
			if not motor then
				showStatus("Select one bone or camera track first.")
				return
			end

			drawing = not drawing
			drawingTarget = drawing and motor or nil
			stroke = nil
			releaseStrokeCamera()
			if drawing then
				refs.State.Timeline:GetState().Playing = false
			end

			showStatus(drawing and "Drag in the viewport. Esc stops drawing." or "Drawing stopped.")
			Pencil.refresh()
		end
	)
	window.show, window.showText = Tool.button(
		frame,
		"Show",
		"HIDE",
		UDim2.fromOffset(148, 66),
		UDim2.fromOffset(76, 26),

		function()
			hidden = not hidden
			Pencil.refresh()
		end
	)
	Tool.button(frame, "Erase", "ERASE", UDim2.fromOffset(232, 66), UDim2.fromOffset(76, 26), function()
		if not selected then
			showStatus("Draw a stroke first.")
			return
		end

		local before = Document.pack(data())
		local after = Document.unpack(before)
		after[selected] = nil
		recordStrokes(before, Document.pack(after), "Erase annotation stroke")
		selected = nil
	end
)
	Tool.label(
		frame,
		"SmoothLabel",
		"Smoothing (%)",
		UDim2.new(1, -220, 0, 130),
		UDim2.fromOffset(118, 24)
	).TextXAlignment =
		Enum.TextXAlignment.Right
	local smooth = Tool.field(
		frame,
		"Smoothing",
		smoothing,
		UDim2.new(1, -94, 0, 130),
		UDim2.fromOffset(82, 24)
	)
	require("NumericInput").connect(smooth, { step = 0.1, min = 0 }, function()
		local value = tonumber(smooth.Text)
		if value and value == value and value >= 0 and value <= 100 then
			smoothing = value
			if selected and data()[selected] then
				local before = Document.pack(data())
				local after = Document.unpack(before)
				after[selected].smoothing = value
				recordStrokes(before, Document.pack(after), "Smooth annotation stroke")
			end
		end

		smooth.Text = tostring(smoothing)
		Pencil.refresh()
	end)
	Tool.button(
		frame,
		"PathTiming",
		"PATH TIMING",
		UDim2.fromOffset(12, 162),
		UDim2.new(1, -24, 0, 26),

		function()
			local id = selected
			local entry = id and data()[id]
			if not entry then
				showStatus("draw a path first")
				return
			end

			local raw = refs.State.Timeline:GetState()
			local strokes = raw.GreaseStrokes
			TimingEditor.open(refs, entry.easing, function(easing)
				assert(
					window and raw.GreaseStrokes == strokes and data()[id],
					"reopen the drawing to edit its timing"
				)
				local before = Document.pack(data())
				local after = Document.unpack(before)
				after[id].easing = easing
				recordStrokes(before, Document.pack(after), "Edit path timing")
			end)
		end
	)
	local divider = Tool.make("Frame", frame, "Divider", {
		Position = UDim2.fromOffset(12, 198),
		Size = UDim2.new(1, -24, 0, 1),
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromRGB(69, 41, 93),
	})
	divider:SetAttribute("ThemeBg", "Div")
	window.strokeLabel =
		Tool.label(frame, "Stroke", "", UDim2.fromOffset(42, 100), UDim2.new(1, -84, 0, 24))
	window.strokeLabel.TextXAlignment = Enum.TextXAlignment.Center

	local function selectStroke(delta)
		local ids = {}
		for id in data() do
			table.insert(ids, id)
		end

		table.sort(ids)
		if #ids == 0 then
			return
		end

		selected = ids[((table.find(ids, selected) or 1) - 1 + delta) % #ids + 1]
		smoothing = data()[selected].smoothing
		smooth.Text = tostring(smoothing)
		Pencil.refresh()
	end

	Tool.button(frame, "PreviousStroke", "<", UDim2.fromOffset(12, 100), UDim2.fromOffset(24, 24), function()
		selectStroke(-1)
	end
)
	Tool.button(frame, "NextStroke", ">", UDim2.new(1, -36, 0, 100), UDim2.fromOffset(24, 24), function()
		selectStroke(1)
	end
)
	local current = refs.State.Timeline:TimeToFrame(refs.State.Timeline:GetState().CurrentTime)
	local fields = {}
	for i, entry in { { "Start", current }, { "End", current + 60 } } do
		local x = 12 + (i - 1) * 154
		Tool.label(
			frame,
			entry[1] .. "Label",
			entry[1],
			UDim2.fromOffset(x, 208),
			UDim2.fromOffset(44, 24)
		)
		fields[i] = Tool.field(
			frame,
			entry[1],
			entry[2],
			i == 2 and UDim2.new(1, -94, 0, 208) or UDim2.fromOffset(x + 48, 208),
			UDim2.fromOffset(i == 2 and 82 or 94, 24)
		)
		if i == 2 then
			local label = frame:FindFirstChild("EndLabel")
			label.Position = UDim2.new(1, -146, 0, 208)
			label.TextXAlignment = Enum.TextXAlignment.Right
		end
	end

	Tool.label(
		frame,
		"SpacingLabel",
		"Key spacing (frames)",
		UDim2.fromOffset(12, 242),
		UDim2.fromOffset(180, 24)
	)
	fields[3] = Tool.field(frame, "Spacing", 4, UDim2.new(1, -94, 0, 242), UDim2.fromOffset(82, 24))

	window.apply, window.applyText = Tool.button(
		frame,
		"Apply",
		"APPLY PATH",
		UDim2.new(0, 12, 1, -38),
		UDim2.new(1, -24, 0, 26),

		function()
			drawing = false
			finishStroke()
			local ok, result = pcall(function()
				local entry = selected and data()[selected]
				assert(entry, "Draw a path first")
				if physicsApply then
					local motor = target()
					assert(motor, "select parts for the path first")
					physicsApply(
						motor,
						Path.smooth(entry.points, entry.smoothing),
						entry.easing,
						table.clone(physicsTargets)
					)
					for _, picked in physicsTargets do
						targetStrokes[picked.Part1] = selected
					end

					return "guide"
				end

				return Pencil.apply(
					target(),
					Path.smooth(entry.points, entry.smoothing),
					tonumber(fields[1].Text),
					tonumber(fields[2].Text),
					tonumber(fields[3].Text),
					false,
					entry.easing
				)
			end)
			showStatus(
				ok
						and (result == "guide" and "Path ready. Go back to Physics and simulate." or tostring(
							result
						) .. " path keys added.")
					or tostring(result):gsub("^.-:%d+: ", "")
			)
			Pencil.refresh()
		end
	)
	if physicsApply then
		frame.Size = UDim2.fromOffset(320, 240)
		for _, name in
			{ "Divider", "StartLabel", "EndLabel", "Start", "End", "SpacingLabel", "Spacing" }
		do
			local child = frame:FindFirstChild(name)
			if child then
				child.Visible = false
			end
		end

		window.applyText.Text = "USE FOR PHYSICS"
		window.apply:SetAttribute("ThemeBg", "MenuSel")
		require("Theme").applyInstance(window.apply)
		if physicsOptions and physicsOptions.clear then
			Tool.button(
				frame,
				"ClearTargetPath",
				"CLEAR PATH",
				UDim2.fromOffset(12, 130),
				UDim2.fromOffset(94, 24),

				function()
					local ok, err = pcall(function()
						assert(target(), "choose an object first")
						for _, motor in physicsTargets do
							physicsOptions.clear(motor)
						end
					end)
					if not ok then
						showStatus(tostring(err):gsub("^.-:%d+: ", ""))
					end
				end
			)
		end
	end

	Pencil.refresh()
	local opened = window
	task.spawn(function()
		while window == opened and not opened.closed do
			task.wait(0.3)
			if window == opened then
				selectionChanged()
			end
		end
	end)
end

function Pencil.toggle()
	if window then
		Pencil.close()
	else
		Pencil.open()
	end
end

function Pencil.write(save)
	local value = Drawing.validate(refs.State.Timeline:GetState().GreaseDrawings or Drawing.empty())
	if #value.layers == 0 then
		local old = save:FindFirstChild("EclipseDrawingsV1")
		if old then
			old:Destroy()
		end
	end

	if #value.layers > 0 then
		Chunks.write(save, "EclipseDrawingsV1", Document.pack(value))
	end

	if next(data()) then
		Chunks.write(save, "EclipseGreasePencil", Document.pack(data()))
	end
end

function Pencil.load(save)
	local visual = save and save:FindFirstChild("EclipseDrawingsV1")
	local value = visual and Drawing.validate(Document.unpack(Chunks.read(visual)))
		or Drawing.empty()
	refs.State.Timeline:GetState().GreaseDrawings = value
	if drawingEditor then
		drawingEditor:cancel()
		drawingEditor.selected = nil
		drawingEditor:refresh()
	end

	TimingEditor.close()
	local restored = {}
	local source = save and save:FindFirstChild("EclipseGreasePencil")
	if source then
		local ok, result = pcall(function()
			return Path.validate(Document.unpack(Chunks.read(source)))
		end)
		if ok then
			restored = result
		end
	end

	refs.State.Timeline:GetState().GreaseStrokes = restored
	selected = next(restored)
	drawing = false
	stroke = nil
	releaseStrokeCamera()
	Pencil.refresh()
end

function Pencil.destroy()
	if drawingEditor then
		drawingEditor:destroy()
		drawingEditor = nil
	end

	TimingEditor.close()
	physicsTarget, physicsApply, physicsOptions = nil, nil, nil
	if window then
		local old = window
		window = nil
		old:close(true)
	end

	drawing = false
	stroke = nil
	releaseStrokeCamera()
	teardown()
	for _, connection in connections do
		connection:Disconnect()
	end

	table.clear(connections)
end

function Pencil.init(options)
	refs = options
	drawingEditor = DrawingEditor.new({
		refs = refs,
		Tool = Tool,
		History = History,
		Picker = ColorPicker,
		Path = Path,
		overUI = overUI,
		lockCamera = lockStrokeCamera,
		notify = function(message)
			Notification.showOnce("DRAWING", message, 5)
		end,
	})
	table.insert(
		connections,
		game:GetService("RunService").RenderStepped:Connect(function()
			if drawingEditor then
				drawingEditor:step()
			end
		end)
	)
	refs.State.GreasePencil = Pencil
	for _, camera in workspace:GetChildren() do
		if camera:IsA("Camera") then
			for _, child in camera:GetChildren() do
				if child.Name == "EclipseGreasePencil" then
					child:Destroy()
				end
			end
		end
	end

	local mouse = refs.Plugin:GetMouse()
	table.insert(connections, mouse.Button1Down:Connect(beginStroke))
	table.insert(connections, mouse.Button1Up:Connect(finishStroke))
	table.insert(
		connections,
		Input.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				finishStroke()
			end
		end)
	)
	table.insert(connections, mouse.Move:Connect(moveStroke))
	table.insert(
		connections,
		Input.InputBegan:Connect(function(input)
			if Shortcuts.matches("Cancel", input) and Pencil.isDrawing() then
				Pencil.cancelStroke()
			end
		end)
	)
	table.insert(connections, Input.WindowFocusReleased:Connect(Pencil.cancelStroke))
	table.insert(
		connections,
		workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
			Pencil.cancelStroke()
		end)
	)
	table.insert(
		connections,
		refs.ScreenGui:GetPropertyChangedSignal("Enabled"):Connect(function()
			if not refs.ScreenGui.Enabled then
				Pencil.close()
			end
		end)
	)
	table.insert(
		connections,
		refs.AnimatorFrame:GetPropertyChangedSignal("Visible"):Connect(function()
			if not refs.AnimatorFrame.Visible then
				Pencil.close()
			end
		end)
	)
	refs.ScreenGui.Destroying:Once(Pencil.destroy)
	refs.Plugin.Unloading:Once(Pencil.destroy)
end

return Pencil
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a49c</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2131">
          <Properties>
            <string name="Name">LiveSession</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028ff6</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{4DDE0C2D-0E76-493E-9AD1-8D58B58532F8}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local Http = game:GetService("HttpService")
local Studio = game:GetService("StudioService")
local Players = game:GetService("Players")
local Input = game:GetService("UserInputService")
local Storage = game:GetService("ServerStorage")
local Document = require("Document")
local Adapter = require("Adapter")
local Chunks = require("ChunkStore")
local Tool = require("Tool")
local History = require("History")
local Raw = require("RawState")
local Policy = require("Policy")
local Confirm = require("Confirm")
local Notification = require("Notification")
local Preview = require("rig")
local Presence = require("Presence")
local Run = game:GetService("RunService")
local Theme = require("Theme")
local Live = {}
local presence, following, renderConnection, joiningFollow
local joinAttempt
local observed, controlNumber, lastSent, remoteSource, remoteRevision
local transportDirty = false
local sessionConnections = {}
local lastCapture = 0
local editVersion = 0
local stream, previewShown, streamEditing
local synchronizing = false
local liveUndo, liveRedo = {}, {}
local stepping = false
local RETRY = "Eclipse Live retry"

local function now()
	return DateTime.now().UnixTimestampMillis / 1000
end

local invitation, invitedRoom
local dismissed = {}
local lifetime = 0
local refs, window, session, actor, document, adapter, unsubscribe
local changed = false
local applying = false
local pendingSince
local generation = 0
local status
local consumed = {}
local tick = 0
local userId, userName
local lastDiscoveryWarning

local function projectId()
	local save = refs.State.currentProjectSave
	return save and save:GetAttribute("EclipseProjectId")
end

local function directory(create)
	local root = require("root").get("EclipseAnimator_Live", false)
	if root then
		assert(
			root:GetAttribute("EclipseLiveVersion") == 1,
			"The Live folder belongs to a different version"
		)
	end

	if not root and create then
		root = require("root").get("EclipseAnimator_Live", true)
		root.Archivable = false
		root:SetAttribute("EclipseLiveVersion", 1)
	end

	return root
end

local PROTOCOL = 35

local function members(room)
	local result = {}
	if room and room:GetAttribute("Closed") then
		return result
	end

	local peers = room and room:FindFirstChild("Peers")
	if room and room:GetAttribute("Host") then
		local host = peers and peers:FindFirstChild(room:GetAttribute("Host"))
		if not host or not Presence.alive(host) then
			return result
		end
	end

	if peers then
		for _, peer in Presence.current(peers) do
			if peer:IsA("Folder") and Presence.alive(peer) then
				local source = Presence.target(peers, peer.Name, "") or peer
				local data = Presence.read(source)
				table.insert(result, {
					playing = data and data.playing,
					id = peer.Name,
					name = peer:GetAttribute("UserName") or "Creator",
					user = peer:GetAttribute("UserId") or 0,
					color = peer:GetAttribute("Color") or Presence.color(peer.Name),
					frame = Presence.sample(source, now()),
					peer = peer,
				})
			end
		end
	end

	table.sort(result, function(a, b)
		return a.id < b.id
	end)
	return result
end

local function cleanupRooms(root)
	if not root then
		return
	end

	local stamp = os.time()
	for _, room in root:GetChildren() do
		if room:IsA("Folder") and room:GetAttribute("Protocol") == PROTOCOL and room ~= session then
			local peers = room:FindFirstChild("Peers")
			local newest = 0
			for _, peer in peers and peers:GetChildren() or {} do
				local seen = peer:GetAttribute("Seen")
				if type(seen) == "number" and seen == seen then
					newest = math.max(newest, seen)
				end
			end

			local closed = room:GetAttribute("Closed") == true
			local closedAt = room:GetAttribute("ClosedAt")
			if closed and type(closedAt) ~= "number" then
				room:SetAttribute("ClosedAt", stamp)
				closedAt = stamp
			end

			if
				(closed and stamp - closedAt >= 15)
				or (not closed and newest > 0 and stamp - newest > 300)
			then
				room:Destroy()
			end
		end
	end
end

local function availableRooms()
	local rooms = {}
	local root = directory(false)
	cleanupRooms(root)
	if root then
		for _, room in root:GetChildren() do
			if room:GetAttribute("Protocol") == PROTOCOL and #members(room) > 0 then
				table.insert(rooms, room)
			end
		end
	end

	table.sort(rooms, function(a, b)
		return a.Name < b.Name
	end)
	return rooms
end

local function closeInvitation()
	if invitation then
		local old = invitation
		invitation = nil
		invitedRoom = nil
		old:close(true)
	end
end

local function findRoom()
	local root = directory(false)
	cleanupRooms(root)
	local found
	if root then
		for _, room in root:GetChildren() do
			if
				room:GetAttribute("Protocol") == PROTOCOL
				and room:GetAttribute("ProjectId") == projectId()
				and #members(room) > 0
				and (
					not found
					or (room:GetAttribute("StartedAt") or 0) > (found:GetAttribute("StartedAt") or 0)
					or (room:GetAttribute("StartedAt") or 0)
							== (found:GetAttribute("StartedAt") or 0)
						and room.Name > found.Name
				)
			then
				found = room
			end
		end
	end

	return found
end

local refresh, busy

function Live.isExporting()
	if refs and refs.State.Timeline:GetState().Exporting then
		return true
	end

	if session then
		for _, peer in Presence.current(session.Peers) do
			if peer:GetAttribute("Exporting") and Presence.alive(peer) then
				return true
			end
		end
	end

	return false
end

local function detachSync()
	if not actor or not session then
		return
	end

	local group = Presence.group(session.Peers, actor.Name)
	local count = 0
	for _ in group do
		count += 1
	end

	if count > 1 then
		actor:SetAttribute("SyncWith", "solo:" .. actor.Name)
	end
end

local function emitTransport()
	if not actor then
		return
	end

	local timeline = refs.State.Timeline
	local raw = timeline:GetState()
	local revision = controlNumber or 0
	for _, peer in session.Peers:GetChildren() do
		local packet = Presence.read(peer)
		if packet then
			revision = math.max(revision, packet.n)
		end
	end

	controlNumber = revision + 1
	actor:SetAttribute(
		"Transport",
		Http:JSONEncode({
			n = controlNumber,
			frame = raw.CurrentTime * raw.FPS,
			fps = raw.FPS,
			at = now(),
			playing = raw.Playing == true,
			finish = timeline:GetPlaybackEndTime() * raw.FPS,
			first = timeline:GetPlaybackStartTime() * raw.FPS,
			loop = timeline:IsLooping(),
		})
	)
	Presence.read(actor)
	lastSent = os.clock()
	transportDirty = false
end

function Live.beginExport()
	if actor then
		actor:SetAttribute("Exporting", true)
	end

	while synchronizing do
		task.wait()
	end

	if actor then
		emitTransport()
	end
end

function Live.endExport(restore)
	if actor then
		actor:SetAttribute("Exporting", nil)
	end

	observed = nil
	remoteSource = nil
	remoteRevision = nil
	if restore and actor then
		emitTransport()
		Live.afterAdvance()
	end
end

function Live.followPlayhead(id)
	if Live.isExporting() then
		return
	end

	if not actor then
		return
	end

	detachSync()
	following = following ~= id and id or nil
	joiningFollow = following ~= nil
	actor:SetAttribute("Following", following)
	refs.State.Timeline:GetState().Playing = false
	observed = nil
	remoteSource = nil
	remoteRevision = nil
	emitTransport()
end

function Live.syncPlayhead(id)
	if Live.isExporting() then
		return
	end

	if not actor or not session then
		return
	end

	local group = Presence.group(session.Peers, actor.Name)
	if not id or group[id] then
		detachSync()
		emitTransport()
		return
	end

	local peer = session.Peers:FindFirstChild(id)
	if not peer or not Presence.alive(peer) then
		return
	end

	following = nil
	joiningFollow = nil
	actor:SetAttribute("Following", nil)
	local source = Presence.target(session.Peers, id, actor.Name) or peer
	local data = Presence.read(source)
	local frame = Presence.sample(source, now())
	local raw = refs.State.Timeline:GetState()
	if frame then
		raw.CurrentTime = frame / raw.FPS
		raw.Playing = data and data.playing == true or false
	end

	actor:SetAttribute("SyncWith", Presence.groupKey(peer))
	observed = nil
	remoteSource = nil
	remoteRevision = nil
	emitTransport()

	refs.State.Timeline.LastLiveFrame = nil
	if refs.State.currentRig then
		refs.State.Timeline:ApplyPoseAtTime(refs.State.currentRig, raw.CurrentTime)
	end

	refs.State.Timeline:UpdatePlayhead()
end

function Live.afterAdvance()
	if refs.State.Timeline:GetState().Exporting then
		return
	end

	if not session or refs.State.Timeline._playbackPreparation then
		return
	end

	local raw = refs.State.Timeline:GetState()
	observed = {
		time = raw.CurrentTime,
		playing = raw.Playing,
		fps = raw.FPS,
		loop = refs.State.Timeline:IsLooping(),
		finish = refs.State.Timeline:GetPlaybackEndTime(),
		first = refs.State.Timeline:GetPlaybackStartTime(),
	}
end

function Live.advance(dt)
	if Live.isExporting() then
		refs.State.Timeline:GetState().Playing = false
		if not refs.State.Timeline:GetState().Exporting then
			require("EventPlayback").stop()
		end

		return true
	end

	if not session then
		return false
	end

	local timeline = refs.State.Timeline
	local raw = timeline:GetState()
	if timeline._playbackPreparation then
		return true
	end

	if timeline._playbackReadyAt and os.clock() < timeline._playbackReadyAt then
		return true
	end

	local manual = observed
		and (
			math.abs(raw.CurrentTime - observed.time) > 1e-7
			or raw.Playing ~= observed.playing
			or raw.FPS ~= observed.fps
			or timeline:IsLooping() ~= observed.loop
			or timeline:GetPlaybackEndTime() ~= observed.finish
			or timeline:GetPlaybackStartTime() ~= observed.first
		)
	local group = Presence.group(session.Peers, actor.Name)
	local shared
	local count = 0
	for _ in group do
		count += 1
	end

	shared = count > 1
	if shared and following then
		following = nil
		actor:SetAttribute("Following", nil)
		refresh()
	end

	if manual then
		if following then
			following = nil
			actor:SetAttribute("Following", nil)
			refresh()
		end

		transportDirty = true
	end

	if
		transportDirty
		and (
			not Raw.PlayheadDrag.draggingPlayhead
			or not lastSent
			or os.clock() - lastSent >= 1 / 30
		)
	then
		emitTransport()
	end

	local target
	if following then
		target = Presence.target(session.Peers, following, actor.Name)
		if not target then
			following = nil
			actor:SetAttribute("Following", nil)
			raw.Playing = false
			emitTransport()
			refresh()
		end
	elseif shared then
		target = Presence.source(session.Peers, actor.Name)
	end

	if target and (target ~= actor or shared) and not Raw.PlayheadDrag.draggingPlayhead then
		local data = Presence.read(target)
		if data then
			if busy() then
				return true
			end

			local commandChanged = remoteSource ~= target or remoteRevision ~= data.n
			local frame = Presence.position(data, os.clock())

			if commandChanged and data.playing and not data.sampleFrame and not joiningFollow then
				data.receivedAt = os.clock()
				frame = data.frame
			end

			timeline:ApplyLivePlayhead(
				frame,
				data.playing,
				dt,
				data.loop,
				data.finish,
				commandChanged,
				data.first
			)
			local shown = target ~= actor
				and not data.playing
				and stream
				and stream:apply(target, consumed[target], dt)
			if previewShown and not shown and refs.State.currentRig then
				timeline:ApplyPoseAtTime(refs.State.currentRig, raw.CurrentTime)
			end

			previewShown = shown
			remoteSource, remoteRevision = target, data.n
			joiningFollow = nil
			return true
		end
	end

	if previewShown and refs.State.currentRig then
		timeline:ApplyPoseAtTime(refs.State.currentRig, raw.CurrentTime)
	end

	previewShown = nil
	remoteSource = nil
	remoteRevision = nil
	return false
end

refresh = function()
	if refs and refs.State.Timeline then
		refs.State.Timeline:RefreshNavigation()
	end

	if not window then
		return
	end

	local room = session or findRoom()
	local people = members(room)
	local rooms = not session and availableRooms() or {}
	window.count.Text = if session or room
		then tostring(#people) .. (#people == 1 and " creator in this file" or " creators in this file")
		else (
			#rooms == 0 and "No Live sessions right now"
			or tostring(#rooms)
				.. (#rooms == 1 and " Live session open" or " Live sessions open")
		)
	window.file.Text = refs.State.currentProjectSave and refs.State.currentProjectSave.Name
		or "Unsaved file"
	local color = session and Color3.fromRGB(108, 213, 160) or Color3.fromRGB(153, 147, 161)
	window.status.Text = session and (Live.isExporting() and "EXPORTING" or "ONLINE") or "OFFLINE"
	window.status:SetAttribute("ThemeTxt", nil)
	window.status.TextColor3 = color
	window.dot.BackgroundColor3 = color
	window.error.Text = status or ""
	window.error.Visible = status ~= nil
	window.list.Size = UDim2.new(1, -24, 1, status and -264 or -226)
	local group = session and Presence.group(session.Peers, actor.Name) or {}
	local roomRows = window.roomRows
	local listed = {}
	if not session then
		for index, other in rooms do
			listed[other] = true
			local row = roomRows[other]
			if not row then
				row = Tool.make(
					"Frame",
					window.list,
					"Room",
					{ Size = UDim2.new(1, -12, 0, 44), BackgroundTransparency = 1 }
				)
				Tool.label(row, "FileName", "", UDim2.fromOffset(12, 4), UDim2.new(1, -110, 0, 20))
				local who =
					Tool.label(row, "Who", "", UDim2.fromOffset(12, 22), UDim2.new(1, -110, 0, 18))
				who.TextSize = 11
				who.TextTransparency = 0.35
				local button = Tool.button(
					row,
					"JoinRoom",
					"JOIN",
					UDim2.new(1, -86, 0, 10),
					UDim2.fromOffset(80, 24),

					function()
						Live.requestJoin(other)
					end
				)
				button:SetAttribute("ThemeBg", "Sel")
				Theme.applyTree(button)
				roomRows[other] = row
			end

			row.LayoutOrder = -100 + index
			local inRoom = members(other)
			row.FileName.Text = (other:GetAttribute("FileName") or "Animation")
				.. (other:GetAttribute("ProjectId") == projectId() and "  (your file)" or "")
			local names = {}
			for i, person in inRoom do
				if i <= 3 then
					table.insert(names, person.name)
				end
			end

			row.Who.Text = table.concat(names, ", ")
				.. (#inRoom > 3 and " +" .. (#inRoom - 3) or "")
		end
	end

	for other, row in roomRows do
		if not listed[other] then
			row:Destroy()
			roomRows[other] = nil
		end
	end

	local count = 0
	for _ in group do
		count += 1
	end

	window.followText.Text = following and "FOLLOW: ON" or "FOLLOW: OFF"
	window.syncText.Text = count > 1 and "SYNC: ON" or "SYNC: OFF"
	window.follow:SetAttribute("ThemeBg", following and "Sel" or "TopBtn")
	window.sync:SetAttribute("ThemeBg", count > 1 and "Sel" or "TopBtn")
	Theme.applyTree(window.follow)
	Theme.applyTree(window.sync)
	window.actionText.Text = session and "SAVE & LEAVE"
		or room and "JOIN LIVE"
		or "START LIVE FOR THIS FILE"
	local present = {}
	for i, person in people do
		present[person.id] = true
		local row = window.rows[person.id]
		if not row then
			row = Tool.make(
				"Frame",
				window.list,
				person.id,
				{ Size = UDim2.new(1, -12, 0, 52), BackgroundTransparency = 1 }
			)
			local avatar = Tool.make("ImageLabel", row, "Avatar", {
				Position = UDim2.fromOffset(12, 8),
				Size = UDim2.fromOffset(36, 36),
				BackgroundColor3 = Color3.fromRGB(44, 34, 54),
				BorderSizePixel = 0,
				ScaleType = Enum.ScaleType.Crop,
			})
			Tool.make("UICorner", avatar, "Round", { CornerRadius = UDim.new(1, 0) })
			Tool.make(
				"UIStroke",
				avatar,
				"Ring",
				{ Thickness = 1, Transparency = 0.25, Color = person.color }
			)
			Tool.button(
				row,
				"Follow",
				"FOLLOW",
				UDim2.new(1, -124, 0, 14),
				UDim2.fromOffset(62, 24),

				function()
					Live.followPlayhead(person.id)
					refresh()
				end
			)
			Tool.button(row, "Sync", "SYNC", UDim2.new(1, -58, 0, 14), UDim2.fromOffset(54, 24), function()
				Live.syncPlayhead(person.id)
				refresh()
			end
)
			Tool.label(row, "Creator", "", UDim2.fromOffset(62, 6), UDim2.new(1, -194, 0, 22))
			local joined = Tool.label(
				row,
				"Joined",
				"Joined",
				UDim2.fromOffset(62, 28),
				UDim2.new(1, -194, 0, 18)
			)
			joined.TextSize = 11
			joined.TextTransparency = 0.35
			window.rows[person.id] = row
		end

		row.LayoutOrder = i
		row.Joined.Text = person.peer:GetAttribute("Exporting") and "Exporting module…"
			or "Joined"
		row.Avatar.Ring.Color = person.color
		row.Follow.Visible = person.id ~= (actor and actor.Name)
		row.Sync.Visible = row.Follow.Visible
		row.Follow:SetAttribute("ThemeBg", following == person.id and "Sel" or "TopBtn")
		row.Sync:SetAttribute("ThemeBg", count > 1 and group[person.id] and "Sel" or "TopBtn")
		Theme.applyTree(row.Follow)
		Theme.applyTree(row.Sync)
		row.Creator.Text = person.name .. (person.id == (actor and actor.Name) and " (you)" or "")
		row.Avatar.Image = person.user > 0
				and "rbxthumb://type=AvatarHeadShot&id=" .. person.user .. "&w=150&h=150"
			or ""
	end

	for id, row in window.rows do
		if not present[id] then
			row:Destroy()
			window.rows[id] = nil
		end
	end

	window.empty.Visible = #people == 0 and next(listed) == nil
	window.empty.Text = if session
		then "No creators connected"
		else "Nobody is live yet. Start one for your file below."
end

busy = function()
	local state = refs.State
	local axis = state.Axis
	return (not synchronizing and Live.isExporting())
		or state.PhysicsSimulating
		or state.PresentationHidden
		or not refs.Active()
		or Input:GetFocusedTextBox() ~= nil
		or state.Timeline._eventDrag ~= nil
		or state.GraphEditor and state.GraphEditor.isInteracting()
		or Raw.KeyframeDrag.draggingKeyframe ~= nil
		or Raw.KeyframeTransform.active
		or Raw.PlayheadDrag.draggingPlayhead
		or axis and (axis:IsHoldingAxis() or axis:IsBlenderGrabMode() or axis:IsBlenderRotateMode())
		or state.PropertyGizmo and state.PropertyGizmo.isEditing()
		or state.EffectHandles and state.EffectHandles.isEditing()
		or state.CameraControls and state.CameraControls.isEditing()
		or state.GreasePencil and state.GreasePencil.isStrokeActive()
end

local function readPacket(peer, budget)
	local records, revision = Document.receive(peer, consumed[peer], budget)
	if not records then
		return nil
	end

	for _, record in records do
		assert(record.a == peer.Name, "Invalid Live author")
	end

	return records, revision
end

local function remember(before, after)
	local entry = {}
	local any = false
	for key, value in after do
		if before[key] ~= value then
			entry[key] = { old = before[key], new = value }
			any = true
		end
	end

	for key, value in before do
		if after[key] == nil then
			entry[key] = { old = value, new = nil }
			any = true
		end
	end

	if not any then
		return
	end

	table.insert(liveUndo, entry)
	if #liveUndo > 100 then
		table.remove(liveUndo, 1)
	end

	table.clear(liveRedo)
end

local function publish(budget)
	assert(session and not session:GetAttribute("Closed"), "The host closed this Live session")
	Document.publish(actor, document.published, document.dirty, budget)
	table.clear(document.dirty)
	if stream then
		stream:commit(actor)
	end
end

local function applyShared(values, previous, budget)
	applying = true
	local ok, err = pcall(function()
		adapter:apply(values, previous, budget)
	end)
	applying = false
	if not ok then
		error(err, 0)
	end
end

local function synchronizeOnce(forceCapture)
	local token, version = generation, editVersion
	local deadline = os.clock() + 0.004

	local function budget()
		if token ~= generation or not session or session:GetAttribute("Closed") then
			error(RETRY, 0)
		end

		if os.clock() >= deadline then
			task.wait()
			deadline = os.clock() + 0.004
			if token ~= generation or version ~= editVersion or busy() then
				error(RETRY, 0)
			end
		end
	end

	local incoming, revisions = {}, {}
	for _, other in session.Peers:GetChildren() do
		if other ~= actor then
			local packet, revision = readPacket(other, budget)
			if packet then
				table.insert(incoming, packet)
				revisions[other] = revision
			end
		end
	end

	local raw = refs.State.Timeline:GetState()
	if
		forceCapture
		or changed and (#incoming > 0 or pendingSince ~= nil or os.clock() - lastCapture >= 0.2)
		or (not raw.Playing and os.clock() - lastCapture >= 10)
	then
		local captured = adapter:capture(budget)
		if version ~= editVersion or busy() then
			return
		end

		local before, userEdit = document.observed, changed
		lastCapture = os.clock()
		changed = false
		if document:edit(captured) and userEdit and not stepping then
			remember(before, captured)
		end
	end

	if next(document.dirty) then
		publish(budget)
	elseif stream and stream.active and not streamEditing then
		stream:commit(actor)
	end

	local remote = false
	for _, packet in incoming do
		local updated = document:merge(packet)
		remote = remote or updated
	end

	if remote then
		pendingSince = pendingSince or os.clock()
	end

	if remote or pendingSince then
		local values = document:values()
		if not Document.equal(values, document.observed) then
			applyShared(values, document.observed, budget)

			document.observed = values
		end

		local shown = adapter:capture(budget)
		if version ~= editVersion then
			error(RETRY, 0)
		end

		document.observed = shown
		lastCapture = os.clock()
		changed = false
		status = nil
		pendingSince = nil
		Live.afterAdvance()
		refresh()
	end

	for peer, revision in revisions do
		consumed[peer] = revision
	end
end

local function synchronize(forceCapture)
	if Live.isExporting() then
		return
	end

	if synchronizing then
		return
	end

	synchronizing = true
	local ok, err = xpcall(function()
		synchronizeOnce(forceCapture)
	end, debug.traceback)
	synchronizing = false
	if not ok then
		error(err, 0)
	end
end

local function step(from, into, back, forward)
	if not session or stepping then
		return false
	end

	stepping = true
	local ok, result = pcall(function()
		refs.Finalize()
		while synchronizing do
			task.wait()
		end

		if changed then
			lastCapture = -math.huge
			stepping = false
			pcall(synchronize)
			stepping = true
			while synchronizing do
				task.wait()
			end
		end

		assert(not busy(), "Finish the current edit first")
		while #from > 0 do
			local entry = table.remove(from)
			local observed = document.observed
			local target = table.clone(observed)
			local applied = {}
			for key, change in entry do
				if observed[key] == change[forward] then
					target[key] = change[back]
					applied[key] = change
				end
			end

			if next(applied) then
				synchronizing = true
				local done, err = pcall(function()
					applyShared(target, observed)
					document:edit(target)
					publish()
				end)
				synchronizing = false
				if not done then
					error(err, 0)
				end

				lastCapture = os.clock()
				changed = false
				table.insert(into, applied)
				Live.afterAdvance()
				return true
			end
		end

		return false
	end)
	stepping = false
	if not ok then
		Notification.show("LIVE", (tostring(result):gsub("^.-:%d+: ", "")))
		return false
	end

	return result
end

function Live.undo()
	return step(liveUndo, liveRedo, "old", "new")
end

function Live.redo()
	return step(liveRedo, liveUndo, "new", "old")
end

function Live.prepareSave()
	if not session then
		return
	end

	refs.Finalize()
	assert(not busy(), "Finish the current edit and stop playback before saving Live")
	while synchronizing do
		task.wait()
	end

	local expected = session
	local deadline = os.clock() + 10
	repeat
		assert(
			session == expected and actor and actor.Parent,
			"Live ended before the save completed"
		)
		assert(os.clock() < deadline, "Live is still receiving edits. Retry Save.")
		changed = true
		local ok, err = pcall(synchronize, true)
		if not ok and not tostring(err):find(RETRY, 1, true) then
			error(err, 0)
		end

		if not ok then
			task.wait()
		end
	until not changed and not pendingSince and not next(document.dirty)
end

function Live.saveAndLeave()
	if not session then
		return true
	end

	local ok, err = pcall(function()
		assert(
			refs.Save(true),
			"Could not save the shared file. You are still connected; retry Save and Leave."
		)
	end)
	if not ok then
		status = tostring(err):gsub("^.-:%d+: ", "")
		refresh()
		return false
	end

	Live.leave(true)
	return true
end

function Live.leave(saved)
	if session and refs and refs.State and refs.State.Timeline then
		local raw = refs.State.Timeline:GetState()
		raw.Playing = false
		if raw.Exporting then
			raw.Exporting.Cancelled = true
		end

		require("EventPlayback").stop()
	end

	if joinAttempt then
		joinAttempt.cancelled = true
	end

	for _, connection in sessionConnections do
		connection:Disconnect()
	end

	sessionConnections = {}
	if
		not saved
		and session
		and not session:GetAttribute("Closed")
		and actor
		and document
		and adapter
		and not refs.State.Timeline:GetState().Exporting
	then
		pcall(function()
			document:edit(adapter:capture())
			if next(document.dirty) then
				publish()
			end
		end)
	end

	if actor and session and session:GetAttribute("Host") == actor.Name then
		session:SetAttribute("Closed", true)
		session:SetAttribute("ClosedAt", os.time())
	end

	detachSync()
	generation += 1
	if actor then
		actor:SetAttribute("Exporting", nil)
		actor:SetAttribute("Seen", 0)
		actor:SetAttribute("PoseActive", false)
	end

	actor, session, document, adapter = nil, nil, nil, nil
	following = nil
	joiningFollow = nil
	observed = nil
	controlNumber = nil
	transportDirty = false
	remoteSource = nil
	remoteRevision = nil
	stream = nil
	previewShown = nil
	streamEditing = nil
	if renderConnection then
		renderConnection:Disconnect()
		renderConnection = nil
	end

	if presence then
		presence:clear()
		presence = nil
	end

	local previewOk, previewError = pcall(Preview.finish)
	History.clear()
	Policy.setLiveChannels(nil)
	consumed = {}
	changed = false
	status = nil
	pendingSince = nil
	table.clear(liveUndo)
	table.clear(liveRedo)
	refresh()
	if not previewOk then
		warn("[Eclipse Live] Preview restoration: " .. tostring(previewError))
	end
end

function Live.isApplying()
	return applying
end

local function endClosedSession()
	if not session then
		return false
	end

	local host = session.Peers:FindFirstChild(session:GetAttribute("Host") or "")
	local closed = session:GetAttribute("Closed")
	if closed or not host or not Presence.alive(host) then
		Live.leave(true)
		status = closed and "The host ended Live. Your current animation remains open."
			or "The Live host disconnected. Your current animation remains open."
		refresh()
		return true
	end

	return false
end

function Live.isJoined()
	return session ~= nil
end

function Live.isOpen()
	return window ~= nil
end

function Live.isBusy()
	return busy()
end

function Live.presentationWidget()
	return window and window.docked and window.widget or nil
end

local function join(selectedRoom, attempt)
	local function checkJoin()
		assert(joinAttempt == attempt and not attempt.cancelled, "Live connection was cancelled")
	end

	assert(not session, "Already joined this Live file")
	assert(refs.Active(), "Open an Eclipse file first")
	assert(
		not refs.State.BlenderBridge or not refs.State.BlenderBridge.isLive(),
		"Turn Blender Live off before joining Eclipse Live"
	)
	refs.Finalize()
	assert(not busy(), "Finish the current edit before joining Live")
	checkJoin()
	local room = selectedRoom or findRoom()
	local created = room == nil
	if room then
		assert(room.Parent and #members(room) > 0, "This Live session has closed")
		assert(
			room:GetAttribute("ProjectId") == projectId(),
			"Open the shared file before joining Live"
		)
	end

	if room then
		assert(
			room:GetAttribute("Protocol") == PROTOCOL,
			"Everyone in this Live file must update and restart Eclipse Live"
		)
		assert(
			refs.State.currentProjectSaved or not History.canUndo(),
			"Save or reopen this file before joining Live"
		)
	else
		assert(refs.Save(), "Save the file before starting Live")
	end

	checkJoin()
	adapter = Adapter.new(refs.State)
	local current = adapter:capture()
	checkJoin()
	if not room then
		room = Instance.new("Folder")
		room.Name = Http:GenerateGUID(false)
		room.Archivable = false
		room:SetAttribute("Protocol", PROTOCOL)
		room:SetAttribute("StartedAt", now())
		room:SetAttribute("ProjectId", projectId())
		room:SetAttribute("FileName", refs.State.currentProjectSave.Name)
		room:SetAttribute("Layout", adapter.signature)
		local seedFolder = Instance.new("Folder")
		seedFolder.Name = "Seed"
		seedFolder.Parent = room
		local records = {}
		for key, value in current do
			records[key] = { n = 0, a = "", v = value }
		end

		Document.publish(seedFolder, records)
		local peers = Instance.new("Folder")
		peers.Name = "Peers"
		peers.Parent = room
		room.Parent = directory(true)
	end

	local seedFolder = room:FindFirstChild("Seed")
	assert(seedFolder, "File is still arriving. Try joining again")
	local seedRecords = Document.receive(seedFolder)
	assert(seedRecords, "File is still arriving. Try joining again")
	checkJoin()
	local seedValues = {}
	for key, record in seedRecords do
		seedValues[key] = record.v
	end

	local peer = Instance.new("Folder")
	peer.Name = Http:GenerateGUID(false)
	peer.Archivable = false
	peer:SetAttribute("Color", Presence.color(tostring(userId) .. ":" .. peer.Name))
	peer:SetAttribute("UserId", userId)
	peer:SetAttribute("UserName", userName)
	peer:SetAttribute("Seen", os.time())
	Preview.begin(refs.State, refs)
	checkJoin()
	History.clear()
	adapter:refresh()
	document = Document.new(peer.Name, seedValues)
	consumed = {}
	for _, other in room.Peers:GetChildren() do
		local packet = readPacket(other)
		if packet then
			document:merge(packet)
		end
	end

	local values = document:values()
	if not Document.equal(values, current) then
		applyShared(values, current)
	end

	checkJoin()
	document.observed = values
	Policy.setLiveChannels(Document.unpack(values.project).channels)
	Presence.claim(peer, room.Peers)
	actor, session = peer, room
	if created then
		room:SetAttribute("Host", peer.Name)
	end

	peer.Parent = room.Peers
	table.insert(sessionConnections, actor:GetAttributeChangedSignal("SyncWith"):Connect(refresh))
	table.insert(sessionConnections, room.Peers.ChildAdded:Connect(refresh))
	table.insert(sessionConnections, room.Peers.ChildRemoved:Connect(refresh))
	generation += 1
	changed = false
	status = nil
	publish()
	refresh()
	stream = Preview.stream(adapter)
	presence = Presence.new(refs.State.Timeline)
	emitTransport()
	Live.afterAdvance()
	local presenceAt, seenAt, validateAt = 0, 0, 0
	renderConnection = Run.RenderStepped:Connect(function(dt)
		if session and not session:GetAttribute("Closed") then
			local stamp = os.clock()
			if Live.isExporting() then
				if stamp - seenAt >= 5 then
					actor:SetAttribute("Seen", os.time())
					seenAt = stamp
				end

				return
			end

			if stamp - presenceAt >= 0.2 then
				local raw = refs.State.Timeline:GetState()
				actor:SetAttribute(
					"Progress",
					Http:JSONEncode({ n = controlNumber, frame = raw.CurrentTime * raw.FPS })
				)
				presenceAt = stamp
			end

			if stamp - seenAt >= 5 then
				actor:SetAttribute("Seen", os.time())
				seenAt = stamp
			end

			presence:update(members(session), actor.Name, actor:GetAttribute("Color"), dt)
			local state = refs.State
			local axis = state.Axis
			local editing = not state.PhysicsSimulating
					and not state.Timeline:GetState().Playing
					and (axis and (axis:IsHoldingAxis() or axis:IsBlenderGrabMode() or axis:IsBlenderRotateMode()) or state.PropertyGizmo and state.PropertyGizmo.isEditing() or state.EffectHandles and state.EffectHandles.isEditing() or state.CameraControls and state.CameraControls.isEditing())
				or false
			if editing and not streamEditing then
				transportDirty = true
			end

			if streamEditing and not editing then
				if not state.PhysicsSimulating and stream then
					stream:publish(actor, true, true)
				end

				changed = true
				editVersion += 1
			end

			streamEditing = editing
			if stream then
				stream:publish(actor, editing)
			end
		end
	end)
	local token = generation
	task.spawn(function()
		while token == generation and session do
			task.wait(1 / 30)
			if token ~= generation then
				break
			end

			local ok, err = pcall(function()
				if endClosedSession() then
					return
				end

				assert(session.Parent and actor.Parent, "Live session closed")
				if not Presence.isCurrent(actor) then
					Live.leave(true)
					status = "This account rejoined Live elsewhere."
					refresh()
					return
				end

				assert(projectId() == session:GetAttribute("ProjectId"), "You switched files")
				assert(
					not refs.State.BlenderBridge or not refs.State.BlenderBridge.isLive(),
					"Blender Live started. Eclipse Live stopped."
				)
				local timeline = refs.State.Timeline
				local raw = timeline:GetState()

				if os.clock() - seenAt >= 5 then
					actor:SetAttribute("Seen", os.time())
					seenAt = os.clock()
				end

				if os.clock() - validateAt >= 5 then
					validateAt = os.clock()

					refresh()
				end

				if busy() then
					return
				end

				synchronize()
			end)
			if not ok then
				local message = tostring(err):gsub("^.-:%d+: ", "")
				if message:find(RETRY, 1, true) then
					continue
				end

				if message:find("Waiting for shared", 1, true) then
					pendingSince = pendingSince or os.clock()
					status = "Waiting for shared rigs / bones..."
					refresh()
					continue
				end

				Live.leave()
				status = message
				refresh()
				break
			end
		end
	end)
end

function Live.join(room)
	assert(not Live.isExporting(), "Wait for module export to finish before joining Live")
	closeInvitation()
	assert(not session, "Already joined this Live file")
	assert(not joinAttempt, "Already connecting to this Live file")
	local attempt = {}
	joinAttempt = attempt
	local ok, err = pcall(join, room, attempt)
	if not ok then
		Live.leave(true)
	end

	if joinAttempt == attempt then
		joinAttempt = nil
	end

	if not ok then
		error(err, 0)
	end
end

local prompt

local function closePrompt()
	if prompt then
		local old = prompt
		prompt = nil
		old:close(true)
	end
end

local function hasUnsavedWork()
	return refs.Active() and not refs.State.currentProjectSaved and History.canUndo()
end

local function besideLive(frame)
	local anchor = window and not window.docked and window.frame
	if not anchor or not anchor.Parent then
		return
	end

	local size = frame.AbsoluteSize
	local screen = anchor.Parent.AbsoluteSize
	local x = anchor.AbsolutePosition.X + anchor.AbsoluteSize.X + 12
	if x + size.X > screen.X - 8 then
		x = anchor.AbsolutePosition.X - size.X - 12
	end

	frame.AnchorPoint = Vector2.zero
	frame.Position = UDim2.fromOffset(
		math.max(8, x),
		math.clamp(anchor.AbsolutePosition.Y, 8, math.max(8, screen.Y - size.Y - 8))
	)
end

local joining = false

function Live.requestJoin(room)
	if session or joining or not room or not room.Parent then
		return
	end

	closePrompt()

	local function enter(saveFirst)
		closePrompt()
		if joining then
			return
		end

		joining = true
		local ok, err = pcall(function()
			refs.Finalize()
			if saveFirst then
				assert(refs.Save(), "Could not save your animation. Try again.")
			end

			if projectId() ~= room:GetAttribute("ProjectId") then
				local saves = require("root").get("EclipseAnimator_Saves", false)
				local save
				for _, candidate in saves and saves:GetChildren() or {} do
					if
						candidate:GetAttribute("EclipseProjectId")
						== room:GetAttribute("ProjectId")
					then
						save = candidate
						break
					end
				end

				assert(save, "The shared file is still arriving. Try joining again.")
				assert(refs.OpenSave, "Update Eclipse to join this file")
				refs.OpenSave(save)
				local deadline = os.clock() + 30
				while
					(
						refs.State.LoadingProject
						or projectId() ~= room:GetAttribute("ProjectId")
						or not refs.Active()
					) and os.clock() < deadline
				do
					task.wait(0.1)
				end

				assert(
					projectId() == room:GetAttribute("ProjectId"),
					"The shared file took too long to open. Try joining again."
				)
			end

			Live.join(room)
			Live.open()
		end)
		joining = false
		if not ok then
			status = (tostring(err):gsub("^.-:%d+: ", ""))
			Notification.show("LIVE", status)
			refresh()
		end
	end

	if not hasUnsavedWork() then
		enter(false)
		return
	end

	prompt = Tool.new(refs, "EclipseLiveSave", "JOIN LIVE", Vector2.new(340, 150), false, function()
		prompt = nil
	end)
	local frame = prompt.frame
	local message = Tool.label(
		frame,
		"Message",
		"You have unsaved changes. Save them before joining "
			.. (room:GetAttribute("FileName") or "this file")
			.. "?",
		UDim2.fromOffset(12, 38),
		UDim2.new(1, -24, 0, 50)
	)
	message.TextWrapped = true
	Tool.button(
		frame,
		"Discard",
		"DON'T SAVE",
		UDim2.new(0, 12, 1, -40),
		UDim2.new(1 / 3, -12, 0, 26),

		function()
			enter(false)
		end
	)
	Tool.button(
		frame,
		"Cancel",
		"CANCEL",
		UDim2.new(1 / 3, 4, 1, -40),
		UDim2.new(1 / 3, -8, 0, 26),
		closePrompt
	)
	local save = Tool.button(
		frame,
		"SaveJoin",
		"SAVE & JOIN",
		UDim2.new(2 / 3, 0, 1, -40),
		UDim2.new(1 / 3, -12, 0, 26),

		function()
			enter(true)
		end
	)
	save:SetAttribute("ThemeBg", "Sel")
	Theme.applyTree(save)
	task.defer(besideLive, frame)
end

local function discover(manual)
	if session or not refs.ScreenGui.Enabled or refs.State.PresentationHidden then
		closeInvitation()
		return
	end

	local rooms = availableRooms()
	if invitation then
		if not invitedRoom or not table.find(rooms, invitedRoom) then
			closeInvitation()
		else
			return
		end
	end

	local room
	for _, candidate in rooms do
		if manual or not dismissed[candidate.Name] then
			room = candidate
			break
		end
	end

	if not room then
		if manual then
			local root = directory(false)
			local incompatible = false
			if root then
				for _, candidate in root:GetChildren() do
					if
						candidate:GetAttribute("Protocol") ~= PROTOCOL
						and #members(candidate) > 0
					then
						incompatible = true
						break
					end
				end
			end

			status = incompatible
					and "Live versions differ. Both creators must update and restart Live."
				or "No sessions found. Both creators must share one Team Create session."
			refresh()
		end

		return
	end

	if manual then
		status = nil
		refresh()
	end

	dismissed[room.Name] = true
	invitedRoom = room
	invitation = Tool.new(refs, "EclipseLiveInvite", "JOIN LIVE", Vector2.new(360, 158), false, function()
		invitation = nil
		invitedRoom = nil
	end
)
	local people = members(room)
	local text = (people[1] and people[1].name or "Someone")
		.. " is editing "
		.. (room:GetAttribute("FileName") or "an animation")
		.. "."
	local label = Tool.label(
		invitation.frame,
		"Message",
		text,
		UDim2.fromOffset(12, 40),
		UDim2.new(1, -24, 0, 50)
	)
	label.TextWrapped = true
	Tool.button(
		invitation.frame,
		"Later",
		"LATER",
		UDim2.new(0, 12, 1, -40),
		UDim2.new(0.5, -18, 0, 26),
		closeInvitation
	)
	local joinButton = Tool.button(
		invitation.frame,
		"Join",
		"JOIN LIVE",
		UDim2.new(0.5, 6, 1, -40),
		UDim2.new(0.5, -18, 0, 26),

		function()
			closeInvitation()
			Live.open()
			Live.requestJoin(room)
		end
	)
	joinButton:SetAttribute("ThemeBg", "Sel")
end

function Live.close()
	if window then
		local old = window
		window = nil
		old:close()
	end

	refresh()
end

function Live.open()
	if window then
		return
	end

	window = Tool.new(refs, "EclipseLive", "LIVE", Vector2.new(440, 350), true, function()
		window = nil
		refresh()
	end)
	local frame = window.frame
	window.file = Tool.label(frame, "File", "", UDim2.fromOffset(12, 38), UDim2.new(1, -24, 0, 24))
	window.file.TextSize = 13
	window.count =
		Tool.label(frame, "Count", "", UDim2.fromOffset(12, 68), UDim2.new(1, -24, 0, 20))
	window.count.TextTransparency = 0.3
	window.list = Tool.make("ScrollingFrame", frame, "Creators", {
		Position = UDim2.fromOffset(12, 156),
		Size = UDim2.new(1, -24, 1, -226),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		BackgroundColor3 = Color3.fromRGB(18, 8, 26),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ClipsDescendants = true,
	})
	window.list:SetAttribute("ThemeBg", "Top")
	Tool.make(
		"UIStroke",
		window.list,
		"Outline",
		{ Color = Color3.fromRGB(69, 41, 93), Transparency = 0.4 }
	)
		:SetAttribute("ThemeStrk", "Strk")
	Tool.make(
		"UIListLayout",
		window.list,
		"Rows",
		{ SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }
	)
	window.empty = Tool.label(
		window.list,
		"Empty",
		"No creators connected",
		UDim2.new(),
		UDim2.new(1, -8, 0, 74)
	)
	window.empty.TextXAlignment = Enum.TextXAlignment.Center
	window.empty.TextTransparency = 0.4
	Tool.button(
		frame,
		"FindLive",
		"FIND LIVE SESSIONS",
		UDim2.fromOffset(12, 94),
		UDim2.new(1, -24, 0, 24),

		function()
			discover(true)
		end
	)
	window.follow, window.followText = Tool.button(
		frame,
		"FollowPlayhead",
		"FOLLOW: OFF",
		UDim2.fromOffset(12, 124),
		UDim2.new(0.5, -18, 0, 24),

		function()
			if following then
				Live.followPlayhead(following)
			elseif session then
				for _, person in members(session) do
					if person.id ~= actor.Name then
						Live.followPlayhead(person.id)
						break
					end
				end
			end

			refresh()
		end
	)
	window.sync, window.syncText = Tool.button(
		frame,
		"SyncPlayhead",
		"SYNC: OFF",
		UDim2.new(0.5, 6, 0, 124),
		UDim2.new(0.5, -18, 0, 24),

		function()
			if session then
				local group = Presence.group(session.Peers, actor.Name)
				local count = 0
				for _ in group do
					count += 1
				end

				if count > 1 then
					Live.syncPlayhead(nil)
				else
					for _, person in members(session) do
						if person.id ~= actor.Name then
							Live.syncPlayhead(person.id)
							break
						end
					end
				end
			end

			refresh()
		end
	)
	window.rows = {}
	window.roomRows = {}
	window.dot = Tool.make(
		"Frame",
		frame,
		"ConnectionDot",
		{ Position = UDim2.new(0, 14, 1, -57), Size = UDim2.fromOffset(6, 6), BorderSizePixel = 0 }
	)
	Tool.make("UICorner", window.dot, "Round", { CornerRadius = UDim.new(1, 0) })
	window.status =
		Tool.label(frame, "Status", "OFFLINE", UDim2.new(0, 28, 1, -65), UDim2.new(1, -40, 0, 22))
	window.status.TextSize = 11
	window.error =
		Tool.label(frame, "Error", "", UDim2.new(0, 12, 1, -104), UDim2.new(1, -24, 0, 32))
	window.error:SetAttribute("ThemeTxt", nil)
	window.error.TextColor3 = Color3.fromRGB(239, 145, 156)
	window.error.TextSize = 11
	window.error.TextWrapped = true

	window.action, window.actionText = Tool.button(
		frame,
		"Connect",
		"START LIVE",
		UDim2.new(0, 12, 1, -38),
		UDim2.new(1, -24, 0, 26),

		function()
			if session then
				Live.saveAndLeave()
			else
				local room = findRoom()
				if room then
					Live.requestJoin(room)
					return
				end

				local ok, err = pcall(Live.join)
				if not ok then
					status = tostring(err):gsub("^.-:%d+: ", "")
					refresh()
				end
			end
		end
	)
	refresh()
	local opened = window
	task.spawn(function()
		while window == opened and not opened.closed do
			task.wait(1)
			if window == opened then
				refresh()
			end
		end
	end)
end

function Live.toggle()
	if window then
		Live.close()
	else
		Live.open()
	end
end

function Live.destroy()
	lifetime += 1
	closeInvitation()
	closePrompt()
	Live.leave()
	if window then
		local old = window
		window = nil
		old:close(true)
	end

	if unsubscribe then
		unsubscribe()
		unsubscribe = nil
	end
end

function Live.init(options)
	refs = options
	refs.State.LiveSession = Live
	refs.State.LiveProject = options
	lifetime += 1
	local token = lifetime
	task.spawn(function()
		while token == lifetime do
			task.wait(2)
			if token ~= lifetime then
				break
			end

			local ok, err = pcall(discover, false)
			if not ok and os.clock() - (lastDiscoveryWarning or -math.huge) > 60 then
				lastDiscoveryWarning = os.clock()
				warn("Eclipse Live discovery: " .. tostring(err))
			end
		end
	end)
	userId = 0
	pcall(function()
		userId = Studio:GetUserId()
	end)
	userName = "Creator " .. userId
	task.spawn(function()
		pcall(function()
			userName = Players:GetNameFromUserIdAsync(userId)
		end)
	end)
	unsubscribe = History.subscribe(function()
		if session then
			changed = true
			editVersion += 1
		end
	end)
	refs.ScreenGui.Destroying:Once(Live.destroy)
	refs.Plugin.Unloading:Once(Live.destroy)
	refs.ScreenGui:GetPropertyChangedSignal("Enabled"):Connect(function()
		if not refs.ScreenGui.Enabled then
			Live.leave()
			Live.close()
			closeInvitation()
		end
	end)
	refs.AnimatorFrame:GetPropertyChangedSignal("Visible"):Connect(function()
		if not refs.AnimatorFrame.Visible and not refs.State.PresentationHidden then
			Live.leave()
			Live.close()
		end
	end)
end

return Live
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a49d</UniqueId>
