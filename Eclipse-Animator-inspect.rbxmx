          <Item class="ModuleScript" referent="2061">
            <Properties>
              <string name="Name">EclipseExportResourcesEffectAssets</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028fb0</UniqueId>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{27FB7E68-2596-4428-9513-FE5B7EFE91BC}</string>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local catalog = script.Parent.Parent.EffectCatalog
local parts = { "return function(require)\nreturn {\n" }

for _, group in {
	catalog.EclipseEffectCatalogSingularColors,
	catalog.EclipseEffectCatalogLighting,
	catalog.EclipseEffectCatalogDoubleColors,
	catalog.EclipseEffectCatalogMisc,
} do
	local records = group:GetChildren()
	table.sort(records, function(a, b)
		return a.Name < b.Name
	end)
	for _, record in records do
		local source = record.Source
		local prefix = "--!nocheck\n-- riftkuro\n\nreturn "
		assert(source:sub(1, #prefix) == prefix, "Invalid bundled effect record")
		table.insert(parts, source:sub(#prefix + 1):gsub("%s+$", "") .. ",\n")
	end
end

table.insert(parts, "}\nend\n")
return table.concat(parts)
]]></string>
