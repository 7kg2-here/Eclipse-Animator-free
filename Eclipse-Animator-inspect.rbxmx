        <Item class="ModuleScript" referent="2028">
          <Properties>
            <string name="Name">ClipboardModes</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f8f</UniqueId>
