        <Item class="ModuleScript" referent="1947">
          <Properties>
            <string name="Name">Faces</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f3e</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
