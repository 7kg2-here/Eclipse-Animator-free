        <Item class="ModuleScript" referent="1957">
          <Properties>
            <string name="Name">BlenderEdit</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f48</UniqueId>
            <ContentId name="LinkedSource">
              <null>
