        </Item>
        <Item class="ModuleScript" referent="1964">
          <Properties>
            <string name="Name">Adapter</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f4f</UniqueId>
