          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1936">
          <Properties>
            <string name="Name">motors</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f33</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{B4D240A8-DE5B-4577-8776-A3597C331B3C}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local Properties = require("Properties")
local Document = require("Document")
local Paths = require("Paths")
local Parenting = require("Parenting")
local Master = require("MasterControl")
local Organization = require("Organization")
local Animation = require("ArmatureAnimation")
local Runtime = require("ArmatureRuntime")
local Policy = require("Policy")
local Curves = require("GraphCurves")
local BoneMotor = require("BoneMotor")
local Origin = require("Origin")
local Preferences = require("Preferences")
local Controls = require("R6Controls")
local Scene = {}

local function objectPath(object, state)
	local path = Paths.of(object, state.LiveProject and state.LiveProject.Scope or workspace)
	if path then
		return { path = path }
	end

	if object:IsDescendantOf(game) and not object:IsDescendantOf(game:GetService("CoreGui")) then
		return { gamePath = Paths.of(object, game) }
	end

	return nil
end

local function resolveObject(value, state)
	return value.gamePath and Paths.resolve(game, value.gamePath)
		or value.path
			and Paths.resolve(
				state.LiveProject and state.LiveProject.Scope or workspace,
				value.path
			)
end

local function scope(state)
	return state.LiveProject and state.LiveProject.Scope or workspace
end

local function rigId(rig, state)
	return rig:GetAttribute("EclipseTrackId")
		or assert(
			Paths.of(rig, scope(state)) or Paths.of(rig, game),
			"The Live object must be in the shared place"
		)
end

local function belongs(motor, rig)
	if Properties.is(motor) then
		return motor.Rig == rig
	end

	local parent = motor.Parent
	return parent and (parent == rig or typeof(parent) == "Instance" and parent:IsDescendantOf(rig))
		or typeof(motor.Part1) == "Instance" and motor.Part1:IsDescendantOf(rig)
end

local function motors(rig, raw, archivePaths)
	local result = {}
	local seen = {}
	local membership = archivePaths and require("Membership")
	local owned = membership and membership.ownedKeys(raw, rig)
	for _, motor in Parenting.collectMotors(rig) do
		result[motor] = true
	end

	for _, motor in Properties.list(rig, true) do
		result[motor] = true
	end

	for _, part in require("RigTraversal").descendants(rig) do
		if part:IsA("BasePart") and part:GetAttribute("EclipseArmatureBone") then
			local motor = BoneMotor.getIKHandle(part, rig)
			if motor then
				result[motor] = true
			end
		end
	end

	local master = Master.get(rig, true)
	if master then
		result[master] = true
	end

	for motor in raw.DefaultPose do
		if
			motor.Parent
			and (
				membership and membership.belongs(motor, rig, owned)
				or not membership and belongs(motor, rig)
			)
		then
			result[motor] = true
		end
	end

	for motor in result do
		local id = Paths.motor(motor, rig, not archivePaths)
		assert(id, "Waiting for shared track " .. motor.Name .. " in " .. rig.Name)
		assert(
			not seen[id],
			"Live found two tracks with the same identity in " .. rig.Name .. ": " .. id
		)
		seen[id] = motor
	end

	return seen
end

Scene.motors = motors

function Scene.index(state)
	local rigs, tracks = {}, {}
	local raw = state.Timeline:GetState()
	for _, rig in state.getAllRigs() do
		local id = rigId(rig, state)
		assert(not rigs[id], "Duplicate Live rig identity")
		rigs[id] = rig
		for name, motor in motors(rig, raw) do
			if raw.DefaultPose[motor] ~= nil then
				tracks[id .. "/" .. name] = motor
			end
		end
	end

	local _, originMotor = Origin.ensure(state.Timeline)
	tracks["$origin"] = originMotor
	return tracks, rigs
end

local function reference(value, state)
	if Origin.is(value) then
		return { origin = true }
	end

	if typeof(value) == "Instance" then
		local owner = Properties.owner(value)
		if owner then
			return {
				propertyOwner = assert(
					objectPath(owner, state),
					"Waiting for shared property owner"
				),
				property = value:GetAttribute("EclipseProperty") or false,
			}
		end
	end

	if typeof(value) == "Instance" then
		if not value.Parent then
			return nil
		end

		return assert(
			objectPath(value, state),
			"Live cannot reference " .. value.Name .. ". Reopen this file to rebuild its controls."
		)
	end

	assert(
		type(value) == "string" or value == false or value == nil,
		"Invalid Live folder reference"
	)
	return { value = value }
end

local function unreference(value, state)
	if not value then
		return nil
	end

	if value.origin then
		return Origin.ensure(state.Timeline)
	end

	if value.propertyRig or value.propertyOwner then
		local owner = assert(
			value.propertyOwner and resolveObject(value.propertyOwner, state)
				or Paths.resolve(scope(state), value.propertyRig),
			"Waiting for shared property owner"
		)
		return value.property and Properties.enable(owner, value.property, true).Part1
			or Properties.folder(owner, true)
	end

	if value.path or value.gamePath then
		return assert(resolveObject(value, state), "Waiting for shared track organization")
	end

	return value.value
end

local function organization(state)
	local old = Organization.snapshot()
	local out = {
		folders = old.folders,
		nextNumber = old.nextNumber,
		placements = {},
		enabled = {},
		removed = {},
	}
	for key, value in old.placements do
		local row = table.clone(value)
		row.parent = reference(value.parent, state)
		local keyRef = reference(key, state)
		if keyRef then
			table.insert(out.placements, { key = keyRef, value = row })
		end
	end

	for key, value in old.enabled do
		local keyRef = reference(key, state)
		if keyRef then
			table.insert(out.enabled, { key = keyRef, value = value })
		end
	end

	for key, value in old.removed or {} do
		local keyRef = reference(key, state)
		if keyRef then
			table.insert(out.removed, { key = keyRef, value = value })
		end
	end

	local function order(a, b)
		return Document.pack(a.key) < Document.pack(b.key)
	end

	table.sort(out.placements, order)
	table.sort(out.enabled, order)
	table.sort(out.removed, order)
	for id, folder in out.folders do
		local copy = table.clone(folder)
		copy.parent = reference(folder.parent, state)
		out.folders[id] = copy
	end

	return out
end

local function resolveOrganization(value, state)
	local out =
		{ folders = {}, placements = {}, enabled = {}, removed = {}, nextNumber = value.nextNumber }
	for id, folder in value.folders do
		local row = table.clone(folder)
		row.parent = unreference(folder.parent, state)
		out.folders[id] = row
	end

	for _, entry in value.placements do
		local row = table.clone(entry.value)
		row.parent = unreference(row.parent, state)
		out.placements[unreference(entry.key, state)] = row
	end

	for _, entry in value.enabled do
		out.enabled[unreference(entry.key, state)] = entry.value
	end

	for _, entry in value.removed or {} do
		out.removed[unreference(entry.key, state)] = entry.value == true
	end

	return out
end

function Scene.capture(state)
	local raw = state.Timeline:GetState()
	local Layers = require("Layers")
	if Layers.has(raw) then
		Layers.ensure(raw)
		Layers.syncProperties(raw)
	end

	local result = {
		version = 2,
		channels = Policy.channelsEnabled(),
		rigs = {},
		organization = organization(state),
		origin = Origin.shared(state.Timeline),
	}
	for _, rig in state.getAllRigs() do
		local planted = rig:GetAttribute("EclipseIKFeetPlanted")
		if planted == nil then
			planted = Preferences.get("IKFeetPlanted")
		end

		local entry = {
			individualParts = rig:GetAttribute("EclipseIndividualParts"),
			feetPlanted = planted,
			id = rigId(rig, state),
			path = Paths.of(rig, scope(state)),
			object = objectPath(rig, state),
			tracks = {},
			r6Bend = rig:GetAttribute("EclipseR6BendPercent") or Preferences.get("R6BendPercent"),
			master = {
				enabled = Master.enabled(rig),
				rest = rig:GetAttribute("EclipseMasterRest"),
				radius = rig:GetAttribute("EclipseMasterRadius"),
			},
			properties = Layers.has(raw) and (raw.AnimationLayers.layers[1].properties[rig] or {
				version = 1,
				tracks = {},
			}) or Animation.propertySnapshot(rig),
			inputs = {},
			itemProperties = Properties.snapshot(rig, raw, false),
		}
		if require("CameraRig").isRig(rig) then
			entry.cameraTarget = {
				enabled = rig:GetAttribute("EclipseTrackTarget"),
				defaultEnabled = rig:GetAttribute("EclipseCamTargetDefaultEnabled"),
			}
			entry.cameraOrthographic = rig:GetAttribute("EclipseOrthographic") == true
		end

		entry.r6Controls = {}
		for _, bone in require("RigTraversal").descendants(rig) do
			if Controls.isControl(bone) then
				local control = Controls.get(bone)
				if control and control.Owner then
					table.insert(entry.r6Controls, {
						owner = assert(
							Paths.motor(control.Owner, rig),
							"Waiting for shared IK owner"
						),
						kind = bone:GetAttribute("EclipseR6Control"),
						customIK = control.Owner:GetAttribute("EclipseAutoIK") == true or nil,
						customRest = require("customRest").rest(control.Owner),
						controlSpace = bone:GetAttribute("EclipseIKControlSpace"),
						anchorOffset = bone:GetAttribute("EclipseIKAnchorOffset"),
						rest = bone.CFrame,
					})
				end
			end
		end

		table.sort(entry.r6Controls, function(a, b)
			return a.owner .. a.kind < b.owner .. b.kind
		end)
		local animated = {}
		for _, track in entry.properties.tracks do
			animated[Document.pack({ track.object, track.bone or "", track.key })] = true
		end

		if Layers.has(raw) then
			for _, layer in raw.AnimationLayers.layers do
				for _, track in layer.properties[rig] and layer.properties[rig].tracks or {} do
					animated[Document.pack({ track.object, track.bone or "", track.key })] = true
				end
			end
		end

		for _, property in Runtime.properties(rig) do
			if
				not animated[Document.pack({ property.object, property.bone or "", property.key })]
			then
				table.insert(entry.inputs, property)
			end
		end

		for id, motor in motors(rig, raw) do
			if raw.DefaultPose[motor] == nil then
				continue
			end

			entry.tracks[id] = {
				partEnabled = motor:GetAttribute("EclipsePartTrackEnabled"),
				default = raw.DefaultPose[motor],
				world = raw.DefaultWorldPose[motor],
				parented = raw.ParentingDefaults[motor] ~= false,
				size = raw.DefaultSize[motor.Part1],
				c1 = motor.C1,
				disabled = motor:GetAttribute("EclipseDisabled") == true,
				active = state.activeObjectMotors and state.activeObjectMotors[motor] == true,
				channels = {},
			}
			for _, channel in Curves.ids do
				if motor:GetAttribute("EclipseChannelDisabled_" .. channel) then
					entry.tracks[id].channels[channel] = true
				end
			end
		end

		table.insert(result.rigs, entry)
	end

	return result
end

function Scene.writeProject(values, project)
	local header = table.clone(project)
	header.rigs = nil
	values.project = Document.pack(header)
	for order, entry in project.rigs do
		local setup = table.clone(entry)
		setup.tracks = nil
		setup.itemProperties = nil
		values["rig|" .. entry.id] = Document.pack(setup)
		local properties = table.clone(entry.itemProperties or { version = 1, tracks = {} })
		properties.tracks = nil
		values["propertySetup|" .. entry.id] = Document.pack(properties)
		for _, row in (entry.itemProperties and entry.itemProperties.tracks or {}) do
			local key = Document.pack({ entry.id, row.id })
			values["property|" .. key] = Document.pack(row)
			values["propertyMember|" .. key] = "true"
		end

		for id, track in entry.tracks do
			local key = Document.pack({ entry.id, id })
			values["track|" .. key] = Document.pack(track)
			values["trackMember|" .. key] = "true"
		end

		values["member|" .. entry.id] = "true"
		values["order|" .. entry.id] = Document.pack(order)
	end
end

function Scene.readProject(values)
	local project = Document.unpack(assert(values.project, "Missing Live project"))
	local rows, rigs = {}, {}
	for key, value in values do
		if key:sub(1, 7) == "member|" then
			local id = key:sub(8)
			local encoded = values["rig|" .. id]
			assert(encoded, "Waiting for shared rig setup")
			local entry = Document.unpack(encoded)
			local order =
				Document.unpack(assert(values["order|" .. id], "Waiting for shared rig order"))
			assert(
				entry.id == id and type(order) == "number" and order >= 1 and order % 1 == 0,
				"Invalid shared rig membership"
			)
			entry.tracks = {}
			rigs[id] = entry
			entry.itemProperties = Document.unpack(
				assert(values["propertySetup|" .. id], "Waiting for shared property setup")
			)
			entry.itemProperties.tracks = {}
			table.insert(rows, { entry = entry, order = order })
		end
	end

	for key in values do
		if key:sub(1, 12) == "trackMember|" then
			local identity = key:sub(13)
			local ids = Document.unpack(identity)
			assert(
				type(ids) == "table" and type(ids[1]) == "string" and type(ids[2]) == "string",
				"Invalid shared track membership"
			)
			local rig = rigs[ids[1]]
			if rig then
				rig.tracks[ids[2]] = Document.unpack(
					assert(values["track|" .. identity], "Waiting for shared track setup")
				)
			end
		end
	end

	for key in values do
		if key:sub(1, 15) == "propertyMember|" then
			local identity = key:sub(16)
			local ids = Document.unpack(identity)
			assert(
				type(ids) == "table" and type(ids[1]) == "string" and type(ids[2]) == "string",
				"Invalid shared property membership"
			)
			local rig = rigs[ids[1]]
			if rig then
				local row = Document.unpack(
					assert(values["property|" .. identity], "Waiting for shared property track")
				)
				assert(type(row) == "table" and row.id == ids[2], "Invalid shared property track")
				table.insert(rig.itemProperties.tracks, row)
			end
		end
	end

	for _, rig in rigs do
		table.sort(rig.itemProperties.tracks, function(a, b)
			return a.id < b.id
		end)
	end

	table.sort(rows, function(a, b)
		return a.order == b.order and a.entry.id < b.entry.id or a.order < b.order
	end)
	project.rigs = {}
	for _, row in rows do
		table.insert(project.rigs, row.entry)
	end

	return project
end

function Scene.projectChanged(values, previous)
	if values.project ~= previous.project then
		return true
	end

	for _, side in { values, previous } do
		for key in side do
			if
				(
					key:sub(1, 4) == "rig|"
					or key:sub(1, 7) == "member|"
					or key:sub(1, 6) == "order|"
					or key:sub(1, 6) == "track|"
					or key:sub(1, 12) == "trackMember|"
					or key:sub(1, 9) == "property|"
					or key:sub(1, 15) == "propertyMember|"
					or key:sub(1, 14) == "propertySetup|"
				) and values[key] ~= previous[key]
			then
				return true
			end
		end
	end

	return false
end

function Scene.prepare(state, value)
	assert(
		type(value) == "table"
			and value.version == 2
			and type(value.channels) == "boolean"
			and type(value.rigs) == "table"
			and #value.rigs <= 100,
		"Invalid Live project setup"
	)
	local targets = {}
	local used = {}
	local sharedById

	local function sharedRig(id)
		if not sharedById then
			sharedById = {}

			local function visit(parent)
				for _, child in parent:GetChildren() do
					if
						child:GetAttribute("EclipseLocalLivePreview")
						or child.Name == "AnimSaves"
						or child:IsA("KeyframeSequence")
						or child:IsA("LuaSourceContainer")
					then
						continue
					end

					local key = child:GetAttribute("EclipseTrackId")
					if key then
						sharedById[key] = sharedById[key] == nil and child or false
					end

					visit(child)
				end
			end

			visit(scope(state))
		end

		assert(
			sharedById[id] ~= false,
			"Waiting for shared rig: duplicate ID on scene objects " .. id
		)
		return sharedById[id]
	end

	for _, entry in value.rigs do
		assert(type(entry.id) == "string" and not used[entry.id], "Duplicate Live rig")
		used[entry.id] = true
		local rig = entry.object and resolveObject(entry.object, state)
			or Paths.resolve(scope(state), entry.path)
		if rig then
			rig = require("rig").localize(rig)
		end

		if not rig or rigId(rig, state) ~= entry.id then
			rig = sharedRig(entry.id)
		end

		assert(rig and rig.Parent, "Waiting for shared rig " .. entry.id)
		rig = require("rig").localize(rig)
		local available = motors(rig, state.Timeline:GetState())
		for _, control in entry.r6Controls or {} do
			assert(
				control.kind == "root"
					or control.kind == "spine"
					or control.kind == "upper"
					or control.kind == "target"
					or control.kind == "pole"
					or control.kind == "roll",
				"Invalid shared IK control"
			)
			assert(typeof(control.rest) == "CFrame", "Invalid shared IK rest pose")
			local owner = assert(available[control.owner], "Waiting for shared IK owner")
			assert(require("customRest").isJoint(owner), "Invalid shared IK owner")
			if control.customIK == true then
				assert(
					require("customRest").chain(rig, owner, require("Parenting").collectMotors(rig)),
					"Shared custom IK chain is no longer connected"
				)
				owner:SetAttribute("EclipseAutoIK", true)
				require("customRest").restoreRest(owner, control.customRest)
				require("LimbIK").invalidate(rig)
			end

			local bone = Controls.ensure(owner, control.kind, control.rest)
			if control.customIK then
				bone:SetAttribute("EclipseIKControlSpace", control.controlSpace)
				bone:SetAttribute("EclipseIKAnchorOffset", control.anchorOffset)
			end
		end

		available = motors(rig, state.Timeline:GetState())
		local propertyIds = {}
		for _, row in entry.itemProperties and entry.itemProperties.tracks or {} do
			assert(Properties.definition(rig, row.id), "Unsupported shared property")
			propertyIds["property:" .. row.id] = true
		end

		for id, track in entry.tracks do
			assert(
				typeof(track.default) == "CFrame"
					and typeof(track.c1) == "CFrame"
					and type(track.parented) == "boolean",
				"Invalid Live track defaults"
			)
			assert(
				track.world == nil or typeof(track.world) == "CFrame",
				"Invalid Live world default"
			)
			assert(
				track.size == nil
					or typeof(track.size) == "Vector3"
						and track.size.X > 0
						and track.size.Y > 0
						and track.size.Z > 0,
				"Invalid Live size"
			)
			assert(
				available[id] or propertyIds[id] or id == "master" and Master.root(rig),
				"Waiting for shared bone " .. id
			)
			if available[id] and id ~= "master" then
				assert(available[id].C1 == track.c1, "Waiting for shared joint rest pose " .. id)
			end
		end

		local properties = {}
		for _, property in Runtime.properties(rig) do
			properties[Document.pack({ property.object, property.bone or "", property.key })] = true
		end

		for _, property in entry.inputs do
			assert(
				properties[Document.pack({ property.object, property.bone or "", property.key })],
				"Waiting for shared armature property " .. property.key
			)
		end

		table.insert(targets, { rig = rig, data = entry })
	end

	local function apply()
		local raw = state.Timeline:GetState()
		local refs = assert(state.LiveProject, "Live project hooks unavailable")
		Policy.setLiveChannels(value.channels)
		if value.origin then
			Origin.applyShared(state.Timeline, value.origin)
		end

		local wanted = {}
		for _, target in targets do
			wanted[target.rig] = true
		end

		for _, target in targets do
			if not table.find(state.getAllRigs(), target.rig) then
				refs.AddRig(target.rig, { Loading = true })
			end

			assert(
				table.find(state.getAllRigs(), target.rig),
				"Could not add shared rig " .. target.rig.Name
			)
		end

		for _, rig in table.clone(state.getAllRigs()) do
			if not wanted[rig] then
				refs.RemoveRig(rig)
			end
		end

		state.activeObjectMotors = state.activeObjectMotors or {}
		for _, target in targets do
			local rig, entry = target.rig, target.data
			rig:SetAttribute("EclipseIndividualParts", entry.individualParts)
			if entry.cameraTarget and require("CameraRig").isRig(rig) then
				assert(
					type(entry.cameraTarget.enabled) == "boolean"
						and (
							entry.cameraTarget.defaultEnabled == nil
							or type(entry.cameraTarget.defaultEnabled) == "boolean"
						),
					"Invalid camera tracking state"
				)
				rig:SetAttribute("EclipseTrackTarget", entry.cameraTarget.enabled)
				rig:SetAttribute(
					"EclipseCamTargetDefaultEnabled",
					entry.cameraTarget.defaultEnabled
				)
				assert(
					entry.cameraOrthographic == nil or type(entry.cameraOrthographic) == "boolean",
					"Invalid camera projection"
				)
				rig:SetAttribute("EclipseOrthographic", entry.cameraOrthographic == true)
			end

			if type(entry.feetPlanted) == "boolean" then
				rig:SetAttribute("EclipseIKFeetPlanted", entry.feetPlanted)
			end

			if entry.r6Bend ~= nil then
				assert(
					type(entry.r6Bend) == "number" and entry.r6Bend >= 0 and entry.r6Bend <= 100,
					"Invalid R6 bend"
				)
				rig:SetAttribute("EclipseR6BendPercent", entry.r6Bend)
			end

			Properties.restore(
				rig,
				entry.itemProperties or { version = 1, tracks = {} },
				state.Timeline,
				state.UIHelpers.SanitizeName
			)
			local sequence = Instance.new("Folder")
			sequence:SetAttribute("EclipseMasterControl", entry.master.enabled)
			sequence:SetAttribute("EclipseMasterRest", entry.master.rest)
			sequence:SetAttribute("EclipseMasterRadius", entry.master.radius)
			Master.read(sequence, rig)
			sequence:Destroy()
			local available = motors(rig, raw)
			for id, track in entry.tracks do
				local motor = assert(available[id], "Shared control is unavailable")
				raw.DefaultPose[motor] = track.default
				raw.DefaultWorldPose[motor] = track.world
				raw.ParentingDefaults[motor] = track.parented
				raw.DefaultSize[motor.Part1] = track.size
				raw.MotorByPart[motor.Part1] = motor
				motor:SetAttribute("EclipseParentingDefault", track.parented)
				motor:SetAttribute("EclipsePartTrackEnabled", track.partEnabled)
				motor:SetAttribute("EclipseDisabled", track.disabled and true or nil)
				for _, channel in Curves.ids do
					motor:SetAttribute(
						"EclipseChannelDisabled_" .. channel,
						track.channels[channel] and true or nil
					)
				end

				motor:SetAttribute(
					"EclipseChannelDisabledAny",
					next(track.channels) and true or nil
				)
				state.activeObjectMotors[motor] = track.active and true or nil
			end

			for id, motor in available do
				if not entry.tracks[id] then
					raw.DefaultPose[motor], raw.DefaultWorldPose[motor], raw.ParentingDefaults[motor], raw.Keyframes[motor] =
						nil, nil, nil, nil
					if raw.MotorByPart[motor.Part1] == motor then
						raw.MotorByPart[motor.Part1] = nil
					end
				end
			end

			Animation.restoreProperties(rig, entry.properties)
			for _, property in entry.inputs do
				assert(
					Runtime.setProperty(
						rig,
						property.object,
						property.key,
						property.value,
						property.bone,
						false
					),
					"Could not apply shared armature property"
				)
			end
		end

		refs.RefreshStructure()
		Organization.restore(resolveOrganization(value.organization, state), "live")
	end

	return function()
		local refs = assert(state.LiveProject, "Live project hooks unavailable")
		if refs.Batch then
			return refs.Batch(apply)
		end

		return apply()
	end
end

return Scene
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a3da</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1937">
          <Properties>
            <string name="Name">Simulation</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f34</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{1FB2587F-272B-4D24-95F3-F00475AD54FA}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local Timing = require("Timing")

local RunService = game:GetService("RunService")
local Simulation = {}
local Path = require("Path")

local function finite(value, low, high)
	return typeof(value) == "number" and value == value and value >= low and value <= high
end

function Simulation.validate(bodies, settings)
	assert(#bodies > 0, "add at least one physics part")
	assert(
		finite(settings.first, 0, 100000) and settings.first % 1 == 0,
		"start frame needs a whole number"
	)
	assert(
		finite(settings.last, settings.first + 1, settings.first + 2400) and settings.last % 1 == 0,
		"use a range of 1 to 2400 frames"
	)
	assert(finite(settings.speed or 1, 0.1, 4), "speed needs to be between 0.1 and 4")
	assert(finite(settings.fps, 1, 240), "fps needs to be between 1 and 240")
	assert(finite(settings.gravity, 0, 1000), "gravity needs to be between 0 and 1000")
	assert(finite(settings.bounce, 0, 1), "bounce needs to be between 0 and 1")
	assert(finite(settings.friction, 0, 2), "friction needs to be between 0 and 2")
	assert(typeof(settings.velocity) == "Vector3", "enter an X, Y and Z push")
	for _, value in { settings.velocity.X, settings.velocity.Y, settings.velocity.Z } do
		assert(finite(value, -500, 500), "push needs to be between -500 and 500")
	end

	assert(#(settings.forces or {}) <= 16, "use up to 16 blast forces")
	for _, force in settings.forces or {} do
		assert(
			force.kind == nil
				or force.kind == "Blast"
				or force.kind == "Pull"
				or force.kind == "Lift"
				or force.kind == "BlackHole",
			"choose Blast, Pull, Lift or Black Hole"
		)
		if force.path then
			Path.validate({ force = { points = force.path, smoothing = 0, easing = force.easing } })
		end

		if force.kind == "BlackHole" or force.path then
			assert(finite(force.spin or 1, -10, 10), "spin needs -10 to 10 turns per second")
			assert(finite(force.launch or 0, 0, 500), "launch speed needs 0 to 500")
			if force.path then
				Path.validate({
					force = { points = force.path, smoothing = 0, easing = force.easing },
				})
			end

			assert(
				finite(force.duration or 60, 1, 2400) and (force.duration or 60) % 1 == 0,
				"duration needs 1 to 2400 frames"
			)
		end

		assert(
			finite(force.frame, 0, 100000) and force.frame % 1 == 0,
			"blast frame needs a whole number"
		)
		assert(finite(force.radius, 0.1, 1000), "blast radius needs to be between 0.1 and 1000")
		assert(finite(force.power, 0, 500), "blast power needs to be between 0 and 500")
		assert(
			typeof(force.position) == "Vector3" and finite(force.position.Magnitude, 0, 1e7),
			"move the blast to a valid position"
		)
	end

	local guides = settings.guides or (settings.guide and { settings.guide } or {})
	assert(#guides <= #bodies, "use one path per object")
	local guided = {}
	for _, guide in guides do
		assert(not settings.hold, 'Turn "Stay still until hit" off to follow a drawn path')
		assert(finite(settings.pathLaunch or 0, 0, 500), "launch speed needs 0 to 500")
		assert(
			finite(settings.pathEnd or settings.last, settings.first + 1, settings.first + 2400),
			"path end needs to be after the start frame (up to 2400 frames)"
		)
		assert(
			finite(guide.index, 1, #bodies) and guide.index % 1 == 0,
			"the guided bone is missing"
		)
		assert(not guided[guide.index], "use one path per object")
		guided[guide.index] = true
		assert(finite(guide.strength, 0, 100), "guide strength needs to be between 0 and 100")
		Path.validate({ guide = { points = guide.points, smoothing = 0, easing = guide.easing } })
	end

	for _, body in bodies do
		assert(
			body.part and (body.part:IsA("BasePart") or body.part:IsA("Bone")) and body.part.Parent,
			"a physics part was removed"
		)
		for _, value in { body.frame:GetComponents() } do
			assert(finite(value, -1e8, 1e8), "a physics pose has invalid values")
		end
	end
end

function Simulation.run(bodies, links, settings, checkpoint, step, colliders)
	Simulation.validate(bodies, settings)
	assert(not RunService:IsRunning(), "stop the Studio playtest before simulating")
	local folder = Instance.new("Folder")

	folder.Name = "EclipsePhysicsPreview"
	require("Recovery").mark(folder)
	local parts, bySource, poses = {}, {}, {}
	local deadline = os.clock() + 0.006

	local function budget(frame)
		if os.clock() >= deadline then
			RunService.Heartbeat:Wait()
			checkpoint(frame)
			deadline = os.clock() + 0.006
		end
	end

	local held, groups, initialVelocity, bodyFor = {}, {}, {}, {}
	local activeCount = 0
	local retired, lastPose, stepParts, guides = {}, {}, {}, {}
	local released = {}
	local sweep
	local dt = (settings.speed or 1) / settings.fps
	local restoreCollide, collisionGroups, movers = {}, {}, {}
	local PhysicsService = game:GetService("PhysicsService")

	local ok, result = xpcall(function()
		for _, body in bodies do
			local bone = body.part:IsA("Bone")
			local part = bone and Instance.new("Part") or Instance.fromExisting(body.part)
			if bone then
				part.Shape = Enum.PartType.Ball
			end

			part.Name = body.part.Name
			part.CFrame = body.frame
			part.Size = body.size or (bone and Vector3.new(0.2, 0.2, 0.2) or body.part.Size)
			part.Anchored, part.Transparency, part.Locked = true, 1, true
			part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow =
				true, false, settings.hold == true, false
			part.CollisionGroup = "Default"
			part.Massless = false
			local properties = bone and PhysicalProperties.new(Enum.Material.Plastic)
				or body.part.CurrentPhysicalProperties
			part.CustomPhysicalProperties = PhysicalProperties.new(
				properties.Density,
				settings.friction,
				settings.bounce,
				100,
				100
			)
			part.Parent = folder
			bySource[body.part] = part
			table.insert(parts, part)
			poses[body.part] = { [settings.first] = body.frame }
			lastPose[part] = body.frame
			held[part] = settings.hold == true
			bodyFor[part] = body
			local group = body.group or body.part
			groups[group] = groups[group] or {}
			table.insert(groups[group], part)
			initialVelocity[part] = {
				linear = settings.velocity + (settings.inherit and body.velocity or Vector3.zero),
				angular = settings.inherit and body.angular or Vector3.zero,
			}
			budget(settings.first)
		end

		local excluded = {}
		for _, source in settings.excludeParts or {} do
			excluded[source] = true
		end

		for _, collider in colliders or {} do
			local source = collider.part
			if
				not source.Parent
				or bySource[source]
				or not source.CanCollide
				or excluded[source]
			then
				continue
			end

			local part = Instance.fromExisting(source)
			part.Name = source.Name
			part.Size = source.Size
			part.CFrame = collider.frames[settings.first] or source.CFrame
			part.Anchored, part.Transparency, part.Locked = true, 1, true
			part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow =
				true, false, true, false
			part.CollisionGroup = "Default"
			part.Massless = false
			part.Parent = folder
			table.insert(movers, { part = part, source = source, frames = collider.frames })
		end

		local ignored = {}
		for _, mover in movers do
			if mover.source.CanCollide then
				ignored[mover.source] = true
			end
		end

		for _, body in bodies do
			if body.part:IsA("BasePart") and body.part.CanCollide then
				ignored[body.part] = true
			end
		end

		for _, source in settings.excludeParts or {} do
			ignored[source] = true
		end

		for source in ignored do
			if source.Parent and source.CanCollide then
				restoreCollide[source] = true
				source.CanCollide = false
			end
		end

		for _, link in links do
			local a, b = bySource[link.a], bySource[link.b]
			if not a or not b then
				continue
			end

			local ignore = Instance.new("NoCollisionConstraint")

			ignore.Part0, ignore.Part1, ignore.Parent = a, b, folder
			if link.rigid then
				local weld = Instance.new("WeldConstraint")

				weld.Part0, weld.Part1, weld.Parent = a, b, folder
			else
				local aa = Instance.new("Attachment")

				aa.CFrame, aa.Parent = a.CFrame:ToObjectSpace(link.frame), a
				local ab = Instance.new("Attachment")

				ab.CFrame, ab.Parent = b.CFrame:ToObjectSpace(link.frame), b
				local joint = Instance.new("BallSocketConstraint")

				joint.Attachment0, joint.Attachment1 = aa, ab
				joint.LimitsEnabled, joint.UpperAngle = true, link.angle or 75
				joint.TwistLimitsEnabled, joint.TwistLowerAngle, joint.TwistUpperAngle =
					true, -45, 45
				joint.MaxFrictionTorque = 0
				joint.Parent = folder
			end
		end

		if settings.selfCollision == false then
			local pairCount = 0
			local byKey, order = {}, {}
			for index, body in bodies do
				local key = if body.group ~= nil then body.group else false
				if not byKey[key] then
					byKey[key] = {}
					table.insert(order, key)
				end

				table.insert(byKey[key], parts[index])
			end

			for _, key in order do
				local size = #byKey[key]
				pairCount += if key == false then size * (#parts - 1) else size * (size - 1) / 2
			end

			local free = PhysicsService:GetMaxCollisionGroups()
				- #PhysicsService:GetRegisteredCollisionGroups()
			if pairCount > 3000 and #order <= free then
				local tag = string.sub(game:GetService("HttpService"):GenerateGUID(false), 1, 8)
				for index, key in order do
					local name = "EclipseSim" .. index .. "_" .. tag
					PhysicsService:RegisterCollisionGroup(name)
					table.insert(collisionGroups, name)
					for _, part in byKey[key] do
						part.CollisionGroup = name
					end
				end

				for index, key in order do
					local name = collisionGroups[index]
					PhysicsService:CollisionGroupSetCollidable(name, name, false)
					if key == false then
						for _, other in collisionGroups do
							PhysicsService:CollisionGroupSetCollidable(name, other, false)
						end
					end
				end
			else
				for i, a in parts do
					for j = i + 1, #parts do
						if bodies[i].group ~= nil and bodies[i].group ~= bodies[j].group then
							continue
						end

						local ignore = Instance.new("NoCollisionConstraint")

						ignore.Part0, ignore.Part1, ignore.Parent = a, parts[j], folder
					end

					budget(settings.first)
				end
			end
		end

		local function release(part)
			if retired[part] or not part:IsDescendantOf(folder) or not part.Anchored then
				return
			end

			held[part] = nil
			part.Anchored = false
			activeCount += 1
			table.insert(released, part)
			part.AssemblyLinearVelocity = initialVelocity[part].linear
			part.AssemblyAngularVelocity = initialVelocity[part].angular
		end

		local function liveParts()
			assert(folder.Parent == workspace, "simulation was canceled; update it again")
			table.clear(stepParts)
			activeCount = 0
			for _, part in parts do
				if not retired[part] and not part:IsDescendantOf(folder) then
					retired[part] = true
					held[part] = nil
				end

				if not retired[part] then
					table.insert(stepParts, part)
					if not part.Anchored then
						activeCount += 1
					end
				end
			end

			for _, guide in guides do
				if retired[guide.part] and guide.force then
					guide.force:Destroy()
					guide.force = nil
				end
			end
		end

		folder.Parent = workspace
		if settings.selfCollision ~= false then
			local query = OverlapParams.new()
			query.FilterType = Enum.RaycastFilterType.Include
			query.FilterDescendantsInstances = parts
			query.RespectCanCollide = true
			local indices = {}
			for i, part in parts do
				indices[part] = i
			end

			for i, part in parts do
				local group = bodies[i].group
				if group == nil then
					continue
				end

				for _, other in workspace:GetPartsInPart(part, query) do
					local j = indices[other]
					if j and j > i and bodies[j].group == group then
						local ignore = Instance.new("NoCollisionConstraint")
						ignore.Part0, ignore.Part1, ignore.Parent = part, other, folder
					end
				end

				budget(settings.first)
			end
		end

		sweep = RaycastParams.new()
		sweep.FilterType = Enum.RaycastFilterType.Exclude
		sweep.FilterDescendantsInstances = { folder }
		sweep.RespectCanCollide = true
		if not settings.hold then
			for _, part in parts do
				release(part)
			end
		end

		checkpoint(settings.first)
		if not step then
			RunService.Heartbeat:Wait()
			checkpoint(settings.first)
		end

		liveParts()
		for _, body in bodies do
			local part = bySource[body.part]
			if retired[part] then
				continue
			end

			if not held[part] then
				part.AssemblyLinearVelocity = initialVelocity[part].linear
				part.AssemblyAngularVelocity = initialVelocity[part].angular
			end

			local attachment = Instance.new("Attachment")

			attachment.Parent = part
			local gravity = Instance.new("VectorForce")

			gravity.Attachment0 = attachment
			gravity.RelativeTo, gravity.ApplyAtCenterOfMass = Enum.ActuatorRelativeTo.World, true
			gravity.Force =
				Vector3.new(0, part:GetMass() * (workspace.Gravity - settings.gravity), 0)
			gravity.Parent = part
		end

		local affected, centers, forcePaths = {}, {}, {}
		for _, force in settings.forces or {} do
			if force.path then
				forcePaths[force] = Path.sampler(force.path)
			end
		end

		local function center(force, frame)
			local values = centers[force]
			if not values then
				values = {}
				centers[force] = values
			end

			local value = values[frame]
			if not value then
				local sample = forcePaths[force]
				value = force.position
					+ (
						sample
							and sample(
								Timing.sample(
									force.easing,
									(frame - force.frame) / math.max(1, (force.duration or 60) - 1)
								)
							)
						or Vector3.zero
					)
				values[frame] = value
			end

			return value
		end

		for _, guide in settings.guides or (settings.guide and { settings.guide } or {}) do
			local body = bodies[guide.index]
			local guidePart = bySource[body.part]
			if retired[guidePart] then
				continue
			end

			local guidePoints = table.clone(guide.points)
			guidePoints[1] = body.frame.Position
			local guideForce = Instance.new("AlignPosition")

			local attachment = Instance.new("Attachment")

			attachment.Parent = guidePart
			guideForce.Attachment0 = attachment
			guideForce.Mode = Enum.PositionAlignmentMode.OneAttachment
			guideForce.RigidityEnabled = true
			guideForce.Position = body.frame.Position
			guideForce.ApplyAtCenterOfMass = true
			guideForce.Parent = guidePart
			table.insert(guides, {
				force = guideForce,
				part = guidePart,
				points = guidePoints,
				sample = Path.sampler(guidePoints),
				easing = guide.easing,
			})
		end

		table.clear(released)
		local impulses = {}
		for frame = settings.first + 1, settings.last do
			table.clear(centers)
			checkpoint(frame)
			liveParts()
			for _, mover in movers do
				local from, to = mover.frames[frame - 1], mover.frames[frame]
				if from and to then
					mover.part.CFrame = from
					mover.part.AssemblyLinearVelocity = (to.Position - from.Position) / dt
					local axis, angle = from:ToObjectSpace(to):ToAxisAngle()
					mover.part.AssemblyAngularVelocity = from:VectorToWorldSpace(axis)
						* (angle / dt)
				end
			end

			table.clear(impulses)
			for index, force in settings.forces or {} do
				local position = center(force, frame)
				local firstForce = force.frame == settings.first and settings.first + 1
					or force.frame
				if
					force.kind == "BlackHole"
					and frame == firstForce + (force.duration or 60)
					and (force.launch or 0) > 0
				then
					for part in affected[index] or {} do
						if retired[part] then
							continue
						end

						local direction = part.Position - position
						if force.path then
							direction = force.path[#force.path] - force.path[#force.path - 1]
						end

						if direction.Magnitude > 1e-5 then
							table.insert(
								impulses,
								{ part = part, velocity = direction.Unit * force.launch }
							)
						end
					end
				end

				local active = (force.kind == "BlackHole" or force.path ~= nil)
					and frame >= firstForce
					and frame < firstForce + (force.duration or 60)
				if
					active
					or not force.path
						and force.kind ~= "BlackHole"
						and (force.frame == frame or frame == settings.first + 1 and force.frame == settings.first)
				then
					local travelling = force.path ~= nil and force.kind ~= "BlackHole"
					local previous = travelling and center(force, math.max(force.frame, frame - 1))
						or nil
					local travel = travelling and position - previous or nil
					for _, part in parts do
						if retired[part] then
							continue
						end

						local hitPosition = position
						if travelling then
							if travel.Magnitude > 1e-5 then
								hitPosition = previous
									+ travel
										* math.clamp(
											(part.Position - previous):Dot(travel)
												/ travel:Dot(travel),
											0,
											1
										)
							end
						end

						local delta = part.Position - hitPosition
						local distance = delta.Magnitude
						if
							distance < force.radius
							and force.power > 0
							and (
								force.kind == "BlackHole"
								or not (affected[index] and affected[index][part])
							)
						then
							affected[index] = affected[index] or {}
							affected[index][part] = true

							local group = bodyFor[part].group or bodyFor[part].part
							for _, guide in guides do
								local guidedBody = bodyFor[guide.part]
								if
									guide.force
									and (guidedBody.group or guidedBody.part) == group
								then
									guide.force:Destroy()
									guide.force = nil
								end
							end

							if held[part] then
								for _, member in groups[bodyFor[part].group or bodyFor[part].part] do
									release(member)
								end
							end

							local direction = distance > 1e-5 and delta / distance or Vector3.yAxis
							if force.kind == "Pull" then
								direction = -direction
							elseif force.kind == "Lift" then
								direction = Vector3.yAxis
							end

							local falloff = 1 - distance / force.radius
							if force.path and force.kind ~= "BlackHole" then
								falloff = math.max(0.25, falloff)
							end

							table.insert(impulses, {
								part = part,
								velocity = direction * force.power * falloff,
								force = force.kind == "BlackHole" and force or nil,
								position = position,
							})
						end
					end
				end
			end

			if #released > 0 then
				if not step then
					RunService.Heartbeat:Wait()
					checkpoint(frame)
				end

				liveParts()
				for _, part in released do
					if retired[part] then
						continue
					end

					part.AssemblyLinearVelocity = initialVelocity[part].linear
					part.AssemblyAngularVelocity = initialVelocity[part].angular
				end

				table.clear(released)
			end

			for _, impulse in impulses do
				local part = impulse.part
				if retired[part] then
					continue
				end

				local velocity = impulse.velocity
				if impulse.force then
					local force = impulse.force
					local frequency = math.sqrt(force.power / math.max(0.1, force.radius))
					local delta = part.Position - impulse.position
					local angle = math.clamp((force.spin or 1) * math.pi * 2 * dt, -0.35, 0.35)
					local target = CFrame.fromAxisAngle(Vector3.yAxis, angle)
						:VectorToWorldSpace(delta) * math.exp(-frequency * 0.35 * dt)
					local travel = (center(force, frame + 1) - impulse.position) / dt
					velocity = (target - delta) / dt + travel - part.AssemblyLinearVelocity
				end

				part:ApplyImpulse(velocity * part:GetMass())
			end

			for _, guide in guides do
				if guide.force and frame > (settings.pathEnd or settings.last) then
					guide.force:Destroy()
					guide.force = nil
					local launch = settings.pathLaunch or 0
					local delta = guide.points[#guide.points] - guide.points[#guide.points - 1]
					if launch > 0 and delta.Magnitude > 1e-5 then
						guide.part.AssemblyLinearVelocity = delta.Unit * launch
					end
				end

				if guide.force then
					local alpha = math.clamp(
						(frame - settings.first)
							/ ((settings.pathEnd or settings.last) - settings.first),
						0,
						1
					)
					guide.force.Position = guide.sample(Timing.sample(guide.easing, alpha))
				end
			end

			if activeCount > 0 then
				if step then
					step(dt, stepParts)
				else
					workspace:StepPhysics(dt, stepParts)
				end

				if not step then
					RunService.Heartbeat:Wait()
					checkpoint(frame)
				end

				for _, part in stepParts do
					if
						part.Anchored
						or held[part]
						or retired[part]
						or not part:IsDescendantOf(folder)
					then
						continue
					end

					local before, current = lastPose[part], part.CFrame
					if not before then
						continue
					end

					local travel = current.Position - before.Position
					local thickness = math.min(part.Size.X, part.Size.Y, part.Size.Z)
					if travel.Magnitude < math.max(0.05, thickness * 0.5) then
						continue
					end

					local hit = workspace:Blockcast(
						CFrame.new(before.Position) * current.Rotation,
						part.Size,
						travel,
						sweep
					)
					if not hit then
						continue
					end

					part.CFrame = CFrame.new(
						before.Position + travel.Unit * math.max(0, hit.Distance - 0.01)
					) * current.Rotation
					local velocity = part.AssemblyLinearVelocity
					local into = velocity:Dot(hit.Normal)
					if into < 0 then
						part.AssemblyLinearVelocity = velocity
							- hit.Normal * into * (1 + settings.bounce)
					end
				end
			else
				budget(frame)
			end

			if settings.hold and next(held) then
				for _, mover in movers do
					if mover.frames[frame] then
						mover.part.CFrame = mover.frames[frame]
					end
				end

				local candidates = {}
				for _, part in parts do
					if not held[part] and not retired[part] then
						table.insert(candidates, part)
					end
				end

				for _, mover in movers do
					table.insert(candidates, mover.part)
				end

				if #candidates > 0 then
					local query = OverlapParams.new()
					query.FilterType = Enum.RaycastFilterType.Include
					query.FilterDescendantsInstances = candidates
					local waiting = {}
					for part in held do
						if not retired[part] then
							table.insert(waiting, part)
						end
					end

					for _, part in waiting do
						if not held[part] then
							continue
						end

						for _, other in workspace:GetPartsInPart(part, query) do
							local velocity = other.AssemblyLinearVelocity
							if
								velocity.Magnitude > 0.5
								and velocity:Dot(part.Position - other.Position) > 0
							then
								for _, member in groups[bodyFor[part].group or bodyFor[part].part] do
									release(member)
								end

								break
							end
						end
					end

					local heldQuery = OverlapParams.new()
					heldQuery.FilterType = Enum.RaycastFilterType.Include
					heldQuery.FilterDescendantsInstances = waiting
					local hitters = {}
					for _, part in parts do
						if not held[part] and not retired[part] then
							table.insert(hitters, { part = part, previous = lastPose[part] })
						end
					end

					for _, mover in movers do
						table.insert(
							hitters,
							{ part = mover.part, previous = mover.frames[frame - 1] }
						)
					end

					for _, hitter in hitters do
						local other = hitter.part
						local velocity, spin =
							other.AssemblyLinearVelocity, other.AssemblyAngularVelocity
						if
							velocity.Magnitude + spin.Magnitude * other.Size.Magnitude * 0.5
							<= 0.5
						then
							continue
						end

						local nudge = if velocity.Magnitude > 1e-3
							then velocity.Unit * 0.05
							else Vector3.zero
						local turn = if spin.Magnitude > 1e-3
							then CFrame.fromAxisAngle(spin.Unit, spin.Magnitude * dt * 0.5)
							else CFrame.identity
						local probe = CFrame.new(other.Position + velocity * dt * 0.5 + nudge)
							* turn
							* other.CFrame.Rotation
						local before = {}
						if hitter.previous then
							for _, part in
								workspace:GetPartBoundsInBox(hitter.previous, other.Size, heldQuery)
							do
								before[part] = true
							end
						end

						for _, part in workspace:GetPartBoundsInBox(probe, other.Size, heldQuery) do
							if held[part] and not before[part] then
								for _, member in groups[bodyFor[part].group or bodyFor[part].part] do
									release(member)
								end
							end
						end
					end
				end
			end

			liveParts()
			for source, part in bySource do
				local cf = retired[part] and lastPose[part]
					or held[part] and bodyFor[part].frame
					or part.CFrame
				for _, value in { cf:GetComponents() } do
					assert(
						finite(value, -1e8, 1e8),
						"physics became unstable; lower the push and try again"
					)
				end

				lastPose[part] = cf
				poses[source][frame] = cf
			end
		end

		return poses
	end, debug.traceback)
	folder:Destroy()

	for _, part in parts do
		part:Destroy()
	end

	for source in restoreCollide do
		if source.Parent then
			source.CanCollide = true
		end
	end

	for _, name in collisionGroups do
		pcall(PhysicsService.UnregisterCollisionGroup, PhysicsService, name)
	end

	assert(ok, result)
	return result
end

return Simulation
]]></string>
            <int64 name="SourceAssetId">-1</int64>
