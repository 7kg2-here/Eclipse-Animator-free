            <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a4c6</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2173">
          <Properties>
            <string name="Name">FileTools</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000029020</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
