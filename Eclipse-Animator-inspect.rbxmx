          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="2044">
        <Properties>
          <string name="Name">Effects</string>
          <BinaryString name="AttributesSerialize"></BinaryString>
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f9f</UniqueId>
          <Color3 name="IconTint">
            <R>0</R>
            <G>0</G>
            <B>0</B>
          </Color3>
          <bool name="DefinesCapabilities">false</bool>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <int64 name="SourceAssetId">-1</int64>
          <BinaryString name="Tags"></BinaryString>
          <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a446</UniqueId>
        </Properties>
        <Item class="ModuleScript" referent="2045">
          <Properties>
            <string name="Name">Bake</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028fa0</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{A146A5B5-768A-47B3-8C2F-F7514709AA21}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local Drawings = require(script:FindFirstAncestor("Container").Shared.EclipseDrawing)
local Codec = require("Codec")
local Snapshot = require("snapshot")
local Paths = require("ClipboardRows")
local Camera = require("CameraRig")
local Properties = require("Properties")
local Objects = require("Objects")
local Events = require("Events")
local Cleanup = require("DumpStorage")
local Organization = require("Organization")
local Faces = require("Faces")
local Geometry = require("Geometry")
local Bake = {}

function Bake.withExportLock(refs, options, callback)
	local state = refs.State
	local timeline = state.Timeline
	local raw = timeline:GetState()
	if raw.Exporting and options._ExportToken == raw.Exporting then
		return callback()
	end

	assert(
		not timeline:IsExportLocked(),
		"A module export is already running. Wait for it to finish."
	)
	assert(
		not state.PhysicsSimulating,
		"Wait for the physics simulation to finish before exporting."
	)
	local token = {}
	local playing, time, recording = raw.Playing, raw.CurrentTime, raw.Recording
	local rig, save, sequence =
		state.currentRig, state.currentProjectSave, state.currentProjectSequence
	local active = not refs.Active or refs.Active()
	raw.Exporting = token
	options._ExportToken = token
	raw.Playing = false
	timeline._playbackPreparation = nil
	timeline._playbackReadyAt = nil
	local live = state.LiveSession
	local result = table.pack(xpcall(function()
		if refs.Finalize then
			refs.Finalize()
		end

		raw.Recording = false
		require("EventPlayback").stop()
		if live and live.beginExport then
			live.beginExport()
		end

		if state.BlenderBridge and state.BlenderBridge.waitForExport then
			state.BlenderBridge.waitForExport(options.IsCancelled)
		end

		assert(not options.IsCancelled or not options.IsCancelled(), "Export cancelled")
		assert(
			state.currentRig == rig and state.currentProjectSave == save,
			"The project changed during export"
		)
		return callback()
	end, debug.traceback))
	local sameProject = state.Timeline == timeline
		and state.currentRig == rig
		and state.currentProjectSave == save
		and state.currentProjectSequence == sequence
	local same = sameProject and (not active or not refs.Active or refs.Active())
	if sameProject then
		raw.Recording = recording
	end

	if same then
		raw.CurrentTime = time
		raw.Recording = recording
		raw.Playing = playing
		timeline._playbackReadyAt = os.clock()
		timeline._videoSampleAt = os.clock()
	end

	raw.Exporting = nil
	options._ExportToken = nil
	local restored, restoreError = pcall(function()
		if live and live.endExport then
			live.endExport(same)
		end

		if same then
			timeline:UpdatePlayhead()
		end
	end)
	assert(result[1], result[2])
	assert(restored, restoreError)
	return table.unpack(result, 2, result.n)
end

local function equal(a, b)
	if a == b then
		return true
	end

	if type(a) ~= "table" or type(b) ~= "table" then
		return false
	end

	for key, value in a do
		if not equal(value, b[key]) then
			return false
		end
	end

	for key in b do
		if a[key] == nil then
			return false
		end
	end

	return true
end

local function build(refs, options, progress)
	local state, timeline = refs.State, refs.State.Timeline
	local raw = timeline:GetState()
	assert(not raw.Playing, "Pause playback before exporting.")
	assert(
		not state.PhysicsSimulating,
		"Wait for the physics simulation to finish before exporting."
	)
	assert(
		not state.BlenderBridge or not state.BlenderBridge.isFollowing(),
		"Disconnect Blender Follow before exporting."
	)
	local shakeTime = raw.CurrentTime
	local fps = raw.FPS
	assert(type(fps) == "number" and fps >= 1 and fps <= 240, "FPS must be between 1 and 240")
	local last = options.LastFrame
	assert(
		type(last) == "number" and last % 1 == 0 and last >= 1 and last <= 144000,
		"End frame must be a whole number between 1 and 144,000"
	)
	local rigs = table.clone(state.getAllRigs())
	local selectedCamera = options.Camera
	if options.CameraMode == "Authored" then
		assert(
			selectedCamera
				and (Camera.isRig(selectedCamera) or selectedCamera:IsA("Camera"))
				and Organization.isEnabled(selectedCamera),
			"Choose an enabled timeline camera."
		)
	end

	local context = require("context").create(options, fps, last)
	local root = context.root
	local scene = context.scene
	local meshFolder = context.meshFolder
	local originals = context.originals
	local data = context.data
	data.GreaseDrawings = Drawings.copy(Drawings.validate(raw.GreaseDrawings or Drawings.empty()))
	data.SkipFrames = raw.SkipFrames or 0
	local surfaces = context.surfaces
	local sourceCode = context.sourceCode
	local ids = context.ids
	local copies = context.copies
	local scanQueue = context.scanQueue
	local rootKinds = context.rootKinds
	local objectQueue = context.objectQueue
	local code = context.code
	local reference = context.reference
	local addRoot = context.addRoot
	local archive
	local channels, channelIndex, meshIds = {}, {}, {}
	local restore
	local projectChanged = false
	local unsubscribe = require("History").subscribe(function()
		projectChanged = true
	end)

	local function checkProject(snapshot, time)
		local reason
		if projectChanged then
			reason = "animation history changed"
		elseif raw.CurrentTime ~= time then
			reason = "playhead changed from " .. tostring(time) .. " to " .. tostring(raw.CurrentTime)
		elseif raw.FPS ~= fps then
			reason = "FPS changed from " .. tostring(fps) .. " to " .. tostring(raw.FPS)
		else
			local matches, detail = snapshot:matches()
			if not matches then reason = detail or "scene properties changed" end
		end
		assert(not reason, "The project changed during export: " .. (reason or "unknown change") .. ". Your edit was kept; export again when ready.")
	end

	local function channel(source, property, kind, getter, smooth, attachmentCamera)
		local id = typeof(source) == "string" and source or ids[source]
		assert(id, "Unmapped animated object " .. tostring(source))
		local key = id .. ":" .. (kind or "Property") .. ":" .. property
		if channelIndex[key] then
			return
		end

		local row = {
			Target = id,
			Property = property,
			Kind = kind or "Property",
			Samples = {},
			Smooth = smooth ~= false,
		}
		table.insert(data.Tracks, row)
		local entry = {
			row = row,
			camera = attachmentCamera,
			get = getter or function()
				return source[property]
			end,
		}
		table.insert(channels, entry)
		channelIndex[key] = entry
	end

	local function mesh(source)
		local key = source.MeshId
		local existing = meshIds[key]
		if existing then
			return existing
		end

		local id = "Mesh" .. tostring(#meshFolder:GetChildren() + 1)
		local copy = Instance.new("MeshPart")
		copy.Name = id
		copy:ApplyMesh(source)
		copy.Parent = meshFolder
		meshIds[key] = id
		return id
	end

	local ok, message = xpcall(function()
		if progress then
			progress("Collecting project and actors…")
		end

		local armature = require("ArmatureRuntime")
		local hasArmature = false
		for _, rig in rigs do
			if Organization.isEnabled(rig) and armature.isRig(rig) then
				hasArmature = true
				break
			end
		end

		if hasArmature then
			if progress then
				progress("Resolving Blender render geometry…")
			end

			restore = Snapshot.new(rigs, raw, {})
			local slice = os.clock()
			local currentTime = raw.CurrentTime
			for frame = 0, last do
				assert(not options.IsCancelled or not options.IsCancelled(), "Export cancelled")
				if rigs[1] then
					timeline:ApplyPoseAtTime(rigs[1], frame / fps, { SkipControls = true })
				end

				if frame < last and os.clock() - slice > 0.08 then
					local snapshot = restore
					restore:restore()
					restore = nil
					if progress then
						progress(
							string.format("Resolving Blender geometry %d / %d", frame + 1, last + 1)
						)
					end

					task.wait()
					checkProject(snapshot, currentTime)
					restore = Snapshot.new(rigs, raw, {})
					slice = os.clock()
				end
			end

			restore:restore()
			restore = nil
		end

		for _, rig in rigs do
			if Organization.isEnabled(rig) then
				for _, surface in require("ArmatureRuntime").exportSurfaces(rig) do
					if not table.find(surfaces, surface) then
						table.insert(surfaces, surface)
					end
				end
			end
		end

		archive = refs.Archive()
		archive.Parent = root

		local ordered = table.clone(rigs)

		local function depth(object)
			local n = 0
			while object.Parent do
				n += 1
				object = object.Parent
			end

			return n
		end

		table.sort(ordered, function(a, b)
			return depth(a) < depth(b)
		end)
		for _, rig in ordered do
			if not Organization.isEnabled(rig) then
				continue
			end

			if rig.Parent == game or rig:IsA("Terrain") then
				context.nextId += 1
				ids[rig] = tostring(context.nextId)
				local record = { Id = ids[rig], Path = Codec.path(rig), Properties = {} }
				record.Reference = reference(rig)
				record.Selector = Codec.selector(rig)
				for _, motor in Properties.list(rig) do
					record.Properties[motor.PropertyId == "TimeOfDay" and "ClockTime" or motor.PropertyId] =
						true
				end

				table.insert(data.Globals, record)
			elseif rig:IsDescendantOf(game:GetService("Lighting")) then
				addRoot(rig, "Lighting")
			else
				addRoot(rig, Camera.isRig(rig) and "Camera" or "Actor")
			end
		end

		local lighting = game:GetService("Lighting")
		local lightingRecord
		for _, record in data.Globals do
			if record.Id == ids[lighting] then
				lightingRecord = record
				break
			end
		end

		if not lightingRecord then
			context.nextId += 1
			ids[lighting] = tostring(context.nextId)
			lightingRecord = { Id = ids[lighting], Path = { "Lighting" }, Properties = {} }
			table.insert(data.Globals, lightingRecord)
		end

		for _, key in
			{
				"Ambient",
				"Brightness",
				"ColorShift_Bottom",
				"ColorShift_Top",
				"EnvironmentDiffuseScale",
				"EnvironmentSpecularScale",
				"ExposureCompensation",
				"ClockTime",
				"GeographicLatitude",
				"GlobalShadows",
				"OutdoorAmbient",
				"FogEnd",
				"FogStart",
				"FogColor",
				"ShadowSoftness",
			}
		do
			lightingRecord.Properties[key] = true
			channel(lighting, key)
		end

		for _, object in lighting:GetChildren() do
			if object:IsA("PostEffect") or object:IsA("Atmosphere") or object:IsA("Sky") then
				if not ids[object] then
					addRoot(object, "Lighting")
				end
			end
		end

		for _, dependency in options.Dependencies or {} do
			if not ids[dependency] then
				assert(
					dependency:IsDescendantOf(workspace)
						or dependency:IsDescendantOf(game:GetService("ReplicatedStorage"))
						or dependency:IsDescendantOf(lighting)
						or dependency:IsDescendantOf(game:GetService("SoundService")),
					"Dependencies must be in Workspace, ReplicatedStorage, Lighting, or SoundService: "
						.. dependency:GetFullName()
				)
				addRoot(dependency, "Dependency")
			end
		end

		for _, surface in surfaces do
			if not ids[surface] then
				addRoot(surface, "Surface")
			end
		end

		for rig, track in Events.all() do
			if Events.isEnabled(track) then
				for _, event in track.Events do
					if event.Enabled ~= false then
						table.insert(scanQueue, { Source = event.CodeBegin or "", Rig = rig })
						table.insert(scanQueue, { Source = event.CodeEnd or "", Rig = rig })
					end
				end
			end
		end

		require("context").dependencies(context)
		local referenceFields = context.referenceFields
		for source, copy in copies do
			local dependency = false
			local ancestor = source
			while ancestor do
				if rootKinds[ancestor] then
					dependency = rootKinds[ancestor] == "Dependency"
					break
				end

				ancestor = ancestor.Parent
			end

			if dependency then
				local editable = Geometry.mesh(source)
				if editable then
					data.Geometry[ids[source]] = Geometry.capture(editable)
				end
			end

			if not dependency then
				if source:IsA("BasePart") then
					for _, key in
						{
							"CFrame",
							"Size",
							"Color",
							"Transparency",
							"Reflectance",
							"Material",
							"MaterialVariant",
							"CastShadow",
						}
					do
						channel(source, key)
					end

					channel(source, "LocalTransparencyModifier", nil, function()
						return table.find(surfaces, source) and source.Parent == nil and 1
							or source.LocalTransparencyModifier
					end, false)
					if source:IsA("MeshPart") then
						local editable = Geometry.mesh(source)
						if editable then
							local geometry = Geometry.capture(editable)
							data.Geometry[ids[source]] = geometry
							Geometry.channels(editable, geometry, function(key, getter, smooth)
								channel("Geometry:" .. ids[source], key, "Geometry", getter, smooth)
							end)
						else
							channel(source, "ApplyMesh", "Mesh", function()
								return mesh(source)
							end, false)
						end

						channel(source, "TextureID", nil, nil, false)
					end
				elseif source:IsA("Bone") then
					channel(source, "Transform")
					channel(source, "CFrame")
				elseif source:IsA("Attachment") then
					channel(source, "CFrame")
				elseif source:IsA("DataModelMesh") then
					for _, key in
						source:IsA("SpecialMesh") and {
							"Scale",
							"Offset",
							"VertexColor",
							"MeshId",
							"TextureId",
							"MeshType",
						} or { "Scale", "Offset", "VertexColor" }
					do
						channel(source, key)
					end
				elseif source:IsA("Decal") then
					for _, key in
						{ "Texture", "Color3", "Transparency", "LocalTransparencyModifier" }
					do
						channel(source, key)
					end
				end
			end

			for _, key in referenceFields(source) do
				local value = source[key]
				if value then
					if
						source:IsA("ObjectValue")
						and source.Name:sub(1, 7) == "Eclipse"
						and not copies[value]
					then
						copy[key] = nil
					elseif not copies[value] and not value:IsDescendantOf(game) then
						copy[key] = nil
					else
						assert(
							copies[value],
							"External reference "
								.. source:GetFullName()
								.. "."
								.. key
								.. " points outside exported actors/dependencies: "
								.. value:GetFullName()
						)
						copy[key] = copies[value]
					end
				end
			end
		end

		local faceRows = {}
		for _, rig in rigs do
			if ids[rig] and copies[rig] and Faces.supports(rig) then
				local track = Events.all()[rig]
				if track and track.FacesEnabled and next(track.FaceKeys or {}) then
					local head = rig:FindFirstChild("Head", true)
					local copyHead = copies[head]
					local face = copyHead and copyHead:FindFirstChild("face")
					if not face or not face:IsA("Decal") then
						face = nil
						for _, candidate in copyHead:GetChildren() do
							if candidate:IsA("Decal") and candidate.Face == Enum.NormalId.Front then
								face = candidate
								break
							end
						end
					end

					if not face then
						face = Instance.new("Decal")
						face.Name = "face"
						face.Face = Enum.NormalId.Front
						face.Parent = copyHead
						context.nextId += 1
						face:SetAttribute("EclipseExportId", tostring(context.nextId))
					end

					local original = head:FindFirstChild(face.Name)
					local base = Faces.originalPresentation(rig, original)
					local id = face:GetAttribute("EclipseExportId")
					local row = { track = track, base = base, values = table.clone(base) }
					table.insert(faceRows, row)
					for property, value in base do
						face[property] = value
						local getter = function()
							return row.values[property]
						end

						local old = channelIndex[id .. ":Property:" .. property]
						if old then
							old.get = getter
							old.row.Smooth = false
						else
							channel(id, property, nil, getter, false)
						end
					end
				end
			end
		end

		for _, rig in rigs do
			if not ids[rig] then
				continue
			end

			if Objects.is(rig) then
				table.insert(data.Effects, ids[rig])
				if Objects.kind(rig) == "Letterbox" then
					local target
					for _, camera in rigs do
						if
							Camera.isRig(camera)
							and camera:GetAttribute("EclipseTrackId")
								== rig:GetAttribute("EffectCameraId")
						then
							target = camera
							break
						end
					end

					assert(target, "Letterbox " .. rig.Name .. " has no valid camera binding")
					local cameraId = "EffectCamera:" .. ids[rig]
					data.EffectCameras[ids[rig]] = {
						Target = cameraId,
						Selected = options.CameraMode == "Authored" and selectedCamera == target,
					}
					channel(cameraId, "View", nil, function()
						return Camera.viewFrame(target, nil, shakeTime)
							* (
								state.ScreenEffects
									and state.ScreenEffects.shake(shakeTime, true, target)
								or CFrame.identity
							)
					end, nil, target)
					channel(cameraId, "FOV", nil, function()
						return Camera.fov(target)
					end)
				end

				for _, definition in Objects.catalog(rig) do
					if
						definition.id == "TopSize"
						or definition.id == "BottomSize"
						or definition.id == "VFXSize"
					then
						continue
					end

					local id = definition.id
					channel(rig, "Effect" .. id, "Attribute", function()
						return Objects.read(rig, id)
					end)
				end
			else
				for _, motor in Properties.list(rig) do
					local id = motor.PropertyId
					if rig:IsA("Model") then
						continue
					end

					if id == "ApplyMesh" then
						Properties.prepare(motor, Properties.readValue(rig, id))
						continue
					end

					local key = id == "ApplyTexture" and "TextureID"
						or id == "TimeOfDay" and "ClockTime"
						or id
					channel(rig, key, nil, function()
						return Properties.readValue(rig, id)
					end)
				end
			end
		end

		if state.ScreenEffects then
			local function offset()
				return options.CameraMode == "Authored"
						and state.ScreenEffects.shake(shakeTime, true, selectedCamera)
					or CFrame.identity
			end

			channel("CameraShake", "View", nil, offset)
			channel("CameraShake", "CFrame", nil, function()
				local delta = offset()
				if
					options.CameraMode == "Authored"
					and Camera.isRig(selectedCamera)
					and selectedCamera:GetAttribute("EclipseOrthographic") == true
				then
					local base = Camera.renderFrame(selectedCamera, nil, true, shakeTime)
					local shaken = require("fov").render(
						Camera.viewFrame(selectedCamera, nil, shakeTime) * delta,
						Camera.fov(selectedCamera),
						true
					)
					return base:ToObjectSpace(shaken)
				end

				return delta
			end)
		end

		local projection = {}
		local fixed = workspace.CurrentCamera
		if options.CameraMode == "Studio" then
			assert(fixed, "No Studio camera exists")
			projection.cf, projection.fov, projection.focus =
				fixed.CFrame, fixed.FieldOfView, fixed.Focus
		end

		if options.CameraMode ~= "Game" then
			channel("Camera", "CFrame", nil, function()
				return projection.cf
			end)
			channel("Camera", "FieldOfView", nil, function()
				return projection.fov
			end)
			channel("Camera", "Focus", nil, function()
				return projection.focus
			end)
			channel("Projection", "View", nil, function()
				return projection.view or projection.cf
			end)
			channel("Projection", "FOV", nil, function()
				return projection.authoredFov or projection.fov
			end)
			channel("Projection", "Enabled", nil, function()
				return options.CameraMode == "Authored"
					and selectedCamera:GetAttribute("EclipseOrthographic") == true
			end, false)
		end

		for rig, track in Events.all() do
			if Events.isEnabled(track) then
				for _, event in track.Events do
					if event.Enabled ~= false then
						if event.Subtitle then
							table.insert(data.Subtitles, {
								id = track.DocumentId .. ":" .. event.Id,
								event = { Frame = event.Frame, Subtitle = event.Subtitle },
							})
						end

						if
							event.CodeBegin ~= ""
							or event.CodeEnd ~= ""
							or #(event.Emits or {}) > 0
							or #(event.Sounds or {}) > 0
							or #Events.markers(event) > 0
						then
							assert(
								ids[rig] or track.ProjectSubtitles,
								"Event rig is not exported: " .. rig.Name
							)
							local copy = table.clone(event)
							copy.Button = nil
							copy.CodeBegin = nil
							copy.CodeEnd = nil
							copy.Subtitle = nil
							copy.Sounds = {}
							local SoundData = require("SoundData")
							for _, sound in SoundData.copy(event.Sounds) do
								if sound.AudioId == "" then
									continue
								end

								assert(
									not require("LocalAudio").is(sound.AudioId),
									"Local audio in event "
										.. event.Name
										.. " is for Studio preview. Replace it with a Roblox audio ID before exporting the cutscene."
								)
								local asset = SoundData.asset(sound.AudioId)
								assert(asset, "Invalid audio ID in event " .. event.Name)
								sound.AudioId = asset
								table.insert(copy.Sounds, sound)
							end

							table.insert(data.Events, {
								Id = track.DocumentId .. ":" .. event.Id,
								Rig = ids[rig],
								Frame = event.Frame,
								Speed = Events.speed(event, fps),
								Data = copy,
								Markers = Events.markers(event),
								Begin = code(event.CodeBegin, event.Name .. " begin"),
								End = code(event.CodeEnd, event.Name .. " end"),
							})
						end
					end
				end
			end
		end

		local contentLast =
			math.max(timeline:GetLastKeyframeFrame() or 0, Drawings.lastFrame(data.GreaseDrawings))
		for _, clip in require("Cache").list(raw) do
			contentLast = math.max(contentLast, clip.last)
		end

		for _, rig in rigs do
			local track = Events.all()[rig]
			if track and track.FacesEnabled and Organization.isEnabled(rig) then
				for _, faceKey in track.FaceKeys or {} do
					contentLast = math.max(contentLast, faceKey.Frame)
				end
			end
		end

		for _, event in data.Events do
			contentLast = math.max(contentLast, event.Frame + (event.Data.Duration or 0))
		end

		for _, row in data.Subtitles do
			contentLast = math.max(contentLast, row.event.Frame + row.event.Subtitle.Duration)
		end

		for _, effect in raw.ScreenEffects or {} do
			if effect.enabled ~= false then
				contentLast = math.max(contentLast, effect.start + effect.duration)
			end
		end

		data.ContentLastFrame = math.clamp(contentLast, 0, last)
		table.sort(data.Subtitles, function(a, b)
			if a.event.Subtitle.Order ~= b.event.Subtitle.Order then
				return a.event.Subtitle.Order < b.event.Subtitle.Order
			end

			return a.id < b.id
		end)
		assert(
			#channels * (last + 1) <= 12000000,
			"This export is too large ("
				.. #channels
				.. " channels × "
				.. (last + 1)
				.. " frames). Shorten the range or split the cutscene."
		)
		if progress then
			progress("Baking " .. (last + 1) .. " frames at " .. fps .. " FPS…")
		end

		for motor, bucket in require("Layers").allTracks(raw) do
			if Properties.is(motor) and motor.PropertyId == "ApplyMesh" then
				for _, key in bucket do
					Properties.prepare(
						motor,
						Properties.decode(motor, key.CFrame or key.C0, key.PropertyValue)
					)
				end
			end
		end

		restore = Snapshot.new(rigs, raw, surfaces)
		local slice = os.clock()
		local lastTime = raw.CurrentTime
		local frameSet = {}
		for frame = 0, last do
			frameSet[frame] = true
		end

		for motor, bucket in require("Layers").allTracks(raw) do
			require("Mods").bakeBoundaries(motor, bucket, last, function(f)
				frameSet[f] = true
			end)
		end

		local sampleFrames = {}
		for f in frameSet do
			table.insert(sampleFrames, f)
		end

		table.sort(sampleFrames)
		for _, frame in sampleFrames do
			assert(not options.IsCancelled or not options.IsCancelled(), "Export cancelled")
			local time = frame / fps
			shakeTime = time
			if rigs[1] then
				timeline:ApplyPoseAtTime(rigs[1], time, { SkipControls = true })
			end

			for _, rig in rigs do
				if
					rig:IsA("Model")
					and not Camera.isRig(rig)
					and not require("ArmatureRuntime").isRig(rig)
				then
					require("RigPose").assemble(rig)
				end
			end

			for _, rig in rigs do
				if ids[rig] and Objects.kind(rig) == "Letterbox" then
					local target
					for _, camera in rigs do
						if
							Camera.isRig(camera)
							and camera:GetAttribute("EclipseTrackId")
								== rig:GetAttribute("EffectCameraId")
						then
							target = camera
							break
						end
					end

					assert(target, "Letterbox " .. rig.Name .. " has no valid camera binding")
					Objects.follow(rig, {
						cf = Camera.viewFrame(target, nil, shakeTime)
							* (
								state.ScreenEffects
									and state.ScreenEffects.shake(time, true, target)
								or CFrame.identity
							),
						fov = Camera.fov(target),
					}, {
						Playing = true,
						CurrentTime = time,
						Keyframes = raw.Keyframes,
						DefaultPose = raw.DefaultPose,
					})
				end
			end

			if options.CameraMode == "Authored" then
				if selectedCamera:IsA("Camera") then
					projection.cf, projection.fov, projection.focus =
						selectedCamera.CFrame, selectedCamera.FieldOfView, selectedCamera.Focus
				else
					projection.cf, projection.fov, projection.focus =
						Camera.renderFrame(selectedCamera, nil, true, shakeTime)
					projection.view, projection.authoredFov =
						Camera.viewFrame(selectedCamera, nil, shakeTime), Camera.fov(selectedCamera)
				end
			end

			for _, row in faceRows do
				local image = Faces.sample(row.track, frame)
				local active = image ~= nil and image ~= ""
				row.values.Texture = active and image or row.base.Texture
				row.values.Transparency = active and 0 or row.base.Transparency
				row.values.LocalTransparencyModifier = active and 0
					or row.base.LocalTransparencyModifier
				row.values.Face = active and Enum.NormalId.Front or row.base.Face
			end

			for _, entry in channels do
				local value = entry.get()
				assert(value ~= nil, "Cannot sample " .. entry.row.Property)
				local samples = entry.row.Samples
				local n = #samples
				local camera = entry.camera
					or entry.row.Target == "Camera" and entry.row.Property ~= "FieldOfView" and selectedCamera
					or entry.row.Target == "Projection"
						and entry.row.Property == "View"
						and selectedCamera
				if camera and Camera.isRig(camera) and frame > 0 then
					local target = require("Target")
					if
						target.attachmentObject(camera, (frame - 1) / fps)
							~= target.attachmentObject(camera, time)
						and n > 0
						and not equal(samples[n][2], value)
					then
						table.insert(samples, { frame, samples[n][2] })
						table.insert(samples, { frame, value })
						continue
					end
				end

				if n >= 2 and equal(samples[n][2], value) and equal(samples[n - 1][2], value) then
					samples[n][1] = frame
				else
					table.insert(samples, { frame, value })
				end
			end

			if frame < last and os.clock() - slice > 0.08 then
				local snapshot = restore
				restore:restore()
				restore = nil
				if progress then
					progress(
						string.format(
							"Baking %d / %d frames · %d FPS",
							math.floor(frame) + 1,
							last + 1,
							fps
						)
					)
				end

				task.wait()
				checkProject(snapshot, lastTime)
				local present = state.getAllRigs()
				assert(#present == #rigs, "Project membership changed during export")
				for i, rig in rigs do
					assert(present[i] == rig and rig.Parent, "An actor changed during export")
				end

				restore = Snapshot.new(rigs, raw, surfaces)
				slice = os.clock()
			end
		end

		assert(raw.CurrentTime == lastTime, "The project playhead changed during export")
		restore:restore()
		restore = nil

		for _, track in data.Tracks do
			if #track.Samples == 2 and equal(track.Samples[1][2], track.Samples[2][2]) then
				table.remove(track.Samples)
			end
		end

		local unused = {}
		for _, surface in surfaces do
			local id = ids[surface]
			local visible = false
			local entry = channelIndex[id .. ":Property:LocalTransparencyModifier"]
			if entry then
				for _, sample in entry.row.Samples do
					if sample[2] < 1 then
						visible = true
						break
					end
				end
			end

			if not visible and copies[surface] then
				local copy = copies[surface]
				unused[id] = true
				for _, child in copy:GetDescendants() do
					local childId = child:GetAttribute("EclipseExportId")
					if childId then
						unused[childId] = true
					end
				end

				copy:Destroy()
			end
		end

		for id in unused do
			data.Geometry[id] = nil
		end

		for i = #data.Tracks, 1, -1 do
			local target = data.Tracks[i].Target
			if unused[target] or unused[target:match("^Geometry:(.+)$")] then
				table.remove(data.Tracks, i)
			end
		end

		for i = #data.Roots, 1, -1 do
			if unused[data.Roots[i].Id] then
				table.remove(data.Roots, i)
			end
		end

		for _, binding in data.Bindings do
			for i = #binding.Nodes, 1, -1 do
				if unused[binding.Nodes[i].Id] then
					table.remove(binding.Nodes, i)
				end
			end
		end

		Codec.encode(data.Events)
		Codec.encode(data.Subtitles)
	end, debug.traceback)
	local restored, restoreError = true, nil
	if restore then
		restored, restoreError = pcall(function()
			restore:restore()
		end)
	end

	unsubscribe()
	if not ok or not restored then
		root:Destroy()
		error(
			(not ok and tostring(message) or "")
				.. (not restored and "\n" .. tostring(restoreError) or ""),
			2
		)
	end

	return root, data, sourceCode
end

function Bake.build(refs, options, progress)
	return Bake.withExportLock(refs, options, function()
		local raw = refs.State.Timeline:GetState()

		local recording = raw.Recording
		raw.Recording = false
		local result = table.pack(xpcall(function()
			return require("EventPreview").withCleanScene(refs.State.Timeline, function()
				return require("Cache").withPreview(raw, function()
					return build(refs, options, progress)
				end)
			end)
		end, debug.traceback))
		raw.Recording = recording
		assert(result[1], result[2])
		return table.unpack(result, 2, result.n)
	end)
end

return Bake
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a447</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2046">
          <Properties>
            <string name="Name">Package</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028fa1</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{98B57944-2283-4571-A4FB-8C255A04D8EB}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local Codec = require("Codec")
local Sources = require("Sources")
local Bake = require("Bake")
local SubtitleData = require("SubtitleData")
local Theme = require("Theme")
local Package = {}
local Editor = game:GetService("ScriptEditorService")
local HEADER = "-- riftkuro | Eclipse Animator"
local RUNTIME_NAME = "EclipseCutsceneRuntime"
local RUNTIME_ENTRY = "Runtime/Cutscene"
local runtimeVersion

local function module(parent, name, source, class)
	if not source:match("^%-%-") then
		source = HEADER .. "\n\n" .. source
	end

	local object = Instance.new(class or "ModuleScript")
	object.Name = name
	local ok, err = pcall(function()
		Editor:UpdateSourceAsync(object, function()
			return source
		end)
	end)
	if not ok then
		object:Destroy()
		error(err)
	end

	assert(object.Source == source, "Could not write export source " .. name)
	object.Parent = parent
	return object
end

local function unique(parent, name)
	name = tostring(name):gsub("[^%w_ %-]", "_"):sub(1, 72)
	if name == "" then
		name = "Item"
	end

	local result = name
	local index = 2
	while parent:FindFirstChild(result) do
		result = name .. "_" .. index
		index += 1
	end

	return result
end

local keywords = {
	["and"] = true,
	["break"] = true,
	["do"] = true,
	["else"] = true,
	["elseif"] = true,
	["end"] = true,
	["false"] = true,
	["for"] = true,
	["function"] = true,
	["if"] = true,
	["in"] = true,
	["local"] = true,
	["nil"] = true,
	["not"] = true,
	["or"] = true,
	["repeat"] = true,
	["return"] = true,
	["then"] = true,
	["true"] = true,
	["until"] = true,
	["while"] = true,
	["const"] = true,
}

local function field(key)
	if type(key) == "string" and key:match("^[%a_][%w_]*$") and not keywords[key] then
		return key
	end

	return "[" .. Codec.encode(key) .. "]"
end

local function scalar(value)
	if type(value) == "number" then
		for precision = 6, 17 do
			local text = string.format("%." .. precision .. "g", value)
			if tonumber(text) == value then
				return text
			end
		end
	elseif typeof(value) == "Color3" then
		local r, g, b = value.R * 255, value.G * 255, value.B * 255
		if
			math.abs(r - math.round(r)) < 1e-3
			and math.abs(g - math.round(g)) < 1e-3
			and math.abs(b - math.round(b)) < 1e-3
		then
			return string.format(
				"Color3.fromRGB(%d, %d, %d)",
				math.round(r),
				math.round(g),
				math.round(b)
			)
		end
	end

	return Codec.encode(value)
end

local function pretty(value, depth)
	if type(value) ~= "table" then
		return scalar(value)
	end

	depth = depth or 0
	local keys = {}
	local flat = true
	for key, item in value do
		table.insert(keys, key)
		if type(item) == "table" then
			flat = false
		end
	end

	if #keys == 0 then
		return "{}"
	end

	local array = #value == #keys
	table.sort(keys, function(a, b)
		if type(a) == type(b) and (type(a) == "number" or type(a) == "string") then
			return a < b
		end

		return Codec.encode(a) < Codec.encode(b)
	end)
	if flat and (array or #keys <= 4) then
		local parts = {}
		for _, key in keys do
			table.insert(
				parts,
				array and scalar(value[key]) or field(key) .. " = " .. scalar(value[key])
			)
		end

		local line = "{ " .. table.concat(parts, ", ") .. " }"
		if #line <= 100 then
			return line
		end
	end

	local indent = string.rep("\t", depth + 1)
	local rows = {}
	for _, key in keys do
		local item = pretty(value[key], depth + 1)
		table.insert(rows, indent .. (array and item or field(key) .. " = " .. item) .. ",")
	end

	return "{\n" .. table.concat(rows, "\n") .. "\n" .. string.rep("\t", depth) .. "}"
end

local function indented(source, depth)
	source = source:gsub("\r\n", "\n"):gsub("\r", "\n"):gsub("%s+$", "")
	if source == "" or source:find("%[=*%[") then
		return source
	end

	local indent = string.rep("\t", depth)
	return indent .. source:gsub("\n", "\n" .. indent):gsub("\n" .. indent .. "\n", "\n\n")
end

local function storeData(folder, value, label)
	label = label or "Layout"

	local function write(source, final)
		local name = unique(folder, final and label or label .. "_Part")
		module(folder, name, source)
		return name
	end

	local literal = pretty(value)
	if #literal <= 80000 then
		return write("return " .. literal, true)
	end

	assert(type(value) == "table", "An individual export value is too large")
	local parts, rows, size = {}, {}, 0

	local function flush()
		if #rows > 0 then
			table.insert(parts, write("return {\n\t" .. table.concat(rows, ",\n\t") .. ",\n}\n"))
			rows = {}
			size = 0
		end
	end

	for key, entry in value do
		local encoded = Codec.encode(entry, nil, 1)
		if #encoded > 20000 and type(entry) == "table" then
			encoded = "require("
				.. string.format(
					"%q",
					"./" .. storeData(folder, entry, label .. "_" .. tostring(key))
				)
				.. ")"
		end

		local row = "[" .. Codec.encode(key) .. "] = " .. encoded
		if size + #row > 80000 then
			flush()
		end

		table.insert(rows, row)
		size += #row
	end

	flush()
	if #parts == 1 then
		return parts[1]
	end

	return write(
		"local value = {}\nlocal parts = "
			.. Codec.encode(parts)
			.. "\n\nfor _, name in parts do\n\tlocal chunk = require(`./{name}`)\n\n\tfor key, item in chunk do\n\t\tvalue[key] = item\n\tend\nend\n\nreturn value\n",
		true
	)
end

local function scan(line, long)
	local i, n = 1, #line
	while i <= n do
		if long then
			local s, e = line:find("]" .. string.rep("=", long) .. "]", i, true)
			if not s then
				return long
			end

			long = nil
			i = e + 1
		else
			local c = line:sub(i, i)
			if c == '"' or c == "'" or c == "`" then
				local j = i + 1
				while j <= n do
					local d = line:sub(j, j)
					if d == "\\" then
						j += 2
					elseif d == c then
						break
					else
						j += 1
					end
				end

				i = j + 1
			elseif c == "-" and line:sub(i + 1, i + 1) == "-" then
				local eq = line:match("^%[(=*)%[", i + 2)
				if eq then
					long = #eq
					i = i + 4 + #eq
				else
					return long
				end
			elseif c == "[" then
				local eq = line:match("^%[(=*)%[", i)
				if eq then
					long = #eq
					i = i + 2 + #eq
				else
					i += 1
				end
			else
				i += 1
			end
		end
	end

	return long
end

local function split(source)
	local lines = {}
	for line in (source .. "\n"):gmatch("([^\n]*)\n") do
		table.insert(lines, line)
	end

	if lines[#lines] == "" then
		table.remove(lines)
	end

	return lines
end

local function mark(lines)
	local inside = {}
	local long = nil
	for index, line in lines do
		inside[index] = long ~= nil
		long = scan(line, long)
	end

	return inside
end

local function dedent(source)
	local lines = split(source)
	local inside = mark(lines)
	for index, line in lines do
		if not inside[index] and line:sub(1, 1) == "\t" then
			lines[index] = line:sub(2)
		end
	end

	return table.concat(lines, "\n")
end

local function trim(line)
	return line:match("^%s*(.-)%s*$")
end

local function indentOf(line)
	return #line:match("^\t*")
end

local closers = {
	["end"] = true,
	["else"] = true,
	["elseif"] = true,
	["until"] = true,
	["}"] = true,
	[")"] = true,
	["]"] = true,
}

local function opensBlock(text)
	return text:match("[{(,]$")
		or text:match("then$")
		or text:match("do$")
		or text:match("else$")
		or text:find("function", 1, true)
		or text:match("^%-%-")
end

local function startsClose(text)
	return closers[text:match("^[%w_]+") or ""] or closers[text:sub(1, 1)]
end

local function space(source)
	local lines = split(source)
	local inside = mark(lines)
	local out = {}
	for index, line in lines do
		local text = trim(line)
		local previous = out[#out]
		local prevText = previous and trim(previous) or ""
		if not inside[index] and previous ~= nil and prevText ~= "" then
			local wantBlank = false
			if text:match("^function[%s(]") or text:match("^local function[%s(]") then
				wantBlank = not opensBlock(prevText)
			elseif
				prevText == "end"
				and not startsClose(text)
				and indentOf(line) <= indentOf(previous)
			then
				wantBlank = true
			elseif
				prevText:match("^local [%w_]+ = Instance%.new%(") and not text:match("^%-%-")
			then
				wantBlank = true
			elseif text:match("^return ") and indentOf(line) == 0 then
				wantBlank = true
			end

			if wantBlank then
				table.insert(out, "")
			end
		end

		table.insert(out, line)
	end

	local result = {}
	local blank = false
	local marks = mark(out)
	for index, line in out do
		if line == "" and not marks[index] then
			if not blank then
				table.insert(result, line)
			end

			blank = true
		else
			table.insert(result, line)
			blank = false
		end
	end

	return table.concat(result, "\n")
end

local function json(text)
	local out = {}
	local depth = 0
	local i, n = 1, #text

	local function newline()
		table.insert(out, "\n" .. string.rep("\t", depth))
	end

	while i <= n do
		local c = text:sub(i, i)
		if c == '"' then
			local j = i + 1
			while j <= n do
				local d = text:sub(j, j)
				if d == "\\" then
					j += 2
				elseif d == '"' then
					break
				else
					j += 1
				end
			end

			table.insert(out, text:sub(i, j))
			i = j + 1
		elseif c == "{" or c == "[" then
			local close = c == "{" and "}" or "]"
			if text:sub(i + 1, i + 1) == close then
				table.insert(out, c .. close)
				i += 2
			else
				table.insert(out, c)
				depth += 1
				newline()
				i += 1
			end
		elseif c == "}" or c == "]" then
			depth -= 1
			newline()
			table.insert(out, c)
			i += 1
		elseif c == "," then
			table.insert(out, ",")
			newline()
			i += 1
		elseif c == ":" then
			table.insert(out, ": ")
			i += 1
		elseif c:match("%s") then
			i += 1
		else
			table.insert(out, c)
			i += 1
		end
	end

	return table.concat(out)
end

local function unwrap(name, source)
	local body = source:match("^%s*return function%(require%)\n(.*)\nend%s*$")
		or source:match("^%-%-[^\n]*\n\nreturn function%(require%)\n(.*)\nend\n?$")
	assert(body, "Unexpected runtime module shape: " .. name)
	body = space(dedent(body))
	if name == "Resources/EffectAssets" then
		local a, b = body:find("%[==%[.-%]==%]")
		if a then
			body = body:sub(1, a + 3) .. json(body:sub(a + 4, b - 4)) .. body:sub(b - 3)
		end
	end

	return HEADER .. "\n\n" .. body .. "\n"
end

local function version()
	if runtimeVersion then
		return runtimeVersion
	end

	local names = {}
	for name in Sources do
		table.insert(names, name)
	end

	table.sort(names)
	local hash = 7
	for _, name in names do
		local source = name .. "\0" .. Sources[name]
		for index = 1, #source do
			hash = (hash * 31 + source:byte(index)) % 4294967296
		end
	end

	runtimeVersion = string.format("2.%08x", hash)
	return runtimeVersion
end

function Package.installRuntime(folder)
	local current = version()
	local existing = folder:FindFirstChild(RUNTIME_NAME)
	if
		existing
		and existing:IsA("ModuleScript")
		and existing:GetAttribute("EclipseRuntime") == current
	then
		return existing, false
	end

	assert(
		not existing or existing:GetAttribute("EclipseRuntime"),
		"ReplicatedStorage.EclipseCutscenes."
			.. RUNTIME_NAME
			.. " is taken by something that is not the Eclipse runtime. Move it and export again."
	)
	assert(Sources[RUNTIME_ENTRY], "The runtime entry module is missing")
	local entry = module(nil, RUNTIME_NAME, unwrap(RUNTIME_ENTRY, Sources[RUNTIME_ENTRY]))
	local ok, message = xpcall(function()
		for name, source in Sources do
			if name == RUNTIME_ENTRY then
				continue
			end

			local pieces = string.split(name, "/")
			local parent = entry
			for index = 1, #pieces - 1 do
				local child = parent:FindFirstChild(pieces[index])
				if not child then
					child = Instance.new("Folder")

					child.Name = pieces[index]
					child.Parent = parent
				end

				parent = child
			end

			module(parent, pieces[#pieces], unwrap(name, source))
		end

		entry:SetAttribute("EclipseRuntime", current)
	end, debug.traceback)
	if not ok then
		entry:Destroy()
		error(message, 2)
	end

	if existing then
		local backup = Instance.new("Folder")

		backup.Name = unique(game:GetService("ServerStorage"), "Eclipse Runtime Backups")
		backup:SetAttribute("EclipseRuntimeBackup", true)
		backup.Parent = game:GetService("ServerStorage")
		existing.Parent = backup
	end

	entry.Parent = folder
	return entry, true
end

local HandlerTemplate = script.Parent.Sources.EclipseExportCutsceneHandler

local function handler()
	local object = HandlerTemplate:Clone()
	object.Name = "EclipseCutsceneHandler"
	object.Enabled = true
	return object
end

local subtitleDefaults =
	{ Entrance = "Fade", Exit = "Fade", InFrames = 12, OutFrames = 12, Order = 0, Preset = "Clean" }

local function style(base, reference)
	local out = {}
	for key, default in SubtitleData.defaults do
		if key == "Words" then
			continue
		end

		if key == "Text" or key == "Speaker" then
			if reference and base[key] ~= reference[key] then
				out[key] = base[key]
			end

			continue
		end

		if base[key] ~= default then
			out[key] = base[key]
		end
	end

	if next(base.Words or {}) then
		out.Words = base.Words
	end

	return out
end

local function subtitleRows(entries)
	local rows = {}
	for _, entry in entries do
		local cue = SubtitleData.copy(entry.event.Subtitle)
		local row = {
			{ "Frame", entry.event.Frame },
			{ "Duration", cue.Duration },
		}
		if cue.Base.Speaker ~= "" then
			table.insert(row, { "Speaker", cue.Base.Speaker })
		end

		table.insert(row, { "Text", cue.Base.Text })
		local look = style(cue.Base)
		if next(look) then
			table.insert(row, { "Style", look })
		end

		for _, key in { "Entrance", "Exit", "InFrames", "OutFrames", "Order", "Preset" } do
			if cue[key] ~= subtitleDefaults[key] then
				table.insert(row, { key, cue[key] })
			end
		end

		if #cue.Keys > 0 then
			local keys = {}
			for _, key in cue.Keys do
				table.insert(
					keys,
					{ Frame = key.Frame, Ease = key.Ease, Value = style(key.Value, cue.Base) }
				)
			end

			table.insert(row, { "Keys", keys })
		end

		table.insert(rows, row)
	end

	return rows
end

local function emitRows(rows)
	local out = {}
	for _, row in rows do
		local plain = true
		local steps = {}
		for _, step in row.Path do
			if
				step.Name:find("/", 1, true)
				or step.Name:match("#%d+$")
				or step.Class:find(".", 1, true)
			then
				plain = false
				break
			end

			table.insert(
				steps,
				step.Class .. "." .. step.Name .. (step.Index > 1 and ("#" .. step.Index) or "")
			)
		end

		if not plain then
			table.insert(out, row)
		elseif row.Mode == "Exact" then
			table.insert(out, table.concat(steps, "/"))
		else
			table.insert(out, { Mode = row.Mode, Path = table.concat(steps, "/") })
		end
	end

	return out
end

local function eventRows(events, rigNames, sources)
	local rows = {}
	for _, event in events do
		local data = event.Data
		local row = {}
		if data.Name and data.Name ~= "" then
			table.insert(row, { "Name", data.Name })
		end

		table.insert(row, { "Frame", event.Frame })
		if event.Rig then
			table.insert(row, { "Rig", rigNames[event.Rig] })
		end

		if (data.Duration or 0) > 0 then
			table.insert(row, { "Duration", data.Duration })
		end

		if event.Speed and event.Speed ~= 1 then
			table.insert(row, { "Speed", event.Speed })
		end

		if data.Parameter and data.Parameter ~= "" then
			table.insert(row, { "Parameter", data.Parameter })
		end

		if #(data.Sounds or {}) > 0 then
			table.insert(row, { "Sounds", data.Sounds })
		end

		if #(data.Emits or {}) > 0 then
			table.insert(row, { "Emit", emitRows(data.Emits) })
		end

		if #(event.Markers or {}) > 0 then
			table.insert(row, { "Markers", event.Markers })
		end

		local extra = {}
		for key, value in data do
			if
				key ~= "Id"
				and key ~= "Name"
				and key ~= "Frame"
				and key ~= "Duration"
				and key ~= "Speed"
				and key ~= "Parameter"
				and key ~= "Sounds"
				and key ~= "Emits"
				and key ~= "Markers"
				and key ~= "Enabled"
			then
				extra[key] = value
			end
		end

		if next(extra) then
			table.insert(row, { "Data", extra })
		end

		for _, phase in { "Begin", "End" } do
			local id = event[phase]
			if id then
				local source = sources[id]
				assert(source, "Missing event code " .. tostring(id))
				table.insert(row, { phase, { code = source } })
			end
		end

		table.insert(rows, row)
	end

	return rows
end

local function renderRows(rows)
	local out = {}
	for _, row in rows do
		local lines = { "\t{" }
		for _, pair in row do
			local key, value = pair[1], pair[2]
			if type(value) == "table" and value.code then
				table.insert(lines, "\t\t" .. key .. " = function(rig, event, parameter, context)")
				local body = indented(value.code, 3)
				if body ~= "" then
					table.insert(lines, body)
				end

				table.insert(lines, "\t\tend,")
			else
				table.insert(lines, "\t\t" .. key .. " = " .. pretty(value, 2) .. ",")
			end
		end

		table.insert(lines, "\t},")
		table.insert(out, table.concat(lines, "\n"))
	end

	if #out == 0 then
		return "{}"
	end

	return "{\n" .. table.concat(out, "\n") .. "\n}"
end

local function cutsceneSource(options, data, subtitles, events, rigNames, sources)
	local lines = {
		HEADER,
		"",
		'local Eclipse = require("./' .. RUNTIME_NAME .. '")',
		"",
		"local Cutscene = {}",
		"",
		"Cutscene.FPS = " .. scalar(data.FPS),
		"Cutscene.LastFrame = " .. scalar(data.LastFrame),
		"Cutscene.Camera = " .. Codec.encode(data.CameraMode),
		"Cutscene.Loop = false",
		"Cutscene.Interpolate = true",
		"Cutscene.HideOriginals = true",
		"",
	}
	if options.Mode == "Button" then
		table.insert(lines, "Cutscene.Button = " .. pretty({
			Label = options.ButtonLabel,
			Theme = {
				Background = Theme.get("TopBtn", Color3.fromRGB(28, 30, 35)),
				Foreground = Theme.get("TopT", Color3.new(1, 1, 1)),
			},
		}))
		table.insert(lines, "")
	end

	table.insert(lines, "Cutscene.Subtitles = " .. renderRows(subtitleRows(subtitles)))
	table.insert(lines, "")
	table.insert(lines, "Cutscene.Events = " .. renderRows(eventRows(events, rigNames, sources)))
	table.insert(lines, "")
	table.insert(lines, "return Eclipse.build(script, Cutscene)")
	table.insert(lines, "")
	return table.concat(lines, "\n")
end
local guide = [====[
Eclipse cutscene

This module is yours. Edit it like any other script; the plugin only reads Baked when
you export again.

----PLAY IT

local Cutscene = require("./%s")
local player = Cutscene.new()

player:Play()
player:Pause()
player:Play()           -- resumes after Pause
player:Seek(1.5)        -- seconds
player:Stop()           -- restores the scene
player:Destroy()

Cutscene.new({ Loop = true, CameraMode = "Game", Interpolate = true, HideOriginals = true, ParentGui = yourGui })
Cutscene.FPS and Cutscene.Duration describe the export. player.Status is Stopped, Loading, Playing or Paused.

player.MarkerReached:Connect(function(name, parameter, frame) end)
player.Completed:Connect(function() end)
player.Stopped:Connect(function(reason) end)
player.Failed:Connect(function(message) end)

Cutscenes play on the client. Require the module from a LocalScript during Play.

----EDIT IT

Frame values are frames at Cutscene.FPS. Move them, and the cutscene follows.

Events      Begin runs at Frame, End runs at Frame + Duration. Both get rig, event, parameter
            and context. Custom code uses normal Roblox globals and receives the real rig instance.
            Native waits/tweens use real time; custom code owns cleanup for objects and tasks it creates.
            Use the built-in Emit, Sounds and Markers tracks for cutscene timing and seeking.
            Delete a row or add Enabled = false to skip it.
Subtitles   Text, Speaker, Frame and Duration. Style holds whatever you changed from the default
            look. Entrance, Exit, InFrames, OutFrames and Keys appear only when they differ.
Camera      "Authored" plays the exported camera, "Game" leaves your camera alone.
LastFrame   Trims the cutscene. Baked motion past it is ignored.
Button      Label and Theme for the shared button handler. Remove it to drop the button.

----PACKAGE

Baked            Sampled motion, scene links and geometry. Export again instead of editing it.
Scene            Actor and VFX copies. Leave their scripts disabled.
Meshes           Mesh variants used by ApplyMesh tracks.
Originals        References back to the original actors.
ProjectArchive   Authoring keyframes so the plugin can re-import this cutscene.
Scene/Assets     Local module dependencies, kept as normal readable ModuleScripts.
EclipseCutsceneRuntime   The shared runtime beside your cutscenes. One copy serves every export.
                         Do not delete it.

Move the cutscene wherever you like. Keep EclipseCutsceneRuntime next to it, or point the
require at the top of the module at the new spot.

----ANOTHER PLACE

Copy the whole EclipseCutscenes folder (cutscenes plus EclipseCutsceneRuntime) into the other
place's ReplicatedStorage, and EclipseCutsceneHandler into StarterPlayerScripts if you use the
buttons. Originals links will not resolve there, so actors are not hidden, but everything the
cutscene needs is inside the package.

----EXPERIENCE SETUP

Audio, image, mesh and animation IDs need permission in your experience. Editable meshes need
the Mesh & Image APIs setting. Restart Play after changing exported ModuleScripts.
]====]

function Package.build(refs, options, progress)
	assert(options.Mode == "Button" or options.Mode == "Scripting", "Choose Buttons or Scripting")
	assert(
		options.Name ~= RUNTIME_NAME,
		RUNTIME_NAME .. " is reserved for the shared runtime. Choose another export name."
	)
	require("HumanoidScale").warnExport(refs.State.Timeline:GetState())
	local root, data, code = Bake.build(refs, options, progress)
	local launcherObject
	local ok, message = xpcall(function()
		if progress then
			progress("Packaging cutscene, baked data and launch controls…")
		end

		local sources = {}
		local assets, seenAssets = {}, {}
		for _, entry in code do
			sources[entry.Id] = entry.Source
			for asset in entry.Source:gmatch("rbxassetid://%d+") do
				if not seenAssets[asset] then
					seenAssets[asset] = true
					table.insert(assets, asset)
				end
			end
		end


		local names = {}
		for _, object in root.Scene:GetDescendants() do
			local id = object:GetAttribute("EclipseExportId")
			if id then
				names[id] = object.Name
			end
		end

		for _, global in data.Globals do
			names[global.Id] = names[global.Id] or global.Path[#global.Path]
		end

		local rigNames, rigs, taken = {}, {}, {}

		local function label(id)
			if rigNames[id] then
				return
			end

			local base = tostring(names[id] or ("Rig" .. id)):gsub("^%s+", ""):gsub("%s+$", "")
			if base == "" then
				base = "Rig" .. id
			end

			local name = base
			local index = 2
			while taken[name] do
				name = base .. " " .. index
				index += 1
			end

			taken[name] = true
			rigNames[id] = name
			rigs[name] = id
		end

		for _, record in data.Roots do
			if record.Kind == "Actor" or record.Kind == "Camera" then
				label(record.Id)
			end
		end

		for _, event in data.Events do
			if event.Rig then
				label(event.Rig)
			end
		end

		local baked = module(root, "Baked", "return {}")
		local chunkNames = {}
		local rows = {}
		local size = 0

		local function flush()
			if #rows == 0 then
				return
			end

			local name = string.format("Chunk_%03d", #chunkNames + 1)
			module(baked, name, "return {\n\t" .. table.concat(rows, ",\n\t") .. ",\n}\n")
			table.insert(chunkNames, name)
			rows = {}
			size = 0
		end

		for _, track in data.Tracks do
			local batch = {}
			local bytes = 0

			local function part()
				local copy = table.clone(track)
				copy.Samples = batch
				local source = Codec.encode(copy, nil, 1)
				if size + #source > 180000 then
					flush()
				end

				table.insert(rows, source)
				size += #source
				batch = {}
				bytes = 0
			end

			for _, sample in track.Samples do
				local encoded = Codec.encode(sample)
				if bytes + #encoded > 90000 and #batch > 0 then
					part()
				end

				table.insert(batch, sample)
				bytes += #encoded
			end

			if #batch > 0 then
				part()
			end
		end

		flush()
		local layout = storeData(baked, {
			Bindings = data.Bindings,
			Roots = data.Roots,
			Globals = data.Globals,
			Effects = data.Effects,
			EffectCameras = data.EffectCameras,
			Geometry = data.Geometry,
			Rigs = rigs,
			Assets = assets,
			Authored = data.CameraMode ~= "Game",
			ContentLastFrame = data.ContentLastFrame,
			SkipFrames = data.SkipFrames or 0,
			GreaseDrawings = data.GreaseDrawings,
		}, "Layout")
		Editor:UpdateSourceAsync(baked, function()
			return string.format(
				[====[%s

local baked = require(%q)
local chunks = %s
local tracks = {}

baked.Tracks = {}

for _, name in chunks do
	for _, track in require(`@self/{name}`) do
		local key = `{track.Target}:{track.Kind}:{track.Property}`
		local previous = tracks[key]

		if previous then
			for _, sample in track.Samples do
				table.insert(previous.Samples, sample)
			end
		else
			tracks[key] = track
			table.insert(baked.Tracks, track)
		end
	end
end

return baked
]====],
				HEADER,
				"@self/" .. layout,
				pretty(chunkNames)
			)
		end)
		local source = cutsceneSource(options, data, data.Subtitles, data.Events, rigNames, sources)
		Editor:UpdateSourceAsync(root, function()
			return source
		end)
		assert(root.Source == source, "Cannot write cutscene entry point")
		root:SetAttribute("EclipseCutscene", 2)
		root:SetAttribute("FPS", data.FPS)
		root:SetAttribute("EndFrame", data.LastFrame)
		root:SetAttribute("RequiresEditableMesh", next(data.Geometry) ~= nil)
		local text = string.format(guide, options.Name)
		local fence = "="
		while text:find("]" .. fence .. "]", 1, true) do
			fence ..= "="
		end

		module(
			root,
			"README",
			HEADER .. "\n\n--[" .. fence .. "[\n" .. text .. "]" .. fence .. "]\n\nreturn {}\n"
		)
		if options.Mode == "Button" then
			root:SetAttribute("EclipseLaunchMode", options.Mode)
			launcherObject = handler()
			launcherObject:SetAttribute("EclipseCutsceneHandler", 1)
			launcherObject:SetAttribute("Cutscene", options.Name)
			launcherObject:SetAttribute("Mode", options.Mode)
			launcherObject:SetAttribute("ButtonLabel", options.ButtonLabel)
			launcherObject:SetAttribute("EclipseHandlerVersion", 5)
		end
	end, debug.traceback)
	if not ok then
		root:Destroy()
		if launcherObject then
			launcherObject:Destroy()
		end

		error(message, 2)
	end

	return root, launcherObject
end

local function fingerprint(text)
	local a, b = 7, 11
	for index = 1, #text do
		local byte = text:byte(index)
		a = (a * 31 + byte) % 4294967296
		b = (b * 131 + byte) % 4294967296
	end

	return string.format("%08x%08x", a, b)
end

local generatedHandlers = {
	["3a5ef365a9e42dbd"] = true,
	["c606d6ddd69c8f5d"] = true,
	["c4fa40b91bd3be65"] = true,
	["21019d6f55159673"] = true,
}

local replacedHandlers = {
	["2385fc3ce22c2b60"] = true,
	["96cccde649fe6596"] = true,
	["8f83073bbcd7000b"] = true,
	["98d9c1cd71a93c8d"] = true,
}

local function isGenerated(source)
	return generatedHandlers[fingerprint(source)] == true
end

local function isReplaceable(source)
	return replacedHandlers[fingerprint(source)] == true
end
function Package.installHandler(proposed)
	local starter = game:GetService("StarterPlayer"):FindFirstChildOfClass("StarterPlayerScripts")
	assert(starter, "StarterPlayerScripts is missing")
	local storage = game:GetService("ReplicatedStorage"):FindFirstChild("EclipseCutscenes")
	assert(storage and storage:IsA("Folder"), "EclipseCutscenes is missing")

	local existing
	local legacy = {}

	for _, object in starter:GetChildren() do
		if object:GetAttribute("EclipseCutsceneHandler") == 1 then
			assert(object:IsA("LocalScript") and not existing, "Multiple Eclipse handlers found")
			existing = object
		elseif object:IsA("LocalScript") and object:GetAttribute("EclipseCutsceneLauncher") then
			local package = storage:FindFirstChild(tostring(object:GetAttribute("Cutscene")))
			if
				package
				and package:IsA("ModuleScript")
				and package:GetAttribute("EclipseCutscene") == 1
			then
				assert(
					isGenerated(object.Source),
					"The handler "
						.. object.Name
						.. " has custom edits. Keep a copy and remove it from StarterPlayerScripts before consolidating."
				)
				table.insert(legacy, {
					script = object,
					package = package,
					source = object.Source,
					enabled = object.Enabled,
				})
			end
		end
	end

	local replaced = existing
			and isReplaceable(existing.Source)
			and existing
		or nil
	local replacedEnabled = replaced and replaced.Enabled
	if replaced then
		existing = nil
	end

	local target = existing
		or proposed
		or handler()
	if not existing then
		target.Name = "EclipseCutsceneHandler"
		target:SetAttribute("EclipseCutsceneHandler", 1)
		target:SetAttribute("EclipseHandlerVersion", 5)
		target:SetAttribute("Cutscene", nil)
		target:SetAttribute("Mode", nil)
		target:SetAttribute("Command", nil)
		target:SetAttribute("ButtonLabel", nil)
	end

	local backup
	local configs = {}
	local attributes = {}
	local moved = {}
	local ok, message = xpcall(function()
		for _, record in legacy do
			local object = record.script
			assert(
				object.Source == record.source and object.Parent == starter,
				"Legacy handler changed during migration"
			)
			if not record.package:FindFirstChild("Launch") then
				local config = module(record.package, "Launch", "return " .. Codec.encode({
					Mode = object:GetAttribute("Mode"),
					ButtonLabel = object:GetAttribute("ButtonLabel"),
					Command = object:GetAttribute("Command"),
				}))
				table.insert(configs, config)
				table.insert(attributes, {
					package = record.package,
					mode = record.package:GetAttribute("EclipseLaunchMode"),
					command = record.package:GetAttribute("EclipseCommand"),
				})
				record.package:SetAttribute("EclipseLaunchMode", object:GetAttribute("Mode"))
				record.package:SetAttribute("EclipseCommand", object:GetAttribute("Command"))
			end
		end

		if #legacy > 0 or replaced then
			backup = Instance.new("Folder")

			backup.Name =
				unique(game:GetService("ServerStorage"), "Eclipse Cutscene Handler Backups")
			backup:SetAttribute("EclipseHandlerBackup", true)
			backup.Parent = game:GetService("ServerStorage")
		end

		for _, record in legacy do
			table.insert(moved, record)
			record.script.Enabled = false
			record.script.Parent = backup
		end

		if replaced then
			assert(
				replaced.Parent == starter and isReplaceable(replaced.Source),
				"Shared handler changed during upgrade"
			)
			replaced.Enabled = false
			replaced.Parent = backup
		end

		if not existing then
			target.Parent = starter
		end
	end, debug.traceback)

	if not ok then
		if replaced and replaced.Parent == backup then
			replaced.Parent = starter
			replaced.Enabled = replacedEnabled
		end

		for _, record in moved do
			record.script.Parent = starter
			record.script.Enabled = record.enabled
		end

		for _, config in configs do
			config:Destroy()
		end

		for _, record in attributes do
			record.package:SetAttribute("EclipseLaunchMode", record.mode)
			record.package:SetAttribute("EclipseCommand", record.command)
		end

		if backup then
			backup:Destroy()
		end

		if not existing then
			target:Destroy()
		end

		error(message, 2)
	end

	if proposed and proposed ~= target then
		proposed:Destroy()
	end

	return target, #moved
end

function Package.install(root, proposed)
	local storage = game:GetService("ReplicatedStorage")
	local folder = storage:FindFirstChild("EclipseCutscenes")
	assert(
		not folder or folder:IsA("Folder"),
		"ReplicatedStorage.EclipseCutscenes must be a Folder"
	)
	assert(
		not folder or not folder:FindFirstChild(root.Name),
		"An export named " .. root.Name .. " already exists. Choose another name to preserve it."
	)

	local created
	local handler
	local ok, message = xpcall(function()
		if not folder then
			folder = Instance.new("Folder")

			folder.Name = "EclipseCutscenes"
			folder.Parent = storage
			created = folder
		end

		Package.installRuntime(folder)
		root.Parent = folder
		if proposed then
			handler = Package.installHandler(proposed)
		end
	end, debug.traceback)

	if not ok then
		root.Parent = nil
		if created then
			created:Destroy()
		end

		error(message, 2)
	end

	return root, handler
end

return Package
