        <Item class="ModuleScript" referent="2146">
          <Properties>
            <string name="Name">RotationInput</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000029005</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{5A68B059-7D50-4B16-A24A-1E1D15BFE119}</string>
