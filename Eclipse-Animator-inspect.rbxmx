        <Item class="ModuleScript" referent="2005">
          <Properties>
            <string name="Name">PropertySettings</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f78</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{4B733FFE-F4B1-4F5F-B5CA-6900364845A0}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local Events = require("Events")
local Faces = require("Faces")
local Playback = require("EventPlayback")

local CameraRig = require("CameraRig")
local Tracks = require("Properties")
local PartRig = require("PartRig")
local Tool = require("Tool")
local History = require("History")
local Theme = require("Theme")
local Notification = require("Notification")
local Edit = require("BlenderEdit")
local Settings = {}
local refs, window, owner
local unsubscribe

function Settings.close()
	if unsubscribe then
		unsubscribe()
		unsubscribe = nil
	end

	owner = nil
	if window then
		local old = window
		window = nil
		old:close()
	end
end

function Settings.recordSelected()
	if not refs or not refs.Active() or Edit.blocked() then
		return 0
	end

	local motors = {}
	for item in refs.State.Rig._selectedItems do
		local motor = item:fetchMotor()
		if Tracks.is(motor) then
			table.insert(motors, motor)
		end
	end

	if #motors == 0 then
		return 0
	end

	local timeline = refs.State.Timeline
	local raw = timeline:GetState()
	local before, after = {}, {}
	for _, motor in motors do
		before[motor] = timeline:_snapshotMotorBucket(motor)
		local value = Tracks.readValue(motor.Rig, motor.PropertyId)
		timeline:RecordKeyframeForMotorAtCurrentTime(
			motor.Part1,
			motor,
			Tracks.encode(value),
			{ PropertyValue = value },
			refs.State.UIHelpers.SanitizeName
		)
		after[motor] = timeline:_snapshotMotorBucket(motor)
	end

	local function apply(data)
		for motor, bucket in data do
			timeline:_restoreMotorBucket(motor, bucket)
		end

		for _, rig in refs.State.getAllRigs() do
			timeline:ApplyPoseAtTime(rig, raw.CurrentTime, { OnlyRig = true })
		end

		refs.State.currentProjectSaved = false
	end

	refs.State.currentProjectSaved = false
	History.record(function()
		apply(before)
	end, function()
		apply(after)
	end, "Record properties")
	return #motors
end

local function addKey(motor, firstFree)
	if
		not refs
		or not refs.Active()
		or Edit.blocked()
		or not Tracks.is(motor)
		or not motor.Parent
		or not Tracks.enabled(motor.Rig, motor.PropertyId)
	then
		return
	end

	refs.Finalize()
	local timeline = refs.State.Timeline
	local raw = timeline:GetState()
	local frame = math.max(0, timeline:TimeToFrame(raw.CurrentTime))
	local bucket = raw.Keyframes[motor] or {}
	while firstFree and bucket[frame] do
		frame += 1
	end

	local value = Tracks.readValue(motor.Rig, motor.PropertyId)
	local before = timeline:_snapshotMotorBucket(motor)
	timeline:EnsureTimelineEnd(frame)
	timeline:RecordKeyframeForMotorAtCurrentTime(
		motor.Part1,
		motor,
		Tracks.encode(value),
		{ Frame = frame, PropertyValue = value },
		refs.State.UIHelpers.SanitizeName
	)
	local after = timeline:_snapshotMotorBucket(motor)

	local function apply(data)
		if not motor.Parent then
			return
		end

		timeline:_restoreMotorBucket(motor, data)
		timeline:ApplyPoseAtTime(motor.Rig, raw.CurrentTime, { OnlyRig = true })
		refs.State.currentProjectSaved = false
	end

	refs.State.currentProjectSaved = false
	History.record(function()
		apply(before)
	end, function()
		apply(after)
	end, "Add " .. motor.PropertyId .. " key")
	return frame
end

function Settings.addFirstFreeKey(motor)
	return addKey(motor, true)
end

function Settings.addAtCurrentTime(motor)
	return addKey(motor, false)
end

function Settings.setEnabled(rig, id, enabled)
	assert(not Edit.blocked(), "Finish the current edit before changing properties")
	refs.Finalize()
	local timeline = refs.State.Timeline
	local raw = timeline:GetState()
	local before = Tracks.snapshot(rig, raw, true)
	Tracks.enable(rig, id, enabled, raw)
	local after = Tracks.snapshot(rig, raw, true)

	local function apply(data)
		Tracks.restore(rig, data, timeline, refs.State.UIHelpers.SanitizeName)
		refs.RefreshStructure()
		timeline:ApplyPoseAtTime(rig, raw.CurrentTime, { OnlyRig = true })
		refs.State.currentProjectSaved = false
	end

	apply(after)
	History.record(function()
		apply(before)
	end, function()
		apply(after)
	end, "Toggle " .. id .. " property")
end

function Settings.setTrackEnabled(rig, id, enabled)
	assert(id == "Events" or id == "Faces", "Unknown item track")
	refs.Finalize()
	local track = Events.get(rig)
	local before = Events.snapshot(track)
	local field = id == "Events" and "Enabled" or "FacesEnabled"
	local after = Events.snapshot(track)
	after[field] = enabled ~= false

	local function apply(value)
		Events.restore(track, value)
		if id == "Events" then
			Playback.disable()
		end

		refs.RefreshStructure()
		refs.State.Timeline:ApplyPoseAtTime(rig, refs.State.Timeline:GetState().CurrentTime)
	end

	apply(after)
	History.record(function()
		apply(before)
	end, function()
		apply(after)
	end, "Toggle " .. id)
end

function Settings.setPartTracks(rig, enabled)
	assert(not Edit.blocked(), "Finish the current edit first")
	refs.Finalize()
	local before = rig:GetAttribute("EclipseIndividualParts")

	local function apply(value)
		rig:SetAttribute("EclipseIndividualParts", value)
		refs.RefreshStructure()
		refs.State.currentProjectSaved = false
	end

	apply(enabled)
	History.record(function()
		apply(before)
	end, function()
		apply(enabled)
	end, "Toggle individual parts")
end

function Settings.open(rig)
	if not refs or not refs.Active() or not table.find(refs.State.getAllRigs(), rig) then
		return
	end

	Settings.close()
	owner = rig
	local camera = CameraRig.isRig(rig)
	local definitions = camera
			and {
				{ id = "EclipseTrackTarget", label = "Track CamTarget" },
				{ id = "EclipseHideCamTarget", label = "Hide CamTarget" },
			}
		or Tracks.catalog(rig)
	for i = #definitions, 1, -1 do
		if definitions[i].hidden then
			table.remove(definitions, i)
		end
	end

	table.insert(definitions, 1, { id = "Events", label = "Events" })
	if Faces.supports(rig) then
		table.insert(definitions, 2, { id = "Faces", label = "Faces" })
	end

	local trackCount = Faces.supports(rig) and 2 or 1
	if PartRig.supports(rig) then
		trackCount += 1
		table.insert(
			definitions,
			trackCount,
			{ id = "IndividualParts", label = "Individual parts" }
		)
	end

	local hasProperties = #definitions > trackCount
	local height = 116
		+ math.clamp(#definitions, 1, 9) * 27
		+ 22
		+ (hasProperties and 32 or 0)
		+ (camera and 60 or 0)
	window = Tool.new(
		refs,
		"EclipseItemSettings",
		"ITEM SETTINGS",
		Vector2.new(290, height),
		false,

		function()
			if unsubscribe then
				unsubscribe()
				unsubscribe = nil
			end

			window = nil
			owner = nil
		end
	)
	local frame = window.frame
	local title =
		Tool.label(frame, "Item", rig.Name, UDim2.fromOffset(12, 33), UDim2.new(1, -24, 0, 21))
	title.TextWrapped = false
	title.TextTruncate = Enum.TextTruncate.AtEnd
	local divider = Tool.make("Frame", frame, "Divider", {
		Position = UDim2.fromOffset(12, 61),
		Size = UDim2.new(1, -24, 0, 1),
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromRGB(69, 41, 93),
	})
	divider:SetAttribute("ThemeBg", "Strk")
	local list = Tool.make("ScrollingFrame", frame, "Properties", {
		Position = UDim2.fromOffset(12, 68),
		Size = UDim2.new(1, -24, 1, camera and -176 or -116),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3,
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
	})
	Tool.make(
		"UIListLayout",
		list,
		"Rows",
		{ Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }
	)
	if #definitions == 0 then
		Tool.label(
			list,
			"Empty",
			"No additional properties",
			UDim2.fromOffset(0, 0),
			UDim2.new(1, 0, 0, 24)
		)
	end

	local function section(name, order)
		local header = Tool.make(
			"Frame",
			list,
			name .. "Section",
			{ Size = UDim2.new(1, -6, 0, 20), BackgroundTransparency = 1, LayoutOrder = order }
		)
		local label = Tool.label(
			header,
			"Title",
			string.upper(name),
			UDim2.fromOffset(1, 0),
			UDim2.new(1, 0, 1, 0)
		)
		label.TextSize = 10
		label.TextTransparency = 0.35
	end

	section("Tracks", 0)
	if hasProperties then
		local divider = Tool.make("Frame", list, "PropertyDivider", {
			Size = UDim2.new(1, -6, 0, 1),
			BorderSizePixel = 0,
			LayoutOrder = trackCount * 10 + 1,
		})
		divider:SetAttribute("ThemeBg", "Strk")
		section(camera and "Camera target" or "Properties", trackCount * 10 + 2)
	end

	local rows = {}

	local function refresh()
		for id, row in rows do
			local enabled = id == "Events" and Events.get(rig).Enabled ~= false
				or id == "Faces" and Events.get(rig).FacesEnabled == true
				or id ~= "Events"
					and id ~= "Faces"
					and (camera and rig:GetAttribute(id) == true or not camera and Tracks.enabled(
						rig,
						id
					))
			local checked = id == "IndividualParts"
					and PartRig.enabled(rig, refs.State.Timeline:GetState())
				or id ~= "IndividualParts" and enabled
			row.check.Visible = checked
			row.label.TextTransparency = checked and 0 or 0.2
		end
	end

	for index, def in definitions do
		local button = Tool.make("TextButton", list, def.id, {
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			BackgroundColor3 = Color3.fromRGB(51, 0, 77),
			Size = UDim2.new(1, -6, 0, 24),
			LayoutOrder = index * 10,
		})
		local box = Tool.make("Frame", button, "Checkbox", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 1, 0.5, 0),
			Size = UDim2.fromOffset(16, 16),
			BorderSizePixel = 0,
			BackgroundColor3 = Color3.fromRGB(51, 0, 77),
		})
		box:SetAttribute("ThemeBg", "TopBtn")
		local stroke = Tool.make("UIStroke", box, "Outline", {
			Color = Color3.fromRGB(69, 41, 93),
			Thickness = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		})
		stroke:SetAttribute("ThemeStrk", "Strk")
		local check =
			Tool.label(box, "Check", "✓", UDim2.fromOffset(0, -1), UDim2.fromScale(1, 1))
		check.TextXAlignment = Enum.TextXAlignment.Center
		check.TextSize = 14
		if def.id == "Events" or def.id == "Faces" then
			local icon = Tool.make("ImageLabel", button, "Icon", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(26, 4),
				Size = UDim2.fromOffset(16, 16),
				Image = def.id == "Faces" and Faces.ICON or "",
				ImageColor3 = Theme.get("Txt", Color3.new(1, 1, 1)),
			})
			if def.id == "Events" then
				require("EventIcons").attach(icon, "track")
			else
				Faces.attach(icon)
			end
		end

		local label =
			Tool.label(button, "Label", def.label, UDim2.fromOffset(26, 0), UDim2.new(1, -26, 1, 0))
		label.TextWrapped = false
		if def.id == "Events" or def.id == "Faces" then
			label.Position = UDim2.fromOffset(48, 0)
			label.Size = UDim2.new(1, -48, 1, 0)
		end

		rows[def.id] = { check = check, label = label }
		button.MouseEnter:Connect(function()
			button.BackgroundTransparency = 0.5
		end)
		button.MouseLeave:Connect(function()
			button.BackgroundTransparency = 1
		end)
		button:SetAttribute("ThemeBg", "TopBtn")
		button.Activated:Connect(function()
			if Tracks.required(rig, def.id) then
				return
			end

			if not rig.Parent or not table.find(refs.State.getAllRigs(), rig) then
				Settings.close()
				return
			end

			local ok, err
			if def.id == "Events" or def.id == "Faces" then
				local track = Events.get(rig)
				local value = if def.id == "Events" then track.Enabled else track.FacesEnabled
				ok, err = pcall(Settings.setTrackEnabled, rig, def.id, value == false)
			elseif def.id == "IndividualParts" then
				ok, err = pcall(function()
					Settings.close()
					require("PartRigging").open(rig)
				end)
			elseif camera then
				ok, err = pcall(
					require("Targets").setOption,
					rig,
					def.id,
					rig:GetAttribute(def.id) ~= true
				)
			else
				ok, err = pcall(Settings.setEnabled, rig, def.id, not Tracks.enabled(rig, def.id))
			end

			if ok then
				refresh()
			else
				Notification.show("PROPERTY", (tostring(err):gsub("^.-:%d+: ", "")))
			end
		end)
	end

	refresh()
	unsubscribe = History.subscribe(function()
		if owner ~= rig then
			return
		end

		if not rig.Parent or not table.find(refs.State.getAllRigs(), rig) then
			Settings.close()
			return
		end

		refresh()
	end)
	if camera then
		Tool.button(
			frame,
			"AttachToPart",
			"ATTACH TO PART…",
			UDim2.new(0, 12, 1, -96),
			UDim2.new(1, -24, 0, 24),

			function()
				Settings.close()
				require("Targets").openCameraAttachment(rig)
			end
		)
	end

	if camera then
		Tool.button(
			frame,
			"ParentTarget",
			"PARENT AT CURRENT FRAME…",
			UDim2.new(0, 12, 1, -66),
			UDim2.new(1, -24, 0, 24),

			function()
				Settings.close()
				require("Targets").openParent(rig)
			end
		)
	end

	local button, label = Tool.button(
		frame,
		"DeleteRig",
		"REMOVE FROM ANIMATION",
		UDim2.new(0, 12, 1, -36),
		UDim2.new(1, -24, 0, 24),

		function()
			Settings.close()
			refs.Remove(rig)
		end
	)
	label:SetAttribute("ThemeTxt", nil)
	label.TextColor3 = Color3.fromRGB(245, 135, 148)
	Theme.applyTree(frame)
end

function Settings.init(options)
	refs = options
	require("Targets").init(options)
	options.State.PropertySettings = Settings
	options.ScreenGui.Destroying:Once(Settings.close)
	options.Plugin.Unloading:Once(Settings.close)
	options.AnimatorFrame:GetPropertyChangedSignal("Visible"):Connect(function()
		if not options.AnimatorFrame.Visible then
			Settings.close()
		end
	end)
end

return Settings
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a41f</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2006">
          <Properties>
            <string name="Name">PropertyEditing</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f79</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{1B750F3C-00C6-4E6D-BC0E-5188B03C8689}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)
local Preferences = require("Preferences")
local PropertyGizmo = require("PropertyGizmo")
local Tracks = require("Properties")
local Policy = require("Policy")
local Edit = require("BlenderEdit")
local Armature = require("ArmatureRuntime")
local History = require("History")
local Notification = require("Notification")
local Scale = {}
local refs, selected, active = nil, nil, false
local selecting = false

function Scale.isActive()
	return active and Preferences.get("ScaleGizmo") ~= false
end

local function adapter(motor)
	if not motor or not motor.Parent or Tracks.is(motor) then
		return nil
	end

	local part = motor.Part1
	if
		typeof(part) ~= "Instance"
		or not part:IsA("BasePart")
		or not Policy.channelAvailable(motor, "scale_x")
	then
		return nil
	end

	if typeof(motor) == "table" and (motor.IsEclipseMasterControl or motor.IsTranslationOnly) then
		return nil
	end

	local state = refs.State
	local timeline, rig = state.Timeline, state.currentRig
	local raw = timeline:GetState()
	local base = raw.DefaultSize[part]
	if not base then
		return nil
	end

	local armature = typeof(motor) == "table" and motor.IsEclipseArmatureControl
	local target = {
		IsEclipseScaleAdapter = true,
		Parent = part.Parent,
		Rig = part,
		Part1 = part,
		PropertyId = "Size",
		DefaultValue = base * (armature and 1 or Tracks.scaleFactor(motor)),
	}

	function target.read()
		return armature and (motor.InputScale or Vector3.one) * base or part.Size
	end

	function target.capture()
		return {
			c0 = motor.C0,
			cf = part.CFrame,
			edit = armature and Armature.captureEdit(motor) or nil,
			bucket = timeline:_snapshotMotorBucket(motor),
		}
	end

	function target.write(value, saved, offset)
		if not part.Parent or not motor.Parent then
			return
		end

		local placement = saved and saved.placement
		if armature then
			motor.InputScale = Armature.constrainScale(motor, value / base)
			if placement and placement.edit then
				motor.C0 = placement.c0
				Armature.evaluate(rig, true)
				local shift = placement.cf.Position + (offset or Vector3.zero) - part.Position
				motor.C0 = Armature.solveEditC0(motor, placement.edit.world + shift, placement.edit)
			end

			Armature.evaluate(rig, true)
		else
			part.Size = value
			if placement then
				local shift = offset or Vector3.zero
				motor.C0 = placement.c0 + motor.Part0.CFrame:VectorToObjectSpace(shift)
				part.CFrame = placement.cf + shift
			end
		end
	end

	function target.finish(saved, cancel)
		if not part.Parent or not motor.Parent then
			return
		end

		local value = target.read()
		local pose = target.capture()
		local original = saved.placement or pose

		local function restorePose(size, placement)
			target.write(size)
			motor.C0 = placement.c0
			if armature then
				if placement.edit then
					Armature.restoreEdit(motor, placement.edit)
				end

				Armature.evaluate(rig, true)
			else
				part.CFrame = placement.cf
			end

			require("Resize").syncBones(state, part)
		end

		if cancel then
			restorePose(saved.value, original)
			return
		end

		if (value - saved.value).Magnitude < 1e-6 and pose.c0 == original.c0 then
			return
		end

		require("HumanoidScale").changed(motor)
		if timeline:IsRecording() then
			local before = original.bucket or timeline:_snapshotMotorBucket(motor)
			local channels = { "scale_x", "scale_y", "scale_z" }
			if pose.c0 ~= original.c0 then
				for _, id in { "loc_x", "loc_y", "loc_z" } do
					table.insert(channels, id)
				end
			end

			timeline:RecordPartialKeyframeForMotorAtCurrentTime(
				part,
				motor,
				motor.C0,
				channels,
				state.UIHelpers.SanitizeName,
				{ Frame = saved.frame }
			)
			local after = timeline:_snapshotMotorBucket(motor)

			local function restore(bucket)
				if not motor.Parent then
					return
				end

				timeline:_restoreMotorBucket(motor, bucket)
				timeline:ApplyPoseAtTime(rig, raw.CurrentTime, { OnlyRig = true })
				state.currentProjectSaved = false
			end

			History.record(function()
				restore(before)
			end, function()
				restore(after)
			end, "Scale " .. part.Name, saved.frame)
		else
			local function restore(size, placement)
				restorePose(size, placement)
				state.currentProjectSaved = false
			end

			History.record(function() end, function() end, "Scale " .. part.Name, {
				afterUndo = function()
					restore(saved.value, original)
				end,
				afterRedo = function()
					restore(value, pose)
				end,
			})
		end

		state.currentProjectSaved = false
		state.lastCFrames[motor] = motor.C0
	end

	return target
end

local function show()
	if not Scale.isActive() then
		PropertyGizmo.select(selected)
		return false
	end

	local target
	local part = selected and (Tracks.is(selected) and selected.Rig or selected.Part1)
	local mesh = typeof(part) == "Instance"
		and part:IsA("BasePart")
		and part:FindFirstChildWhichIsA("DataModelMesh")
	if mesh and Tracks.definition(mesh, "Scale") then
		local project = refs.State.currentRig

		selecting = true
		local ok, err = xpcall(function()
			if not table.find(refs.State.getAllRigs(), mesh) then
				refs.AddRig(mesh, { Loading = true, MeshScaleTarget = true })
			end

			if not table.find(refs.State.getAllRigs(), mesh) then
				return
			end

			target = Tracks.enable(mesh, "Scale", true, refs.State.Timeline:GetState())
			require("Resize").prepare(mesh)
			if not active or refs.State.currentRig ~= project or not mesh.Parent then
				target = nil
				return
			end

			if refs.RefreshStructure then
				refs.RefreshStructure()
			end
		end, debug.traceback)
		selecting = false
		if not ok then
			error(err)
		end
	elseif
		Tracks.is(selected)
		and (
			selected.Rig:IsA("BasePart")
			or selected.Rig:IsA("Model")
			or selected.Rig:IsA("DataModelMesh")
		)
	then
		local id = selected.Rig:IsA("BasePart") and "Size" or "Scale"
		local enabled = Tracks.enabled(selected.Rig, id)
		target = Tracks.enable(selected.Rig, id, true, refs.State.Timeline:GetState())
		if not enabled then
			refs.State.currentProjectSaved = false
			if refs.RefreshStructure then
				refs.RefreshStructure()
			end
		end

		if selected.Rig:IsA("DataModelMesh") then
			require("Resize").prepare(selected.Rig)
		end
	else
		target = adapter(selected)
	end

	if not active then
		target = nil
	end

	PropertyGizmo.select(target)
	refs.State.Axis:RefreshAxis()
	return target ~= nil
end

function Scale.select(motor)
	if selecting then
		return
	end

	if selected == motor then
		if not active then
			PropertyGizmo.select(motor)
		end

		return
	end

	selected = motor
	show()
end

function Scale.disable()
	if not active then
		return
	end

	PropertyGizmo.finish(false)
	active = false
	PropertyGizmo.select(selected)
	refs.State.Axis:RefreshAxis()
end

function Scale.clear()
	PropertyGizmo.finish(true)
	selected, active = nil, false
	PropertyGizmo.select(nil)
end

function Scale.start()
	if not refs or Preferences.get("ScaleGizmo") == false then
		return false
	end

	if PropertyGizmo.isEditing() then
		PropertyGizmo.finish(true)
		return false
	end

	if refs.State.Timeline:GetState().Playing or refs.State.PhysicsSimulating or Edit.blocked() then
		return false
	end

	refs.Finalize()
	active = true
	if not show() then
		Scale.disable()
		Notification.show("SCALE", "Select a rig limb, mesh part or imported armature control.")
		return false
	end

	return PropertyGizmo.begin("pointer")
end

function Scale.reset()
	if
		not refs
		or not selected
		or not selected.Parent
		or PropertyGizmo.isEditing()
		or refs.State.Timeline:GetState().Playing
		or refs.State.PhysicsSimulating
		or Edit.blocked()
	then
		return false
	end

	refs.Finalize()
	local wasActive = active
	active = true
	local ok, result = xpcall(function()
		return show() and PropertyGizmo.reset()
	end, debug.traceback)
	active = wasActive
	if not active then
		PropertyGizmo.select(selected)
		refs.State.Axis:RefreshAxis()
	end

	if not ok then
		error(result, 0)
	end

	return result
end

function Scale.toggle()
	if not refs or Preferences.get("ScaleGizmo") == false then
		return
	end

	if active then
		Scale.disable()
		return
	end

	if refs.State.Timeline:GetState().Playing or refs.State.PhysicsSimulating or Edit.blocked() then
		return
	end

	refs.Finalize()
	active = true
	if not show() then
		Scale.disable()
		Notification.show(
			"SIZING GIZMO",
			"Select a rig limb, mesh part or imported armature control."
		)
	end
end

function Scale.init(options)
	refs, selected, active = options, nil, false
	options.State.ScaleGizmo = Scale
	local unsubscribe = Preferences.subscribe(function(key, value)
		if key == "ScaleGizmo" and value == false then
			Scale.disable()
		end
	end)
	options.ScreenGui.Destroying:Once(unsubscribe)
end

return Scale
]]></string>
