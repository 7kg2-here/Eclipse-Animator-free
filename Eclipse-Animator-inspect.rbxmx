          <Properties>
            <string name="Name">Bridge</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f73</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{4AF1C062-9415-4BB2-A73E-697C704EE475}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local Http = game:GetService("HttpService")
local Theme = require("Theme")
local Video = {}
local URL = "http://127.0.0.1:49185"

local listeners = {}
local refs, session, token, response
local accessError
local connected, enabled, busy, closed = false, true, false, true
local ownsSession = false
local companionVersion
local sequence, offset, bestRoundTrip = 0, 0, math.huge
local lastHello = 0
local reconnectDelay = 2
local authFailed = false
local lastStart
local themeDirty = true
local unsubscribe
local nextSend = 0
local lastSend, lastPushPosition = 0, nil
local handled = 0
local receiveControl
local generation = 0
local lifetime = {}
local pendingCommand

local function active()
	return refs
		and refs.ScreenGui.Enabled
		and (
			refs.AnimatorFrame.Visible
			or refs.State.CameraPreview and refs.State.CameraPreview.isFull()
		)
end

local function changed()
	for callback in listeners do
		callback()
	end
end

local function request(path, body)
	local requestGeneration = generation
	local began = os.clock()
	local headers = {}
	if body then
		headers["Content-Type"] = "application/json"
		headers["X-Eclipse-Token"] = token
	end

	local ok, result = pcall(Http.RequestAsync, Http, {
		Url = URL .. path,
		Method = body and "POST" or "GET",
		Headers = headers,
		Body = body and Http:JSONEncode(body) or nil,
	})
	if requestGeneration ~= generation then
		return nil
	end

	if not ok or not result.Success then
		if not ok then
			accessError = not Http.HttpEnabled
					and "Enable HTTP Requests in Studio's Experience Settings to connect Eclipse Video."
				or "Cannot reach Eclipse Video on this computer. Open the companion and check its local connection."
		end

		if ok and (result.StatusCode == 403 or result.StatusCode == 401) then
			accessError = "The companion rejected the connection. Update the companion and reconnect."
			local parsed, data = pcall(Http.JSONDecode, Http, result.Body)
			if parsed and typeof(data) == "table" and typeof(data.error) == "string" then
				accessError = data.error
			end
		end

		connected = false
		response = nil
		changed()
		return nil
	end

	local parsed, data = pcall(Http.JSONDecode, Http, result.Body)
	if not parsed or typeof(data) ~= "table" then
		connected = false
		return nil
	end

	local elapsed = os.clock() - began

	if path == "/hello" and typeof(data.now) == "number" then
		if elapsed <= bestRoundTrip * 1.5 or elapsed < 0.01 then
			offset = data.now - (began + elapsed * 0.5)
		end

		bestRoundTrip = math.min(bestRoundTrip, elapsed)
	end

	return data
end

local function hello()
	lastHello = os.clock()
	authFailed = false
	local data = request("/hello")
	if not data or data.app ~= "Eclipse Video" or data.protocol ~= 1 then
		connected = false
		ownsSession = false
		return false
	end

	if token ~= data.token then
		connected = false
		ownsSession = false
		handled = 0
		bestRoundTrip = math.huge
		themeDirty = true
	end

	token = data.token
	companionVersion = data.version
	if data.authorization == 1 then
		accessError = "This companion needs an update for this Eclipse build."
		connected = false
		authFailed = true
		return false
	end
	accessError = nil

	return typeof(token) == "string"
end

local function state(action, timeline, position)
	sequence += 1
	local current = timeline and timeline:GetState()
	local data = {
		action = action,
		session = session,
		seq = sequence,
		ack = handled,
		controllable = timeline ~= nil and active(),
		at = os.clock() + offset,
		position = position or current and current.CurrentTime or 0,
		playing = current and current.Playing and not timeline._playbackPreparation or false,
		preparing = current and current.Playing and timeline._playbackPreparation ~= nil or false,
		fps = current and current.FPS or 60,
		endTime = timeline and timeline:GetPlaybackEndTime() or 0,
		loop = timeline and timeline:IsLooping() or false,
	}
	if action == "state" and data.playing then
		local sampled = timeline._playbackReadyAt or timeline._videoSampleAt
		if sampled then
			data.at = sampled + offset
		end
	end

	if themeDirty then
		data.theme = Theme.videoPalette()
		themeDirty = false
	end

	return data
end

local function send(data)
	lastSend = os.clock()
	local result = request("/command", data)
	if result and not closed and data.session == session then
		response = result
		connected = not result.error
		ownsSession = connected and data.action ~= "disconnect"
		if receiveControl then
			receiveControl(result.control)
		end

		changed()
	end

	return result
end

receiveControl = function(control)
	if closed or not enabled or typeof(control) ~= "table" then
		return
	end

	local id = control.id
	if typeof(id) ~= "number" or id ~= id or id % 1 ~= 0 or id <= handled or id > 2 ^ 53 then
		return
	end

	handled = id
	local timeline = refs.State.Timeline
	if not timeline or not active() or timeline:IsExportLocked() then
		return
	end

	local current = timeline:GetState()
	if control.action == "play" then
		task.defer(function()
			while timeline._playbackPreparation and not closed and handled == id do
				task.wait()
			end

			if closed or not enabled or handled ~= id or refs.State.Timeline ~= timeline then
				return
			end

			if not active() or timeline:IsExportLocked() then
				return
			end

			timeline:StartPlayback(true)
		end)
	elseif control.action == "pause" or control.action == "seek" then
		current.Playing = false
		if
			control.action == "seek"
			and typeof(control.position) == "number"
			and control.position == control.position
		then
			current.CurrentTime = math.clamp(control.position, 0, timeline:GetPlaybackEndTime())
			local rig = timeline.refs.GetCurrentRig and timeline.refs.GetCurrentRig()
			if rig then
				timeline:ApplyPoseAtTime(rig, current.CurrentTime)
			end

			timeline:UpdatePlayhead()
		end
	end

	nextSend = 0
end

function Video.status()
	return {
		connected = connected,
		enabled = enabled,
		version = companionVersion,
		file = response and response.file or "",
		ready = response and response.ready or false,
		drift = response and response.driftMs or 0,
		error = accessError or response and response.error,
	}
end

function Video.subscribe(callback)
	listeners[callback] = true
	return function()
		listeners[callback] = nil
	end
end

function Video.setEnabled(value)
	enabled = value
	if not enabled then
		lastStart = nil
	end

	refs.Plugin:SetSetting("EclipseVideoSync", enabled)
	if not enabled and connected then
		pendingCommand = state("disconnect", refs.State.Timeline)
	end

	nextSend = 0
	changed()
end

function Video.prepare(timeline, position, isCurrent)
	if
		not enabled
		or not connected
		or not response
		or not response.ready
		or response.sync == false
		or not isCurrent()
	then
		return nil
	end

	local trip = bestRoundTrip < 1 and bestRoundTrip or 0.03
	local deadline = os.clock() + math.clamp(trip * 1.5 + 0.02, 0.035, 0.12)
	local command = state("start", timeline, position)
	command.deadline = deadline + offset
	command.playing = true
	command.preparing = false
	local marker = {}
	lastStart = marker
	pendingCommand = command
	nextSend = 0
	return deadline
end

function Video.push(urgent)
	if closed or not enabled then
		return
	end

	local timeline = refs.State.Timeline
	local current = timeline and timeline:GetState()
	if lastStart and current and not current.Playing then
		lastStart = nil
		local command = state("stop", timeline)
		pendingCommand = command
		nextSend = 0
	end

	if urgent and current and lastPushPosition ~= current.CurrentTime then
		lastPushPosition = current.CurrentTime
		nextSend = math.min(nextSend, lastSend + 0.04)
	end
end

function Video.destroy()
	if closed then
		return
	end

	closed = true
	for _, connection in lifetime do
		connection:Disconnect()
	end

	table.clear(lifetime)
	generation += 1
	pendingCommand = nil
	lastStart = nil
	if unsubscribe then
		unsubscribe()
		unsubscribe = nil
	end

	if ownsSession then
		local command = state("disconnect", refs.State.Timeline)
		local savedToken = token
		task.spawn(function()
			pcall(Http.RequestAsync, Http, {
				Url = URL .. "/command",
				Method = "POST",
				Headers = {
					["Content-Type"] = "application/json",
					["X-Eclipse-Token"] = savedToken,
				},
				Body = Http:JSONEncode(command),
			})
		end)
	end

	connected = false
	ownsSession = false
	changed()
end

function Video.init(options)
	Video.destroy()
	refs = options
	session = Http:GenerateGUID(false)
	handled = 0
	lastStart = nil
	closed = false
	generation += 1
	local currentGeneration = generation
	busy = false
	pendingCommand = nil
	token = nil
	response = nil
	ownsSession = false
	companionVersion = nil
	sequence = 0
	nextSend = 0
	bestRoundTrip = math.huge
	enabled = true
	reconnectDelay = 2
	accessError = nil
	refs.State.VideoBridge = Video
	unsubscribe = Theme.onChanged(function()
		themeDirty = true
		nextSend = 0
	end)
	table.insert(lifetime, refs.Plugin.Unloading:Once(Video.destroy))
	table.insert(lifetime, refs.ScreenGui.Destroying:Once(Video.destroy))
	task.spawn(function()
		while not closed and currentGeneration == generation do
			local now = os.clock()
			if not enabled or not active() then
				if ownsSession then
					send(state("disconnect", refs.State.Timeline))
					ownsSession = false
				end
				if connected or response then
					connected = false
					response = nil
					ownsSession = false
					accessError = nil
					changed()
				end
				pendingCommand = nil
				lastStart = nil
				nextSend = 0
				task.wait(0.1)
				continue
			end
			if (enabled or pendingCommand) and not busy and now >= nextSend then
				busy = true
				nextSend = math.huge
				local available = connected
				if not connected or now - lastHello > 4 then
					available = hello()
				end

				if currentGeneration ~= generation then
					return
				end

				if available then
					local timeline = refs.State.Timeline
					local data = pendingCommand or state("state", timeline)
					pendingCommand = nil
					if not active() then
						data.playing = false
						data.preparing = false
					end

					send(data)
				end

				if currentGeneration ~= generation then
					return
				end

				busy = false
				reconnectDelay = connected and 2 or authFailed and 10 or 3
				nextSend = pendingCommand and 0
					or math.min(
						nextSend,
						os.clock() + (connected and (active() and 0.2 or 1) or reconnectDelay)
					)
			end

			task.wait(0.015)
		end
	end)
end

return Video
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a41a</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2001">
          <Properties>
            <string name="Name">History</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f74</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{70D75D89-2420-4115-BA4B-53A9AA9E51F2}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)
local Shortcuts = require("Shortcuts")
local BlenderEdit = require("BlenderEdit")
local ChangeHistoryService = game:GetService("ChangeHistoryService")
local UserInputService = require("UserInputService")
local RunService = game:GetService("RunService")

local GraphRootState = require("State")
local History = {}

local undoStack = {}
local redoStack = {}
local maxSize = 1000

local applyingUndoRedo = false
local connections = {}
local onNotify = nil
local listeners = {}

local function changed()
	for callback in listeners do
		task.defer(callback)
	end
end

function History.subscribe(callback)
	listeners[callback] = true
	return function()
		listeners[callback] = nil
	end
end

local jumpToFrameCallback = nil
local activeCheckFn = nil
local beforeUndoRedo = nil
local shortcutHeld = {}

function History.isApplying()
	return applyingUndoRedo
end

local guardCallbacks = {}
local guardCleanupCallback = nil

local function push(stack, item)
	table.insert(stack, item)
	if #stack > maxSize then
		table.remove(stack, 1)
	end
end

local function isActive()
	if GraphRootState.WorkspaceSelection then
		return false
	end

	if GraphRootState.GraphEditor and GraphRootState.GraphEditor.hasFocus() then
		return false
	end

	if GraphRootState.CameraPreview and GraphRootState.CameraPreview.isFull() then
		return true
	end

	if not activeCheckFn then
		return true
	end

	local ok, result = pcall(activeCheckFn)
	return ok and result == true
end

local function resetStudioWaypoints(force)
	if force or ChangeHistoryService:GetCanUndo() or ChangeHistoryService:GetCanRedo() then
		ChangeHistoryService:SetWaypoint("EclipseAnimator_Reset_Begin")
		ChangeHistoryService:SetWaypoint("EclipseAnimator_Reset_End")
		ChangeHistoryService:ResetWaypoints()
	end
end

local function wipeStudioHistory()
	pcall(resetStudioWaypoints)
end

function History.protectSavedAnimations()
	local ok, err = pcall(resetStudioWaypoints, true)
	if not ok then
		warn("Eclipse could not protect saved animations from Studio undo:", err)
	end

	return ok
end

local function jumpIfNeeded(entry, direction)
	if not entry then
		return
	end

	if not jumpToFrameCallback then
		return
	end

	local target = nil
	if direction == "undo" and entry.undoContextFrame ~= nil then
		target = entry.undoContextFrame
	elseif direction == "redo" and entry.redoContextFrame ~= nil then
		target = entry.redoContextFrame
	else
		target = entry.contextFrame
	end

	if target == nil then
		return
	end

	pcall(jumpToFrameCallback, target)
end

function History.record(undoFn, redoFn, description, contextFrame, redoContextFrame)
	if type(undoFn) ~= "function" or type(redoFn) ~= "function" then
		warn("History.record: undoFn and redoFn must be functions")
		return
	end

	if applyingUndoRedo then
		return
	end

	local undoCF, redoCF
	if type(contextFrame) == "table" then
		undoCF = contextFrame.undo
		redoCF = contextFrame.redo
	else
		undoCF = contextFrame
		redoCF = redoContextFrame
	end

	local raw = require("RawState").Timeline
	local layerId = raw.AnimationLayers and raw.AnimationLayers.active
	local master = raw.AnimationLayers and raw.AnimationLayers.master
	local activeByRig = raw.AnimationLayers and table.clone(raw.AnimationLayers.activeByRig or {})

	local function bound(fn)
		return function()
			return require("Layers").history(layerId, fn, master, activeByRig)
		end
	end

	local entry = {
		undo = bound(undoFn),
		redo = bound(redoFn),
		description = description or "Action",
		contextFrame = undoCF,
		undoContextFrame = undoCF,
		redoContextFrame = (redoCF ~= nil) and redoCF or undoCF,
		afterUndo = type(contextFrame) == "table" and contextFrame.afterUndo or nil,
		afterRedo = type(contextFrame) == "table" and contextFrame.afterRedo or nil,
	}

	push(undoStack, entry)
	table.clear(redoStack)

	wipeStudioHistory()
	changed()
end

function History.undo()
	local picker = require("Picker")
	if picker.isOpen() then
		if BlenderEdit.blocked(true) then
			return false
		end

		return picker.undo()
	end

	if GraphRootState.PivotEditor and GraphRootState.PivotEditor.isActive() then
		GraphRootState.PivotEditor.undo()
		return
	end

	if
		GraphRootState.LiveSession
		and GraphRootState.LiveSession.isJoined()
		and GraphRootState.LiveSession.undo
	then
		task.spawn(GraphRootState.LiveSession.undo)
		return
	end

	if BlenderEdit.blocked(true) then
		return
	end

	if applyingUndoRedo then
		return false, nil
	end

	if GraphRootState.GreasePencil and GraphRootState.GreasePencil.isDrawing() then
		GraphRootState.GreasePencil.cancelStroke()
	end

	if beforeUndoRedo then
		beforeUndoRedo()
	end

	local action = table.remove(undoStack)
	if not action then
		if guardCleanupCallback then
			pcall(guardCleanupCallback)
		end

		return false, nil
	end

	applyingUndoRedo = true
	local ok, err = pcall(function()
		action.undo()
		jumpIfNeeded(action, "undo")
		if action.afterUndo then
			action.afterUndo()
		end
	end)
	applyingUndoRedo = false

	if not ok then
		warn("History undo failed:", err)
		push(undoStack, action)
		return false, nil
	end

	push(redoStack, action)
	pcall(function()
		require("motionPath").markDirty()
	end)

	wipeStudioHistory()
	changed()
	return true, action.description
end

function History.redo()
	local picker = require("Picker")
	if picker.isOpen() then
		if BlenderEdit.blocked(true) then
			return false
		end

		return picker.redo()
	end

	if GraphRootState.PivotEditor and GraphRootState.PivotEditor.isActive() then
		GraphRootState.PivotEditor.redo()
		return
	end

	if
		GraphRootState.LiveSession
		and GraphRootState.LiveSession.isJoined()
		and GraphRootState.LiveSession.redo
	then
		task.spawn(GraphRootState.LiveSession.redo)
		return
	end

	if BlenderEdit.blocked(true) then
		return
	end

	if applyingUndoRedo then
		return false, nil
	end

	if GraphRootState.GreasePencil and GraphRootState.GreasePencil.isDrawing() then
		GraphRootState.GreasePencil.cancelStroke()
	end

	if beforeUndoRedo then
		beforeUndoRedo()
	end

	local action = table.remove(redoStack)
	if not action then
		return false, nil
	end

	applyingUndoRedo = true
	local ok, err = pcall(function()
		action.redo()
		jumpIfNeeded(action, "redo")
		if action.afterRedo then
			action.afterRedo()
		end
	end)
	applyingUndoRedo = false

	if not ok then
		warn("History redo failed:", err)
		push(redoStack, action)
		return false, nil
	end

	push(undoStack, action)
	pcall(function()
		require("motionPath").markDirty()
	end)

	wipeStudioHistory()
	changed()
	return true, action.description
end

function History.clear()
	table.clear(undoStack)
	table.clear(redoStack)
	History.protectSavedAnimations()
end

function History.hasAnimationEdits()
	for _, entry in undoStack do
		if entry.description ~= "Add rig" then
			return true
		end
	end

	return false
end

function History.canUndo()
	return #undoStack > 0
end

function History.canRedo()
	return #redoStack > 0
end

function History.getStats()
	return {
		undo = #undoStack,
		redo = #redoStack,
		max = maxSize,
		undoTotal = #undoStack,
		redoTotal = #redoStack,
	}
end

function History.setMaxSize(n)
	maxSize = math.max(1, math.floor(n))
end

function History.setNotifyHandler(fn)
	onNotify = fn
end

function History.setJumpToFrame(fn)
	jumpToFrameCallback = fn
end

function History.setGuardCleanup(fn)
	guardCleanupCallback = fn
end

function History.setBeforeUndoRedo(fn)
	beforeUndoRedo = fn
end

function History.setActiveCheck(fn)
	activeCheckFn = fn
end

function History.setGuardCallbacks(cbs)
	guardCallbacks = cbs or {}
end

function History.setGuardExpiry(_seconds) end

function History.armGuard() end

local function isCtrlHeld()
	return UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
end

local function isShiftHeld()
	return UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
end

function History.init(_markerInst)
	for _, c in connections do
		c:Disconnect()
	end

	table.clear(connections)

	wipeStudioHistory()

	table.insert(
		connections,
		UserInputService.InputBegan:Connect(function(input, _gameProcessed)
			if input.UserInputType ~= Enum.UserInputType.Keyboard then
				return
			end

			if UserInputService:GetFocusedTextBox() then
				return
			end

			if not isActive() then
				return
			end

			local action
			if
				Shortcuts.matches("Redo", input)
				or Shortcuts.matches("RedoAlternate", input)
				or Shortcuts.matches("RedoShift", input)
			then
				action = History.redo
			elseif
				Shortcuts.matches("Undo", input) or Shortcuts.matches("UndoAlternate", input)
			then
				action = History.undo
			end

			if action and not shortcutHeld[input.KeyCode] then
				shortcutHeld[input.KeyCode] = true
				action()
			end
		end)
	)

	table.insert(
		connections,
		UserInputService.InputEnded:Connect(function(input)
			shortcutHeld[input.KeyCode] = nil
		end)
	)
	table.insert(
		connections,
		UserInputService.WindowFocusReleased:Connect(function()
			table.clear(shortcutHeld)
		end)
	)
	table.insert(
		connections,
		RunService.Heartbeat:Connect(function()
			for key in shortcutHeld do
				if not UserInputService:IsKeyDown(key) then
					shortcutHeld[key] = nil
				end
			end

			if not isActive() then
				return
			end

			wipeStudioHistory()
		end)
	)
end

function History.disconnect()
	table.clear(shortcutHeld)
	for _, c in connections do
		c:Disconnect()
	end

	table.clear(connections)
end

return History
]]></string>
            <int64 name="SourceAssetId">-1</int64>
