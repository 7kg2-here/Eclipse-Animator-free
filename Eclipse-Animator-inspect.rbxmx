          <Properties>
            <string name="Name">ArmaturePropertiesEditor</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f1a</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
