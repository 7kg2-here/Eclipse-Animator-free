            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local makeLegacy = require("makeLegacy")
local VFX = { Version = 1 }

local function finite(value, fallback, limit)
	if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then
		return fallback
	end

	return math.clamp(value, 0, limit or 3600)
end

function VFX.classify(item)
	if item:GetAttribute("Transformed") == true then
		return true, true
	end

	if item:HasTag("BezierParticle") then
		return true, true
	end

	if item:IsA("Model") then
		if item:FindFirstChild("Start") and item:FindFirstChild("End") then
			return true, true
		end

		if
			item:GetAttribute("SpinRotation")
			or item:GetAttribute("Scale_Start")
			or item:GetAttribute("Scale_End")
		then
			return true, false
		end
	end

	if item:IsA("BasePart") then
		local ancestor = item.Parent
		while ancestor and ancestor ~= game do
			if ancestor:IsA("Attachment") and ancestor:HasTag("Shockwave") then
				return true, true
			end

			ancestor = ancestor.Parent
		end
	end

	if item:IsA("RayValue") then
		return true, true
	end

	if item:IsA("ParticleEmitter") then
		local start = tonumber(item:GetAttribute("TimeScale_Start")) or item.TimeScale
		local finish = tonumber(item:GetAttribute("TimeScale_End")) or start
		if start ~= finish then
			return true, true
		end
	end

	if item:IsA("Beam") then
		for _, name in
			{
				"EffectDuration",
				"Width0_Start",
				"Width0_End",
				"StartWidth0",
				"EndTransparencyScale",
			}
		do
			if item:GetAttribute(name) ~= nil then
				return true, true
			end
		end
	end

	return false, false
end

function VFX.new(previewServices)
	local env = previewServices or {
		task = task,
		game = game,
		workspace = workspace,
		Instance = Instance,
		typeof = typeof,
		type = type,
		os = os,
		math = math,
		Random = Random,
		coroutine = coroutine,
		warn = warn,
		shared = shared,
	}
	local task, Instance, typeof = env.task, env.Instance, env.typeof
	local engine = { runs = {}, closed = false, enabled = {} }

	local function attribute(object, name, fallback, limit)
		local value = object:GetAttribute(name)
		if typeof(value) == "NumberRange" then
			value = env.math.random() * (value.Max - value.Min) + value.Min
		elseif typeof(value) == "string" then
			local a, b = value:match("^%s*([%d%.%-]+)%s*,%s*([%d%.%-]+)%s*$")
			if a and b then
				a, b = tonumber(a), tonumber(b)
				if a and b then
					value = a + env.math.random() * (b - a)
				end
			else
				value = tonumber(value)
			end
		end

		return finite(value, fallback, limit)
	end

	function engine:SetEnabled(root, value, options)
		assert(not self.closed, "EclipseVFX is closed")
		assert(typeof(root) == "Instance", "SetEnabled expects an instance")
		assert(type(value) == "boolean", "SetEnabled expects a boolean")
		options = options or {}

		local function apply(item)
			if
				not (
					item:IsA("ParticleEmitter")
					or item:IsA("Beam")
					or item:IsA("Trail")
					or item:IsA("Light")
				)
			then
				return
			end

			local saved = self.enabled[item]
			if not saved then
				saved = { original = item.Enabled }
				self.enabled[item] = saved
			end

			item.Enabled = value
			saved.last = value
		end

		apply(root)
		if not options.SelfOnly then
			for _, item in
				(options.Descendants == false and root:GetChildren() or root:GetDescendants())
			do
				apply(item)
			end
		end
	end

	function engine:Apply(root, row)
		local options = { Descendants = row.Mode == "All", SelfOnly = row.Mode == "Exact" }
		if row.Action == "Enable" or row.Action == "Disable" then
			return self:SetEnabled(root, row.Action == "Enable", options)
		elseif row.Action == nil or row.Action == "Emit" then
			return self:Emit(root, options)
		end
	end

	function engine:Emit(root, options)
		assert(not self.closed, "EclipseVFX is closed")
		assert(typeof(root) == "Instance", "Emit expects an instance")
		options = options or {}
		local run = {
			cancelled = false,
			outputs = {},
			threads = {},
			pending = 0,
			errors = {},
			children = {},
		}

		function run:IsFinished()
			return self.cancelled
				or self.pending == 0 and next(self.outputs) == nil and not self.legacy
		end

		self.runs[run] = true

		local function finished()
			if run.pending == 0 and next(run.outputs) == nil and not run.legacy then
				self.runs[run] = nil
			end
		end

		local function schedule(delay, fn)
			run.pending += 1
			local token = {}
			run.threads[token] = true
			local thread = task.delay(delay, function()
				if not run.cancelled and not self.closed then
					local ok, err = pcall(fn)
					if not ok then
						table.insert(run.errors, tostring(err))
						env.warn("EclipseVFX: " .. tostring(err))
					end
				end

				run.pending -= 1
				run.threads[token] = nil
				finished()
			end)
			if run.threads[token] then
				run.threads[token] = thread
			end
		end

		function run:Cancel()
			if self.cancelled then
				return
			end

			self.cancelled = true
			for _, child in self.children do
				child:Cancel()
			end

			table.clear(self.children)
			if self.legacy then
				self.legacy:Destroy()
				self.legacy = nil
			end

			for _, thread in self.threads do
				if type(thread) == "thread" and thread ~= coroutine.running() then
					pcall(task.cancel, thread)
				end
			end

			for output in self.outputs do
				output:Destroy()
			end

			table.clear(self.outputs)
			table.clear(self.threads)
			engine.runs[self] = nil
		end

		run.Destroy = run.Cancel

		local function native(source)
			local delay = attribute(source, "EmitDelay", 0)
			schedule(delay, function()
				if not source.Parent then
					return
				end

				local output = Instance.fromExisting(source)
				output.Name = "EclipseVFX Output"
				output.Archivable = false
				output:SetAttribute("EclipseVFXOutput", true)
				output.Enabled = false
				run.outputs[output] = true
				local parent = source.Parent
				if
					parent
					and parent:IsA("Attachment")
					and not parent:FindFirstAncestorWhichIsA("BasePart")
				then
					local anchor = Instance.new("Attachment")
					anchor.Name = "EclipseVFX Anchor"
					anchor.Archivable = false
					anchor.CFrame = parent.WorldCFrame
					anchor.Parent = env.workspace.Terrain
					run.outputs[anchor] = true
					parent = anchor
					local follow
					follow = function()
						if not output.Parent or not source.Parent then
							return
						end

						anchor.CFrame = source.Parent.WorldCFrame
						schedule(1 / 60, follow)
					end

					schedule(1 / 60, follow)
					output.Destroying:Once(function()
						anchor:Destroy()
						run.outputs[anchor] = nil
					end)
				end

				output.Parent = parent
				local duration = attribute(source, "EmitDuration", 0)
				local life = 0
				if source:IsA("ParticleEmitter") then
					local count = options.Count ~= nil and finite(options.Count, 0, 100000)
						or attribute(source, "EmitCount", 1, 100000)
					output.TimeScale = attribute(source, "TimeScale_Start", source.TimeScale, 1)
					output:Emit(math.floor(count))
					if duration > 0 then
						output.Enabled = true
					end

					local speed = math.max(0.001, output.TimeScale)
					life = source.Lifetime.Max / speed
				else
					output.Enabled = true
					duration = attribute(
						source,
						"EmitDuration",
						attribute(source, "EffectDuration", attribute(source, "Duration", 0.25))
					)
					if source:IsA("Trail") then
						life = source.Lifetime
					end
				end

				schedule(duration, function()
					if output.Parent then
						output.Enabled = false
					end

					schedule(life, function()
						output:Destroy()
						run.outputs[output] = nil
					end)
				end)
			end)
		end

		local visited = {}

		local function visit(item, descend)
			if visited[item] or item:GetAttribute("EclipseVFXOutput") == true then
				return
			end

			visited[item] = true
			local special, prune = VFX.classify(item)
			if special then
				schedule(0, function()
					if not item.Parent then
						return
					end

					if not run.legacy then
						run.legacy = makeLegacy(env, function(object)
							local child = self:Emit(object)
							table.insert(run.children, child)
							return child
						end)
						local poll
						poll = function()
							if not run.legacy then
								return
							end

							if run.legacy:active() then
								schedule(0.1, poll)
							else
								run.legacy:Destroy()
								run.legacy = nil
							end
						end

						schedule(0.1, poll)
					end

					run.legacy:emit(item)
				end)
				if prune then
					return
				end
			elseif
				item:IsA("ParticleEmitter")
				or item:IsA("Beam")
				or item:IsA("Trail")
				or item:IsA("Light")
			then
				native(item)
			end

			for _, child in item:GetChildren() do
				if descend then
					visit(child, true)
				elseif
					not options.SelfOnly
					and (
						child:IsA("ParticleEmitter")
						or child:IsA("Beam")
						or child:IsA("Trail")
						or child:IsA("Light")
					)
				then
					visit(child, false)
				end
			end
		end

		visit(root, options.Descendants ~= false)
		finished()
		return run
	end

	function engine:EmitAll(root, options)
		options = table.clone(options or {})
		options.Descendants = true
		return self:Emit(root, options)
	end

	function engine:EmitSelected(root, options)
		options = table.clone(options or {})
		options.Descendants = false
		return self:Emit(root, options)
	end

	function engine:Destroy()
		if self.closed then
			return
		end

		self.closed = true
		for run in self.runs do
			run:Cancel()
		end

		for item, saved in self.enabled do
			pcall(function()
				if item.Enabled == saved.last then
					item.Enabled = saved.original
				end
			end)
		end

		table.clear(self.enabled)
	end

	return engine
end

local default

function VFX.Emit(root, options)
	if not default or default.closed then
		default = VFX.new()
	end

	return default:Emit(root, options)
end

function VFX.EmitAll(root, options)
	options = table.clone(options or {})
	options.Descendants = true
	return VFX.Emit(root, options)
end

function VFX.EmitSelected(root, options)
	options = table.clone(options or {})
	options.Descendants = false
	return VFX.Emit(root, options)
end

function VFX.Destroy()
	if default then
		default:Destroy()
		default = nil
	end
end

function VFX.Bind(animationTrack, root)
	local engine = VFX.new()
	local connection = animationTrack:GetMarkerReachedSignal("EclipseVFX"):Connect(function(payload)
		local ok, data = pcall(
			game:GetService("HttpService").JSONDecode,
			game:GetService("HttpService"),
			payload
		)
		if not ok or type(data) ~= "table" or data.Version ~= 1 or type(data.Emits) ~= "table" then
			return
		end

		for _, row in data.Emits do
			if
				type(row) ~= "table"
				or type(row.Path) ~= "table"
				or #row.Path > 128
				or (row.Mode ~= "All" and row.Mode ~= "Selected" and row.Mode ~= "Exact")
			then
				continue
			end

			local target = root
			for _, step in row.Path do
				if not target or type(step) ~= "table" then
					target = nil
					break
				end

				local found, index = nil, 0
				for _, child in target:GetChildren() do
					if child.Name == step.Name and child.ClassName == step.Class then
						index += 1
						if index == step.Index then
							found = child
							break
						end
					end
				end

				target = found
			end

			if target and target.Parent then
				engine:Apply(target, row)
			end
		end
	end)
	local stopped = animationTrack.Stopped:Connect(function()
		engine:Destroy()
		engine = VFX.new()
	end)
	local binding = {}

	function binding:Disconnect()
		connection:Disconnect()
		stopped:Disconnect()
		engine:Destroy()
	end

	binding.Destroy = binding.Disconnect
	return binding
end

return VFX
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a449</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2048">
          <Properties>
            <string name="Name">EffectSampler</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028fa3</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{F0F3925F-1A39-4523-A860-CBEAE2799AB8}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local VFX = {}
local cache = setmetatable({}, { __mode = "k" })

local function sample(sequence, t, keypoints)
	local points = keypoints or sequence.Keypoints
	local a = points[1]
	for i = 2, #points do
		local b = points[i]
		if t <= b.Time then
			local f = (t - a.Time) / math.max(1e-6, b.Time - a.Time)
			return typeof(a.Value) == "Color3" and a.Value:Lerp(b.Value, f)
				or a.Value + (b.Value - a.Value) * f
		end

		a = b
	end

	return a.Value
end

local function set(object, property, value)
	if object[property] ~= value then
		object[property] = value
	end
end

local function frame(parent)
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.ClipsDescendants = true
	f.Active = false
	f.Interactable = false
	f.Parent = parent
	return f
end

local function image(parent, texture)
	local i = Instance.new("ImageLabel")
	i.AnchorPoint = Vector2.new(0.5, 0.5)
	i.BackgroundTransparency = 1
	i.BorderSizePixel = 0
	i.Image = texture
	i.Active = false
	i.Interactable = false
	i.Parent = parent
	return i
end

local function create(part, rows)
	local result = {}
	cache[part] = result
	for _, face in { Enum.NormalId.Back, Enum.NormalId.Front } do
		local gui = Instance.new("SurfaceGui")
		gui.Name = "EffectVFX" .. face.Name
		gui.Archivable = false
		gui:SetAttribute("EclipseEffectSurface", true)
		gui.Face = face
		gui.LightInfluence = 0
		gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		gui.CanvasSize = Vector2.new(1024, 1024)
		gui.ClipsDescendants = false
		gui.Active = false
		gui.Parent = part
		local surface = { gui = gui, rows = {}, flip = face == Enum.NormalId.Front and -1 or 1 }
		table.insert(result, surface)
		for index, row in rows do
			local object = row.object
			local entry = { object = object, source = row, slices = {} }
			table.insert(surface.rows, entry)
			if object:IsA("Beam") then
				local count = math.abs(object.Width0 - object.Width1) > 0.001 and 32 or 1
				for i = 1, count do
					local clip = frame(gui)
					clip.Name = "Ribbon" .. index .. "_" .. i
					local images = {}
					for j = 1, 3 do
						images[j] = image(clip, object.Texture)
					end

					table.insert(
						entry.slices,
						{ clip = clip, images = images, t = (i - 0.5) / count, count = count }
					)
				end
			else
				entry.image = image(gui, object.Texture)
				entry.image.Name = "Flare" .. index
			end
		end
	end

	return result
end

function VFX.paint(part, rows, visible, time)
	local surfaces = cache[part]
	if not visible then
		if surfaces then
			for _, s in surfaces do
				set(s.gui, "Enabled", false)
			end
		end

		return
	end

	if not surfaces then
		for _, c in part:GetChildren() do
			if c:IsA("SurfaceGui") and c.Name:sub(1, 9) == "EffectVFX" then
				c:Destroy()
			end
		end

		surfaces = create(part, rows)
	end

	local partSize = part.Size
	for _, s in surfaces do
		set(s.gui, "Enabled", true)
		set(s.gui, "AlwaysOnTop", true)
		for _, entry in s.rows do
			local object = entry.object
			if object:IsA("Beam") then
				local a, b = object.Attachment0.Position, object.Attachment1.Position
				local width0, width1, mode, texture =
					object.Width0, object.Width1, object.TextureMode, object.TextureLength
				local enabled = entry.source.props.Enabled ~= false
				local geometry = entry.geometry
				local changed = not geometry
					or geometry.a ~= a
					or geometry.b ~= b
					or geometry.size ~= partSize
					or geometry.width0 ~= width0
					or geometry.width1 ~= width1
					or geometry.mode ~= mode
					or geometry.texture ~= texture
					or geometry.enabled ~= enabled
				local color, transparency = object.Color, object.Transparency
				local paintChanged = entry.color ~= color or entry.transparency ~= transparency
				local colorPoints = paintChanged and color.Keypoints
				local transparencyPoints = paintChanged and transparency.Keypoints
				local offset = (time * (entry.source.props.TextureSpeed or 0)) % 1
				local moving = changed or entry.offset ~= offset
				if changed then
					local delta = b - a
					local length = math.max(0.001, delta.Magnitude)
					local textureLength = mode == Enum.TextureMode.Stretch
							and length / math.max(0.01, texture)
						or math.max(0.01, texture)
					local horizontal = math.abs(delta.X) >= math.abs(delta.Y)
					geometry = {
						a = a,
						b = b,
						size = partSize,
						width0 = width0,
						width1 = width1,
						mode = mode,
						texture = texture,
						enabled = enabled,
						length = length,
						textureLength = textureLength,
						along = horizontal and partSize.X or partSize.Y,
						across = horizontal and partSize.Y or partSize.X,
						rotation = math.deg(math.atan2(-delta.Y, s.flip * delta.X)),
					}
					entry.geometry = geometry
				end

				if not changed and not paintChanged and not moving then
					continue
				end

				for _, slice in entry.slices do
					local t = slice.t
					if changed then
						local center = a:Lerp(b, t)
						local width = width0 + (width1 - width0) * t
						local clip = slice.clip
						set(clip, "Visible", enabled and width > 0.00001)
						set(
							clip,
							"Position",
							UDim2.fromScale(
								0.5 + s.flip * center.X / partSize.X,
								0.5 - center.Y / partSize.Y
							)
						)
						set(
							clip,
							"Size",
							UDim2.fromScale(
								geometry.length / slice.count / geometry.along,
								width / geometry.across
							)
						)
						set(clip, "Rotation", geometry.rotation)
						slice.tile = geometry.textureLength / (geometry.length / slice.count)
						slice.phase = (t - 0.5 / slice.count)
							* geometry.length
							/ geometry.textureLength
					end

					local tile = slice.tile
					local phase = (offset + slice.phase) % 1
					local tint = paintChanged and sample(color, t, colorPoints)
					local alpha = paintChanged and sample(transparency, t, transparencyPoints)
					for j, i in slice.images do
						if changed then
							set(i, "Size", UDim2.fromScale(tile, 1))
						end

						if moving then
							set(i, "Position", UDim2.fromScale((j - 1 - phase) * tile, 0.5))
						end

						if paintChanged then
							set(i, "ImageColor3", tint)
							set(i, "ImageTransparency", alpha)
						end
					end
				end

				entry.color, entry.transparency, entry.offset = color, transparency, offset
			else
				local life = math.max(0.001, (object.Lifetime.Min + object.Lifetime.Max) * 0.5)
				local age = (time * object.TimeScale % life) / life
				local size = sample(object.Size, age)
				local squash = math.max(0.05, 1 + sample(object.Squash, age))
				local attachment = object.Parent
				local p = attachment:IsA("Attachment") and attachment.Position or Vector3.zero
				local i = entry.image
				i.Visible = entry.source.props.Enabled ~= false
				i.Position =
					UDim2.fromScale(0.5 + s.flip * p.X / partSize.X, 0.5 - p.Y / partSize.Y)
				i.Size = UDim2.fromScale(size * squash / partSize.X, size / squash / partSize.Y)
				i.Rotation = (object.Rotation.Min + object.Rotation.Max) * 0.5
					+ time * (object.RotSpeed.Min + object.RotSpeed.Max) * 0.5
				i.ImageColor3 = sample(object.Color, age)
				i.ImageTransparency = sample(object.Transparency, age)
			end
		end
	end
end

return VFX
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a44a</UniqueId>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2049">
          <Properties>
            <string name="Name">KeyframeStorage</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028fa4</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{F1478E33-1826-4419-BA4B-5796ADB8D4D1}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local Http = game:GetService("HttpService")
local Policy = require("Policy")
local Data = require("ChunkStore")
local R6Controls = require("R6Controls")
local MasterControl = require("MasterControl")
local Physics = require("Cache")
local Storage = {}
local MainState = require("State")

local function checkpoint()
	if MainState.ProjectWorkStep then
		MainState.ProjectWorkStep()
	end
end

local NAME = "EclipseKeyframeData"
local omitted = {
	Motor = true,
	Part = true,
	Button = true,
	SanitizeName = true,
	_EclipseRawStored = true,
	_EclipseRawChannels = true,
}

local function encode(value, seen)
	checkpoint()
	local kind = typeof(value)
	if kind == "CFrame" then
		return { C = { value:GetComponents() } }
	elseif kind == "Vector3" then
		return { V = { value.X, value.Y, value.Z } }
	elseif kind == "EnumItem" then
		return { E = { (tostring(value.EnumType):gsub("Enum%.", "")), value.Name } }
	elseif kind == "number" then
		assert(value == value and math.abs(value) < math.huge, "Non-finite keyframe value")
		return value
	elseif kind == "string" or kind == "boolean" then
		return value
	elseif kind == "table" then
		seen = seen or {}
		if seen[value] then
			return nil
		end

		seen[value] = true
		local pose = typeof(value.C0) == "CFrame" and value.C0 or nil
		local derived = false
		local flat = {}
		for key, item in value do
			if not omitted[key] and (typeof(key) == "string" or typeof(key) == "number") then
				if
					pose
					and (
						(key == "Position" and item == pose.Position)
						or (key == "Rotation" and item == pose.Rotation)
					)
				then
					derived = true
					continue
				end

				local encoded = encode(item, seen)
				if encoded ~= nil then
					table.insert(flat, key)
					table.insert(flat, encoded)
				end
			end
		end

		if derived then
			table.insert(flat, "_EclipseDerivedPose")
			table.insert(flat, true)
		end

		seen[value] = nil
		return { T = flat }
	end

	return nil
end

local function decode(value, budget)
	if typeof(value) ~= "table" then
		return value
	end

	if value.T then
		local flat, out = value.T, {}
		for index = 1, #flat, 2 do
			out[flat[index]] = decode(flat[index + 1], budget)
			if budget then
				budget()
			end
		end

		if out._EclipseDerivedPose then
			out._EclipseDerivedPose = nil
			if typeof(out.C0) == "CFrame" then
				if out.Position == nil then
					out.Position = out.C0.Position
				end

				if out.Rotation == nil then
					out.Rotation = out.C0.Rotation
				end
			end
		end

		return out
	elseif value.C then
		return CFrame.new(table.unpack(value.C))
	elseif value.V then
		return Vector3.new(table.unpack(value.V))
	elseif value.E then
		return Enum[value.E[1]][value.E[2]]
	end

	if value.type == "CFrame" then
		return CFrame.new(table.unpack(value.value))
	elseif value.type == "Vector3" then
		return Vector3.new(table.unpack(value.value))
	elseif value.type == "Enum" then
		return Enum[value.enum][value.value]
	elseif value.type == "Table" then
		local out = {}
		for _, entry in value.entries do
			out[entry.key] = decode(entry.value, budget)
			if budget then
				budget()
			end
		end

		return out
	end

	error("Invalid keyframe encoding")
end

local function pathOf(part, rig, bindings)
	local original = part
	local path = {}
	while part and part ~= rig do
		local parent = part.Parent
		if not parent then
			break
		end

		local index = 0
		for _, child in parent:GetChildren() do
			if child.Name == part.Name and child.ClassName == part.ClassName then
				index += 1
			end

			if child == part then
				break
			end
		end

		table.insert(path, 1, { name = part.Name, class = part.ClassName, index = index })
		part = parent
	end

	return part == rig and path
		or require("TrackOrganizationStorage").bindingPath(rig, original, bindings)
end

local function resolve(rig, path)
	local part = rig
	for _, step in path do
		if step.link == "Part1" then
			if not part:IsA("Motor6D") or not part.Part1 then
				return nil
			end

			part = part.Part1
			continue
		end

		local count, found = 0, nil
		for _, child in part:GetChildren() do
			if child.Name == step.name and child.ClassName == step.class then
				count += 1
				if count == step.index then
					found = child
					break
				end
			end
		end

		if not found then
			return nil
		end

		part = found
	end

	return part
end

local function collect(rig, state, fullArchive)
	local tracks, archived = {}, {}
	local incoming = {}
	for _, motor in require("RigTraversal").rigDescendants(rig) do
		if motor:IsA("Motor6D") and motor.Part1 then
			incoming[motor.Part1] = (incoming[motor.Part1] or 0) + 1
		end
	end

	local bindings = {}
	local hasMaster = MasterControl.get(rig, true) ~= nil
	local buckets = state.Keyframes
	if hasMaster or fullArchive then
		buckets = table.clone(buckets)
		for motor in state.DefaultPose do
			if not buckets[motor] then
				buckets[motor] = {}
			end
		end
	end

	for motor, bucket in buckets do
		checkpoint()
		if
			typeof(motor) == "table"
			and (motor.IsEclipseArmatureControl or motor.IsEclipseProperty)
		then
			continue
		end

		local path = pathOf(motor.Part1, rig, bindings)
		if not path then
			continue
		end

		local jointPath = typeof(motor) == "Instance"
				and motor:IsA("Motor6D")
				and (incoming[motor.Part1] or 0) > 1
				and pathOf(motor, rig)
			or nil
		local rest = (fullArchive or not next(bucket)) and state.DefaultPose[motor]
		local control = typeof(motor) == "table" and motor.IsEclipseR6Control
		local needed = jointPath ~= nil
			or fullArchive
			or control
			or rest
			or hasMaster
			or not Policy.channelsEnabled()
		for _, key in bucket do
			if
				key.CamAttachTarget ~= nil
				or key.CamTargetEnabled ~= nil
				or key.CamTrackTo ~= nil
				or key.CamTargetParent ~= nil
				or typeof(key.IK) == "boolean"
				or Policy.isDisabled(key)
				or key.ChannelPoseC0
				or key.BlenderCurve
				or key.BlenderSource
				or next(key.KeyGroups or {})
			then
				needed = true
				break
			end
		end

		if not needed then
			for _, key in bucket do
				for _, channel in key.Channels or {} do
					if channel.Easing then
						needed = true
						break
					end
				end

				if needed then
					break
				end
			end
		end

		if needed and (rest or hasMaster or next(bucket)) then
			local keys = {}
			for frame, key in bucket do
				table.insert(keys, { frame = frame, data = encode(key) })
				checkpoint()
			end

			local descriptor = control
					and {
						kind = motor:GetAttribute("EclipseR6Control"),
						customIK = motor.Owner:GetAttribute("EclipseAutoIK") == true or nil,
						customRest = encode(require("customRest").rest(motor.Owner)),
						owner = pathOf(motor.Owner.Part1, rig),
						rest = encode(state.DefaultPose[motor] or motor.Bone.CFrame),
						attributes = encode(motor:GetAttributes()),
					}
				or nil
			table.insert(tracks, {
				path = path,
				jointPath = jointPath,
				keys = keys,
				rest = rest and encode(rest) or nil,
				world = fullArchive and encode(state.DefaultWorldPose[motor]) or nil,
				parented = if fullArchive then state.ParentingDefaults[motor] else nil,
				size = fullArchive and encode(state.DefaultSize[motor.Part1]) or nil,
				control = descriptor,
			})
			if not control then
				archived[motor] = true
			end
		end
	end

	return tracks, archived
end

function Storage.plan(rig, state, fullArchive)
	return collect(rig, state, fullArchive)
end

local function encodeTracks(tracks)
	local out = { '{"version":2,"quaternionInterpolation":2,"tracks":[' }
	for i, track in tracks do
		if i > 1 then
			table.insert(out, ",")
		end

		local metadata = table.clone(track)
		metadata.keys = nil
		local text = Http:JSONEncode(metadata)
		table.insert(out, text:sub(1, -2))
		table.insert(out, ',"keys":[')
		for first = 1, #track.keys, 64 do
			local batch = table.create(math.min(64, #track.keys - first + 1))
			for index = first, math.min(first + 63, #track.keys) do
				table.insert(batch, track.keys[index])
			end

			if first > 1 then
				table.insert(out, ",")
			end

			local encoded = Http:JSONEncode(batch)
			table.insert(out, encoded:sub(2, -2))
			checkpoint()
		end

		table.insert(out, "]}")
		checkpoint()
	end

	table.insert(out, "]}")
	return table.concat(out)
end

function Storage.write(sequence, rig, state, fullArchive, prepared)
	local planted = rig:GetAttribute("EclipseIKFeetPlanted")
	if planted == nil then
		planted = require("Preferences").get("IKFeetPlanted")
	end

	sequence:SetAttribute("EclipseIKFeetPlanted", planted)
	sequence:SetAttribute("EclipseIKSettingsVersion", 2)
	sequence:SetAttribute(
		"EclipseR6BendPercent",
		rig:GetAttribute("EclipseR6BendPercent") or require("Preferences").get("R6BendPercent")
	)
	local tracks = prepared or collect(rig, state, fullArchive)
	if #tracks > 0 then
		Data.write(sequence, NAME, encodeTracks(tracks))
	end

	local modifierTracks = require("Mods").collect(rig, state, pathOf)
	if #modifierTracks > 0 then
		Data.write(
			sequence,
			"EclipseCurveModifiers",
			Http:JSONEncode({ version = 1, tracks = modifierTracks })
		)
	end

	Physics.write(sequence, rig, state, encode, pathOf)
end

local function restoreControl(rig, track, state, archive)
	local descriptor = track.control
	local last = track.path[#track.path]
	local kind = descriptor and descriptor.kind
		or last
			and last.class == "Bone"
			and ({ IK = "root", Spine = "spine", UpperTorso = "upper" })[last.name]
	if not kind then
		return nil
	end

	local ownerPath = descriptor and descriptor.owner or table.clone(track.path)
	if not descriptor then
		table.remove(ownerPath)
	end

	local ownerPart = resolve(rig, ownerPath)
	local owner = ownerPart and state.MotorByPart[ownerPart]
	if not owner then
		for candidate in state.DefaultPose do
			if candidate.Part1 == ownerPart then
				owner = candidate
				break
			end
		end
	end

	if not require("customRest").isJoint(owner) then
		return nil
	end

	local bone
	if descriptor then
		if descriptor.customIK == true then
			assert(
				require("customRest").chain(rig, owner, require("Parenting").collectMotors(rig)),
				"Saved custom IK chain is no longer connected"
			)
			owner:SetAttribute("EclipseAutoIK", true)
			require("customRest").restoreRest(
				owner,
				descriptor.customRest and decode(descriptor.customRest)
			)
			require("LimbIK").invalidate(rig)
		end

		bone = R6Controls.ensure(owner, kind, decode(descriptor.rest))

		bone:SetAttribute(
			"EclipseIKControlSpace",
			decode(descriptor.attributes).EclipseIKControlSpace
		)
		bone:SetAttribute(
			"EclipseIKAnchorOffset",
			decode(descriptor.attributes).EclipseIKAnchorOffset
		)
		for name, value in decode(descriptor.attributes) do
			bone:SetAttribute(name, value)
		end

		if
			descriptor.customIK
			and R6Controls.rigRoot(rig, owner.Part0)
			and not decode(descriptor.attributes).EclipseIKControlSpace
			and not decode(descriptor.attributes).EclipseIKAnchorOffset
		then
			bone:SetAttribute("EclipseIKControlSpace", nil)
			local first, offset
			for _, saved in archive and archive.tracks or {} do
				if resolve(rig, saved.path) == ownerPart then
					for _, record in saved.keys do
						local key = decode(record.data)
						if
							key.IKAnchor
							and key.IKRigWorld
							and (not first or record.frame < first)
						then
							first = record.frame
							offset = key.IKRigWorld:ToObjectSpace(key.IKAnchor)
						end
					end
				end
			end

			bone:SetAttribute("EclipseIKAnchorOffset", offset)
		end
	else
		local ik = require("LimbIK")
		local chain = ik.chain(rig, owner)
		if not chain or (chain.kind ~= "R6" and chain.kind ~= "Torso") then
			return nil
		end

		ik.prepare(chain)
		bone = R6Controls.find(owner, kind)
	end

	if not bone then
		return nil
	end

	local motor = R6Controls.get(bone)
	if descriptor and descriptor.customIK then
		R6Controls.anchor(owner, kind)
	end

	state.DefaultPose[motor] = descriptor and decode(descriptor.rest) or bone.CFrame
	state.MotorByPart[bone], state.ParentingDefaults[motor] = motor, true
	return bone
end

local function restoreAttachment(rig, data, state)
	if not require("CameraRig").isRig(rig) then
		return
	end

	for _, track in data.tracks do
		local last = track.path and track.path[#track.path]
		if last and last.name == "AttachToPart" then
			for _, record in track.keys or {} do
				if decode(record.data).CamAttachTarget ~= nil then
					local motor = require("Target").ensureAttachment(rig)
					if motor then
						state.DefaultPose[motor] = state.DefaultPose[motor] or CFrame.identity
						state.MotorByPart[motor.Part1] = motor
						state.ParentingDefaults[motor] = true
					end

					return
				end
			end
		end
	end
end

function Storage.prepareRead(sequence, rig, state, budget, layered)
	local source = sequence:FindFirstChild(NAME)
	if not source then
		return nil, {}
	end

	local data = Data.decodeJson(Data.read(source), budget, layered == true)
	assert(data.version == 1 or data.version == 2, "Unsupported keyframe data version")
	restoreAttachment(rig, data, state)
	local motors = {}
	for _, track in data.tracks do
		local part = resolve(rig, track.path)
		local motor = part and state.MotorByPart[part]
		if track.jointPath then
			motor = resolve(rig, track.jointPath)
			if not motor or not motor:IsA("Motor6D") or motor.Part1 ~= part then
				motor = nil
			end
		end

		if not motor and part and not track.jointPath then
			for candidate in state.DefaultPose do
				if candidate.Part1 == part then
					motor = candidate
					break
				end
			end
		end

		if motor then
			motors[motor] = true
		end
	end

	return data, motors
end

local function restoreQuaternionVersion(snapshot, samples)
	local ordered = {}
	for _, key in snapshot do
		table.insert(ordered, key)
	end

	table.sort(ordered, function(a, b)
		return a.Time < b.Time
	end)
	local version = 2
	local oldError, newError, count = 0, 0, 0
	local Interp = require("Interp")

	local function errorSquared(a, b)
		return (a.RightVector - b.RightVector).Magnitude ^ 2
			+ (a.UpVector - b.UpVector).Magnitude ^ 2
			+ (a.LookVector - b.LookVector).Magnitude ^ 2
	end

	for _, sample in samples or {} do
		checkpoint()
		local left, right
		for i = 1, #ordered - 1 do
			if
				sample.time > ordered[i].Time + 1e-5
				and sample.time < ordered[i + 1].Time - 1e-5
			then
				left, right = ordered[i], ordered[i + 1]
				break
			end
		end

		if
			left
			and not left.QuaternionInterpolationVersion
			and Interp.usesAutomaticBezier(left, right)
		then
			local alpha = (sample.time - left.Time) / (right.Time - left.Time)
			local modern = Interp.cframe(snapshot, left, right, alpha, "C0")
			left.QuaternionInterpolationVersion = 1
			local old = Interp.cframe(snapshot, left, right, alpha, "C0")
			left.QuaternionInterpolationVersion = nil
			if modern and old then
				newError += errorSquared(modern, sample.c0)
				oldError += errorSquared(old, sample.c0)
				count += 1
			end
		end
	end

	if count >= 2 and oldError < count * 1e-6 and newError > oldError + count * 1e-5 then
		version = 1
	end

	for _, key in ordered do
		key.QuaternionInterpolationVersion = key.QuaternionInterpolationVersion or version
	end
end

function Storage.read(
	sequence,
	rig,
	timeline,
	sanitize,
	prepared,
	budget,
	targetPivot,
	rotationEvidence
)
	local planted = sequence:GetAttribute("EclipseIKFeetPlanted")
	if type(planted) == "boolean" then
		rig:SetAttribute("EclipseIKFeetPlanted", planted)
	end

	rig:SetAttribute("EclipseIKSettingsVersion", 2)
	local bend = sequence:GetAttribute("EclipseR6BendPercent")
	if sequence:GetAttribute("EclipseIKSettingsVersion") ~= 2 and bend == 74.2 then
		bend = 65
	end

	if typeof(bend) == "number" and bend == bend then
		rig:SetAttribute("EclipseR6BendPercent", math.clamp(bend, 0, 100))
	end

	local function readModifiers()
		local modifierSource = sequence:FindFirstChild("EclipseCurveModifiers")
		if not modifierSource then
			return
		end

		local decoded = Http:JSONDecode(Data.read(modifierSource))
		local modifierState = timeline:GetState()
		require("Mods").load(decoded.tracks, modifierState, function(path)
			local part = resolve(rig, path)
			local motor = part and modifierState.MotorByPart[part]
			if not motor and part then
				for candidate in modifierState.DefaultPose do
					if candidate.Part1 == part then
						motor = candidate
						break
					end
				end
			end

			return motor
		end)
	end

	local source = sequence:FindFirstChild(NAME)
	if not source then
		readModifiers()
		return
	end

	local data = prepared or Data.decodeJson(Data.read(source), budget)
	assert(data.version == 1 or data.version == 2, "Unsupported keyframe data version")
	local state = timeline:GetState()
	restoreAttachment(rig, data, state)
	local legacyWorld = {}
	local hasMaster = MasterControl.get(rig) ~= nil
	for _, track in data.tracks do
		local part = resolve(rig, track.path)
		if track.control or not part then
			part = restoreControl(rig, track, state, data) or part
		end

		local motor = part and state.MotorByPart[part]
		if track.jointPath then
			motor = resolve(rig, track.jointPath)
			if not motor or not motor:IsA("Motor6D") or motor.Part1 ~= part then
				motor = nil
			end
		end

		if not motor and not track.jointPath then
			for candidate in state.DefaultPose do
				if candidate.Part1 == part then
					motor = candidate
					break
				end
			end
		end

		if not motor then
			assert(
				sequence:GetAttribute("EclipseRawRecovery") ~= true or #track.keys == 0,
				"Recovery is missing an attached object or joint. Restore the matching Studio place before reopening this recovery copy."
			)
			continue
		end

		if track.rest then
			state.DefaultPose[motor] = require("PoseSpace").scaleTranslation(
				decode(track.rest),
				require("PoseSpace").savedRatio(rig, sequence)
			)
		end

		if track.world then
			local space = require("PoseSpace")
			state.DefaultWorldPose[motor] = space.retargetWorld(
				decode(track.world),
				space.savedRatio(rig, sequence),
				sequence:GetAttribute("EclipseAuthoredPivot"),
				targetPivot or space.getImportPivot(rig, sequence)
			)
		end

		if track.parented ~= nil then
			state.ParentingDefaults[motor] = track.parented
		end

		if
			track.size
			and (
				state.DefaultSize[part] == nil
				or sequence:GetAttribute("EclipseRawRecovery") == true
			)
		then
			state.DefaultSize[part] = decode(track.size)
				* require("PoseSpace").savedRatio(rig, sequence)
		end

		local snapshot = {}
		for _, record in track.keys do
			if budget then
				budget()
			end

			local key = decode(record.data, budget)
			key._EclipseRawStored = true
			key.Frame, key.Time = record.frame, record.frame / state.FPS
			key.Motor, key.Part, key.SanitizeName = motor, part, sanitize
			snapshot[record.frame] = key
			if hasMaster and key.WorldCFrame and not key.MasterWorld then
				table.insert(legacyWorld, key)
			end

			timeline:EnsureTimelineEnd(record.frame)
		end

		restoreQuaternionVersion(
			snapshot,
			not data.quaternionInterpolation
				and rotationEvidence
				and rotationEvidence[motor]
				and rotationEvidence[motor].samples
		)
		timeline:_restoreMotorBucket(motor, snapshot, state._ImportingKeyframes, budget)
	end

	for _, record in legacyWorld do
		if budget then
			budget()
		end

		local key = state.Keyframes[record.Motor] and state.Keyframes[record.Motor][record.Frame]
		if key then
			local delta = MasterControl.worldDelta(record.Motor, function(motor, time)
				return timeline:EvaluateMotorC0(motor, time)
			end, record.Time)
			if delta and delta ~= CFrame.identity then
				key.MasterWorld = delta
			end
		end
	end

	readModifiers()
	if timeline.CaptureDefaultPoseAdditive then
		timeline:CaptureDefaultPoseAdditive(rig)
	end
end

function Storage.writePhysics(sequence, rig, state)
	Physics.write(sequence, rig, state, encode, pathOf)
end

function Storage.preparePhysics(sequence, rig, budget)
	return Physics.prepareRead(sequence, rig, resolve, budget)
end

function Storage.readPhysics(sequence, rig, timeline, sanitize, prepared, budget, targetPivot)
	Physics.read(sequence, rig, timeline, function(value)
		return decode(value, budget)
	end, resolve, sanitize, prepared, budget, targetPivot)
end

Storage.encode = encode
Storage.decode = decode
return Storage
]]></string>
