        <Item class="ModuleScript" referent="1960">
          <Properties>
            <string name="Name">MeshDisplay</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f4b</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{CA16E471-BF60-4352-9EE1-80D8EF1F23DB}</string>
