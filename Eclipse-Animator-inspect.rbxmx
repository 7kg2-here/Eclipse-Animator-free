              <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a463</UniqueId>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="2074">
          <Properties>
            <string name="Name">EffectCatalog</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028fbd</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{8550F5EB-AF3A-404B-AB56-E03F415E14B0}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local assets = {}

for _, group in {
	script.EclipseEffectCatalogSingularColors,
	script.EclipseEffectCatalogLighting,
	script.EclipseEffectCatalogDoubleColors,
	script.EclipseEffectCatalogMisc,
} do
	for _, asset in require(group) do
		table.insert(assets, asset)
	end
end

return assets
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">446baec80ec399830ae2841c0000a464</UniqueId>
          </Properties>
