        <Item class="ModuleScript" referent="1991">
          <Properties>
            <string name="Name">EditActions</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028f6a</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
