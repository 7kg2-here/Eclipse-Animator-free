            <Properties>
              <string name="Name">EclipseExportSubsystemsEventParticles</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <UniqueId name="HistoryId">31f3f4845f33150c0ae19e1000028fba</UniqueId>
              <ContentId name="LinkedSource">
                <null>
                </null>
