            <string name="Source"><![CDATA[--!nocheck
-- riftkuro

local require = require(script:FindFirstAncestor("Container").Require)

local ThemeConfig = {}

ThemeConfig.version = 1
ThemeConfig.settingKey = "EclipseThemeV1"

local legacyDefault = {

	Bg = "#210031>#0a0a0a@90",
	Top = "#210031",
	TopBtn = "#33004d",
	TopT = "#ffffff",
	Ctrl = "#ac9bc3>#675680@90",
